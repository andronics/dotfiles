#!/bin/bash
# pve-ct-create — create a Proxmox LXC container with a per-container root
# password generated into `pass` and the pve-guests SSH key injected.
#
# The password never appears on a command line: it is generated locally by
# `pass`, then fed to `chpasswd` inside the container over ssh stdin.
#
# Usage:
#   pve-ct-create [options] CTID NAME [-- extra `pct create` args]
#
# Options (env var fallback in brackets):
#   -n NODE       PVE node ssh alias/host            [PVE_NODE=pve-node-01]
#   -t TEMPLATE   template volid, e.g. local:vztmpl/debian-13-standard_...tar.zst
#                 default: newest debian-*-standard on NODE   [PVE_CT_TEMPLATE]
#   -s STORAGE    rootfs storage; default: first active storage
#                 offering 'rootdir' on NODE             [PVE_CT_STORAGE]
#   -d SIZE       rootfs size in GiB                     [8]
#   -c CORES      cores                                  [2]
#   -m MB         memory in MiB                          [1024]
#   -b BRIDGE     bridge for eth0                        [vmbr0]
#   -i IPCONF     ip for eth0, e.g. dhcp or 192.168.1.50/24,gw=192.168.1.1  [dhcp]
#   -p            privileged container (default unprivileged)
#   -k KEYFILE    public key to inject                   [~/.ssh/pve-guests.pub]
#   -P PASSPATH   pass entry path                        [hosts/NAME/users/root]
#   -f            overwrite an existing pass entry
#   -N            do not start the container (password + sshd hardening skipped)
#   -S            skip sshd hardening (leave PasswordAuthentication as template default)
#   -h            help
#
# Examples:
#   pve-ct-create 101 web01
#   pve-ct-create -n pve-node-02 -c 4 -m 4096 -i 192.168.1.101/24,gw=192.168.1.1 102 db01
#   pve-ct-create 103 docker01 -- --features nesting=1 --onboot 1

set -euo pipefail

NODE="${PVE_NODE:-pve-node-01}"
TEMPLATE="${PVE_CT_TEMPLATE:-}"
STORAGE="${PVE_CT_STORAGE:-}"
DISK=8
CORES=2
MEMORY=1024
BRIDGE=vmbr0
IPCONF=dhcp
UNPRIV=1
KEYFILE="$HOME/.ssh/pve-guests.pub"
PASSPATH=""
FORCE=0
START=1
HARDEN=1

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
die()   { printf 'pve-ct-create: %s\n' "$*" >&2; exit 1; }
log()   { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

[[ "${1:-}" == --help ]] && set -- -h
while getopts ':n:t:s:d:c:m:b:i:pk:P:fNSh' opt; do
    case $opt in
        n) NODE=$OPTARG ;;
        t) TEMPLATE=$OPTARG ;;
        s) STORAGE=$OPTARG ;;
        d) DISK=$OPTARG ;;
        c) CORES=$OPTARG ;;
        m) MEMORY=$OPTARG ;;
        b) BRIDGE=$OPTARG ;;
        i) IPCONF=$OPTARG ;;
        p) UNPRIV=0 ;;
        k) KEYFILE=$OPTARG ;;
        P) PASSPATH=$OPTARG ;;
        f) FORCE=1 ;;
        N) START=0 ;;
        S) HARDEN=0 ;;
        h) usage 0 ;;
        :) die "option -$OPTARG requires an argument" ;;
        *) die "unknown option -$OPTARG (see -h)" ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -ge 2 ]] || usage 1
CTID=$1; NAME=$2; shift 2
[[ ${1:-} == '--' ]] && shift
EXTRA=("$@")

[[ $CTID =~ ^[0-9]+$ && $CTID -ge 100 ]] || die "CTID must be an integer >= 100"
[[ $NAME =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || die "NAME must be a valid lowercase hostname label"
[[ -r $KEYFILE ]] || die "public key not readable: $KEYFILE"
PASSPATH=${PASSPATH:-hosts/$NAME/users/root}

for tool in pass ssh; do command -v "$tool" >/dev/null || die "$tool not found"; done

# --- pass entry: refuse to clobber unless -f ---------------------------------
if pass show "$PASSPATH" >/dev/null 2>&1 && [[ $FORCE -eq 0 ]]; then
    die "pass entry '$PASSPATH' already exists (use -f to overwrite)"
fi

# --- remote sanity checks ----------------------------------------------------
rssh() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$NODE" "$@"; }

log "checking node $NODE"
rssh 'command -v pct >/dev/null' || die "cannot reach $NODE or pct missing (is ~/.ssh/pve-hosts.pub in root's authorized_keys?)"

if rssh "pct status $CTID" >/dev/null 2>&1; then
    die "CT $CTID already exists on $NODE"
fi
if rssh "pvesh get /cluster/resources --type vm --output-format json" 2>/dev/null | grep -q "\"vmid\":$CTID[,}]"; then
    die "VMID $CTID is already in use elsewhere in the cluster"
fi

if [[ -z $TEMPLATE ]]; then
    TEMPLATE=$(rssh "pveam list local 2>/dev/null | awk '/debian-[0-9]+-standard/ {print \$1}' | sort -V | tail -1")
    [[ -n $TEMPLATE ]] || die "no debian-*-standard template on $NODE local storage; pass -t or run: pveam download local <template>"
fi

if [[ -z $STORAGE ]]; then
    STORAGE=$(rssh "pvesm status --content rootdir 2>/dev/null | awk 'NR>1 && \$3==\"active\" {print \$1}' | head -1")
    [[ -n $STORAGE ]] || die "no active storage with 'rootdir' content on $NODE; pass -s"
fi

cat <<SUMMARY
  node      $NODE
  ctid      $CTID
  hostname  $NAME
  template  $TEMPLATE
  rootfs    $STORAGE:$DISK
  cores/mem $CORES / ${MEMORY}MiB
  net0      $BRIDGE ip=$IPCONF
  unpriv    $UNPRIV
  key       $KEYFILE
  pass      $PASSPATH
  extra     ${EXTRA[*]:-}
SUMMARY

# --- password ----------------------------------------------------------------
log "generating root password -> pass $PASSPATH"
pass generate -n -f "$PASSPATH" 32 >/dev/null
PASSWORD=$(pass show "$PASSPATH" | head -1)
[[ -n $PASSWORD ]] || die "pass returned an empty password"
# re-store with metadata lines (password stays on line 1)
printf '%s\nuser: root\nnode: %s\nctid: %s\nhostname: %s\ncreated: %s\nnote: console/su only — sshd is key-only\n' \
    "$PASSWORD" "$NODE" "$CTID" "$NAME" "$(date -Iseconds)" \
    | pass insert -m -f "$PASSPATH" >/dev/null

# --- create ------------------------------------------------------------------
log "creating CT $CTID on $NODE"
# ship the pubkey over stdin so nothing is written to the node beforehand
rssh "set -e; f=\$(mktemp); trap 'rm -f \$f' EXIT; cat > \$f; \
      pct create $CTID $(printf '%q' "$TEMPLATE") \
        --hostname $(printf '%q' "$NAME") \
        --rootfs $(printf '%q' "$STORAGE:$DISK") \
        --cores $CORES --memory $MEMORY \
        --net0 $(printf '%q' "name=eth0,bridge=$BRIDGE,ip=$IPCONF") \
        --unprivileged $UNPRIV \
        --ssh-public-keys \$f \
        $([[ ${#EXTRA[@]} -gt 0 ]] && printf '%q ' "${EXTRA[@]}")" < "$KEYFILE"

if [[ $START -eq 0 ]]; then
    log "created but not started (-N). Root password is in pass but NOT yet set in the container."
    exit 0
fi

# --- start + set password ----------------------------------------------------
log "starting CT $CTID"
rssh "pct start $CTID"
for _ in $(seq 1 30); do
    rssh "pct exec $CTID -- true" >/dev/null 2>&1 && break
    sleep 1
done
rssh "pct exec $CTID -- true" >/dev/null 2>&1 || die "container started but not exec-able after 30s"

log "setting root password inside container"
printf 'root:%s\n' "$PASSWORD" | rssh "pct exec $CTID -- chpasswd"

if [[ $HARDEN -eq 1 ]]; then
    log "hardening sshd (key-only)"
    rssh "pct exec $CTID -- sh -c '
        [ -d /etc/ssh ] || exit 0
        mkdir -p /etc/ssh/sshd_config.d
        printf \"PasswordAuthentication no\\nPermitRootLogin prohibit-password\\nKbdInteractiveAuthentication no\\n\" > /etc/ssh/sshd_config.d/10-keys-only.conf
        grep -q \"^Include /etc/ssh/sshd_config.d\" /etc/ssh/sshd_config 2>/dev/null || \
            sed -i \"1i Include /etc/ssh/sshd_config.d/*.conf\" /etc/ssh/sshd_config
        (systemctl reload ssh || systemctl reload sshd || rc-service sshd reload) >/dev/null 2>&1 || true
    '"
fi

IP=$(rssh "pct exec $CTID -- hostname -I 2>/dev/null" | awk '{print $1}' || true)
log "done"
cat <<DONE
  CT $CTID ($NAME) running on $NODE${IP:+, ip $IP}
  ssh:      ssh -i ~/.ssh/pve-guests root@${IP:-<ip>}
  console:  ssh $NODE pct enter $CTID       (no password needed)
  password: pass show $PASSPATH             (web console / su only)
DONE
