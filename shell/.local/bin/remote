#!/usr/bin/env zsh
set -e

source "${DOTLIB}/_dispatcher" || { echo "missing _dispatcher" >&2; exit 1; }
source "${DOTLIB}/_remote"     || { echo "missing _remote" >&2; exit 1; }

dispatcher-init "remote" \
    --route=function \
    --description="Google Drive mount/sync management via rclone"

dispatcher-execute "$@"
