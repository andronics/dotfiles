#!/usr/bin/env zsh

# _barctl - the bar controller: one long-lived process that follows event
# sources and redraws polybar's custom/ipc modules only when what they show
# changes (design record 0001, docs/design/0001-polybar-ipc-module-taxonomy.md).
#
# How it works. `run` starts one watcher per source, each a child of the
# controller. A watcher follows its source's event stream, works out each of
# its modules' tier and text, and calls _barctl-set, which writes
# "<tier><TAB><text>" to ${BARCTL_STATE_DIR}/<module> and, only if that
# changed, pokes the module (`polybar-msg action "#<module>.hook.0"`). The
# module's one hook, `hook-0 = barctl render <module>`, reads that file and
# colours the text from the theme's roles on every render, so a polybar
# restart (initial = 1) or `theme apply` (which restarts the bar) shows the
# current state in the current colours without asking the controller.
#
# Tiers (record 0001 §6), each a theme role read at render time:
#   unavailable = dim, idle = fg_dim, active = accent, alert = urgent.
#
# Sources:
#   volume  `pactl subscribe` (sink and server events: a server event covers
#           a new default sink) -> audio-level. Unavailable when the pulse
#           server (pipewire-pulse) doesn't answer, idle when muted, active
#           otherwise.
#   player  `playerctl -a --follow metadata` over every MPRIS player ->
#           player-play-pause (the chosen player's icon from _player's
#           instances.json, and its state glyph) and player-metadata
#           ("artist: title", at most 40 characters). The chosen player:
#           Playing beats Paused beats Stopped, then the one whose status
#           changed most recently. Unavailable with no player, idle when
#           paused or stopped, active when playing.
#
# A watcher returns when its stream ends (the pulse server restarted, say):
# its modules go unavailable and `run` restarts it after BARCTL_RETRY
# seconds. `run` exits non-zero if a watcher dies, for systemd to restart.
#
# Adding a module: write _barctl-source-<name>, which follows its source and
# calls `_barctl-set <module> <tier> <text>` for each of its modules, and
# returns when the stream ends; list it in _BARCTL_SOURCES with its modules;
# make the module `type = custom/ipc` with `hook-0 = barctl render <module>`
# and `initial = 1` (polybar/modules/audio.ini is an example).
#
# The controller runs from systemd (barctl.service, started by .zlogin.d's
# 50-barctl), never from polybar: polybar 3.7 leaks its module pipes into
# long-lived children, which can freeze its next restart.
#
# Usage:
#   source "${DOTLIB}/_barctl"
#
# Dependencies:
#   Required: _common, _log; _theme (render); _player (the player source)
#   External: pactl, playerctl, polybar-msg, jq, flock, timeout

[[ -n "${BARCTL_LOADED:-}" ]] && return 0
declare -gr BARCTL_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _barctl requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

# BARCTL_STATE_DIR is for tests: .zshenv.d's 05-xdg keeps a caller's
# XDG_STATE_HOME, but a test should never be one variable away from the
# live state.
declare -g _BARCTL_STATE="${BARCTL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/barctl}"
declare -g _BARCTL_RETRY="${BARCTL_RETRY:-2}"
declare -g _BARCTL_SUPERVISE="${BARCTL_SUPERVISE:-30}"

# source -> the modules it draws, in start order.
typeset -gA _BARCTL_SOURCES=(
    [volume]="audio-level"
    [player]="player-play-pause player-metadata"
)
typeset -ga _BARCTL_ORDER=(volume player)

typeset -ga _BARCTL_ROLES=(unavailable=dim idle=fg_dim active=accent alert=urgent)
typeset -gA _BARCTL_COLORS=()

# What a module shows before its source has said anything, or with no
# controller running. Glyphs are current Nerd Font codepoints, as byte
# escapes (_barmenu does the same) so no editor turns them into CJK.
typeset -gA _BARCTL_GLYPH=(
    [vol-off]=$'\xf3\xb0\x96\x81'   # U+F0581 md-volume_off: muted or no server
    [vol-0]=$'\xef\x80\xa6'         # U+F026  fa-volume_off: speaker, no waves
    [vol-low]=$'\xef\x80\xa7'       # U+F027  fa-volume_low
    [vol-high]=$'\xef\x80\xa8'      # U+F028  fa-volume_high
    [stop]=$'\xef\x81\x8d'          # U+F04D  fa-stop
)
typeset -gA _BARCTL_DEFAULT=(
    [audio-level]="${_BARCTL_GLYPH[vol-off]}"
    [player-play-pause]="${_BARCTL_GLYPH[stop]}"
    [player-metadata]=""
)

declare -gi _BARCTL_METADATA_MAX=40

typeset -gA _BARCTL_DESCRIPTIONS=(
    [run]="The controller: follow every source (volume through pactl subscribe, players through playerctl --follow) and poke a module only when its text changes; one at a time, normally run by barctl.service"
    [render]="Print <module>'s current text, coloured from the theme's roles by its tier (the module's hook-0)"
    [poke]="Ask polybar to redraw <module> (polybar-msg action #<module>.hook.0)"
    [status]="Say whether the controller is running, and each module's tier and text"
)

_barctl-run-help()    { print -r -- "usage: barctl run: ${_BARCTL_DESCRIPTIONS[run]}"; }
_barctl-render-help() { print -r -- "usage: barctl render <module>: ${_BARCTL_DESCRIPTIONS[render]}"; }
_barctl-poke-help()   { print -r -- "usage: barctl poke <module>: ${_BARCTL_DESCRIPTIONS[poke]}"; }
_barctl-status-help() { print -r -- "usage: barctl status: ${_BARCTL_DESCRIPTIONS[status]}"; }

# Module names become file names and polybar action names.
_barctl-check-module() {
    [[ "${1:-}" =~ '^[a-z0-9][a-z0-9-]*$' ]] && return 0
    log-error "[barctl] not a module name: '${1:-}'"
    return 1
}

_barctl-poke() {
    (( ${+commands[polybar-msg]} )) || return 0
    timeout 2 polybar-msg action "#${1}.hook.0" </dev/null >/dev/null 2>&1 || true
}

# _barctl-set <module> <tier> <text>: records the module's state and pokes
# it, only if it changed. The file is replaced whole, so a render never
# reads half of it.
_barctl-set() {
    local _file="${_BARCTL_STATE}/$1" _new="$2"$'\t'"$3" _old=
    [[ -r "$_file" ]] && _old=$(<"$_file")
    [[ "$_old" == "$_new" ]] && return 0
    print -r -- "$_new" >| "${_file}.tmp" && mv -f -- "${_file}.tmp" "$_file" || return 1
    _barctl-poke "$1"
}

# --- volume -----------------------------------------------------------------

# Queries the default sink and sets audio-level.
_barctl-volume-update() {
    local _out _vol= _muted=no _glyph _pct
    if ! _out=$(pactl get-default-sink 2>/dev/null) || [[ -z "$_out" ]]; then
        _barctl-set audio-level unavailable "${_BARCTL_GLYPH[vol-off]}"
        return
    fi
    _out=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null) || _out=
    [[ "$_out" =~ '([0-9]+)%' ]] && _vol=${match[1]}
    _out=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null) || _out=
    [[ "$_out" == *'Mute: yes'* ]] && _muted=yes
    _pct="${_vol}%"
    if [[ -z "$_vol" ]]; then
        _barctl-set audio-level unavailable "${_BARCTL_GLYPH[vol-off]}"
    elif [[ "$_muted" == yes ]]; then
        _barctl-set audio-level idle "${_BARCTL_GLYPH[vol-off]} ${(r:4:)_pct}"
    else
        if (( _vol == 0 )); then _glyph=${_BARCTL_GLYPH[vol-0]}
        elif (( _vol < 50 )); then _glyph=${_BARCTL_GLYPH[vol-low]}
        else _glyph=${_BARCTL_GLYPH[vol-high]}
        fi
        _barctl-set audio-level active "${_glyph} ${(r:4:)_pct}"
    fi
}

_barctl-source-volume() {
    local _line
    _barctl-volume-update
    pactl subscribe 2>/dev/null | while IFS= read -r _line; do
        [[ "$_line" == "Event '"*"' on "(sink|server)" #"* ]] && _barctl-volume-update
    done
    _barctl-set audio-level unavailable "${_BARCTL_GLYPH[vol-off]}"
}

# --- player -----------------------------------------------------------------

# Per player instance, in the watcher's shell: its status, the tick of its
# last status change, its name (for the icon) and its track text.
typeset -gA _BARCTL_P_STATUS=() _BARCTL_P_SEQ=() _BARCTL_P_NAME=() _BARCTL_P_TRACK=()
typeset -gA _BARCTL_ICON_CACHE=()
declare -gi _BARCTL_P_TICK=0
declare -g _BARCTL_US=$'\x1f'

# Sets REPLY to the chosen player instance, or empty with none: Playing
# beats Paused beats Stopped, then the latest status change (record 0001,
# question 3).
_barctl-player-pick() {
    local _p
    local -i _rank _best=-1 _bestseq=-1
    REPLY=
    for _p in "${(@k)_BARCTL_P_STATUS}"; do
        case "${_BARCTL_P_STATUS[$_p]}" in
            Playing) _rank=3 ;;
            Paused)  _rank=2 ;;
            Stopped) _rank=1 ;;
            *)       _rank=0 ;;
        esac
        if (( _rank > _best || (_rank == _best && ${_BARCTL_P_SEQ[$_p]:-0} > _bestseq) )); then
            _best=_rank _bestseq=${_BARCTL_P_SEQ[$_p]:-0} REPLY=$_p
        fi
    done
}

# Sets REPLY to the icon _player's instances.json gives player name $1
# (the "default" entry for an unknown one), or the state table's glyph for
# state:<status>. Looked up once per name.
_barctl-player-icon() {
    local _key=$1 _json _field=name _val=$1
    [[ -n "${_BARCTL_ICON_CACHE[$_key]+x}" ]] && { REPLY=${_BARCTL_ICON_CACHE[$_key]}; return; }
    _json=${_PLAYER_INSTANCES_DATA:-[]}
    if [[ "$_key" == state:* ]]; then
        _json=${_PLAYER_STATES_DATA:-[]} _field=state _val=${(L)_key#state:}
    fi
    REPLY=$(jq -r --arg f "$_field" --arg v "$_val" \
        '((map(select(.[$f] == $v)) + map(select(.[$f] == "default" or .[$f] == "stopped")))[0].icon) // ""' \
        <<<"$_json" 2>/dev/null) || REPLY=
    _BARCTL_ICON_CACHE[$_key]=$REPLY
}

# Polybar reads %{ as the start of a format tag; %%{ is a literal one.
_barctl-escape() {
    REPLY=${1//\%\{/%%\{}
}

_barctl-player-update() {
    local _p _tier _text _track
    _barctl-player-pick; _p=$REPLY
    if [[ -z "$_p" ]]; then
        _barctl-set player-play-pause unavailable "${_BARCTL_DEFAULT[player-play-pause]}"
        _barctl-set player-metadata unavailable ""
        return
    fi
    [[ "${_BARCTL_P_STATUS[$_p]}" == Playing ]] && _tier=active || _tier=idle
    _barctl-player-icon "${_BARCTL_P_NAME[$_p]}"; _text=$REPLY
    _barctl-player-icon "state:${_BARCTL_P_STATUS[$_p]}"; _text+="${_text:+ }$REPLY"
    _track=${_BARCTL_P_TRACK[$_p]}
    (( ${#_track} > _BARCTL_METADATA_MAX )) && _track="${_track[1,_BARCTL_METADATA_MAX-1]}…"
    _barctl-escape "$_track"; _track=$REPLY
    _barctl-set player-play-pause "$_tier" "$_text"
    _barctl-set player-metadata "$_tier" "$_track"
}

# Forgets players playerctl no longer lists. playerctl -a --follow prints an
# empty line when a player goes, but not always before the next event.
_barctl-player-prune() {
    local _p
    local -A _live=()
    for _p in ${(f)"$(playerctl -l 2>/dev/null)"}; do _live[$_p]=1; done
    for _p in "${(@k)_BARCTL_P_STATUS}"; do
        (( ${+_live[$_p]} )) && continue
        unset "_BARCTL_P_STATUS[$_p]" "_BARCTL_P_SEQ[$_p]" "_BARCTL_P_NAME[$_p]" "_BARCTL_P_TRACK[$_p]"
    done
}

# One line of the follow stream: instance, name, status, artist, title.
_barctl-player-event() {
    local _inst _name _status _artist _title
    IFS=$_BARCTL_US read -r _inst _name _status _artist _title <<<"$1"
    if [[ -n "$_inst" ]]; then
        if [[ "${_BARCTL_P_STATUS[$_inst]:-}" != "$_status" ]]; then
            _BARCTL_P_SEQ[$_inst]=$(( ++_BARCTL_P_TICK ))
        fi
        _BARCTL_P_STATUS[$_inst]=$_status
        _BARCTL_P_NAME[$_inst]=$_name
        if [[ -n "$_artist" && -n "$_title" ]]; then
            _BARCTL_P_TRACK[$_inst]="${_artist}: ${_title}"
        else
            _BARCTL_P_TRACK[$_inst]="${_artist}${_title}"
        fi
    fi
    _barctl-player-prune
    _barctl-player-update
}

_barctl-source-player() {
    local _line _fmt="{{playerInstance}}${_BARCTL_US}{{playerName}}${_BARCTL_US}{{status}}${_BARCTL_US}{{artist}}${_BARCTL_US}{{title}}"
    _BARCTL_P_STATUS=() _BARCTL_P_SEQ=() _BARCTL_P_NAME=() _BARCTL_P_TRACK=()
    if [[ -z "${_PLAYER_INSTANCES_DATA:-}" ]]; then
        source "${DOTLIB}/_player" >/dev/null 2>&1 && player-load-instances >/dev/null 2>&1 \
            || log-warning "[barctl] _player missing: players shown without icons"
    fi
    _barctl-player-update
    playerctl -a --follow metadata --format "$_fmt" 2>/dev/null | while IFS= read -r _line; do
        _barctl-player-event "$_line"
    done
    _BARCTL_P_STATUS=()
    _barctl-player-update
}

# --- the controller ---------------------------------------------------------

# Appends <pid> and everything under it to the caller's _tree, parents first.
_barctl-tree() {
    local _child
    _tree+=("$1")
    for _child in ${(f)"$(pgrep -P "$1" 2>/dev/null)"}; do
        _barctl-tree "$_child"
    done
}

# Kills <pid> and everything under it. The tree is listed before anything
# dies, and a watcher's shell goes before its stream: a stream that ended
# first would have the watcher mark its modules unavailable and restart it.
_barctl-kill-tree() {
    local -a _tree=()
    _barctl-tree "$1"
    kill -TERM "${_tree[@]}" 2>/dev/null
    return 0
}

barctl-run() {
    emulate -L zsh -o extended_glob
    local _src _module _lock_fd _p
    local -a _pids=()
    [[ "${1:-}" == (-h|--help) ]] && { _barctl-run-help; return 0; }

    mkdir -p -- "$_BARCTL_STATE" || return 1
    exec {_lock_fd}>"${_BARCTL_STATE}/run.lock"
    if ! flock -n "$_lock_fd"; then
        log-error "[barctl] already running (pid $(<"${_BARCTL_STATE}/pid" 2>/dev/null))"
        return 1
    fi
    print -r -- $$ >| "${_BARCTL_STATE}/pid"

    # A fresh start redraws every module, whatever the files say.
    for _src in "${_BARCTL_ORDER[@]}"; do
        for _module in ${=_BARCTL_SOURCES[$_src]}; do
            rm -f -- "${_BARCTL_STATE}/${_module}"
        done
    done

    {
        trap 'return 0' TERM INT HUP
        for _src in "${_BARCTL_ORDER[@]}"; do
            (
                trap - TERM INT HUP
                while :; do
                    "_barctl-source-${_src}"
                    sleep "$_BARCTL_RETRY"
                done
            ) &
            _pids+=($!)
        done
        log-info "[barctl] running: ${(j:, :)_BARCTL_ORDER}"
        while :; do
            for _p in "${_pids[@]}"; do
                kill -0 "$_p" 2>/dev/null && continue
                log-error "[barctl] a watcher died; exiting for a restart"
                return 1
            done
            sleep "$_BARCTL_SUPERVISE" &
            wait $! 2>/dev/null
        done
    } always {
        for _p in "${_pids[@]}"; do _barctl-kill-tree "$_p"; done
        pkill -P $$ -x sleep 2>/dev/null
        rm -f -- "${_BARCTL_STATE}/pid"
        exec {_lock_fd}>&-
    }
}

barctl-render() {
    emulate -L zsh -o extended_glob
    local _module=${1:-} _line _tier=unavailable _text
    [[ "$_module" == (-h|--help) ]] && { _barctl-render-help; return 0; }
    _barctl-check-module "$_module" || return 1
    _text=${_BARCTL_DEFAULT[$_module]:-}
    if [[ -r "${_BARCTL_STATE}/${_module}" ]]; then
        _line=$(<"${_BARCTL_STATE}/${_module}")
        _tier=${_line%%$'\t'*} _text=${_line#*$'\t'}
    fi
    [[ -z "$_text" ]] && { print; return 0; }
    source "${DOTLIB}/_theme" >/dev/null 2>&1 || { print -r -- "$_text"; return 0; }
    theme-roles _BARCTL_COLORS "${_BARCTL_ROLES[@]}" 2>/dev/null
    print -r -- "%{F${_BARCTL_COLORS[$_tier]:-${_BARCTL_COLORS[unavailable]}}}${_text}%{F-}"
}

barctl-poke() {
    emulate -L zsh
    [[ "${1:-}" == (-h|--help) ]] && { _barctl-poke-help; return 0; }
    _barctl-check-module "${1:-}" || return 1
    (( ${+commands[polybar-msg]} )) || { log-error "[barctl] polybar-msg not found"; return 1; }
    polybar-msg action "#${1}.hook.0" </dev/null
}

barctl-status() {
    emulate -L zsh
    local _src _module _line _pid=
    [[ "${1:-}" == (-h|--help) ]] && { _barctl-status-help; return 0; }
    [[ -r "${_BARCTL_STATE}/pid" ]] && _pid=$(<"${_BARCTL_STATE}/pid")
    if [[ -n "$_pid" ]] && kill -0 "$_pid" 2>/dev/null; then
        print -r -- "controller: running (pid ${_pid})"
    else
        print -r -- "controller: not running"
    fi
    for _src in "${_BARCTL_ORDER[@]}"; do
        for _module in ${=_BARCTL_SOURCES[$_src]}; do
            _line=
            [[ -r "${_BARCTL_STATE}/${_module}" ]] && _line=$(<"${_BARCTL_STATE}/${_module}")
            printf '%-18s %-8s %-12s %s\n' "$_module" "$_src" "${${_line%%$'\t'*}:-none}" "${_line#*$'\t'}"
        done
    done
}
