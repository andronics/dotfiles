# Show current configuration
log-show-config() {
    echo "Logging Configuration:"
    echo "  Mode:              $LOG_MODE"
    echo "  Level:             $LOG_LEVEL"
    echo "  Timestamps:        $LOG_TIMESTAMPS"
    echo "  Output Format:     $LOG_OUTPUT_FORMAT"
