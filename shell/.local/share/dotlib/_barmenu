#!/usr/bin/env zsh

# _barmenu - the polybar menu buttons as rofi menus that open just above the
# clicked button (rofi/themes/bar-menu.rasi).
#
# Every menu is one entry in _BARMENU_MENUS plus its rows in _BARMENU_ROWS;
# `barmenu <menu>` (a function generated per entry) shows it and runs the
# picked row's command. Escape runs nothing.
#
# Placement: polybar passes a click no coordinates, so the pointer is read
# with xdotool when the menu opens and the window's bottom-left corner put
# there (less _BARMENU_INSET, so the pointer sits over the glyph column),
# clamped to the pointer's monitor. y-offset in the theme clears the bar.
# Without a pointer the menu falls back to its side's bottom corner.
#
# Bar clicks and polybar's pipes: polybar 3.7 opens its pipes without
# close-on-exec and forks commands from several threads, so a click handler
# can inherit another module's output pipe, and anything long-lived holding
# it can freeze the bar's next restart (see _desk-close-inherited in _desk).
# So every entry point first drops inherited pipes (and points stdio that is
# a pipe at /dev/null) before rofi starts, and the picked command runs in its
# own session under `setsid -f` on /dev/null. `barmenu run <cmd...>` gives the same launch to buttons that are not
# menus (the power button runs `barmenu run power menu`).
#
# A menu's settle time (seconds) delays its command after rofi closes, so a
# screenshot never catches rofi: picom fades a closing window out over about
# 0.4s (fade-out-step 0.05 at fade-delta 20ms).
#
# Usage:
#   source "${DOTLIB}/_barmenu"
#
# Dependencies:
#   Required:
#     - _common
#   Optional:
#     - _log
#   External:
#     - rofi, setsid; xdotool and xrandr for placement (else the side corner)

[[ -n "${BARMENU_LOADED:-}" ]] && return 0
declare -gr BARMENU_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _barmenu requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

zmodload -F zsh/stat b:zstat

# name -> "glyph|title|side|settle": glyph is the bar button's, side (left or
# right) the fallback corner, settle the seconds to wait before the command.
# Glyphs are UTF-8 byte escapes (locale-proof, unlike \u): several are legacy
# Nerd Font codepoints (U+F900-FAFF) that editors and Unicode normalisation
# turn into CJK ideographs.
typeset -gA _BARMENU_MENUS=(
    [layout]=$'\xEF\xAA\xB1|Layout|left|'
    [screenshot]=$'\xF3\xB0\x84\x80|Screenshot|left|0.5'
    [settings]=$'\xEF\x80\x93|Settings|left|'
    [vpn]=$'\xEF\xAA\x81|VPN|left|'
    [session]=$'\xEF\x80\x87|Session|right|'
)

# Flat: menu, glyph (may be empty), label, command. Commands run in `zsh -fc`
# with the bar's environment, detached; the order here is the menu's order.
typeset -ga _BARMENU_ROWS=(
    layout     ''        'DEFAULT'         'bsp-layout set tiled'
    layout     ''        'EVEN'            'bsp-layout set even'
    layout     ''        'GRID HORIZONTAL' 'bsp-layout set grid'
    layout     ''        'GRID VERTICAL'   'bsp-layout set rgrid'
    layout     ''        'TALL LEFT'       'bsp-layout set tall'
    layout     ''        'TALL RIGHT'      'bsp-layout set rtall'
    layout     ''        'WIDE TOP'        'bsp-layout set wide'
    layout     ''        'WIDE BOTTOM'     'bsp-layout set rwide'

    screenshot $'\xEE\xA9\xBA' 'FULLSCREEN'      'screenshot fullscreen'
    screenshot $'\xEE\xA9\xBA' 'GEOMETRY'        'screenshot geometry'
    screenshot $'\xEE\xA9\xBA' 'SELECTION'       'screenshot selection'
    screenshot $'\xEE\xA9\xBA' 'WINDOW'          'screenshot window'
    screenshot $'\xEE\xA9\xBA' 'DELAYED…'        'screenshot delayed'

    settings   ''        'BSPWM'           'code ~/.config/bspwm'
    settings   ''        'POLYBAR'         'code ~/.config/polybar'
    settings   ''        'DOTFILES'        'code ~/.dotfiles'
    settings   ''        'SXHKD'           'code ~/.config/sxhkd/sxhkdrc'

    vpn        $'\xEF\xA6\x83' 'CONNECT'         'nordvpn connect'
    vpn        $'\xEF\x99\x9A' 'Disconnect'      'nordvpn disconnect'
    vpn        $'\xEF\x9F\xBC' 'Information'     'dunstify -t 0 "VPN Status" "$(nordvpn status)"'

    session    $'\xEF\xAB\xBC' 'QUIT'            'power logout'
    session    $'\xEF\xA5\x92' 'COMPOSITOR'      'killall -eq picom; sleep 1.5; picom --config ~/.config/picom/picom.conf -b'
)

# rofi theme: a name resolves to ~/.config/rofi/themes/<name>.rasi.
declare -g _BARMENU_THEME="${BARMENU_THEME:-bar-menu}"
# Must match window.width in themes/bar-menu.rasi (it is passed again, so the
# clamp and the window agree even if the theme drifts).
declare -gi _BARMENU_WIDTH=360
# Pixels from the menu's left edge to the pointer, and kept from the edge of
# the monitor.
declare -gi _BARMENU_INSET=24
declare -gi _BARMENU_MARGIN=8

# The commands of the rows _barmenu-rows last built.
typeset -ga _BARMENU_COMMANDS=()

typeset -gA _BARMENU_DESCRIPTIONS=(
    [run]="Run a command detached from the bar (setsid, no inherited fds)"
)

# ------------------------------
# Private Helpers
# ------------------------------

# Closes every pipe this shell inherited beyond 0-2, and points 0-2 at
# /dev/null when they are pipes (a terminal or file is kept, for use from a
# shell). The same rule as _desk-close-inherited: only pipes.
_barmenu-close-inherited() {
    local _fd _link
    for _fd in /proc/$$/fd/<3->(N:t); do
        zstat -L -A _link +link /proc/$$/fd/$_fd 2>/dev/null || continue
        [[ "$_link" == pipe:* ]] && exec {_fd}>&-
    done
    # No 2>/dev/null here: under it, fd 2 itself reads as /dev/null.
    for _fd in 0 1 2; do
        zstat -L -A _link +link /proc/$$/fd/$_fd || continue
        [[ "$_link" == pipe:* ]] || continue
        case $_fd in
            0) exec </dev/null ;;
            1) exec >/dev/null ;;
            2) exec 2>/dev/null ;;
        esac
    done
    return 0
}

# Runs shell command $1 in its own session on /dev/null and returns at once.
_barmenu-launch() {
    setsid -f zsh -fc "$1" </dev/null >/dev/null 2>&1
}

# Sets reply to the -theme arguments, or none when the file is missing (rofi
# would refuse to start).
_barmenu-theme-args() {
    local _theme=$_BARMENU_THEME
    [[ "$_theme" == */* ]] || _theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/themes/${_theme}.rasi"
    reply=()
    [[ -r "$_theme" ]] && reply=(-theme "$_theme")
    return 0
}

# Sets reply to the rofi arguments that place menu $1's window: bottom-left
# corner at the pointer on the pointer's monitor, else the menu's side corner.
_barmenu-place() {
    local _side=${${(s:|:)_BARMENU_MENUS[$1]}[3]:-left} _line _name
    local -i _px _py _mx _my _mw _mh _x _found=0
    local -A _pointer

    if (( ${+commands[xdotool]} && ${+commands[xrandr]} )) \
        && _line=$(xdotool getmouselocation --shell 2>/dev/null) \
        && [[ -n "$_line" ]]; then
        for _line in ${(f)_line}; do _pointer[${_line%%=*}]=${_line#*=}; done
        _px=${_pointer[X]:-0} _py=${_pointer[Y]:-0}
        # " 0: +*DP-2 5120/1200x1440/340+0+0  DP-2"
        for _line in ${(f)"$(xrandr --listactivemonitors 2>/dev/null)"}; do
            [[ "$_line" =~ '([0-9]+)/[0-9]+x([0-9]+)/[0-9]+\+([0-9]+)\+([0-9]+)[[:space:]]+([^[:space:]]+)$' ]] || continue
            _mw=$match[1] _mh=$match[2] _mx=$match[3] _my=$match[4] _name=$match[5]
            if (( _px >= _mx && _px < _mx + _mw && _py >= _my && _py < _my + _mh )); then
                _found=1
                break
            fi
        done
    fi

    if (( _found )); then
        _x=$(( _px - _mx - _BARMENU_INSET ))
        (( _x > _mw - _BARMENU_WIDTH - _BARMENU_MARGIN )) && _x=$(( _mw - _BARMENU_WIDTH - _BARMENU_MARGIN ))
        (( _x < _BARMENU_MARGIN )) && _x=$_BARMENU_MARGIN
        reply=(-m "$_name" -theme-str "window { location: south west; anchor: south west; x-offset: ${_x}px; width: ${_BARMENU_WIDTH}px; }")
    elif [[ "$_side" == right ]]; then
        reply=(-theme-str "window { location: south east; anchor: south east; x-offset: -${_BARMENU_MARGIN}px; width: ${_BARMENU_WIDTH}px; }")
    else
        reply=(-theme-str "window { location: south west; anchor: south west; x-offset: ${_BARMENU_MARGIN}px; width: ${_BARMENU_WIDTH}px; }")
    fi
}

_barmenu-escape() {
    local _s=${1//&/&amp;}
    _s=${_s//</&lt;}
    REPLY=${_s//>/&gt;}
}

# Sets reply to menu $1's pango rows and _BARMENU_COMMANDS to their commands,
# in the same order. Returns 1 for an unknown or empty menu.
_barmenu-rows() {
    local _menu=$1 _m _glyph _label _cmd
    reply=() _BARMENU_COMMANDS=()
    (( ${+_BARMENU_MENUS[$_menu]} )) || return 1
    for _m _glyph _label _cmd in "${_BARMENU_ROWS[@]}"; do
        [[ "$_m" == "$_menu" ]] || continue
        _barmenu-escape "$_label"
        # The glyph is part of the text (the theme has no icon column), so a
        # row without one starts at the element's padding.
        if [[ -n "$_glyph" ]]; then
            reply+=("<span font_family='Symbols Nerd Font Mono'>${_glyph}</span> ${REPLY}")
        else
            reply+=("$REPLY")
        fi
        _BARMENU_COMMANDS+=("$_cmd")
    done
    (( ${#reply} ))
}

# Shows menu $1 and sets REPLY to the picked row's command. Returns 1 on
# Escape or an unknown menu. Extra arguments go to rofi (rofi-preview adds a
# -mesg).
_barmenu-choose() {
    local _menu=$1 _choice _glyph _title
    local -a _rows _theme _place
    shift
    _barmenu-rows "$_menu" || { log-error "[barmenu] unknown menu '${_menu}'"; return 1; }
    _rows=("${reply[@]}")
    _barmenu-theme-args; _theme=("${reply[@]}")
    _barmenu-place "$_menu"; _place=("${reply[@]}")
    _glyph=${${(s:|:)_BARMENU_MENUS[$_menu]}[1]}
    _title=${${(s:|:)_BARMENU_MENUS[$_menu]}[2]:-$_menu}

    # -format i returns the row's index in the unfiltered list.
    _choice=$(print -rn -- "${(pj:\n:)_rows}" | rofi -dmenu -i -no-custom -markup-rows -format i \
        "${_theme[@]}" "${_place[@]}" -p "${_glyph:+$_glyph }${_title}" "$@") || return 1
    [[ "$_choice" == <-> ]] && (( _choice < ${#_BARMENU_COMMANDS} )) || return 1
    REPLY=${_BARMENU_COMMANDS[_choice + 1]}
}

# Shows menu $1 and launches the pick. Escape returns 0: closing the menu is
# not a failure.
_barmenu-open() {
    local _menu=$1 _settle
    _barmenu-close-inherited
    _barmenu-choose "$_menu" || return 0
    _settle=${${(s:|:)_BARMENU_MENUS[$_menu]}[4]}
    _barmenu-launch "${_settle:+sleep $_settle; }${REPLY}"
}

barmenu-help() {
    local _menu
    print -r -- "barmenu - the polybar menu buttons as rofi menus, opened above the pointer"
    print
    print -r -- "Usage: barmenu <menu>"
    print -r -- "       barmenu run <command> [args...]"
    print
    print -r -- "Menus:"
    for _menu in ${(ok)_BARMENU_MENUS}; do
        print -r -- "  ${(r:12:)_menu}${_BARMENU_DESCRIPTIONS[$_menu]}"
    done
    print
    print -r -- "  run         Run a command detached from the bar's pipes (setsid, /dev/null)"
    print
    print -r -- "Environment:"
    print -r -- "  BARMENU_THEME   rofi theme name or path (default bar-menu)"
}

# ------------------------------
# Public
# ------------------------------

# One barmenu-<menu> per table entry, with a description listing its rows.
() {
    local _menu _m _glyph _label _cmd
    local -a _labels
    for _menu in ${(k)_BARMENU_MENUS}; do
        _labels=()
        for _m _glyph _label _cmd in "${_BARMENU_ROWS[@]}"; do
            [[ "$_m" == "$_menu" ]] && _labels+=("$_label")
        done
        _BARMENU_DESCRIPTIONS[$_menu]="${${(s:|:)_BARMENU_MENUS[$_menu]}[2]} menu: ${(j:, :)_labels}"
        functions[barmenu-$_menu]="_barmenu-open ${(q)_menu} \"\$@\""
    done
}

barmenu-run() {
    (( $# )) || { log-error "[barmenu] run: no command"; return 2; }
    _barmenu-close-inherited
    setsid -f "$@" </dev/null >/dev/null 2>&1
}
