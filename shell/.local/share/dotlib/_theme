#!/usr/bin/env zsh

# _theme - the desktop theme spec: load a source, resolve it into semantic
# roles with guaranteed contrast, render templates with gomplate, and swap the
# result in atomically.
#
# Pipeline (`apply`):
#   source   a named scheme: base16/base24 YAML in ${THEME_CONFIG}/schemes;
#            or an image or a single colour, run through matugen and
#            adapted into the same scheme shape (see "Generated sources")
#   resolve  prefs.toml, with ${state}/overrides.json merged over it, plus the
#            palette -> roles (bg, fg, accent, urgent, busy, dim, ...), the
#            contrast floors below, sizes from fonts.scale, metrics
#   render   every templates/*.tmpl -> builds/<id>.tmp/<name>, with
#            spec.json beside them
#   validate per-extension checks (_THEME_VALIDATORS); any failure, or a
#            gomplate error, discards the build and leaves `current` alone
#   swap     builds/<id>.tmp -> builds/<id>, then `current` is replaced by a
#            rename (ln -sfn current.tmp + mv -T), so readers see the old
#            build or the new one, never neither
#   reload   _theme-reload runs each target's reloader (_THEME_RELOADERS);
#            on failure `current` rolls back to the previous build, then to
#            known-good. known-good only advances after a successful reload.
#
# State (never tracked) in ${XDG_STATE_HOME}/theme:
#   current -> builds/<id>     known-good -> builds/<id>
#   builds/<id>/{spec.json,theme.zsh,...}   pruned to _THEME_KEEP_BUILDS,
#                                           never current or known-good
#   history        "<id>\t<name>" per activation, newest last; `undo` pops it
#   overrides.json knobs merged over prefs.toml (written by a later `set`)
#   lockscreen.cached  "<wallpaper>\t<mtime>" betterlockscreen's cache was
#                  last made from; lockscreen.lock and lockscreen.log beside it
#   xsettingsd.conf -> current/xsettingsd.conf, what xsettingsd is started
#                  on (see _theme-reload-xsettingsd)
#
# Wallpaper: every build records one (spec.wallpaper, THEME_META[wallpaper]).
# A new build keeps the current build's wallpaper, so `apply <scheme>` never
# changes it; `theme wallpaper <img>` makes a new build from the current
# spec with only the wallpaper changed, and reloads only the wallpaper and
# lock screen. With no wallpaper recorded, prefs [wallpaper] default is
# looked up in [wallpaper] dirs. `undo` and `apply <build-id>` bring back
# that build's wallpaper with its colours.
#
# Contrast guarantees (WCAG 2 ratios against bg unless noted). A colour that
# misses its floor keeps its OKLCH hue and moves in lightness, away from bg,
# just far enough (chroma shrinks at the sRGB edge):
#   fg on bg and bg_alt     7.0 (contrast = "aaa") or 4.5 ("aa"); aaa falls
#                           back to aa, recorded as degraded, only when 7.0
#                           is out of reach
#   fg_dim                  4.5
#   dim                     3.0, and below fg_dim's ratio
#   accent urgent busy ok warn info   3.0
#   on_accent / on_urgent   4.5 on accent / urgent; on_ok / on_warn the
#                           same on ok / warn (GTK's success and warning fills)
#   busy, urgent, accent    pairwise ΔE_OK >= 0.08 (the strip states)
#   bg_alt vs bg            ΔL_OK >= 0.03 (two-tone bar segments)
#
# Hue anchoring (before the floors): urgent must read red, busy orange or
# amber, ok green (_THEME_HUE_WINDOW). One outside its window is replaced by
# the mode's anchor turned a quarter of the way (at most 15°) toward the source's hue
# (x-source, else the colour it replaces), recorded in contrast.anchored.
# busy keeps to its window when it is turned to stay distinct; if it can't,
# accent turns instead.
#
# Generated sources (image:<img>, colour:#hex): matugen JSON (`--json hex
# --dry-run`, both modes in one run) cached in ${XDG_CACHE_HOME}/theme as
# sources/<sha256(image)>-<variant>-<contrast>.json (colour-<hex>-... for a
# colour), from a 512px thumbnail thumbs/<sha256>.png. The adapter turns
# the mode's Material roles into a scheme: surface -> bg,
# surface_container_high -> bg_alt, on_surface -> fg, primary -> accent,
# error -> urgent, tertiary -> info; busy, ok, warn and the terminal's six
# hues are Catppuccin anchors turned toward the source colour within
# _THEME_ANSI_SPREAD degrees, at >= _THEME_MIN_ANSI on bg. Material roles
# are kept as m3-* palette names. Knobs: --mode/--variant/--contrast, else
# prefs mode and [matugen] variant/contrast (overrides.json merged).
#
# Scheme extensions (all optional): x-accent (slot, name or hex for the
# accent when prefs accent = "scheme"), x-pair (light/dark twin), x-roles
# (role -> slot, name or hex, replacing the default slot), x-ansi (index ->
# same), x-names (named colours, emitted so `@lavender`-style references keep
# resolving). Generated sources also set x-source (the colour busy, ok and
# urgent are harmonised toward) and x-notes (lines for `theme check`).
#
# Usage:
#   source "${DOTLIB}/_theme"
#
# Environment:
#   THEME_CONFIG_DIR     prefs, schemes, templates (default
#                        ${XDG_CONFIG_HOME}/theme)
#   THEME_TEMPLATE_DIR   templates only (default ${THEME_CONFIG_DIR}/templates)
#   THEME_STATE_DIR      state (default ${XDG_STATE_HOME}/theme). Tests and
#                        previews set this, not XDG_STATE_HOME: the zsh
#                        dispatcher's .zshenv re-exports XDG_STATE_HOME in
#                        every zsh it starts, so `theme` itself would ignore it
#   THEME_WALLPAPER_DIRS colon-separated dirs that replace prefs [wallpaper]
#                        dirs (self-test)
#   THEME_CACHE_DIR      thumbnails and matugen output (default
#                        ${XDG_CACHE_HOME}/theme)
#   THEME_MATUGEN        the matugen command (default matugen on PATH)
#
# Dependencies:
#   Required:
#     - _common, _log, _colour
#   External:
#     - gomplate (YAML/TOML -> JSON, rendering), jq, GNU mv (-T)
#     - matugen 4.x (image and colour sources only), sha256sum; magick
#       (ImageMagick) for thumbnails, else matugen reads the full image
#     - feh (wallpaper), betterlockscreen (lock cache), file (image check),
#       xsettingsd and dump_xsettings, gsettings; each only where its
#       reloader runs, and skipped when missing
#     - adw-gtk-theme (adw-gtk3, adw-gtk3-dark), the GTK theme gtk.css colours

[[ -n "${THEME_LOADED:-}" ]] && return 0
declare -gr THEME_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _theme requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true
source "${DOTLIB}/_colour" || { echo "[ERROR] _theme requires _colour" >&2; return 1; }

zmodload -F zsh/datetime p:EPOCHREALTIME p:EPOCHSECONDS b:strftime
zmodload -F zsh/system b:zsystem
zmodload -F zsh/stat b:zstat

declare -gi _THEME_KEEP_BUILDS=20
declare -g _THEME_DEFAULT_SCHEME=catppuccin-mocha

typeset -ga _THEME_ROLES=(
    bg bg_alt surface border fg fg_dim dim accent focused on_accent
    urgent on_urgent busy ok on_ok warn on_warn info cursor selection
)

# Default slot per role. x-roles in a scheme replaces any of these; accent
# comes from prefs accent / x-accent instead.
typeset -gA _THEME_ROLE_SLOTS=(
    [bg]=base00 [bg_alt]=base01 [surface]=base02 [border]=base02
    [fg]=base05 [fg_dim]=base04 [dim]=base03 [accent]=base0D
    [urgent]=base08 [busy]=base09 [ok]=base0B [warn]=base0A [info]=base0C
    [cursor]=base06 [selection]=base02
)

# The tinted-theming terminal mapping; 9-14 use the base24 bright slots,
# which base16 schemes fill from the normal ones.
typeset -ga _THEME_ANSI_SLOTS=(
    base00 base08 base0B base0A base0D base0E base0C base05
    base03 base12 base14 base13 base16 base17 base15 base07
)

# base24 slots a base16 scheme lacks, and where they come from.
typeset -gA _THEME_BASE24_FILL=(
    [base10]=base00 [base11]=base00 [base12]=base08 [base13]=base0A
    [base14]=base0B [base15]=base0C [base16]=base0D [base17]=base0E
)

declare -gr _THEME_MIN_FG_DIM=4.5 _THEME_MIN_DIM=3.0 _THEME_MIN_INDICATOR=3.0
declare -gr _THEME_MIN_ON=4.5 _THEME_MIN_DELTA_E=0.08 _THEME_MIN_DELTA_L=0.03
declare -gr _THEME_FONT_FLOOR=6

# Roles of catppuccin-mocha as resolved, plus the metrics the polybar strips
# read: what `get` and `roles` answer before any theme has been applied. The
# only fallback table in the codebase; self-test fails if it drifts from the
# resolver.
typeset -gA _THEME_FALLBACK=(
    [bg]='#1e1e2e' [bg_alt]='#313244' [surface]='#313244' [border]='#313244'
    [fg]='#cdd6f4' [fg_dim]='#a6adc8' [dim]='#6c7086' [accent]='#b4befe'
    [focused]='#b4befe' [on_accent]='#11111b' [urgent]='#f38ba8'
    [on_urgent]='#11111b' [busy]='#fab387' [ok]='#a6e3a1' [on_ok]='#11111b'
    [warn]='#f9e2af' [on_warn]='#11111b'
    [info]='#94e2d5' [cursor]='#f5e0dc' [selection]='#313244'
    [cell_gap]=8
)

# extension -> validator function, run on every rendered file.
# A file name (for outputs without an extension) wins over its extension.
typeset -gA _THEME_VALIDATORS=(
    [zsh]=_theme-validate-zsh [sh]=_theme-validate-zsh
    [json]=_theme-validate-json [toml]=_theme-validate-toml
    [rasi]=_theme-validate-rasi [ini]=_theme-validate-polybar
    [conf]=_theme-validate-dunst [xresources]=_theme-validate-xresources
    [betterlockscreen.sh]=_theme-validate-betterlockscreen
    [css]=_theme-validate-gtk-css [xsettingsd.conf]=_theme-validate-xsettingsd
)

# reload target -> reloader, run after every swap. rofi reads the generated
# file per launch, so its reloader is a no-op, listed so `theme reload rofi`
# knows it. alacritty live-reloads, but see _theme-reload-alacritty.
typeset -gA _THEME_RELOADERS=(
    [rofi]=_theme-reload-rofi
    [alacritty]=_theme-reload-alacritty
    [polybar]=_theme-reload-polybar
    [bspwm]=_theme-reload-bspwm
    [dunst]=_theme-reload-dunst
    [xresources]=_theme-reload-xresources
    [wallpaper]=_theme-reload-wallpaper
    [lockscreen]=_theme-reload-lockscreen
    [xsettingsd]=_theme-reload-xsettingsd
    [gsettings]=_theme-reload-gsettings
)

# Image files `theme wallpaper` and `theme list wallpapers` consider.
declare -gr _THEME_WALLPAPER_EXT='(png|jpg|jpeg|webp|bmp|gif)'

# The live state dir. The desktop reads it by this literal path (polybar's
# include-file expands ~ but not ${env:...}; bspwmrc, .zlogin.d/10-x11 and
# the dunst drop-in link use the same path), so reloaders that touch the
# running desktop act only when _THEME_STATE is this one (_theme-live).
declare -g _THEME_POLYBAR_STATE='~/.local/state/theme'

# The dunst drop-in `theme ensure` and the dunst reloader keep linked to the
# current build. dunst reads dunstrc.d/*.conf after the dunstrc beside it.
declare -g _THEME_DUNST_DROPIN='dunst/dunstrc.d/90-theme.conf'

# GTK: each gtk.css (stowed) starts with @import url("theme.css"), and
# `theme ensure` links theme.css beside it to current/gtk.css. xsettingsd
# (.zlogin.d/20-xsettingsd) is started on the state link xsettingsd.conf,
# which points at current/xsettingsd.conf, except for the moment the
# xsettingsd reloader points it at a copy with another theme name.
typeset -ga _THEME_GTK_DIRS=(gtk-3.0 gtk-4.0)
declare -g _THEME_XSETTINGSD_LINK=xsettingsd.conf
# How long GTK apps get to see the toggled theme name before it goes back;
# both changes inside one event-loop pass would look like no change.
declare -g _THEME_XSETTINGSD_TOGGLE_WAIT=${THEME_XSETTINGSD_TOGGLE_WAIT:-0.5}

# Hue anchoring: the OKLCH hue window (degrees, lo hi, wrapping past 360)
# each state colour must sit in to read as red, orange/amber or green. A
# role outside its window, or too grey (chroma below _THEME_MIN_CHROMA) to
# read as any hue, is replaced by the anchor for the mode (Catppuccin Mocha /
# Latte) turned _THEME_HARMONISE of the way toward the source's hue, and
# kept inside the window. orange is busy for generated sources: Material's
# dark error is a pale salmon, too near Mocha's peach (ΔE_OK 0.05), so it is
# deeper and more saturated, and harmonised only within _THEME_BUSY_GEN.
typeset -gA _THEME_HUE_WINDOW=( [urgent]='330 40' [busy]='35 85' [ok]='100 170' )
typeset -gA _THEME_ANCHOR_DARK=(
    [urgent]='#f38ba8' [busy]='#fab387' [ok]='#a6e3a1'
    [red]='#f38ba8' [yellow]='#f9e2af' [green]='#a6e3a1' [cyan]='#94e2d5' [blue]='#89b4fa' [magenta]='#f5c2e7'
    [orange]='#f5a05a'
)
typeset -gA _THEME_ANCHOR_LIGHT=(
    [urgent]='#d20f39' [busy]='#fe640b' [ok]='#40a02b'
    [red]='#d20f39' [yellow]='#df8e1d' [green]='#40a02b' [cyan]='#179299' [blue]='#1e66f5' [magenta]='#ea76cb'
    [orange]='#fe640b'
)
# The turn is capped, as Material's harmonise caps it at 15°: a blue
# wallpaper should warm an orange slightly, not turn it red.
declare -gr _THEME_HARMONISE=0.25 _THEME_HARMONISE_MAX=15 _THEME_MIN_CHROMA=0.03
# A generated terminal colour stays within this many degrees of its anchor,
# so red, yellow, green, cyan, blue and magenta never meet.
declare -gr _THEME_ANSI_SPREAD=22
# Terminal colours on bg: readable as text, not just visible.
declare -gr _THEME_MIN_ANSI=4.5
declare -gr _THEME_BUSY_GEN='50 85'

# matugen's scheme types (`-t`); prefs [matugen] variant may drop "scheme-".
typeset -ga _THEME_MATUGEN_VARIANTS=(
    content expressive fidelity fruit-salad monochrome neutral rainbow tonal-spot vibrant
)

typeset -gA _THEME_DESCRIPTIONS=(
    [apply]="Resolve, render, validate and swap in <scheme|colour:#hex|image:<img>|build-id|default> [--mode m] [--variant v] [--contrast c]; keeps the current theme on any failure"
    [mode]="Show the mode, or set it: dark, light or toggle (recorded in overrides.json; a scheme follows its x-pair, a wallpaper or colour is generated again)"
    [next]="Next wallpaper with its own colours (default), or next scheme of the current mode: [wallpapers|schemes] [--keep-palette]; wraps"
    [previous]="Previous wallpaper with its own colours (default), or previous scheme: [wallpapers|schemes] [--keep-palette]; wraps"
    [random]="A random other wallpaper with its own colours (default), or scheme of the current mode: [wallpapers|schemes] [--keep-palette]"
    [current]="Show the applied theme's name, source, mode, scale and contrast; --json prints spec.json"
    [get]="Print one value: a role (accent, fg, ...), palette slot or name, size, metric or font"
    [roles]="Print <key>=<role> ... as '<key> <value>' lines, each role (or palette name, size, metric) from the current theme or the built-in fallback; in zsh, theme-roles <assoc> <key>=<role> ... fills an assoc instead"
    [list]="List [schemes|wallpapers|history|builds] (default schemes)"
    [check]="Resolve [source] (default: the current one) without applying; print roles, contrast, adjustments and hue anchoring; non-zero if a guarantee can't be met"
    [swatch]="Print the current theme, or [source], as truecolour blocks"
    [ensure]="Make sure a current theme exists: keep it, else re-activate known-good, else render the default"
    [undo]="Re-activate the previous build from history (no re-render)"
    [reload]="Run the reloaders for [target...] (default all): rofi, alacritty, polybar, bspwm, dunst, xresources, wallpaper, lockscreen, xsettingsd, gsettings"
    [wallpaper]="Set the wallpaper and generate the colours from it: <image|name|number> [--keep-palette] (recorded in the theme, kept by apply), or restore (login)"
)

theme-help() {
    cat <<'EOF'
theme - desktop theme from a scheme, wallpaper or colour: resolve, render, swap

Usage: theme <command> [args]

Sources (apply, check, swatch):
  <scheme>                          a named scheme (theme list schemes)
  image:<image|name|number>         colours generated from a picture by
                                    matugen (an image path works without
                                    the prefix)
  colour:#rrggbb                    colours generated from one colour by
                                    matugen ('#rrggbb' works too)
  Generated sources take --mode dark|light, --variant <matugen type> and
  --contrast <-1..1>, else prefs mode and [matugen] variant/contrast.

Commands:
  apply <source|build-id|default> [--mode m] [--variant v] [--contrast c]
                                    Build and activate a theme (an image
                                    source also becomes the wallpaper)
  current [--json]                  Show the applied theme
  get <key>                         One value: role, palette slot/name, size,
                                    metric or font (e.g. accent, base0D,
                                    lavender, terminal, gap, mono)
  roles <key>=<role> ...            Several values as "<key> <value>" lines;
                                    in zsh, theme-roles <assoc> ... fills an
                                    assoc (the polybar strips)
  list [schemes|wallpapers|history|builds]
                                    What can be applied (default schemes)
  check [source] [--mode m] [--variant v] [--contrast c]
                                    Resolve without applying; roles, contrast
                                    ratios, adjustments and hue anchoring;
                                    exit 1 on failure
  swatch [source]                   Truecolour preview in the terminal
  ensure                            Guarantee a current theme (fast no-op
                                    when one exists)
  undo                              Back to the previous build
  mode [dark|light|toggle]          Show or set the mode. A scheme switches
                                    to its x-pair twin; a wallpaper or colour
                                    is generated again in the new mode.
                                    Recorded in overrides.json (prefs mode)
  next|previous|random [wallpapers|schemes] [--keep-palette]
                                    Walk the wallpapers (default), each with
                                    its own colours, or the schemes of the
                                    current mode; next and previous wrap
  wallpaper <img|name|number> [--keep-palette]
                                    Set the wallpaper and record it in the
                                    theme, so apply and login keep it. A path,
                                    or a name/number from [wallpaper] dirs
                                    (0004, 4, 0004.png). The colours are
                                    generated from it, unless --keep-palette
                                    keeps the current ones
  wallpaper restore                 Set the recorded wallpaper again and
                                    refresh the lock screen's cache if it
                                    changed (.zlogin.d/90-feh)
  reload [target...]                Re-run reloaders (default all; targets:
                                    rofi, alacritty, polybar, bspwm, dunst,
                                    xresources, wallpaper, lockscreen,
                                    xsettingsd, gsettings)
  self-test                         Render every scheme into a scratch state
                                    dir under ~/.cache and validate

Files:
  ${XDG_CONFIG_HOME}/theme/prefs.toml      scale, font sizes, contrast, accent,
                                           mode, [matugen], [wallpaper]
  ${XDG_CONFIG_HOME}/theme/schemes/*.yaml  base16/base24 schemes
  ${XDG_CONFIG_HOME}/theme/templates/      gomplate templates (.tmpl)
  ${XDG_STATE_HOME}/theme/                 builds, current, known-good,
                                           history, overrides.json
  ${XDG_CACHE_HOME}/theme/                 thumbs/<sha256>.png (512px) and
                                           sources/ (matugen output), safe
                                           to delete
EOF
}

# ------------------------------
# Private Helpers: paths, ids, state
# ------------------------------

# Paths are read from the environment on every call, not at source time, so
# self-test can point XDG_STATE_HOME at a scratch dir.
_theme-paths() {
    _THEME_CONFIG=${THEME_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/theme}
    _THEME_TEMPLATES=${THEME_TEMPLATE_DIR:-$_THEME_CONFIG/templates}
    _THEME_STATE=${THEME_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/theme}
}

# REPLY = a new build id: timestamp, then milliseconds and one random hex
# digit, so ids sort in creation order (pruning relies on it).
_theme-new-id() {
    local ts sfx
    local -i ms
    strftime -s ts '%Y%m%dT%H%M%S' $EPOCHSECONDS
    ms=$(( int((EPOCHREALTIME - int(EPOCHREALTIME)) * 1000) ))
    while :; do
        printf -v sfx '%03x%x' $ms $(( RANDOM % 16 ))
        [[ -e "$_THEME_STATE/builds/$ts-$sfx" ]] || break
    done
    REPLY="$ts-$sfx"
}

# REPLY = the build id a state link (current, known-good) points at, if the
# build is complete. Returns 1 otherwise.
_theme-link-id() {
    local link="$_THEME_STATE/$1"
    [[ -L "$link" && -r "$link/spec.json" && -r "$link/theme.zsh" ]] || return 1
    REPLY=${${:-$link}:A:t}
}

_theme-build-ok() {
    [[ -n "$1" && -r "$_THEME_STATE/builds/$1/spec.json" && -r "$_THEME_STATE/builds/$1/theme.zsh" ]]
}

# Points state link $1 at build $2 by rename, so it is never missing.
_theme-link() {
    ln -sfn "builds/$2" "$_THEME_STATE/$1.tmp" && mv -Tf "$_THEME_STATE/$1.tmp" "$_THEME_STATE/$1"
}

_theme-history-push() {
    print -r -- "$1"$'\t'"$2" >> "$_THEME_STATE/history"
}

# Rewrites history without its last line; atomic so a crash can't truncate it.
_theme-history-pop() {
    local h="$_THEME_STATE/history"
    [[ -s "$h" ]] || return 1
    local -a lines=("${(@f)$(<"$h")}")
    print -rl -- "${(@)lines[1,-2]}" > "$h.tmp" && mv -f "$h.tmp" "$h"
}

_theme-history-last() {
    local h="$_THEME_STATE/history"
    [[ -s "$h" ]] || return 1
    local -a lines=("${(@f)$(<"$h")}")
    [[ -n "${lines[-1]}" ]] || return 1
    REPLY=${lines[-1]%%$'\t'*}
}

# Keeps the newest _THEME_KEEP_BUILDS builds plus whatever current and
# known-good point at; also clears builds left half-made by a crash.
_theme-prune() {
    local -a builds keep
    local b
    builds=("$_THEME_STATE"/builds/*(N/:t))
    for b in current known-good; do _theme-link-id $b && keep+=($REPLY); done
    local -a done=("${(@)builds:#*.tmp}")
    # zsh slices from a negative index before the start come back empty.
    (( ${#done} > _THEME_KEEP_BUILDS )) && done=("${(@)done[-$_THEME_KEEP_BUILDS,-1]}")
    keep+=("${done[@]}")
    for b in "${builds[@]}"; do
        (( ${keep[(Ie)$b]} )) || rm -rf -- "$_THEME_STATE/builds/$b"
    done
}

# The lock is held until the process exits (or _theme-unlock). It is an
# fcntl lock: a forked child doesn't inherit it, and blocks on it while the
# parent holds it.
declare -gi _THEME_LOCK_FD=0
_theme-lock() {
    mkdir -p "$_THEME_STATE/builds" || return 1
    : >> "$_THEME_STATE/lock"
    zsystem flock -t 10 -f _THEME_LOCK_FD "$_THEME_STATE/lock" || { log-error "[theme] another theme command holds the lock"; return 1; }
}

# Releases the lock (closing one of its fds drops the process's lock), so
# that a child of this process can take it: self-test's subshells.
_theme-unlock() {
    (( _THEME_LOCK_FD )) && zsystem flock -u $_THEME_LOCK_FD 2>/dev/null
    _THEME_LOCK_FD=0
}

_theme-ms-since() {
    REPLY=$(( int((EPOCHREALTIME - $1) * 1000) ))
}

# Formats a number for spec/templates: two decimals at most, no trailing zeros.
_theme-num() {
    printf -v REPLY '%.2f' "$1"
    while [[ "$REPLY" == *.*0 ]]; do REPLY=${REPLY%0}; done
    REPLY=${REPLY%.}
    [[ -z "$REPLY" || "$REPLY" == "-" ]] && REPLY=0
    return 0
}

# ------------------------------
# Private Helpers: load
# ------------------------------

# REPLY = the YAML file for scheme name or path $1.
_theme-scheme-file() {
    local ref=$1
    if [[ "$ref" == */* || "$ref" == *.y(a|)ml ]]; then
        [[ -r "$ref" ]] && { REPLY=${ref:A}; return 0; }
    else
        local f
        for f in "$_THEME_CONFIG/schemes/$ref".{yaml,yml}; do
            [[ -r "$f" ]] && { REPLY=$f; return 0; }
        done
    fi
    log-error "[theme] unknown scheme '$ref' (see: theme list)"
    return 1
}

# Fills the assoc _THEME_IN with every scalar of prefs (overrides merged in)
# and scheme file $1 as flat "prefs.fonts.scale"-style keys. One gomplate
# (YAML + TOML -> JSON) and one jq.
_theme-load() {
    local scheme_file=$1 prefs="$_THEME_CONFIG/prefs.toml" ov="$_THEME_STATE/overrides.json"
    local overrides='{}' line out
    [[ -r "$prefs" ]] || { log-error "[theme] missing $prefs"; return 1; }
    [[ -r "$ov" ]] && overrides=$(<"$ov")
    out=$(gomplate -c "prefs=$prefs" -c "scheme=$scheme_file" \
            -i '{{ dict "prefs" .prefs "scheme" .scheme | data.ToJSON }}' 2>&1 |
          jq -r --argjson o "$overrides" '
            .prefs *= $o
            | paths(scalars) as $p
            | [($p | map(tostring) | join(".")), (getpath($p) | tostring)] | @tsv' 2>&1) || {
        log-error "[theme] cannot read prefs/overrides/scheme: ${out//$'\n'/ }"
        return 1
    }
    typeset -gA _THEME_IN=()
    for line in "${(@f)out}"; do
        _THEME_IN[${line%%$'\t'*}]=${line#*$'\t'}
    done
}

# ------------------------------
# Private Helpers: sources (scheme, image, colour)
# ------------------------------

# Sets _THEME_SRC_KIND (scheme|image|colour) and _THEME_SRC_REF (the scheme
# name or path, the image's absolute path, or #rrggbb) for source ref $1:
#   colour:<hex>, color:<hex>, #<hex>   a colour
#   image:<image|name|number>          an image, looked up as `theme
#                                      wallpaper` does
#   a path to an image (with a / or ~) an image
#   anything else                      a scheme
_theme-source-parse() {
    local ref=$1 hex=
    typeset -g _THEME_SRC_KIND=scheme _THEME_SRC_REF=$1
    case "$ref" in
        (colour|color):*) hex=${ref#*:} ;;
        '#'*)             hex=$ref ;;
    esac
    if [[ -n "$hex" ]]; then
        hex="#${${hex#\#}:l}"
        colour-valid "$hex" || { log-error "[theme] '$ref' is not a colour: give #rrggbb"; return 1; }
        _THEME_SRC_KIND=colour _THEME_SRC_REF=$hex
        return 0
    fi
    if [[ "$ref" == image:* ]]; then
        _theme-wallpaper-find "${ref#image:}" ||
            { log-error "[theme] no image '${ref#image:}': give a path, or a name or number from: theme list wallpapers"; return 1; }
        _THEME_SRC_KIND=image _THEME_SRC_REF=$REPLY
        return 0
    fi
    if [[ ( "$ref" == */* || "$ref" == \~* ) && "$ref" != *.y(a|)ml ]] && _theme-wallpaper-find "$ref"; then
        _THEME_SRC_KIND=image _THEME_SRC_REF=$REPLY
    fi
    return 0
}

# REPLY = the source ref that rebuilds the theme in spec file $1 (scheme
# slug, image:<path>, colour:<hex>); reply = its mode, variant and contrast
# (empty for a scheme).
_theme-spec-source() {
    local -a f
    f=("${(@ps:\t:)$(jq -r '[.source.kind // "scheme", .source.ref // .name, .source.mode // "",
                              .source.variant // "", (.source.contrast // "" | tostring)] | @tsv' "$1")}") || return 1
    case "${f[1]}" in
        scheme) REPLY=${f[2]} ;;
        *)      REPLY="${f[1]}:${f[2]}" ;;
    esac
    reply=("${f[3]}" "${f[4]}" "${f[5]}")
}

_theme-cache-dir() {
    REPLY=${THEME_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/theme}
}

# Sets _THEME_SRC_MODE, _THEME_SRC_VARIANT (scheme-*) and
# _THEME_SRC_CONTRAST for a generated source: --mode/--variant/--contrast
# (_THEME_OPT_*, local to the command), else prefs mode and [matugen]
# variant/contrast with overrides.json merged, else dark, tonal-spot, 0.
_theme-matugen-knobs() {
    local mode variant contrast
    local -a p
    _theme-prefs '[(.mode // ""), (.matugen.variant // ""), (.matugen.contrast // "" | tostring)] | @tsv' &&
        p=("${(@ps:\t:)REPLY}")
    mode=${_THEME_OPT_MODE:-${p[1]:-dark}}
    variant=${_THEME_OPT_VARIANT:-${p[2]:-scheme-tonal-spot}}
    contrast=${_THEME_OPT_CONTRAST:-${p[3]:-0}}
    [[ "$mode" == (dark|light) ]] || { log-error "[theme] mode must be dark or light, not '$mode'"; return 1; }
    variant=${variant#scheme-}
    (( ${_THEME_MATUGEN_VARIANTS[(Ie)$variant]} )) ||
        { log-error "[theme] unknown matugen variant '$variant' (${(j:, :)_THEME_MATUGEN_VARIANTS})"; return 1; }
    [[ "$contrast" =~ '^-?([0-9]+(\.[0-9]*)?|\.[0-9]+)$' ]] && (( contrast >= -1 && contrast <= 1 )) ||
        { log-error "[theme] matugen contrast must be a number from -1 to 1, not '$contrast'"; return 1; }
    _theme-num $contrast
    typeset -g _THEME_SRC_MODE=$mode _THEME_SRC_VARIANT=scheme-$variant _THEME_SRC_CONTRAST=$REPLY
}

# REPLY = a 512px thumbnail of image $1 (sha256 $2) in thumbs/, made once;
# the image itself where ImageMagick is missing or fails (matugen scales
# it down anyway, just more slowly).
_theme-thumb() {
    local img=$1 sha=$2 dir
    _theme-cache-dir; dir="$REPLY/thumbs"
    REPLY="$dir/$sha.png"
    [[ -s "$REPLY" ]] && return 0
    if (( $+commands[magick] )) && mkdir -p "$dir" &&
       magick "${img}[0]" -sample '1024x1024>' -resize '512x512>' -strip "$dir/.$sha.$$.png" 2>/dev/null &&
       mv -f -- "$dir/.$sha.$$.png" "$REPLY"; then
        return 0
    fi
    rm -f -- "$dir/.$sha.$$.png"
    log-warning "[theme] couldn't make a thumbnail of ${img:t} (ImageMagick missing?); matugen reads the full image"
    REPLY=$img
}

# Runs matugen ($@ = its source arguments) and writes the trimmed result to
# $out: {source, colors: {<role>: {dark, light}}}, lowercase #rrggbb.
# Returns 1 with a message when matugen is missing or fails.
_theme-matugen-run() {
    local out=$1 dir cfg json err bin=${THEME_MATUGEN:-matugen}
    shift
    if ! whence -p -- "$bin" >/dev/null; then
        log-error "[theme] matugen isn't installed (sudo pacman -S matugen): image and colour sources need it"
        return 1
    fi
    dir=${out:h}
    mkdir -p "$dir" || return 1
    # An empty config, so the user's own ~/.config/matugen (templates, custom
    # colours, caching) never changes or slows these runs.
    cfg="${dir:h}/matugen.toml"
    [[ -s "$cfg" ]] || print -rl -- '[config]' '[templates]' > "$cfg"
    err="$dir/.err.$$"
    if ! json=$(timeout 30 "$bin" -c "$cfg" "$@" -t "$_THEME_SRC_VARIANT" --contrast "$_THEME_SRC_CONTRAST" \
                    --json hex --dry-run -q --include-image-in-json false 2>"$err" </dev/null); then
        log-error "[theme] matugen failed: ${$(<"$err")//$'\n'/ }"
        rm -f -- "$err"; return 1
    fi
    rm -f -- "$err"
    if ! print -r -- "$json" | jq -e '
            def hex: .color | .[0:7] | ascii_downcase;
            {source: (.colors.source_color.dark | hex),
             colors: (.colors | with_entries(.value |= {dark: (.dark | hex), light: (.light | hex)}))}
            | select(.colors.primary and .colors.surface and .colors.on_surface and .colors.error)' \
            > "$out.tmp.$$" 2>/dev/null; then
        rm -f -- "$out.tmp.$$"
        log-error "[theme] matugen's JSON lacks colors.primary/surface/on_surface/error (${${(f)"$("$bin" --version 2>/dev/null)"}[1]}; 4.x expected)"
        return 1
    fi
    mv -f -- "$out.tmp.$$" "$out"
}

# REPLY = the cached matugen output for the current _THEME_SRC_* source,
# made on a miss. An image is keyed by its content (sha256), so a renamed or
# re-saved copy still hits, and an image edited in place misses.
_theme-matugen-source() {
    local dir sha raw
    _theme-cache-dir; dir="$REPLY/sources"
    case "$_THEME_SRC_KIND" in
        image)
            sha=$(sha256sum -- "$_THEME_SRC_REF" 2>/dev/null) && sha=${sha%% *} && [[ -n "$sha" ]] ||
                { log-error "[theme] cannot read $_THEME_SRC_REF"; return 1; }
            raw="$dir/$sha-${_THEME_SRC_VARIANT#scheme-}-$_THEME_SRC_CONTRAST.json"
            [[ -s "$raw" ]] && { REPLY=$raw; return 0; }
            _theme-thumb "$_THEME_SRC_REF" "$sha"
            _theme-matugen-run "$raw" image "$REPLY" --source-color-index 0 || return 1
            ;;
        colour)
            raw="$dir/colour-${_THEME_SRC_REF#\#}-${_THEME_SRC_VARIANT#scheme-}-$_THEME_SRC_CONTRAST.json"
            [[ -s "$raw" ]] && { REPLY=$raw; return 0; }
            _theme-matugen-run "$raw" color hex "$_THEME_SRC_REF" || return 1
            ;;
    esac
    REPLY=$raw
}

# The generated source's scheme: matugen output $1 in _THEME_SRC_MODE,
# adapted into the base24 + x-* shape a scheme YAML has (see the header),
# written beside it as <raw>.<mode>.scheme.json; REPLY = its path. Made on
# every load: it's cheap, and an adapter change takes effect at once.
_theme-adapt() {
    local raw=$1 mode=$_THEME_SRC_MODE line k v src out name title hue n
    local -A m=() anchors=() slot=() hues
    local -a lines
    lines=("${(@f)$(jq -r --arg m "$mode" '"source\t\(.source)", (.colors | to_entries[] | "\(.key)\t\(.value[$m])")' "$raw")}") ||
        { log-error "[theme] cannot read $raw"; return 1; }
    for line in "${lines[@]}"; do m[${line%%$'\t'*}]=${line#*$'\t'}; done
    for k in surface surface_container_low surface_container_lowest surface_container_high surface_container_highest \
             on_surface on_surface_variant outline outline_variant primary error tertiary secondary_container; do
        colour-valid "${m[$k]:-}" || { log-error "[theme] matugen output lacks $k"; return 1; }
    done
    src=${m[source]}
    colour-valid "$src" || src=${m[primary]}
    if [[ "$mode" == light ]]; then anchors=("${(@kv)_THEME_ANCHOR_LIGHT}")
    else anchors=("${(@kv)_THEME_ANCHOR_DARK}"); fi

    # The six terminal hues and their bright twins, each kept near its
    # anchor and readable on bg; bright is a step further from bg.
    hues=(red 08 yellow 0A green 0B cyan 0C blue 0D magenta 0E)
    typeset -A bright=(red 12 yellow 13 green 14 cyan 15 blue 16 magenta 17)
    for hue n in "${(@kv)hues}"; do
        colour-to-oklch "${anchors[$hue]}"
        _theme-harmonise "${anchors[$hue]}" "$src" $(( reply[3] - _THEME_ANSI_SPREAD )) $(( reply[3] + _THEME_ANSI_SPREAD ))
        colour-ensure-contrast "$REPLY" "${m[surface]}" $_THEME_MIN_ANSI
        slot[base$n]=$REPLY
        if [[ "$mode" == light ]]; then colour-darken "$REPLY" 0.06; else colour-lighten "$REPLY" 0.06; fi
        colour-ensure-contrast "$REPLY" "${m[surface]}" $_THEME_MIN_ANSI
        slot[base${bright[$hue]}]=$REPLY
    done
    # busy: orange, kept off error's salmon.
    _theme-harmonise "${anchors[orange]}" "$src" ${=_THEME_BUSY_GEN}
    colour-ensure-contrast "$REPLY" "${m[surface]}" $_THEME_MIN_ANSI
    slot[base09]=$REPLY

    slot+=(
        [base00]=${m[surface]} [base01]=${m[surface_container_high]} [base02]=${m[surface_container_highest]}
        [base03]=${m[outline_variant]} [base04]=${m[on_surface_variant]} [base05]=${m[on_surface]}
        [base06]=${m[on_primary_container]:-${m[on_surface]}} [base07]=${m[primary_fixed_dim]:-${m[primary]}}
        [base0F]=${m[tertiary]} [base10]=${m[surface_container_low]} [base11]=${m[surface_container_lowest]}
    )

    # A red picture's primary is error's salmon; the resolver would turn it
    # by an arbitrary angle. Material's tertiary is the palette's own
    # second accent, so it goes first (and is turned less, if at all).
    local accent=${m[primary]} note=
    colour-delta-e "${m[primary]}" "${m[error]}"; local -F dp=$REPLY
    colour-delta-e "${m[tertiary]}" "${m[error]}"
    if (( dp < _THEME_MIN_DELTA_E && REPLY > dp )); then
        accent=${m[tertiary]}
        printf -v note 'accent: primary %s is too close to error %s (ΔE %.3f); using tertiary %s' \
            "${m[primary]}" "${m[error]}" $dp "${m[tertiary]}"
    fi

    case "$_THEME_SRC_KIND" in
        image)  name="image:${_THEME_SRC_REF:t:r}" title=${_THEME_SRC_REF:t} ;;
        colour) name="colour:$_THEME_SRC_REF" title=$_THEME_SRC_REF ;;
    esac
    title+=", ${${_THEME_SRC_VARIANT#scheme-}//-/ }, $mode${${_THEME_SRC_CONTRAST:#0}:+, contrast $_THEME_SRC_CONTRAST}"
    out="${raw%.json}.$mode.scheme.json"
    {
        print -r -- "system"$'\t'"base24"
        print -r -- "name"$'\t'"$title"
        print -r -- "slug"$'\t'"$name"
        print -r -- "variant"$'\t'"$mode"
        for k v in "${(@kv)slot}"; do print -r -- "palette.$k"$'\t'"$v"; done
        print -r -- "x-accent"$'\t'"$accent"
        [[ -n "$note" ]] && print -r -- "x-notes.0"$'\t'"$note"
        print -r -- "x-source"$'\t'"$src"
        for k v in bg_alt surface_container_high surface surface_container_highest border outline_variant \
                   fg on_surface fg_dim on_surface_variant dim outline urgent error info tertiary \
                   cursor primary selection secondary_container; do
            print -r -- "x-roles.$k"$'\t'"${m[$v]}"
        done
        # Terminal black/white as Catppuccin's: a visible black, two greys.
        print -r -- "x-ansi.0"$'\t'"${m[outline_variant]}"
        print -r -- "x-ansi.7"$'\t'"${m[on_surface_variant]}"
        print -r -- "x-ansi.8"$'\t'"${m[outline]}"
        print -r -- "x-ansi.15"$'\t'"${m[on_surface]}"
        for k v in "${(@kv)m}"; do
            [[ "$k" == source ]] && continue
            print -r -- "x-names.m3-${k//_/-}"$'\t'"$v"
        done
    } | jq -Rn 'reduce (inputs | split("\t")) as [$p, $v] ({}; setpath($p | split("."); $v))' > "$out.tmp.$$" &&
        mv -f -- "$out.tmp.$$" "$out" || { rm -f -- "$out.tmp.$$"; log-error "[theme] cannot write $out"; return 1; }
    REPLY=$out
}

# Loads source ref $1 into _THEME_IN (prefs merged), setting _THEME_SRC_*;
# REPLY = the theme's name (scheme slug, image:<name>, colour:<hex>).
_theme-load-source() {
    local file
    typeset -g _THEME_SRC_MODE= _THEME_SRC_VARIANT= _THEME_SRC_CONTRAST=
    _theme-source-parse "$1" || return 1
    if [[ "$_THEME_SRC_KIND" == scheme ]]; then
        _theme-scheme-file "$1" || return 1
        file=$REPLY
        _theme-load "$file" || return 1
        REPLY=${_THEME_IN[scheme.slug]:-${file:t:r}}
        _THEME_SRC_REF=$REPLY
        return 0
    fi
    _theme-matugen-knobs || return 1
    _theme-matugen-source || return 1
    _theme-adapt "$REPLY" || return 1
    _theme-load "$REPLY" || return 1
    REPLY=${_THEME_IN[scheme.slug]}
}

# ------------------------------
# Private Helpers: resolve
# ------------------------------

# REPLY = hex for a colour reference: #rrggbb, a slot (base0d/base0D) or an
# x-names name. Needs _THEME_PAL filled.
_theme-ref() {
    local ref=${1:l}
    if colour-valid "$ref"; then REPLY=$ref; return 0; fi
    if [[ "$ref" =~ '^base[0-9a-f]{2}$' ]]; then
        REPLY=${_THEME_PAL[base${(U)ref[5,6]}]:-}
    else
        REPLY=${_THEME_PAL[$ref]:-}
    fi
    [[ -n "$REPLY" ]] && return 0
    log-error "[theme] unknown colour reference '$1'"
    return 1
}

# Fills _THEME_PAL: base00..base17 (base24 gaps filled) and x-names, lowercase.
_theme-palette() {
    typeset -gA _THEME_PAL=()
    local k v
    for k v in "${(@kv)_THEME_IN}"; do
        case "$k" in
            scheme.palette.base[0-9A-Fa-f][0-9A-Fa-f]) _THEME_PAL[base${(U)k[-2,-1]}]=${v:l} ;;
            scheme.x-names.*)                          _THEME_PAL[${k#scheme.x-names.}]=${v:l} ;;
        esac
    done
    for k in base0{0..9} base0{A..F}; do
        colour-valid "${_THEME_PAL[$k]:-}" || { log-error "[theme] scheme lacks a valid $k"; return 1; }
    done
    for k v in "${(@kv)_THEME_BASE24_FILL}"; do
        colour-valid "${_THEME_PAL[$k]:-}" || _THEME_PAL[$k]=${_THEME_PAL[$v]}
    done
}

# Records why role $1 changed.
_theme-adjusted() {
    (( ${_THEME_ADJUSTED[(Ie)$1]} )) || _THEME_ADJUSTED+=($1)
    _THEME_NOTES+=("$1: $2")
}

# Lifts role $1 to ratio $2 against bg; returns 1 if unreachable.
_theme-floor() {
    local role=$1 before=${_THEME_ROLE[$1]}
    colour-ensure-contrast "$before" "${_THEME_ROLE[bg]}" "$2" || return 1
    if [[ "$REPLY" != "$before" ]]; then
        _THEME_ROLE[$role]=$REPLY
        _theme-adjusted $role "$before -> $REPLY (contrast >= $2)"
    fi
}

# True when role $1 is at least _THEME_MIN_DELTA_E from every role named after it.
_theme-distinct() {
    local a=$1 b
    shift
    for b; do
        colour-delta-e "${_THEME_ROLE[$a]}" "${_THEME_ROLE[$b]}"
        (( REPLY >= _THEME_MIN_DELTA_E )) || return 1
    done
}

# Turns role $1's hue in growing steps, alternating direction, until it is
# distinct from the roles after it and still meets the indicator floor. A
# role with a hue window (busy, ...) only takes hues inside it. Returns 1,
# with the role as it was, when no step works; the caller notes it.
_theme-separate() {
    local role=$1 orig=${_THEME_ROLE[$1]} step sign cand
    local -a win=(${=_THEME_HUE_WINDOW[$1]:-})
    shift
    _theme-distinct $role "$@" && return 0
    for step in 15 30 45 60 90 120 150 180; do
        for sign in 1 -1; do
            colour-rotate "$orig" $(( sign * step ))
            colour-ensure-contrast "$REPLY" "${_THEME_ROLE[bg]}" $_THEME_MIN_INDICATOR || continue
            cand=$REPLY
            if (( ${#win} )); then
                colour-to-oklch "$cand"
                _theme-hue-in ${reply[3]} $win || continue
            fi
            _THEME_ROLE[$role]=$cand
            if _theme-distinct $role "$@"; then
                _theme-adjusted $role "$orig -> $cand (hue turned $(( sign * step ))° to stay distinct from ${(j:, :)@})"
                return 0
            fi
        done
    done
    _THEME_ROLE[$role]=$orig
    return 1
}

# True when hue $1 (degrees) is inside window $2..$3, which may wrap past
# 360 (330 40) or reach outside 0..360 (-19 25).
_theme-hue-in() {
    local -F h=$1 lo=$2 hi=$3
    (( lo < 0 )) && (( lo += 360 )); (( lo >= 360 )) && (( lo -= 360 ))
    (( hi < 0 )) && (( hi += 360 )); (( hi > 360 )) && (( hi -= 360 ))
    if (( lo <= hi )); then (( h >= lo && h <= hi ))
    else (( h >= lo || h <= hi )); fi
}

# REPLY = the signed shortest turn (degrees, -180..180) from hue $1 to $2.
_theme-hue-diff() {
    local -F d=$(( $2 - $1 ))
    while (( d > 180 )); do (( d -= 360 )); done
    while (( d <= -180 )); do (( d += 360 )); done
    REPLY=$d
}

# REPLY = hue $1 moved to the nearer edge of window $2..$3 if outside it.
_theme-hue-clamp() {
    local -F h=$1 lo=$2 hi=$3 dlo dhi
    _theme-hue-in $h $lo $hi && { REPLY=$h; return 0; }
    _theme-hue-diff $h $lo; dlo=${REPLY#-}
    _theme-hue-diff $h $hi; dhi=${REPLY#-}
    (( dlo <= dhi )) && h=$lo || h=$hi
    (( h < 0 )) && (( h += 360 )); (( h >= 360 )) && (( h -= 360 ))
    REPLY=$h
}

# _theme-harmonise <anchor> <toward> [lo hi]: REPLY = <anchor> with its
# OKLCH hue turned _THEME_HARMONISE of the way toward <toward>'s, at most
# _THEME_HARMONISE_MAX degrees (matugen's "harmonise": the colour keeps its
# meaning but sits with the palette), then kept inside window lo..hi.
# Lightness and chroma are the anchor's.
# A grey <toward> has no hue to lean to, so the anchor stays as it is.
_theme-harmonise() {
    local anchor=$1 toward=$2 lo=${3:-} hi=${4:-}
    local -F L C h
    colour-to-oklch "$anchor"; L=${reply[1]} C=${reply[2]} h=${reply[3]}
    colour-to-oklch "$toward"
    if (( reply[2] >= 0.02 )); then
        _theme-hue-diff $h ${reply[3]}
        local -F turn=$(( REPLY * _THEME_HARMONISE ))
        (( turn > _THEME_HARMONISE_MAX )) && turn=$_THEME_HARMONISE_MAX
        (( turn < -_THEME_HARMONISE_MAX )) && turn=-$_THEME_HARMONISE_MAX
        (( h += turn ))
        (( h < 0 )) && (( h += 360 ))
        (( h >= 360 )) && (( h -= 360 ))
    fi
    if [[ -n "$lo" ]]; then _theme-hue-clamp $h $lo $hi; h=$REPLY; fi
    colour-from-oklch $L $C $h
}

# Hue anchoring for urgent, busy and ok (see the header). Needs _THEME_MODE.
_theme-anchor-hues() {
    local role c toward
    local -a win
    local -F C h
    local -A anchors
    if [[ "$_THEME_MODE" == light ]]; then anchors=("${(@kv)_THEME_ANCHOR_LIGHT}")
    else anchors=("${(@kv)_THEME_ANCHOR_DARK}"); fi
    for role in urgent busy ok; do
        c=${_THEME_ROLE[$role]}
        win=(${=_THEME_HUE_WINDOW[$role]})
        colour-to-oklch "$c"; C=${reply[2]} h=${reply[3]}
        (( C >= _THEME_MIN_CHROMA )) && _theme-hue-in $h $win && continue
        toward=${_THEME_IN[scheme.x-source]:-$c}
        _theme-harmonise "${anchors[$role]}" "$toward" $win
        _THEME_ROLE[$role]=$REPLY
        _THEME_ANCHORED+=($role)
        if (( C < _THEME_MIN_CHROMA )); then
            _THEME_NOTES+=("$role: $c is too grey to read as a hue; anchored to $REPLY")
        else
            _THEME_NOTES+=("$role: $c (hue $(( int(rint(h)) ))°) is outside ${win[1]}-${win[2]}°; anchored to $REPLY")
        fi
    done
}

# Resolves _THEME_IN into _THEME_ROLE, _THEME_ANSI, _THEME_CONTRAST (pair ->
# ratio or distance), _THEME_LEVEL (aaa|aa), _THEME_DEGRADED, _THEME_ADJUSTED,
# _THEME_NOTES, _THEME_ANCHORED, _THEME_SIZE, _THEME_METRIC, _THEME_MODE.
# Returns 1 if a guarantee can't be met.
_theme-resolve() {
    typeset -gA _THEME_ROLE=() _THEME_CONTRAST=() _THEME_SIZE=() _THEME_METRIC=()
    typeset -ga _THEME_ANSI=() _THEME_ADJUSTED=() _THEME_NOTES=() _THEME_ANCHORED=()
    typeset -g _THEME_LEVEL _THEME_MODE
    typeset -gi _THEME_DEGRADED=0
    local role k v accent orig body fail=0

    _theme-palette || return 1

    for role k in "${(@kv)_THEME_ROLE_SLOTS}"; do
        _THEME_ROLE[$role]=${_THEME_PAL[$k]}
    done
    for k v in "${(@kv)_THEME_IN}"; do
        [[ "$k" == scheme.x-roles.* ]] || continue
        role=${k#scheme.x-roles.}
        (( ${_THEME_ROLES[(Ie)$role]} )) && [[ "$role" != (accent|focused|on_*) ]] || {
            log-warning "[theme] x-roles: ignoring '$role'"; continue
        }
        _theme-ref "$v" || return 1
        _THEME_ROLE[$role]=$REPLY
    done

    for k in ${(on)${(k)_THEME_IN[(I)scheme.x-notes.*]}}; do _THEME_NOTES+=("${_THEME_IN[$k]}"); done

    accent=${_THEME_IN[prefs.accent]:-scheme}
    [[ "$accent" == scheme ]] && accent=${_THEME_IN[scheme.x-accent]:-base0D}
    _theme-ref "$accent" || return 1
    _THEME_ROLE[accent]=$REPLY

    _THEME_MODE=${_THEME_IN[scheme.variant]:-}
    if [[ "$_THEME_MODE" != (dark|light) ]]; then
        local -F lbg lfg
        colour-luminance "${_THEME_ROLE[bg]}"; lbg=$REPLY
        colour-luminance "${_THEME_ROLE[fg]}"; lfg=$REPLY
        (( lbg < lfg )) && _THEME_MODE=dark || _THEME_MODE=light
    fi

    _theme-anchor-hues

    # bg_alt: base01, else base02, else nudged away from bg toward fg.
    colour-delta-l "${_THEME_ROLE[bg_alt]}" "${_THEME_ROLE[bg]}"
    if (( REPLY < _THEME_MIN_DELTA_L )) && [[ -z "${_THEME_IN[scheme.x-roles.bg_alt]:-}" ]]; then
        _THEME_NOTES+=("bg_alt: base01 too close to bg, using base02")
        _THEME_ROLE[bg_alt]=${_THEME_PAL[base02]}
        colour-delta-l "${_THEME_ROLE[bg_alt]}" "${_THEME_ROLE[bg]}"
    fi
    if (( REPLY < _THEME_MIN_DELTA_L )); then
        orig=${_THEME_ROLE[bg_alt]}
        if [[ "$_THEME_MODE" == dark ]]; then colour-lighten "${_THEME_ROLE[bg]}" 0.04
        else colour-darken "${_THEME_ROLE[bg]}" 0.04; fi
        _THEME_ROLE[bg_alt]=$REPLY
        _theme-adjusted bg_alt "$orig -> $REPLY (ΔL >= $_THEME_MIN_DELTA_L from bg)"
    fi

    # fg on bg and bg_alt: AAA, or AA when AAA can't be reached.
    _THEME_LEVEL=${_THEME_IN[prefs.contrast]:-aaa}
    [[ "$_THEME_LEVEL" == (aa|aaa) ]] || { log-error "[theme] contrast must be aa or aaa"; return 1; }
    orig=${_THEME_ROLE[fg]}
    while :; do
        [[ "$_THEME_LEVEL" == aaa ]] && body=7.0 || body=4.5
        _THEME_ROLE[fg]=$orig
        if colour-ensure-contrast "$orig" "${_THEME_ROLE[bg]}" $body &&
           colour-ensure-contrast "$REPLY" "${_THEME_ROLE[bg_alt]}" $body; then
            v=$REPLY
            colour-contrast "$v" "${_THEME_ROLE[bg]}"
            (( REPLY >= body )) && break
        fi
        if [[ "$_THEME_LEVEL" == aaa ]]; then
            _THEME_LEVEL=aa
            _THEME_DEGRADED=1
            _THEME_NOTES+=("fg: 7.0 (AAA) unreachable on bg/bg_alt; degraded to AA 4.5")
            continue
        fi
        _THEME_NOTES+=("fg: even 4.5 (AA) is unreachable on bg/bg_alt")
        return 1
    done
    if [[ "$v" != "$orig" ]]; then
        _THEME_ROLE[fg]=$v
        _theme-adjusted fg "$orig -> $v (contrast >= $body)"
    fi

    _theme-floor fg_dim $_THEME_MIN_FG_DIM || fail=1

    # dim: visible (3.0) but quieter than fg_dim.
    _theme-floor dim $_THEME_MIN_DIM || fail=1
    local -F rdim rdimfg
    colour-contrast "${_THEME_ROLE[dim]}" "${_THEME_ROLE[bg]}"; rdim=$REPLY
    colour-contrast "${_THEME_ROLE[fg_dim]}" "${_THEME_ROLE[bg]}"; rdimfg=$REPLY
    if (( rdim >= rdimfg )); then
        orig=${_THEME_ROLE[dim]}
        colour-fit-contrast "$orig" "${_THEME_ROLE[bg]}" $_THEME_MIN_DIM
        _THEME_ROLE[dim]=$REPLY
        _theme-adjusted dim "$orig -> $REPLY (dimmer than fg_dim)"
    fi

    for role in accent urgent busy ok warn info; do
        _theme-floor $role $_THEME_MIN_INDICATOR || fail=1
    done

    # The three strip states: urgent keeps its colour, accent moves before
    # busy. busy stays in its hue window; when that leaves no room (an
    # orange accent from an orange wallpaper), accent moves instead.
    if ! _theme-separate accent urgent; then
        _THEME_NOTES+=("accent: cannot be made distinct from urgent"); fail=1
    fi
    if ! _theme-separate busy urgent accent && ! _theme-separate accent urgent busy; then
        _THEME_NOTES+=("busy: cannot be made distinct from urgent, accent"); fail=1
    fi

    _THEME_ROLE[focused]=${_THEME_ROLE[accent]}
    for role in accent urgent ok warn; do
        colour-best-on "${_THEME_ROLE[$role]}" $_THEME_MIN_ON \
            "${_THEME_PAL[base11]}" "${_THEME_ROLE[bg]}" "${_THEME_ROLE[fg]}" || fail=1
        _THEME_ROLE[on_$role]=$REPLY
    done

    # ANSI 0-15: tinted mapping, then x-ansi.
    for k in {1..16}; do _THEME_ANSI[k]=${_THEME_PAL[${_THEME_ANSI_SLOTS[k]}]}; done
    for k v in "${(@kv)_THEME_IN}"; do
        [[ "$k" =~ '^scheme\.x-ansi\.([0-9]+)$' ]] || continue
        (( match[1] <= 15 )) || continue
        _theme-ref "$v" || return 1
        _THEME_ANSI[$(( match[1] + 1 ))]=$REPLY
    done

    _theme-contrast-table
    _theme-sizes || return 1

    for role in "${_THEME_ROLES[@]}"; do
        colour-valid "${_THEME_ROLE[$role]:-}" || { log-error "[theme] role $role unresolved"; return 1; }
    done
    for k in {1..16}; do
        colour-valid "${_THEME_ANSI[k]:-}" || { log-error "[theme] ansi $(( k - 1 )) unresolved"; return 1; }
    done
    return $fail
}

_theme-contrast-table() {
    local pair a b
    local -A on=(on_accent accent on_urgent urgent)
    for pair in fg/bg fg/bg_alt fg_dim/bg dim/bg accent/bg urgent/bg busy/bg ok/bg warn/bg info/bg \
                on_accent/accent on_urgent/urgent on_ok/ok on_warn/warn; do
        a=${pair%/*}; b=${pair#*/}
        colour-contrast "${_THEME_ROLE[$a]}" "${_THEME_ROLE[$b]}"
        colour-round $REPLY; _THEME_CONTRAST[$pair]=$REPLY
    done
    for pair in busy~urgent busy~accent accent~urgent; do
        colour-delta-e "${_THEME_ROLE[${pair%~*}]}" "${_THEME_ROLE[${pair#*~}]}"
        colour-round $REPLY 3; _THEME_CONTRAST[$pair]=$REPLY
    done
    colour-delta-l "${_THEME_ROLE[bg_alt]}" "${_THEME_ROLE[bg]}"
    colour-round $REPLY 3; _THEME_CONTRAST[bg_alt~bg]=$REPLY
}

# Point sizes from fonts.base x fonts.scale, a type scale (ratio 1.2) on the
# menu size, and pixel metrics. gap and cell_gap are unscaled (decision D5),
# and so is bar_height: the bar keeps its height and its text grows inside it.
# bar_reserve (bspwm's bottom_padding) is unscaled too: it is deliberately
# less than bar_height (D15), so it must not drift from it with the scale.
_theme-sizes() {
    local k v
    local -F scale=${_THEME_IN[prefs.fonts.scale]:-1} n menu
    (( scale > 0 )) || { log-error "[theme] fonts.scale must be > 0"; return 1; }
    _THEME_SIZE[scale]=${_THEME_IN[prefs.fonts.scale]:-1}
    for k v in "${(@kv)_THEME_IN}"; do
        [[ "$k" == prefs.fonts.base.* ]] || continue
        n=$(( v * scale ))
        (( n < _THEME_FONT_FLOOR )) && n=$_THEME_FONT_FLOOR
        _theme-num $n; _THEME_SIZE[${k#prefs.fonts.base.}]=$REPLY
    done
    menu=$(( ${_THEME_IN[prefs.fonts.base.menu]:-11} * scale ))
    _theme-num $(( menu / 1.2 ));   _THEME_SIZE[sm]=$REPLY
    _theme-num $menu;               _THEME_SIZE[md]=$REPLY
    _theme-num $(( menu * 1.2 ));   _THEME_SIZE[lg]=$REPLY
    _theme-num $(( menu * 1.728 )); _THEME_SIZE[xl]=$REPLY

    for k v in "${(@kv)_THEME_IN}"; do
        [[ "$k" == prefs.metrics.* ]] || continue
        k=${k#prefs.metrics.}
        if [[ "$k" == (gap|cell_gap|bar_height|bar_reserve) ]]; then _THEME_METRIC[$k]=$(( int(rint(v)) ))
        else _THEME_METRIC[$k]=$(( int(rint(v * scale)) )); fi
    done
    _THEME_METRIC[cursor]=$(( int(rint(${_THEME_IN[prefs.cursor.size]:-24} * scale)) ))
}

# ------------------------------
# Private Helpers: spec, render, validate
# ------------------------------

# Prints spec.json for build id $1 named $2 (the scheme slug, image:<name>
# or colour:<hex>), with wallpaper $3 (a path, or empty). The source comes
# from _THEME_SRC_* (_theme-load-source).
_theme-spec() {
    local id=$1 ref=$2 wall=${3:-} k v
    local mode=$_THEME_MODE
    {
        print -r -- "id"$'\t'"s"$'\t'"$id"
        print -r -- "name"$'\t'"s"$'\t'"$ref"
        print -r -- "title"$'\t'"s"$'\t'"${_THEME_IN[scheme.name]:-$ref}"
        print -r -- "source.kind"$'\t'"s"$'\t'"${_THEME_SRC_KIND:-scheme}"
        print -r -- "source.ref"$'\t'"s"$'\t'"${_THEME_SRC_REF:-$ref}"
        if [[ "${_THEME_SRC_KIND:-scheme}" != scheme ]]; then
            print -r -- "source.mode"$'\t'"s"$'\t'"$_THEME_SRC_MODE"
            print -r -- "source.variant"$'\t'"s"$'\t'"$_THEME_SRC_VARIANT"
            print -r -- "source.contrast"$'\t'"n"$'\t'"$_THEME_SRC_CONTRAST"
            print -r -- "source.colour"$'\t'"s"$'\t'"${_THEME_IN[scheme.x-source]:-}"
        fi
        print -r -- "mode"$'\t'"s"$'\t'"$mode"
        print -r -- "pair"$'\t'"s"$'\t'"${_THEME_IN[scheme.x-pair]:-}"
        for k v in "${(@kv)_THEME_PAL}"; do
            if [[ "$k" == base[0-9A-F][0-9A-F] ]]; then print -r -- "palette.$k"$'\t'"s"$'\t'"$v"
            else print -r -- "palette.names.$k"$'\t'"s"$'\t'"$v"; fi
        done
        for k v in "${(@kv)_THEME_ROLE}"; do print -r -- "roles.$k"$'\t'"s"$'\t'"$v"; done
        for k in {1..16}; do print -r -- "ansi.$(( k - 1 ))"$'\t'"s"$'\t'"${_THEME_ANSI[k]}"; done
        for k v in "${(@kv)_THEME_CONTRAST}"; do print -r -- "contrast.ratios.$k"$'\t'"n"$'\t'"$v"; done
        print -r -- "contrast.level"$'\t'"s"$'\t'"$_THEME_LEVEL"
        print -r -- "contrast.requested"$'\t'"s"$'\t'"${_THEME_IN[prefs.contrast]:-aaa}"
        print -r -- "contrast.degraded"$'\t'"b"$'\t'"$(( _THEME_DEGRADED ))"
        print -r -- "contrast.adjusted"$'\t'"a"$'\t'"${(j: :)_THEME_ADJUSTED}"
        print -r -- "contrast.anchored"$'\t'"a"$'\t'"${(j: :)_THEME_ANCHORED}"
        print -r -- "contrast.notes"$'\t'"l"$'\t'"${(pj:\x1f:)_THEME_NOTES}"
        for k v in "${(@kv)_THEME_SIZE}"; do print -r -- "font.sizes.$k"$'\t'"n"$'\t'"$v"; done
        for k in ui mono icon; do
            print -r -- "font.family.$k"$'\t'"s"$'\t'"${_THEME_IN[prefs.fonts.family.$k]:-}"
        done
        for k v in "${(@kv)_THEME_METRIC}"; do print -r -- "metrics.$k"$'\t'"n"$'\t'"$v"; done
        print -r -- "icons"$'\t'"s"$'\t'"${_THEME_IN[prefs.icons.$mode]:-}"
        print -r -- "gtk"$'\t'"s"$'\t'"${_THEME_IN[prefs.gtk.$mode]:-}"
        print -r -- "cursor.theme"$'\t'"s"$'\t'"${_THEME_IN[prefs.cursor.theme]:-}"
        print -r -- "cursor.size"$'\t'"n"$'\t'"${_THEME_METRIC[cursor]}"
        print -r -- "wallpaper"$'\t'"s"$'\t'"$wall"
    } | jq -Rn '
        reduce (inputs | split("\t")) as [$p, $t, $v] ({};
            setpath($p | split(".") | map(tonumber? // .);
                if   $t == "n" then ($v | tonumber)
                elif $t == "b" then ($v == "1")
                elif $t == "a" then ($v | split(" ") | map(select(. != "")))
                elif $t == "l" then ($v | split("\u001f") | map(select(. != "")))
                else $v end))'
}

_theme-validate-zsh()  { zsh -n "$1"; }
_theme-validate-json() { jq empty "$1"; }
# The template must reference the datasource, or gomplate never parses it;
# and an empty -i makes gomplate read its template from stdin.
_theme-validate-toml() { gomplate -c "x=$1" -i '{{ $x := .x }}' </dev/null >/dev/null; }

# rofi parses a theme without a display; skipped where rofi isn't installed.
# On a parse error -dump-theme warns and dumps its default theme with status
# 0 (and -rasi-validate crashes), so any stderr is the failure.
_theme-validate-rasi() {
    (( $+commands[rofi] )) || return 0
    local err
    err=$(DISPLAY= WAYLAND_DISPLAY= rofi -no-config -theme "$1" -dump-theme 2>&1 </dev/null >/dev/null)
    [[ -z "$err" ]] || { print -r -- "$err"; return 1; }
}

# polybar.ini: a [colors] and [theme] fragment for config.ini's include-file.
# Every line is a section, a comment or key = value; no key repeats in its
# section (polybar refuses duplicates); colours are #rrggbb or #aarrggbb; and
# nothing is a ${...} reference (the fragment is all literals, so a reference
# would be a template bug). With an X display, polybar parses it too.
_theme-validate-polybar() {
    setopt localoptions extendedglob
    local f=$1 line sec= key val wrap
    local -A seen=()
    local -i n=0
    for line in "${(@f)$(<"$f")}"; do
        (( n++ ))
        line=${line##[[:space:]]#}
        [[ -z "$line" || "$line" == [\;\#]* ]] && continue
        if [[ "$line" =~ '^\[([^]]+)\]$' ]]; then sec=${match[1]}; continue; fi
        [[ "$line" == *=* && -n "$sec" ]] || { print -r -- "line $n: not a section or key = value: $line"; return 1; }
        key=${${line%%=*}%%[[:space:]]#}
        val=${${line#*=}##[[:space:]]#}
        (( ${+seen[$sec/$key]} )) && { print -r -- "line $n: duplicate key $key in [$sec]"; return 1; }
        seen[$sec/$key]=1
        [[ "$val" == *'${'* ]] && { print -r -- "line $n: unresolved reference: $line"; return 1; }
        [[ "$sec" == colors && ! "$val" =~ '^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$' ]] &&
            { print -r -- "line $n: $key is not a colour: $val"; return 1; }
    done
    (( ${+seen[colors/bg]} && ${+seen[theme/height]} )) || { print -r -- "no [colors] bg or [theme] height"; return 1; }
    [[ -n "${DISPLAY:-}" ]] && (( $+commands[polybar] )) || return 0
    wrap="${f:h}/.polybar-validate.ini"
    print -rl -- "include-file = ${f:A}" "[bar/theme-validate]" 'background = ${colors.bg}' > "$wrap"
    local err
    err=$(polybar -q --config="$wrap" --dump=background theme-validate 2>&1 >/dev/null </dev/null)
    local rc=$?
    rm -f -- "$wrap"
    # No X server behind DISPLAY: the structural checks above stand.
    [[ "$err" == *'X connection error'* ]] && return 0
    (( rc == 0 )) || { print -r -- "polybar: ${err##*: }"; return 1; }
}

# dunst.conf: a drop-in over dunstrc. Every line is a section, a comment or
# key = value; no key repeats in its section; colour keys are quoted
# "#rrggbb" (dunst warns and keeps its default on anything else, so a bad
# value would pass unnoticed); a [global] font is set. dunst itself is never
# run: it would claim the notification bus from the live one.
_theme-validate-dunst() {
    setopt localoptions extendedglob
    local f=$1 line sec= key val
    local -A seen=()
    local -i n=0
    for line in "${(@f)$(<"$f")}"; do
        (( n++ ))
        line=${line##[[:space:]]#}
        [[ -z "$line" || "$line" == [\;\#]* ]] && continue
        if [[ "$line" =~ '^\[([a-z_]+)\]$' ]]; then sec=${match[1]}; continue; fi
        [[ "$line" == *=* && -n "$sec" ]] || { print -r -- "line $n: not a section or key = value: $line"; return 1; }
        key=${${line%%=*}%%[[:space:]]#}
        val=${${line#*=}##[[:space:]]#}
        [[ "$key" =~ '^[a-z_]+$' && -n "$val" ]] || { print -r -- "line $n: bad key or empty value: $line"; return 1; }
        (( ${+seen[$sec/$key]} )) && { print -r -- "line $n: duplicate key $key in [$sec]"; return 1; }
        seen[$sec/$key]=1
        [[ "$key" == (*_color|background|foreground|highlight) && ! "$val" =~ '^"#[0-9a-fA-F]{6}"$' ]] &&
            { print -r -- "line $n: $key is not a quoted colour: $val"; return 1; }
    done
    (( ${+seen[global/font]} && ${+seen[urgency_critical/frame_color]} )) ||
        { print -r -- "no [global] font or [urgency_critical] frame_color"; return 1; }
}

# xresources: merged with `xrdb -nocpp -merge`. Every line is a comment or
# resource: value; *.colorN, the colour keys and theme.* are #rrggbb; all 16
# colours and Xcursor.theme/size are there. No resource twice: xrdb keeps the
# last silently.
_theme-validate-xresources() {
    setopt localoptions extendedglob
    local f=$1 line key val
    local -A seen=()
    local -i n=0
    for line in "${(@f)$(<"$f")}"; do
        (( n++ ))
        [[ -z "${line//[[:space:]]/}" || "$line" == '!'* ]] && continue
        [[ "$line" =~ '^([A-Za-z0-9_.*?-]+):[[:space:]]*(.*[^[:space:]])[[:space:]]*$' ]] ||
            { print -r -- "line $n: not resource: value: $line"; return 1; }
        key=${match[1]} val=${match[2]}
        (( ${+seen[$key]} )) && { print -r -- "line $n: duplicate resource $key"; return 1; }
        seen[$key]=1
        [[ "$key" == (\*.color<0-15>|\*.foreground|\*.background|\*.cursorColor|theme.*) && ! "$val" =~ '^#[0-9a-fA-F]{6}$' ]] &&
            { print -r -- "line $n: $key is not a colour: $val"; return 1; }
        [[ "$key" == Xcursor.size && "$val" != <1-> ]] && { print -r -- "line $n: Xcursor.size is not a number: $val"; return 1; }
    done
    for key in '*.color'{0..15} Xcursor.theme Xcursor.size; do
        (( ${+seen[$key]} )) || { print -r -- "missing $key"; return 1; }
    done
}

# betterlockscreen.sh: sourced by bash at the end of betterlockscreenrc.
# bash -n; every line a comment or key=value; no key twice; *color keys are
# rrggbbaa without a # (i3lock-color's format; anything else and it draws its
# own defaults); the ring, inside, verify, wrong and font keys are all set.
_theme-validate-betterlockscreen() {
    local f=$1 line key val
    local -A seen=()
    local -i n=0
    if (( $+commands[bash] )); then bash -n "$f" || return 1; fi
    for line in "${(@f)$(<"$f")}"; do
        (( n++ ))
        [[ -z "${line//[[:space:]]/}" || "$line" == '#'* ]] && continue
        [[ "$line" =~ '^([a-z_]+)=(.+)$' ]] || { print -r -- "line $n: not key=value: $line"; return 1; }
        key=${match[1]} val=${match[2]}
        (( ${+seen[$key]} )) && { print -r -- "line $n: duplicate key $key"; return 1; }
        seen[$key]=1
        [[ "$key" == *color && ! "$val" =~ '^[0-9a-f]{8}$' ]] &&
            { print -r -- "line $n: $key is not rrggbbaa: $val"; return 1; }
    done
    for key in ringcolor insidecolor ringvercolor insidevercolor ringwrongcolor insidewrongcolor \
               verifcolor wrongcolor font; do
        (( ${+seen[$key]} )) || { print -r -- "missing $key"; return 1; }
    done
}

# gtk.css: imported by GTK 3 and 4, which skip a rule they can't parse with
# only a warning on stderr. Every line is a comment or `@define-color <name>
# <value>;`; no name twice; a value is #rrggbb, rgba(r, g, b, a) or
# alpha(#rrggbb, a), which both GTKs read; the names adw-gtk3 and libadwaita
# draw most with are all there.
_theme-validate-gtk-css() {
    setopt localoptions extendedglob
    local f=$1 line name val comment=0
    local -A seen=()
    local -i n=0
    local hex='#[0-9a-fA-F]{6}' num='[0-9]+(\.[0-9]+)?'
    for line in "${(@f)$(<"$f")}"; do
        (( n++ ))
        line=${${line##[[:space:]]#}%%[[:space:]]#}
        if (( comment )); then [[ "$line" == *'*/' ]] && comment=0; continue; fi
        [[ -z "$line" ]] && continue
        if [[ "$line" == '/*'* ]]; then [[ "$line" == *'*/' ]] || comment=1; continue; fi
        [[ "$line" =~ '^@define-color ([a-z0-9_]+) (.+);$' ]] ||
            { print -r -- "line $n: not @define-color <name> <value>;: $line"; return 1; }
        name=${match[1]} val=${match[2]}
        (( ${+seen[$name]} )) && { print -r -- "line $n: $name defined twice"; return 1; }
        seen[$name]=1
        [[ "$val" =~ "^($hex|rgba\\($num, $num, $num, $num\\)|alpha\\($hex, $num\\))\$" ]] ||
            { print -r -- "line $n: $name is not #rrggbb, rgba() or alpha(): $val"; return 1; }
    done
    (( ! comment )) || { print -r -- "unterminated comment"; return 1; }
    for name in accent_bg_color accent_fg_color window_bg_color window_fg_color view_bg_color view_fg_color \
                headerbar_bg_color headerbar_fg_color destructive_bg_color error_bg_color \
                popover_bg_color dialog_bg_color card_bg_color; do
        (( ${+seen[$name]} )) || { print -r -- "missing $name"; return 1; }
    done
}

# xsettingsd.conf: every line a comment or `<Name> <value>`, the name
# slash-separated words, the value an integer or a "quoted string" (the only
# kinds written); no name twice (xsettingsd refuses duplicates); the font and
# cursor are set. xsettingsd itself is never run: it would claim the
# XSETTINGS selection from the live one.
_theme-validate-xsettingsd() {
    local f=$1 line name
    local -A seen=()
    local -i n=0
    for line in "${(@f)$(<"$f")}"; do
        (( n++ ))
        [[ -z "${line//[[:space:]]/}" || "$line" == '#'* ]] && continue
        [[ "$line" =~ '^([A-Za-z][A-Za-z0-9]*(/[A-Za-z][A-Za-z0-9]*)+) (-?[0-9]+|"([^"\\]|\\.)*")$' ]] ||
            { print -r -- "line $n: not <Name> <integer|\"string\">: $line"; return 1; }
        name=${match[1]}
        (( ${+seen[$name]} )) && { print -r -- "line $n: duplicate setting $name"; return 1; }
        seen[$name]=1
    done
    for name in Gtk/FontName Gtk/CursorThemeName Gtk/CursorThemeSize; do
        (( ${+seen[$name]} )) || { print -r -- "missing $name"; return 1; }
    done
}

# Validates every file in build dir $1. gomplate's own errors never reach
# here; this catches templates that render but produce something broken.
_theme-validate() {
    local dir=$1 f ext fn line
    local -a files=("$dir"/*(N.))
    if f=$(grep -l '<no value>' "${files[@]}"); then
        log-error "[theme] unresolved template value in: ${(f)f:t}"
        return 1
    fi
    for f in "${files[@]}"; do
        ext=${f:e}
        fn=${_THEME_VALIDATORS[${f:t}]:-}
        [[ -z "$fn" && -n "$ext" ]] && fn=${_THEME_VALIDATORS[$ext]:-}
        [[ -n "$fn" ]] || continue
        "$fn" "$f" 2>&1 | while IFS= read -r line; do log-error "[theme] ${f:t}: $line"; done
        (( ${pipestatus[1]} == 0 )) || { log-error "[theme] ${f:t} failed validation"; return 1; }
    done
}

# Resolves source $1 (see _theme-source-parse) into _THEME_* without writing
# a build. REPLY = the theme's name.
_theme-resolve-source() {
    local name
    _theme-load-source "$1" || return 1
    name=$REPLY
    _theme-resolve || { log-error "[theme] $name: ${(j:; :)_THEME_NOTES}"; return 1; }
    REPLY=$name
}

# Builds source $1 into builds/<id> with wallpaper $2 (default: an image
# source's own image when $3 is 1, else the current build's, else the prefs
# default); REPLY = id. Nothing is left behind on failure.
_theme-build() {
    local slug id tmp wall=${2:-}
    _theme-resolve-source "$1" || return 1
    slug=$REPLY
    [[ -z "$wall" && "${3:-}" == 1 && "$_THEME_SRC_KIND" == image ]] && wall=$_THEME_SRC_REF
    [[ -n "$wall" ]] || { _theme-wallpaper-current; wall=$REPLY; }
    _theme-new-id; id=$REPLY
    tmp="$_THEME_STATE/builds/$id.tmp"
    mkdir -p "$tmp" || return 1
    if ! _theme-spec "$id" "$slug" "$wall" > "$tmp/spec.json"; then
        rm -rf -- "$tmp"; log-error "[theme] could not write spec.json"; return 1
    fi
    _theme-render "$tmp" "$id"
}

# Builds a copy of build $1 with only its wallpaper changed to $2: the same
# spec (colours, sizes, name) under a new id, rendered again. REPLY = id.
_theme-build-wallpaper() {
    local from="$_THEME_STATE/builds/$1/spec.json" id tmp
    _theme-new-id; id=$REPLY
    tmp="$_THEME_STATE/builds/$id.tmp"
    mkdir -p "$tmp" || return 1
    if ! jq --arg id "$id" --arg w "$2" '.id = $id | .wallpaper = $w' "$from" > "$tmp/spec.json"; then
        rm -rf -- "$tmp"; log-error "[theme] could not write spec.json from build $1"; return 1
    fi
    _theme-render "$tmp" "$id"
}

# Renders every template from $1/spec.json into $1 (builds/<id $2>.tmp),
# validates, and moves it to builds/<id>; REPLY = id. Discards $1 on failure.
_theme-render() {
    local tmp=$1 id=$2 out
    if [[ ! -d "$_THEME_TEMPLATES" ]]; then
        rm -rf -- "$tmp"; log-error "[theme] no templates in $_THEME_TEMPLATES"; return 1
    fi
    if ! out=$(gomplate -c "spec=$tmp/spec.json" --input-dir "$_THEME_TEMPLATES" \
                   --output-map "$tmp/{{ .in | strings.TrimSuffix \".tmpl\" }}" 2>&1); then
        rm -rf -- "$tmp"
        out=$(jq -r '.err // .' <<<"$out" 2>/dev/null || print -r -- "$out")
        log-error "[theme] render failed: ${${out//$tmp\//}//$_THEME_TEMPLATES\//}"
        return 1
    fi
    if ! _theme-validate "$tmp"; then
        rm -rf -- "$tmp"; return 1
    fi
    mv -T "$tmp" "$_THEME_STATE/builds/$id" || { rm -rf -- "$tmp"; return 1; }
    REPLY=$id
}

_theme-reload-rofi() { return 0; }

# True when _THEME_STATE is the state the desktop reads (see
# _THEME_POLYBAR_STATE): a scratch state (self-test, a preview) never
# reaches the running desktop.
_theme-live() {
    local live=${_THEME_POLYBAR_STATE/#\~/$HOME}
    [[ "${_THEME_STATE:A}" == "${live:A}" ]]
}

# Points link $1 at $2 unless it already does; by rename, so it is never
# missing.
_theme-link-to() {
    [[ -L "$1" && "$(readlink -- "$1")" == "$2" ]] && return 0
    ln -sfn -- "$2" "$1.tmp" && mv -Tf -- "$1.tmp" "$1"
}

# Points the dunst drop-in at current/dunst.conf, and gtk-3.0/theme.css and
# gtk-4.0/theme.css at current/gtk.css, so every swap reaches them. Each only
# where its app is configured (~/.config/dunst, a gtk.css to import it) and
# for the live state; these are real directories, never stowed. Also the
# state's xsettingsd.conf link, back on current/xsettingsd.conf.
_theme-link-dropins() {
    _theme-live || return 0
    local cfg=${XDG_CONFIG_HOME:-$HOME/.config} d rc=0
    local link="$cfg/$_THEME_DUNST_DROPIN"
    if [[ -d "${link:h:h}" ]]; then
        mkdir -p -- "${link:h}" && _theme-link-to "$link" "$_THEME_STATE/current/dunst.conf" || rc=1
    fi
    for d in "${_THEME_GTK_DIRS[@]}"; do
        [[ -e "$cfg/$d/gtk.css" ]] || continue
        _theme-link-to "$cfg/$d/theme.css" "$_THEME_STATE/current/gtk.css" || rc=1
    done
    [[ -d "$_THEME_STATE" ]] && { _theme-link-to "$_THEME_STATE/$_THEME_XSETTINGSD_LINK" current/xsettingsd.conf || rc=1; }
    return $rc
}

# bspwm: sources current/bspwm.sh (border colours and width, window_gap,
# bottom_padding), then re-docks a shown coordinator panel, whose geometry
# depends on the gap, the border and the bottom padding. Skipped without a
# running bspwm. A failed re-dock only warns: rolling the theme back
# wouldn't move the panel either.
_theme-reload-bspwm() {
    _theme-live || return 0
    [[ -n "${DISPLAY:-}" ]] && whence bspc >/dev/null || return 0
    bspc query -M >/dev/null 2>&1 || return 0
    local f="$_THEME_STATE/current/bspwm.sh"
    [[ -r "$f" ]] || { log-error "[theme] no $f"; return 1; }
    source "$f" || return 1
    whence coord >/dev/null || return 0
    local side
    side=$(coord side 2>/dev/null) && [[ "$side" == (left|right) ]] &&
        coord side "$side" >/dev/null 2>&1 || log-warning "[theme] coord re-dock failed; run: coord side \"\$(coord side)\""
    return 0
}

# dunst re-reads dunstrc and dunstrc.d/*.conf on `dunstctl reload` (when it
# was started without -config, as 10-dunst does). Skipped when no dunst runs.
_theme-reload-dunst() {
    _theme-live || return 0
    _theme-link-dropins || log-warning "[theme] couldn't link the dunst drop-in"
    whence dunstctl >/dev/null && pgrep -x -u $UID dunst >/dev/null || return 0
    timeout 5 dunstctl reload
}

# X resources: merges current/xresources over what 10-x11 loaded
# (~/.Xresources). -nocpp: the file has no directives, and cpp would expand
# predefined macros such as `linux` inside values.
_theme-reload-xresources() {
    _theme-live || return 0
    [[ -n "${DISPLAY:-}" ]] && whence xrdb >/dev/null || return 0
    timeout 5 xrdb -nocpp -merge "$_THEME_STATE/current/xresources"
}

# True when theme $2 of kind $1 (themes: a GTK 3 theme; icons: an icon
# theme) is installed in an XDG data dir or the legacy ~/.themes, ~/.icons.
# The same lookup as xsettingsd.conf.tmpl's.
_theme-installed() {
    local kind=$1 name=$2 d file
    [[ -n "$name" ]] || return 1
    [[ "$kind" == themes ]] && file=gtk-3.0/gtk.css || file=index.theme
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}" ${(s.:.)${XDG_DATA_DIRS:-/usr/local/share:/usr/share}}; do
        [[ -r "$d/$kind/$name/$file" ]] && return 0
    done
    [[ -r "$HOME/.$kind/$name/$file" ]]
}

# REPLY = the value of setting $1 in xsettingsd.conf $2, unquoted.
_theme-xsettingsd-get() {
    local line
    line=$(grep -m1 "^$1 " "$2" 2>/dev/null) || return 1
    REPLY=${${${line#$1 }#\"}%\"}
}

# xsettingsd re-reads its config on SIGHUP and announces what changed. GTK 3
# applies a new font, icon or cursor theme at once, but re-reads gtk.css (so
# the new colours) only when Net/ThemeName changes. When the name stays the
# same (dark to dark), the link goes to a copy with the name's other variant
# (adw-gtk3-dark <-> adw-gtk3: the colours come from gtk.css either way, so
# the flash is slight), HUP, a pause, then back and HUP again. A mode change
# changes the name, so one HUP does. Live state and a running xsettingsd only;
# the login hook starts it. A failed signal only warns: rolling the theme
# back wouldn't reach xsettingsd either.
_theme-reload-xsettingsd() {
    _theme-live || return 0
    _theme-link-dropins || log-warning "[theme] couldn't link the GTK and xsettingsd files"
    pgrep -x -u $UID xsettingsd >/dev/null || return 0
    local conf="$_THEME_STATE/current/xsettingsd.conf" link="$_THEME_STATE/$_THEME_XSETTINGSD_LINK"
    local tmp="$_THEME_STATE/xsettingsd.toggle.conf" name live= other
    [[ -r "$conf" ]] || { log-error "[theme] no $conf"; return 1; }
    if _theme-xsettingsd-get Net/ThemeName "$conf"; then
        name=$REPLY
        [[ -n "${DISPLAY:-}" ]] && whence dump_xsettings >/dev/null &&
            live=$(timeout 2 dump_xsettings 2>/dev/null | sed -n 's/^Net\/ThemeName "\(.*\)"$/\1/p')
        if [[ -z "$live" || "$live" == "$name" ]]; then
            [[ "$name" == *-dark ]] && other=${name%-dark} || other=$name-dark
            sed "s|^Net/ThemeName .*|Net/ThemeName \"$other\"|" "$conf" > "$tmp" &&
                _theme-link-to "$link" "${tmp:t}" &&
                pkill -HUP -x -u $UID xsettingsd && sleep $_THEME_XSETTINGSD_TOGGLE_WAIT
        fi
    fi
    _theme-link-to "$link" current/xsettingsd.conf || return 1
    rm -f -- "$tmp"
    pkill -HUP -x -u $UID xsettingsd || log-warning "[theme] couldn't signal xsettingsd"
    return 0
}

# GNOME's interface settings, read by libadwaita (color-scheme, through the
# settings portal), xdg-desktop-portal-gtk, Firefox and Chromium: the mode,
# the GTK and icon themes (when installed), the UI font, the cursor. Only
# keys that differ are written. Live state and a writable dconf only;
# skipped quietly otherwise. A failed write only warns.
_theme-reload-gsettings() {
    _theme-live || return 0
    whence gsettings >/dev/null || return 0
    local schema=org.gnome.desktop.interface spec="$_THEME_STATE/current/spec.json" k v cur
    gsettings writable $schema color-scheme >/dev/null 2>&1 || return 0
    [[ -r "$spec" ]] || { log-error "[theme] no $spec"; return 1; }
    local -a vals=("${(@f)$(jq -r '.mode, .gtk, .icons, "\(.font.family.ui) \(.font.sizes.gtk)", .cursor.theme, .cursor.size' "$spec")}")
    local -A want=(
        [color-scheme]=${${vals[1]:#light}:+prefer-dark}
        [font-name]=${vals[4]}
        [cursor-theme]=${vals[5]}
        [cursor-size]=${vals[6]}
    )
    [[ -n "${want[color-scheme]}" ]] || want[color-scheme]=default
    _theme-installed themes "${vals[2]}" && want[gtk-theme]=${vals[2]}
    _theme-installed icons "${vals[3]}" && want[icon-theme]=${vals[3]}
    for k in ${(ok)want}; do
        v=${want[$k]}
        [[ "$k" == cursor-size ]] || v="'$v'"
        cur=$(gsettings get $schema $k 2>/dev/null)
        [[ "$cur" == "$v" ]] && continue
        gsettings set $schema $k "$v" 2>/dev/null || log-warning "[theme] gsettings set $schema $k $v failed"
    done
    return 0
}

# ------------------------------
# Private Helpers: wallpaper
# ------------------------------

# REPLY = the result of jq filter $1 over prefs.toml with overrides.json
# merged in (one gomplate, one jq). Returns 1 when prefs can't be read.
_theme-prefs() {
    local prefs="$_THEME_CONFIG/prefs.toml" ov="$_THEME_STATE/overrides.json" overrides='{}'
    [[ -r "$prefs" ]] || return 1
    [[ -r "$ov" ]] && overrides=$(<"$ov")
    REPLY=$(gomplate -c "p=$prefs" -i '{{ .p | data.ToJSON }}' 2>/dev/null |
            jq -r --argjson o "$overrides" "(. * \$o) | $1" 2>/dev/null)
}

# reply = the wallpaper dirs that exist, in lookup order: THEME_WALLPAPER_DIRS
# (colon-separated) or prefs [wallpaper] dirs, ~ expanded. Absolute but not
# symlink-resolved, so a stowed dir keeps its ~/.local/share path.
_theme-wallpaper-dirs() {
    local d
    local -a dirs
    if [[ -n "${THEME_WALLPAPER_DIRS:-}" ]]; then
        dirs=("${(@s.:.)THEME_WALLPAPER_DIRS}")
    elif _theme-prefs '(.wallpaper.dirs // [])[]'; then
        dirs=("${(@f)REPLY}")
    fi
    reply=()
    for d in "${dirs[@]}"; do
        [[ -n "$d" ]] || continue
        d=${d/#\~/$HOME}
        [[ -d "$d" ]] && reply+=("${d:a}")
    done
}

# reply = every image in the wallpaper dirs, each dir's sorted by name. A
# name (file name without extension) already found in an earlier dir is
# skipped, as `theme wallpaper <name>` would never reach it.
_theme-wallpaper-list() {
    setopt localoptions extendedglob
    local d f
    local -a dirs seen
    _theme-wallpaper-dirs; dirs=("${reply[@]}")
    reply=()
    for d in "${dirs[@]}"; do
        for f in "$d"/(#i)*.${~_THEME_WALLPAPER_EXT}(N-.on); do
            (( ${seen[(Ie)${f:t:r}]} )) && continue
            seen+=("${f:t:r}")
            reply+=("$f")
        done
    done
}

# True when $1 is a readable image (file(1)'s MIME type, else the extension).
_theme-wallpaper-image() {
    setopt localoptions extendedglob
    [[ -f "$1" && -r "$1" ]] || return 1
    if (( $+commands[file] )); then
        [[ "$(file -b -L --mime-type -- "$1" 2>/dev/null)" == image/* ]]
    else
        [[ "${1:e}" == (#i)${~_THEME_WALLPAPER_EXT} ]]
    fi
}

# REPLY = the image wallpaper reference $1 names, as an absolute path:
#   a path (with a / or a leading ~), used as it is;
#   else a name in the wallpaper dirs: its file name (0004.png), then its
#   name without extension (0004), then its number (4 finds 0004);
#   else a file of that name in the current directory.
# Returns 1, quietly, when there is none or it isn't an image.
_theme-wallpaper-find() {
    local ref=$1 f hit=
    [[ -n "$ref" ]] || return 1
    if [[ "$ref" == */* || "$ref" == \~* ]]; then
        hit=${ref/#\~/$HOME}
    else
        _theme-wallpaper-list
        for f in "${reply[@]}"; do [[ "${f:t}" == "$ref" ]] && { hit=$f; break; }; done
        [[ -z "$hit" ]] && for f in "${reply[@]}"; do [[ "${f:t:r}" == "$ref" ]] && { hit=$f; break; }; done
        [[ -z "$hit" && "$ref" =~ '^[0-9]+$' ]] && for f in "${reply[@]}"; do
            [[ "${f:t:r}" =~ '^[0-9]+$' ]] && (( 10#${f:t:r} == 10#$ref )) && { hit=$f; break; }
        done
        [[ -z "$hit" && -f "$ref" ]] && hit=$ref
    fi
    [[ -n "$hit" ]] && _theme-wallpaper-image "$hit" || return 1
    REPLY=${hit:a}
}

# REPLY = prefs [wallpaper] default looked up in the dirs, or "" if missing.
_theme-wallpaper-default() {
    local name=0001
    _theme-prefs '.wallpaper.default // "0001"' && [[ -n "$REPLY" ]] && name=$REPLY
    _theme-wallpaper-find "$name" || REPLY=
    return 0
}

# REPLY = the wallpaper the current build records, while it is still an
# image; else the default (which may be "").
_theme-wallpaper-current() {
    local w=
    [[ -r "$_THEME_STATE/current/spec.json" ]] &&
        w=$(jq -r '.wallpaper // ""' "$_THEME_STATE/current/spec.json" 2>/dev/null)
    if [[ -n "$w" ]] && _theme-wallpaper-image "$w"; then
        REPLY=$w
        return 0
    fi
    _theme-wallpaper-default
}

# Sets the current wallpaper on the root window (feh, which also gives
# picom and the lock screen's wallpaper_cmd the same picture). Live state
# and an X display only. A recorded wallpaper that has gone falls back to
# the default; with neither the root window is left alone.
_theme-reload-wallpaper() {
    _theme-live || return 0
    [[ -n "${DISPLAY:-}" ]] && (( $+commands[feh] )) || return 0
    _theme-wallpaper-current
    [[ -n "$REPLY" ]] || { log-warning "[theme] no wallpaper recorded and no default found; root window left as it is"; return 0; }
    timeout 10 feh --no-fehbg --bg-fill "$REPLY"
}

# REPLY = what lockscreen.cached records for wallpaper $1: its path and
# mtime, so an image edited in place counts as a change too.
_theme-lockscreen-key() {
    local -a st
    zstat -A st +mtime -- "$1" 2>/dev/null || st=(0)
    REPLY="$1"$'\t'"${st[1]}"
}

# betterlockscreen locks with images it cached at `betterlockscreen -u
# <wallpaper>` (resized, dimmed, blurred per display; seconds of CPU on a
# 5120px image). Its colours come from betterlockscreenrc and the
# betterlockscreen.sh it sources at lock time, so only a new wallpaper needs
# a new cache. When the current wallpaper differs from lockscreen.cached, a
# detached, niced job refreshes it; the reload returns at once. Live state
# only; skipped without betterlockscreen.
_theme-reload-lockscreen() {
    _theme-live || return 0
    (( $+commands[betterlockscreen] )) || return 0
    _theme-wallpaper-current
    [[ -n "$REPLY" ]] || return 0
    _theme-lockscreen-key "$REPLY"
    [[ -r "$_THEME_STATE/lockscreen.cached" && "$(<"$_THEME_STATE/lockscreen.cached")" == "$REPLY" ]] && return 0
    _theme-lockscreen-refresh </dev/null >|"$_THEME_STATE/lockscreen.log" 2>&1 &!
    return 0
}

# The background job: one at a time (lockscreen.lock). It reads the current
# wallpaper again after the lock and after each refresh, so a quick run of
# wallpaper changes ends with the cache made from the last one.
_theme-lockscreen-refresh() {
    local mark="$_THEME_STATE/lockscreen.cached" key ts wall
    local -a pre=(nice -n 19)
    local -i n
    (( $+commands[ionice] )) && pre+=(ionice -c 3)
    : >> "$_THEME_STATE/lockscreen.lock"
    zsystem flock -t 900 "$_THEME_STATE/lockscreen.lock" || return 1
    for (( n = 0; n < 3; n++ )); do
        _theme-wallpaper-current
        [[ -n "$REPLY" ]] || return 0
        wall=$REPLY
        _theme-lockscreen-key "$wall"; key=$REPLY
        [[ -r "$mark" && "$(<"$mark")" == "$key" ]] && return 0
        strftime -s ts '%F %T' $EPOCHSECONDS
        print -r -- "$ts ${pre[*]} betterlockscreen -u $wall"
        "${pre[@]}" betterlockscreen -u "$wall" || { print -r -- "$ts failed"; return 1; }
        print -r -- "$key" >| "$mark.tmp" && mv -f -- "$mark.tmp" "$mark"
    done
}

# alacritty (0.17, config/monitor.rs) watches the canonical path of each
# import, i.e. builds/<old id>/alacritty.toml behind `current`, so swapping
# `current` alone never reaches it. A metadata change on the old file does:
# alacritty reloads, re-reads the import through `current`, and restarts its
# watcher on the new build. Every build is touched, so a terminal that missed
# a swap catches up; the files' contents never change. A terminal started
# before any theme existed watches nothing here and needs a restart.
_theme-reload-alacritty() {
    local -a files=("$_THEME_STATE"/builds/*/alacritty.toml(N.))
    (( ${#files} )) || return 0
    touch -c -- "${files[@]}"
}

# polybar reads the theme at start-up only, so each bar is restarted in place
# (`polybar-msg -p <pid> cmd restart` re-execs it, keeping its pid and
# environment). Only for the state dir its config.ini includes: a scratch
# state (self-test, a preview) never touches the running bar. No bar running
# is success; the login hook or `polybar-reload` starts one.
#
# A restarted bar must answer IPC again within _THEME_POLYBAR_WAIT seconds.
# One that doesn't, or that wouldn't take the restart, is frozen (a restart
# that hangs leaves a bar deaf to IPC and SIGTERM): it is killed with its
# scripts and relaunched from its recorded command line and environment, so a
# reload never leaves a frozen or missing bar. Every message has a timeout;
# polybar-msg killed by it can take a slow bar down with SIGPIPE when the
# answer comes, which the relaunch covers too.
#
# A bar that exits by itself, after its restart or a relaunch, can't parse
# its config. Its command line and environment are kept in
# _THEME_POLYBAR_DEAD and the reload fails, so _theme-activate rolls
# `current` back and reloads again; that reload relaunches the dead ones on
# the restored build.
typeset -ga _THEME_POLYBAR_DEAD=()
typeset -g _THEME_POLYBAR_WAIT=${THEME_POLYBAR_WAIT:-6}
_theme-reload-polybar() {
    local pid entry
    local -a pids started
    local -A cmd=() waiting=()
    local -F deadline
    _theme-live || return 0
    (( $+commands[polybar] )) || return 0
    pids=(${(f)"$(pgrep -x -u $UID polybar || :)"})
    for entry in "${_THEME_POLYBAR_DEAD[@]}"; do
        _theme-polybar-start "$entry" && { started+=($REPLY); cmd[$REPLY]=$entry; }
    done
    (( ${#_THEME_POLYBAR_DEAD} )) &&
        log-warning "[theme] relaunched ${#_THEME_POLYBAR_DEAD} polybar bar(s) that exited on restart"
    _THEME_POLYBAR_DEAD=()
    for pid in "${pids[@]}"; do
        _theme-polybar-cmd $pid && cmd[$pid]=$REPLY
        if timeout 3 polybar-msg -p $pid cmd restart >/dev/null 2>&1; then
            waiting[$pid]=1
        else
            log-warning "[theme] polybar $pid didn't take the restart; relaunching it"
            _theme-polybar-relaunch $pid "${cmd[$pid]:-}" && { started+=($REPLY); cmd[$REPLY]=${cmd[$pid]}; }
        fi
    done
    (( deadline = EPOCHREALTIME + _THEME_POLYBAR_WAIT ))
    while (( ${#waiting} )); do
        sleep 0.25
        for pid in ${(k)waiting}; do
            if ! kill -0 $pid 2>/dev/null; then
                unset "waiting[$pid]"
                [[ -n "${cmd[$pid]:-}" ]] && _THEME_POLYBAR_DEAD+=("${cmd[$pid]}")
            elif _theme-polybar-ping $pid; then
                unset "waiting[$pid]"
            elif (( $? == 124 || EPOCHREALTIME >= deadline )); then
                # No answer: frozen.
                unset "waiting[$pid]"
                log-warning "[theme] polybar $pid froze on restart; killing and relaunching it"
                _theme-polybar-relaunch $pid "${cmd[$pid]:-}" && { started+=($REPLY); cmd[$REPLY]=${cmd[$pid]}; }
            fi
        done
    done
    # A bar that can't parse its config exits within milliseconds.
    (( ${#started} )) && sleep 0.5
    for pid in "${started[@]}"; do
        kill -0 $pid 2>/dev/null || _THEME_POLYBAR_DEAD+=("${cmd[$pid]}")
    done
    (( ${#_THEME_POLYBAR_DEAD} )) || return 0
    log-error "[theme] ${#_THEME_POLYBAR_DEAD} polybar bar(s) exited on the new config"
    return 1
}

# Succeeds when polybar $1 answers IPC; 124 when it doesn't answer in time.
# The action names no module: polybar answers and logs it as unknown.
_theme-polybar-ping() {
    timeout 2 polybar-msg -p $1 action '#theme-ping.ping' >/dev/null 2>&1
}

# REPLY = "<count>\0<environment...>\0<argv...>" for polybar pid $1, NUL
# separated: its environment variables, then its command line.
_theme-polybar-cmd() {
    local args env
    local -a envv
    args=$(</proc/$1/cmdline) && env=$(</proc/$1/environ) || return 1
    envv=("${(@ps:\0:)${env%$'\0'}}")
    REPLY=${#envv}$'\0'${env%$'\0'}$'\0'${args%$'\0'}
} 2>/dev/null

# Starts the bar recorded in entry $1 (from _theme-polybar-cmd), detached in
# ~ with exactly its recorded environment; REPLY = its pid.
_theme-polybar-start() {
    local entry=$1
    local -a parts envv argv
    local -i n
    parts=("${(@ps:\0:)entry}")
    n=${parts[1]}
    envv=("${(@)parts[2,n+1]}") argv=("${(@)parts[n+2,-1]}")
    (( ${#argv} )) || return 1
    ( cd ~ && exec env -i "${envv[@]}" "${argv[@]}" ) </dev/null >/dev/null 2>&1 &!
    REPLY=$!
}

# SIGKILLs polybar $1 and the process group of each script it runs (desk
# watch and its bspc subscribe), then starts entry $2; REPLY = the new pid.
# SIGKILL because a frozen bar ignores SIGTERM; its scripts would otherwise
# linger until they next write to the dead bar.
_theme-polybar-relaunch() {
    local pid=$1 entry=$2 kid
    local -a kids
    local -i i
    kids=(${(f)"$(pgrep -P $pid 2>/dev/null || :)"})
    kill -KILL $pid 2>/dev/null
    for kid in "${kids[@]}"; do
        # polybar makes each script a group leader; never signal another group.
        [[ ${"$(ps -o pgid= -p $kid 2>/dev/null)"// /} == $kid ]] && kill -KILL -- -$kid 2>/dev/null
        kill -KILL $kid 2>/dev/null
    done
    for (( i = 0; i < 20; i++ )); do kill -0 $pid 2>/dev/null || break; sleep 0.05; done
    [[ -n "$entry" ]] || { log-error "[theme] no command line recorded for polybar $pid"; return 1; }
    _theme-polybar-start "$entry"
}

# Runs the reloaders for targets $@ (default: every target); non-zero if any
# fails or is unknown.
_theme-reload() {
    local t rc=0
    local -a targets=("$@")
    (( ${#targets} )) || targets=(${(ko)_THEME_RELOADERS})
    for t in "${targets[@]}"; do
        if (( ! ${+_THEME_RELOADERS[$t]} )); then
            log-error "[theme] unknown reload target '$t' (${(kj:, :)_THEME_RELOADERS})"
            rc=1
        elif ! "${_THEME_RELOADERS[$t]}"; then
            log-error "[theme] reload $t failed"
            rc=1
        fi
    done
    return $rc
}

# Activates build $1 (name $2) and reloads targets $3... (default all). On a
# failed reload rolls back to the build that was current before, then to
# known-good, reloading the same targets. known-good advances only on
# success.
_theme-activate() {
    local id=$1 name=$2 prev= kg=
    shift 2
    _theme-link-id current && prev=$REPLY
    _theme-link-id known-good && kg=$REPLY
    _theme-link current "$id" || return 1
    _theme-history-push "$id" "$name"
    if _theme-reload "$@"; then
        _theme-link known-good "$id"
        return 0
    fi
    log-error "[theme] reload failed for $name ($id); rolling back"
    _theme-history-pop
    if [[ -n "$prev" ]] && _theme-link current "$prev" && _theme-reload "$@"; then
        log-warning "[theme] restored the previous build $prev"
    elif [[ -n "$kg" ]] && _theme-build-complete "$kg" && _theme-link current "$kg" && _theme-reload "$@"; then
        log-warning "[theme] restored known-good $kg"
    else
        log-error "[theme] rollback failed too; run: theme apply default"
    fi
    return 1
}

# Sources the current theme.zsh into THEME_* (or nothing); returns 1 if none.
_theme-source-current() {
    [[ -r "$_THEME_STATE/current/theme.zsh" ]] || return 1
    source "$_THEME_STATE/current/theme.zsh"
}

_theme-swatch-block() {
    colour-parse "$1" || return 1
    printf '\e[48;2;%d;%d;%dm%s\e[0m' $(( int(rint(reply[1]*255)) )) $(( int(rint(reply[2]*255)) )) \
        $(( int(rint(reply[3]*255)) )) "${2:-      }"
}

_theme-fg-on() {
    local fg=$1 bg=$2 text=$3
    colour-parse "$fg"; local -a f=($reply)
    colour-parse "$bg"; local -a b=($reply)
    printf '\e[38;2;%d;%d;%dm\e[48;2;%d;%d;%dm%s\e[0m' \
        $(( int(rint(f[1]*255)) )) $(( int(rint(f[2]*255)) )) $(( int(rint(f[3]*255)) )) \
        $(( int(rint(b[1]*255)) )) $(( int(rint(b[2]*255)) )) $(( int(rint(b[3]*255)) )) "$text"
}

# ------------------------------
# Public
# ------------------------------

# REPLY = prefs `default`, else _THEME_DEFAULT_SCHEME.
_theme-default-scheme() {
    REPLY=$(gomplate -c "p=$_THEME_CONFIG/prefs.toml" -i '{{ .p.default }}' 2>/dev/null)
    [[ -n "$REPLY" ]] || REPLY=$_THEME_DEFAULT_SCHEME
}

# Parses --mode, --variant and --contrast (also --opt=value) out of $@ into
# _THEME_OPT_MODE/_VARIANT/_CONTRAST, which the caller declares local;
# reply = the other arguments. Returns 2 on an unknown option.
_theme-opts() {
    local a
    reply=()
    while (( $# )); do
        a=$1; shift
        case "$a" in
            --mode|--variant|--contrast)
                (( $# )) || { log-error "[theme] $a needs a value"; return 2; }
                : ${(P)${:-_THEME_OPT_${(U)a#--}}::=$1}; shift ;;
            --mode=*|--variant=*|--contrast=*)
                : ${(P)${:-_THEME_OPT_${(U)${a%%=*}#--}}::=${a#*=}} ;;
            --) reply+=("$@"); break ;;
            -?*) [[ "$a" =~ '^-[0-9.]' ]] && { reply+=("$a"); continue; }
                 log-error "[theme] unknown option '$a'"; return 2 ;;
            *)  reply+=("$a") ;;
        esac
    done
}

theme-apply() {
    [[ "${1:-}" == (-h|--help) ]] && { theme-help; return 0; }
    local _THEME_OPT_MODE= _THEME_OPT_VARIANT= _THEME_OPT_CONTRAST=
    _theme-opts "$@" || return 2
    local target=${reply[1]:-} id name t0=$EPOCHREALTIME
    (( ${#reply} == 1 )) || { log-error "[theme] usage: theme apply <scheme|colour:#hex|image:<img>|build-id|default> [--mode m] [--variant v] [--contrast c]"; return 2; }
    _theme-paths
    _theme-lock || return 1
    if [[ "$target" == default ]]; then
        _theme-default-scheme; target=$REPLY
    fi
    if _theme-build-ok "$target"; then
        _theme-build-fresh "$target" || return 1
        id=$REPLY
        name=$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")
    else
        # An image source is also the wallpaper.
        _theme-build "$target" "" 1 || return 1
        id=$REPLY
        name=$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")
    fi
    _theme-activate "$id" "$name" || return 1
    _theme-prune
    _theme-ms-since $t0
    log-success "[theme] applied $name ($id) in ${REPLY} ms"
}

theme-current() {
    _theme-paths
    if ! _theme-link-id current; then
        log-error "[theme] no theme applied (consumers fall back to $_THEME_DEFAULT_SCHEME); run: theme ensure"
        return 1
    fi
    if [[ "${1:-}" == --json ]]; then
        cat "$_THEME_STATE/current/spec.json"
        return 0
    fi
    _theme-source-current
    print -r -- "name      ${THEME_META[name]} (${THEME_META[title]})"
    print -r -- "source    ${THEME_META[source]}"
    print -r -- "mode      ${THEME_META[mode]}"
    print -r -- "scale     ${THEME_SIZE[scale]}"
    print -r -- "contrast  ${THEME_META[contrast]}${${THEME_META[degraded]:#false}:+ (degraded from ${THEME_META[requested]})}"
    print -r -- "adjusted  ${THEME_META[adjusted]:-none}"
    print -r -- "anchored  ${THEME_META[anchored]:-none}"
    print -r -- "build     ${THEME_META[id]}"
}

theme-get() {
    local key=${1:-} map ref
    [[ -n "$key" && "$key" != (-h|--help) ]] || {
        print -r -- "Usage: theme get <role|palette slot or name|size|metric|font>"
        print -r -- "Roles: ${_THEME_ROLES[*]}"
        [[ -n "$key" ]]; return
    }
    _theme-paths
    if _theme-source-current; then
        [[ "$key" == base[0-9a-fA-F][0-9a-fA-F] ]] && key=base${(U)key[5,6]}
        for map in THEME_ROLE THEME_PALETTE THEME_SIZE THEME_METRIC THEME_FONT THEME_META; do
            ref="${map}[$key]"
            if (( ${(P)+ref} )); then
                print -r -- "${(P)ref}"
                return 0
            fi
        done
    elif [[ -n "${_THEME_FALLBACK[$key]:-}" ]]; then
        print -r -- "${_THEME_FALLBACK[$key]}"
        return 0
    fi
    log-error "[theme] unknown key '$key'"
    return 1
}

# theme-roles [<assoc>] <key>=<role> ...
# Fills the caller's assoc <assoc> (declared there, or global) with key ->
# the current theme's value for role, looked up as `get` does (role, palette
# slot or name, size, metric), else _THEME_FALLBACK's when no theme is
# applied or the build predates the role. Without <assoc>, prints
# "<key> <value>" lines. One `source` of theme.zsh, so the polybar strips call
# it per draw. Returns 1 if some role is unknown (its key is left as it was).
theme-roles() {
    local _tr_assoc= _tr_pair _tr_key _tr_role _tr_map _tr_ref _tr_val _tr_rc=0 _tr_have=0
    [[ "${1:-}" == (-h|--help) ]] && { theme-help; return 0; }
    [[ "${1:-}" =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] && { _tr_assoc=$1; shift; }
    _theme-paths
    _theme-source-current && _tr_have=1
    for _tr_pair in "$@"; do
        _tr_key=${_tr_pair%%=*} _tr_role=${_tr_pair#*=} _tr_val=
        (( _tr_have )) && for _tr_map in THEME_ROLE THEME_PALETTE THEME_SIZE THEME_METRIC; do
            _tr_ref="${_tr_map}[$_tr_role]"
            (( ${(P)+_tr_ref} )) && { _tr_val=${(P)_tr_ref}; break; }
        done
        : ${_tr_val:=${_THEME_FALLBACK[$_tr_role]:-}}
        if [[ -z "$_tr_val" || ! "$_tr_key" =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]; then
            log-error "[theme] roles: no value for '$_tr_pair'"; _tr_rc=1
        elif [[ -n "$_tr_assoc" ]]; then
            : ${(P)${:-${_tr_assoc}[$_tr_key]}::=$_tr_val}
        else
            print -r -- "$_tr_key $_tr_val"
        fi
    done
    return $_tr_rc
}

theme-reload() {
    [[ "${1:-}" == (-h|--help) ]] && { theme-help; return 0; }
    _theme-paths
    _theme-reload "$@" || return 1
    log-success "[theme] reloaded ${${*:-all}// /, }"
}

theme-list() {
    local what=${1:-schemes} f name variant cur= line id
    _theme-paths
    case "$what" in
        schemes)
            _theme-source-current 2>/dev/null && cur=${THEME_META[name]:-}
            for f in "$_THEME_CONFIG"/schemes/*.y(a|)ml(N); do
                name=${${(M)${(f)"$(<"$f")"}:#name:*}#name: }
                variant=${${(M)${(f)"$(<"$f")"}:#variant:*}#variant: }
                printf '%s %-22s %-6s %s\n' "${${(M)cur:#${f:t:r}}:+*}${${cur:#${f:t:r}}:+ }" \
                    "${f:t:r}" "${variant//\"/}" "${name//\"/}"
            done
            ;;
        history)
            [[ -s "$_THEME_STATE/history" ]] || { print -r -- "(empty)"; return 0; }
            for line in "${(@f)$(<"$_THEME_STATE/history")}"; do
                id=${line%%$'\t'*}
                _theme-build-ok "$id" && print -r -- "  $line" || print -r -- "  $line (pruned)"
            done
            ;;
        builds)
            for f in "$_THEME_STATE"/builds/*(N/:t); do print -r -- "$f"; done
            ;;
        wallpapers)
            # * marks the current one: the recorded wallpaper, else the default.
            _theme-wallpaper-current; cur=$REPLY
            _theme-wallpaper-list
            (( ${#reply} )) || { _theme-wallpaper-dirs; print -r -- "(no images in: ${${reply[*]/#$HOME/~}:-no [wallpaper] dirs})"; return 0; }
            for f in "${reply[@]}"; do
                printf '%s %-14s %s\n' "${${(M)f:#${(b)cur}}:+*}${${f:#${(b)cur}}:+ }" "${f:t:r}" "${f/#$HOME/~}"
            done
            ;;
        *) log-error "[theme] list: schemes, wallpapers, history or builds"; return 2 ;;
    esac
}

theme-check() {
    [[ "${1:-}" == (-h|--help) ]] && { theme-help; return 0; }
    local _THEME_OPT_MODE= _THEME_OPT_VARIANT= _THEME_OPT_CONTRAST=
    _theme-opts "$@" || return 2
    local ref=${reply[1]:-} name role pair rc=0 t0=$EPOCHREALTIME
    _theme-paths
    if [[ -z "$ref" ]]; then
        if _theme-link-id current; then
            _theme-spec-source "$_THEME_STATE/current/spec.json"
            ref=$REPLY
            : ${_THEME_OPT_MODE:=${reply[1]}} ${_THEME_OPT_VARIANT:=${reply[2]}} ${_THEME_OPT_CONTRAST:=${reply[3]}}
        else
            ref=$_THEME_DEFAULT_SCHEME
        fi
    fi
    _theme-load-source "$ref" || return 1
    name=$REPLY
    _theme-resolve || rc=1
    _theme-ms-since $t0
    print -r -- "$name: mode ${_THEME_MODE}, contrast ${_THEME_LEVEL}${${_THEME_DEGRADED:#0}:+ (DEGRADED from ${_THEME_IN[prefs.contrast]})}, resolved in ${REPLY} ms"
    [[ "$_THEME_SRC_KIND" == scheme ]] ||
        print -r -- "  source:   $_THEME_SRC_KIND ${_THEME_SRC_REF/#$HOME/~} (${_THEME_SRC_VARIANT}, contrast $_THEME_SRC_CONTRAST; source colour ${_THEME_IN[scheme.x-source]:-?})"
    print -r -- "  anchored: ${${(j:, :)_THEME_ANCHORED}:-none}"
    for role in "${_THEME_ROLES[@]}"; do
        printf '  %-10s %s %s%s%s\n' "$role" "${_THEME_ROLE[$role]}" \
            "$([[ -t 1 ]] && _theme-swatch-block "${_THEME_ROLE[$role]}" '    ')" \
            "${${(M)_THEME_ADJUSTED:#$role}:+  adjusted}" "${${(M)_THEME_ANCHORED:#$role}:+  anchored}"
    done
    print -r -- "  ratios:"
    for pair in ${(ko)_THEME_CONTRAST}; do
        printf '    %-18s %s\n' "$pair" "${_THEME_CONTRAST[$pair]}"
    done
    (( ${#_THEME_NOTES} )) && print -rl -- "  notes:" "${(@)_THEME_NOTES/#/    }"
    (( rc == 0 )) && print -r -- "  ok: every guarantee met" || print -r -- "  FAILED: a guarantee can't be met"
    return $rc
}

theme-swatch() {
    local ref=${1:-} role i
    local -A roles
    local -a ansi
    _theme-paths
    if [[ -n "$ref" ]]; then
        _theme-load-source "$ref" || return 1
        ref=$REPLY
        _theme-resolve || return 1
        roles=("${(@kv)_THEME_ROLE}"); ansi=("${_THEME_ANSI[@]}")
    elif _theme-source-current; then
        ref=${THEME_META[name]}
        roles=("${(@kv)THEME_ROLE}"); ansi=("${THEME_ANSI[@]}")
    else
        ref="$_THEME_DEFAULT_SCHEME (fallback)"
        roles=("${(@kv)_THEME_FALLBACK}")
    fi
    print -r -- "$ref"
    for role in "${_THEME_ROLES[@]}"; do
        printf '  %s %-10s %s  ' "$(_theme-swatch-block "${roles[$role]}")" "$role" "${roles[$role]}"
        case "$role" in
            on_accent) _theme-fg-on "${roles[on_accent]}" "${roles[accent]}" ' selected row ' ;;
            on_urgent) _theme-fg-on "${roles[on_urgent]}" "${roles[urgent]}" ' waiting ' ;;
            bg|bg_alt|surface|selection) _theme-fg-on "${roles[fg]}" "${roles[$role]}" ' body text ' ;;
            *) _theme-fg-on "${roles[$role]}" "${roles[bg]}" " $role on bg " ;;
        esac
        print
    done
    if (( ${#ansi} )); then
        printf '  ansi  '
        for i in {1..8}; do _theme-swatch-block "${ansi[i]}" '   '; done
        printf '\n        '
        for i in {9..16}; do _theme-swatch-block "${ansi[i]}" '   '; done
        print
    fi
}

# True when build $1 holds every template's output. A build made before a
# template was added (polybar.ini, say) is incomplete, and polybar can't
# start without its include.
_theme-build-complete() {
    _theme-build-ok "$1" || return 1
    local t
    for t in "$_THEME_TEMPLATES"/*.tmpl(N:t:r); do
        [[ -r "$_THEME_STATE/builds/$1/$t" ]] || return 1
    done
}

# True when state link $1 points at a complete build; REPLY = its id.
_theme-link-complete() {
    _theme-link-id "$1" && _theme-build-complete "$REPLY"
}

# REPLY = a complete build of build $1's theme: $1 itself, or, when it lacks
# an output, a fresh render of its source (same scheme; prefs and overrides
# as they are now). Returns 1, leaving everything as it was, when the source
# can't be rendered (its scheme file gone, say).
_theme-build-fresh() {
    local id=$1 ref wall
    _theme-build-complete "$id" && { REPLY=$id; return 0; }
    _theme-build-ok "$id" || { log-error "[theme] no build $id"; return 1; }
    _theme-spec-source "$_THEME_STATE/builds/$id/spec.json" || return 1
    ref=$REPLY
    local _THEME_OPT_MODE=${reply[1]} _THEME_OPT_VARIANT=${reply[2]} _THEME_OPT_CONTRAST=${reply[3]}
    wall=$(jq -r '.wallpaper // ""' "$_THEME_STATE/builds/$id/spec.json")
    [[ -n "$wall" ]] && _theme-wallpaper-image "$wall" || wall=
    log-warning "[theme] build $id lacks an output (made before a template existed); re-rendering $ref"
    _theme-build "$ref" "$wall" && return 0
    log-error "[theme] cannot re-render $id from '$ref'; nothing changed"
    return 1
}

theme-ensure() {
    local id t0=$EPOCHREALTIME
    _theme-paths
    _theme-link-dropins
    _theme-link-complete current && return 0
    _theme-lock || return 1
    _theme-link-complete current && return 0
    # Incomplete: apply re-renders the same theme so a new template doesn't
    # change it.
    if _theme-link-id current; then
        theme-apply "$REPLY" && return 0
    fi
    if _theme-link-complete known-good; then
        id=$REPLY
        _theme-link current "$id" || return 1
        _theme-history-push "$id" "$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")"
        _theme-ms-since $t0
        log-warning "[theme] current was missing; re-activated known-good $id in ${REPLY} ms"
        return 0
    fi
    if _theme-link-id known-good; then
        theme-apply "$REPLY" && return 0
    fi
    log-warning "[theme] no usable build; rendering the default"
    theme-apply default
}

theme-undo() {
    local id name line t0=$EPOCHREALTIME
    _theme-paths
    _theme-lock || return 1
    _theme-history-last || { log-error "[theme] no history"; return 1; }
    _theme-history-pop
    while _theme-history-last; do
        id=$REPLY
        _theme-build-ok "$id" && break
        log-warning "[theme] skipping pruned build $id"
        _theme-history-pop; id=
    done
    if [[ -z "$id" ]]; then
        log-error "[theme] nothing to undo to"
        # Put the current build back on the stack it was popped from.
        _theme-link-id current && _theme-history-push "$REPLY" "$(jq -r .name "$_THEME_STATE/current/spec.json")"
        return 1
    fi
    if ! _theme-build-fresh "$id"; then
        _theme-link-id current && _theme-history-push "$REPLY" "$(jq -r .name "$_THEME_STATE/current/spec.json")"
        return 1
    fi
    id=$REPLY
    line=$(tail -n 1 "$_THEME_STATE/history")
    name=${line#*$'\t'}
    _theme-history-pop
    _theme-activate "$id" "$name" || return 1
    _theme-ms-since $t0
    log-success "[theme] back to $name ($id) in ${REPLY} ms"
}

# theme wallpaper <image|name|number> [--keep-palette] [--mode m]
#                 [--variant v] [--contrast c] | restore
# By default the colours are generated from the image (matugen), so every
# target reloads. --keep-palette keeps the current build's colours and
# reloads only the wallpaper and the lock screen.
theme-wallpaper() {
    local _THEME_OPT_MODE= _THEME_OPT_VARIANT= _THEME_OPT_CONTRAST=
    local ref= a wall cur id name src palette=image t0=$EPOCHREALTIME
    local usage="[theme] usage: theme wallpaper <image|name|number> [--keep-palette] [--mode m] [--variant v] [--contrast c] | restore"
    local -a args=()
    for a; do
        case "$a" in
            -h|--help) theme-help; return 0 ;;
            --keep-palette) palette=keep ;;
            *) args+=("$a") ;;
        esac
    done
    _theme-opts "${args[@]}" || return 2
    for a in "${reply[@]}"; do
        [[ -z "$ref" ]] || { log-error "$usage"; return 2; }
        ref=$a
    done
    [[ -n "$ref" ]] || { log-error "$usage"; return 2; }
    _theme-paths
    [[ "$ref" == restore ]] && { _theme-wallpaper-restore; return; }

    # Found and checked before anything is locked or written.
    if ! _theme-wallpaper-find "$ref"; then
        log-error "[theme] no wallpaper '$ref': give an image path, or a name or number from: theme list wallpapers"
        return 1
    fi
    wall=$REPLY
    _theme-lock || return 1
    if [[ "$palette" == image ]]; then
        # Already this image's colours with the same knobs: only set it again.
        if _theme-link-complete current && _theme-matugen-knobs 2>/dev/null &&
           [[ "$(jq -r '[.wallpaper, .source.kind, .source.ref, .source.mode, .source.variant, (.source.contrast | tostring)] | join("\t")' \
                 "$_THEME_STATE/current/spec.json")" == "$wall"$'\t'image$'\t'"$wall"$'\t'"$_THEME_SRC_MODE"$'\t'"$_THEME_SRC_VARIANT"$'\t'"$_THEME_SRC_CONTRAST" ]]; then
            _theme-reload wallpaper || return 1
            log-success "[theme] wallpaper and colours are already ${wall/#$HOME/~}"
            return 0
        fi
        _theme-build "image:$wall" "$wall" || return 1
        id=$REPLY
        name=$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")
        _theme-activate "$id" "$name" || return 1
    elif _theme-link-complete current; then
        id=$REPLY
        cur=$(jq -r '.wallpaper // ""' "$_THEME_STATE/builds/$id/spec.json")
        name=$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")
        if [[ "$cur" == "$wall" ]]; then
            _theme-reload wallpaper || return 1
            log-success "[theme] wallpaper is already ${wall/#$HOME/~}"
            return 0
        fi
        # Same colours, so only the wallpaper and the lock screen reload.
        _theme-build-wallpaper "$id" "$wall" || return 1
        id=$REPLY
        _theme-activate "$id" "$name" wallpaper lockscreen || return 1
    else
        # No complete current build: render its theme (or the default) with
        # the wallpaper, and reload everything as apply would.
        if _theme-link-id current; then
            _theme-spec-source "$_THEME_STATE/current/spec.json"; src=$REPLY
            : ${_THEME_OPT_MODE:=${reply[1]}} ${_THEME_OPT_VARIANT:=${reply[2]}} ${_THEME_OPT_CONTRAST:=${reply[3]}}
        else
            _theme-default-scheme; src=$REPLY
        fi
        _theme-build "$src" "$wall" || return 1
        id=$REPLY
        name=$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")
        _theme-activate "$id" "$name" || return 1
    fi
    _theme-prune
    _theme-ms-since $t0
    log-success "[theme] wallpaper ${wall/#$HOME/~} ($name, $id) in ${REPLY} ms"
}

# REPLY = the mode new generated themes use: prefs mode (overrides merged),
# else dark.
_theme-pref-mode() {
    _theme-prefs '.mode // ""' && [[ "$REPLY" == (dark|light) ]] || REPLY=dark
}

# Merges jq filter $1 (with $v = $2) into overrides.json, atomically.
_theme-override() {
    local ov="$_THEME_STATE/overrides.json" cur='{}'
    mkdir -p "$_THEME_STATE" || return 1
    [[ -r "$ov" ]] && cur=$(<"$ov")
    print -r -- "$cur" | jq --arg v "$2" "$1" > "$ov.tmp" && mv -f -- "$ov.tmp" "$ov" ||
        { rm -f -- "$ov.tmp"; log-error "[theme] cannot write $ov"; return 1; }
}

# theme mode [dark|light|toggle]
theme-mode() {
    local want=${1:-} cur pref kind ref pair id name t0=$EPOCHREALTIME
    [[ "$want" == (-h|--help) ]] && { theme-help; return 0; }
    (( $# <= 1 )) && [[ "$want" == (|dark|light|toggle) ]] ||
        { log-error "[theme] usage: theme mode [dark|light|toggle]"; return 2; }
    _theme-paths
    _theme-pref-mode; pref=$REPLY
    cur=$pref
    _theme-source-current 2>/dev/null && cur=${THEME_META[mode]:-$pref}
    if [[ -z "$want" ]]; then
        print -r -- "$cur${${pref:#$cur}:+ (wallpapers and colours generate $pref)}"
        return 0
    fi
    [[ "$want" == toggle ]] && { [[ "$cur" == dark ]] && want=light || want=dark; }
    _theme-lock || return 1
    _theme-override '.mode = $v' "$want" || return 1
    if ! _theme-link-id current; then
        log-success "[theme] mode $want (no theme applied yet)"
        return 0
    fi
    _theme-spec-source "$_THEME_STATE/current/spec.json"
    ref=$REPLY
    kind=$(jq -r '.source.kind // "scheme"' "$_THEME_STATE/current/spec.json")
    if [[ "$kind" == scheme ]]; then
        if [[ "$cur" == "$want" ]]; then
            log-success "[theme] mode $want (${THEME_META[name]} already is)"
            return 0
        fi
        pair=${THEME_META[pair]:-}
        if [[ -z "$pair" ]] || ! _theme-scheme-file "$pair" 2>/dev/null; then
            log-warning "[theme] ${THEME_META[name]} has no $want twin (x-pair), so it stays; wallpapers and colours now generate $want"
            return 0
        fi
        theme-apply "$pair" || return 1
        return 0
    fi
    # A generated theme: the same source with its own variant and contrast,
    # in the new mode, keeping the wallpaper it has.
    local _THEME_OPT_MODE=$want _THEME_OPT_VARIANT=${reply[2]} _THEME_OPT_CONTRAST=${reply[3]}
    _theme-build "$ref" || return 1
    id=$REPLY
    name=$(jq -r .name "$_THEME_STATE/builds/$id/spec.json")
    _theme-activate "$id" "$name" || return 1
    _theme-prune
    _theme-ms-since $t0
    log-success "[theme] mode $want: $name ($id) in ${REPLY} ms"
}

# reply = the schemes whose variant is mode $1 (all when none match), by
# name.
_theme-schemes-of-mode() {
    local f v
    local -a all
    reply=()
    for f in "$_THEME_CONFIG"/schemes/*.y(a|)ml(N); do
        all+=("${f:t:r}")
        v=${${(M)${(f)"$(<"$f")"}:#variant:*}#variant: }
        [[ "${v//[\"\' ]/}" == "$1" ]] && reply+=("${f:t:r}")
    done
    (( ${#reply} )) || reply=("${all[@]}")
}

# _theme-walk <step> [wallpapers|schemes] [--keep-palette]: step 1 next, -1
# previous, 0 random. Wallpapers that aren't images are skipped; next and
# previous wrap; random never picks the current one. Schemes are those of
# the current mode (D9).
_theme-walk() {
    local -i step=$1 i n k
    shift
    local what=wallpapers a cur= mode
    local -a flags items
    for a; do
        case "$a" in
            -h|--help) theme-help; return 0 ;;
            wallpapers|wallpaper|w) what=wallpapers ;;
            schemes|scheme|s) what=schemes ;;
            --keep-palette) flags+=("$a") ;;
            *) log-error "[theme] usage: theme next|previous|random [wallpapers|schemes] [--keep-palette]"; return 2 ;;
        esac
    done
    _theme-paths
    if [[ "$what" == wallpapers ]]; then
        _theme-wallpaper-list
        for a in "${reply[@]}"; do _theme-wallpaper-image "$a" && items+=("$a"); done
        _theme-wallpaper-current; cur=$REPLY
    else
        (( ${#flags} )) && { log-error "[theme] --keep-palette is for wallpapers"; return 2; }
        _theme-pref-mode; mode=$REPLY
        if _theme-source-current 2>/dev/null; then
            mode=${THEME_META[mode]:-$mode}
            [[ "${THEME_META[source]}" == scheme:* ]] && cur=${THEME_META[name]}
        fi
        _theme-schemes-of-mode "$mode"; items=("${reply[@]}")
    fi
    n=${#items}
    (( n )) || { log-error "[theme] no $what to walk (theme list $what)"; return 1; }
    i=${items[(Ie)$cur]}
    if (( step == 0 )); then
        if (( n == 1 )); then k=1
        else
            k=$(( RANDOM % n + 1 ))
            (( k == i )) && k=$(( k % n + 1 ))
        fi
    elif (( i == 0 )); then
        (( step > 0 )) && k=1 || k=n
    else
        k=$(( (i - 1 + step + n) % n + 1 ))
    fi
    if [[ "$what" == wallpapers ]]; then
        theme-wallpaper "${items[k]}" "${flags[@]}"
    else
        theme-apply "${items[k]}"
    fi
}

theme-next()     { _theme-walk 1 "$@"; }
theme-previous() { _theme-walk -1 "$@"; }
theme-random()   { _theme-walk 0 "$@"; }

# Sets the recorded wallpaper again and refreshes the lock screen's cache if
# it was made from another one. Read-only on the theme (no lock, no build),
# so it is safe in the background at login.
_theme-wallpaper-restore() {
    _theme-wallpaper-current
    [[ -n "$REPLY" ]] || { log-error "[theme] no wallpaper recorded and no default ([wallpaper] default) in the dirs"; return 1; }
    local wall=$REPLY
    if ! _theme-live; then
        log-info "[theme] $_THEME_STATE isn't the live state; wallpaper ${wall/#$HOME/~} not set"
        return 0
    fi
    _theme-reload wallpaper lockscreen || return 1
    log-success "[theme] wallpaper ${wall/#$HOME/~}"
}

# Generated sources, with the matugen stub first on PATH (theme-self-test):
# the fixture's shape, colour and image sources, the cache, the knobs,
# mode, --keep-palette, hue anchoring, next/previous/random and failures.
# Called from _theme-self-test-run, whose ok/bad and counters it uses.
_theme-self-test-generated() {
    local scratch=$1 calls="$1/matugen-calls" fx=$THEME_SELFTEST_FIXTURE raw out id before k rc
    local w1="$scratch/walls/0001.png" w2="$scratch/walls/0002.png" w10="$scratch/walls/0010.png" wbeach="$scratch/pics/beach.png"
    local -i n
    local -a bl args
    print -r -- "  generated sources (matugen stub: $fx)"
    _theme-cache-dir
    [[ "$REPLY" == "$scratch/cache" && "$(whence -p matugen)" == "$scratch/mbin/matugen" ]] ||
        { bad "matugen stub or scratch cache not in place; generated sources not exercised"; return 0; }

    # The installed matugen gives what the fixture (captured from 4.2.0) has.
    if [[ -x "${THEME_SELFTEST_REAL_MATUGEN:-}" ]]; then
        out=$(PATH="${THEME_SELFTEST_REAL_MATUGEN:h}:$PATH" _THEME_SRC_VARIANT=scheme-tonal-spot _THEME_SRC_CONTRAST=0 \
              _theme-matugen-run "$scratch/real.json" color hex '#6750a4' 2>&1 && jq -c . "$scratch/real.json")
        [[ -n "$out" && "$out" == "$(_THEME_SRC_VARIANT=scheme-tonal-spot _THEME_SRC_CONTRAST=0 \
                 _theme-matugen-run "$scratch/stub.json" color hex '#6750a4' && jq -c . "$scratch/stub.json")" ]] &&
            ok "installed $("$THEME_SELFTEST_REAL_MATUGEN" --version) matches the 4.2 fixture for #6750a4 (every role, both modes)" ||
            bad "installed matugen differs from the 4.2 fixture: ${out[1,300]}"
        rm -f -- "$calls"
    else
        ok "matugen not installed: real-output check skipped (the stub covers the rest)"
    fi

    # colour: roles from the fixture's dark scheme; a full ANSI set.
    theme-apply colour:#6750a4 2>"$scratch/err"; rc=$?
    _theme-source-current
    [[ $rc == 0 && "${THEME_META[name]} ${THEME_META[source]} ${THEME_META[mode]}" == "colour:#6750a4 colour:#6750a4 dark" &&
       "${THEME_ROLE[bg]} ${THEME_ROLE[fg]} ${THEME_ROLE[accent]} ${THEME_ROLE[urgent]}" == \
       "$(jq -r '.colors | [.surface, .on_surface, .primary, .error] | map(.dark.color) | join(" ")' "$fx")" &&
       "${THEME_PALETTE[m3-primary]}" == "${THEME_ROLE[accent]}" ]] &&
        ok "apply colour:#6750a4: bg/fg/accent/urgent = surface/on_surface/primary/error (dark), m3-* names kept" ||
        bad "apply colour: rc $rc, ${THEME_META[name]} ${THEME_META[source]}, roles ${THEME_ROLE[bg]} ${THEME_ROLE[fg]} ${THEME_ROLE[accent]} ${THEME_ROLE[urgent]}: $(<"$scratch/err")"
    local -a weak=()
    local -F hue
    # THEME_ANSI is 1-based: [2] is ansi 1 (red), [3] green, [5] blue.
    local -A win=([2]='330 40' [3]='100 170' [5]='235 285')
    for k in {2..7} {10..15}; do
        colour-contrast "${THEME_ANSI[k]}" "${THEME_ROLE[bg]}"
        (( REPLY >= _THEME_MIN_ANSI )) || weak+=("ansi$(( k - 1 ))=${THEME_ANSI[k]}")
    done
    for k in 2 3 5; do
        colour-to-oklch "${THEME_ANSI[k]}"; hue=${reply[3]}
        _theme-hue-in $hue ${=win[$k]} || weak+=("ansi$(( k - 1 )) hue $hue")
    done
    (( ${#THEME_ANSI} == 16 && ! ${#weak} )) &&
        ok "colour source ANSI: 16 colours; 1-6 and 9-14 >= $_THEME_MIN_ANSI on bg; red, green and blue keep their hues" ||
        bad "colour source ANSI (${#THEME_ANSI}): ${weak[*]}"

    # The cache: the same colour and knobs never run matugen again.
    n=$(wc -l < "$calls")
    theme-apply colour:#6750a4 2>/dev/null
    theme-check '#6750A4' >/dev/null 2>&1
    (( $(wc -l < "$calls") == n )) && [[ "$(<"$calls")" == *"color hex #6750a4 -t scheme-tonal-spot --contrast 0 --json hex --dry-run"* ]] &&
        ok "colour cache hit: apply and check again (#6750A4 too) run matugen 0 more times; first run had -t scheme-tonal-spot --contrast 0 --json hex --dry-run" ||
        bad "colour cache: $n -> $(wc -l < "$calls") matugen runs: $(<"$calls")"
    theme-apply colour:#6750a4 --variant vibrant --contrast 0.5 2>/dev/null
    (( $(wc -l < "$calls") == n + 1 )) && [[ "$(tail -n 1 "$calls")" == *"-t scheme-vibrant --contrast 0.5 "* &&
       "$(jq -r '[.source.variant, .source.contrast] | join(" ")' "$_THEME_STATE/current/spec.json")" == "scheme-vibrant 0.5" ]] &&
        ok "--variant vibrant --contrast 0.5: a new matugen run, recorded in spec.source" ||
        bad "variant/contrast knobs: $(tail -n 1 "$calls")"
    rc=
    for args in "colour:#12345" "colour:#123456 --variant bogus" "colour:#123456 --contrast 3" "colour:#123456 --mode dusk"; do
        theme-apply ${=args} 2>/dev/null; rc+="$? "
    done
    theme-apply colour:#123456 --hue 3 2>/dev/null; rc+="$?"
    [[ "$rc" == "1 1 1 1 2" ]] && ok "bad colour, variant, contrast, mode and an unknown option fail before matugen runs" ||
        bad "bad generated inputs: exit codes $rc"

    # image: theme wallpaper generates the colours; a 512px thumbnail; the
    # cache is keyed by content, so an identical file under another name hits.
    _theme-link-id current; before=$REPLY
    n=$(wc -l < "$calls")
    theme-wallpaper 2 2>"$scratch/err"; rc=$?
    _theme-source-current
    local sha=${"$(sha256sum "$w2")"%% *}
    [[ $rc == 0 && "${THEME_META[source]}" == "image:$w2" && "${THEME_META[wallpaper]}" == "$w2" &&
       "${THEME_META[name]}" == image:0002 && -s "$scratch/cache/thumbs/$sha.png" &&
       -s "$scratch/cache/sources/$sha-tonal-spot-0.json" && "$(tail -n 1 "$calls")" == *" image $scratch/cache/thumbs/$sha.png --source-color-index 0 "* ]] &&
        ok "wallpaper 2: colours from the image (image:0002), thumbs/<sha256>.png, sources/<sha256>-tonal-spot-0.json" ||
        bad "wallpaper 2 with palette: rc $rc, ${THEME_META[source]}, $(tail -n 1 "$calls"): $(<"$scratch/err")"
    theme-wallpaper 10 2>/dev/null; theme-wallpaper 2 2>/dev/null
    _theme-source-current
    (( $(wc -l < "$calls") == n + 1 )) && [[ "${THEME_META[source]}" == "image:$w2" ]] &&
        ok "image cache hit: 0010 (same pixels as 0002) and 0002 again run matugen 0 more times" ||
        bad "image cache: $n -> $(wc -l < "$calls") runs"
    theme-wallpaper 2 2>/dev/null
    (( $(wc -l < "$calls") == n + 1 )) && ok "wallpaper 2 again with its own colours: nothing rebuilt" || bad "wallpaper 2 again re-ran matugen"
    theme-wallpaper beach 2>/dev/null
    (( $(wc -l < "$calls") == n + 2 )) && ok "beach (other pixels): one new matugen run" || bad "beach: $(wc -l < "$calls") runs"

    # --keep-palette over an image build: same colours and source.
    local roles=$(jq -c '[.roles, .source]' "$_THEME_STATE/current/spec.json")
    theme-wallpaper 1 --keep-palette 2>/dev/null
    [[ "$(jq -c '[.roles, .source]' "$_THEME_STATE/current/spec.json")" == "$roles" && "$(theme-get wallpaper)" == "$w1" ]] &&
        ok "wallpaper 1 --keep-palette: beach's colours and source kept, wallpaper 0001" ||
        bad "--keep-palette over an image build: $(jq -c .source "$_THEME_STATE/current/spec.json")"

    # mode: overrides.json, the light scheme, the wallpaper kept; toggle back.
    theme-mode light 2>/dev/null
    _theme-source-current
    [[ "${THEME_META[mode]} ${THEME_ROLE[bg]}" == "light $(jq -r .colors.surface.light.color "$fx")" &&
       "$(jq -r .mode "$_THEME_STATE/overrides.json")" == light && "${THEME_META[wallpaper]}" == "$w1" &&
       "${THEME_META[source]}" == "image:$wbeach" && "$(theme-mode)" == light ]] &&
        ok "mode light: beach regenerated light (bg = light surface), wallpaper 0001 kept, overrides.json mode light" ||
        bad "mode light: ${THEME_META[mode]} bg ${THEME_ROLE[bg]} wallpaper ${THEME_META[wallpaper]}"
    theme-apply colour:#6750a4 2>/dev/null
    [[ "$(theme-get mode)" == light ]] && ok "a new colour source follows the mode preference (light)" ||
        bad "colour after mode light: $(theme-get mode)"
    theme-mode toggle 2>/dev/null
    [[ "$(theme-get mode)" == dark ]] && ok "mode toggle: back to dark" || bad "mode toggle: $(theme-get mode)"
    theme-apply catppuccin-mocha 2>/dev/null; theme-mode light 2>/dev/null
    [[ "$(theme-get name)" == catppuccin-latte ]] && ok "mode light on catppuccin-mocha follows x-pair to catppuccin-latte" ||
        bad "mode light on mocha: $(theme-get name)"
    theme-apply nord 2>/dev/null; theme-mode light 2>/dev/null; rc=$?
    [[ $rc == 0 && "$(theme-get name)" == nord ]] && ok "mode light on nord (no x-pair): nord stays" || bad "mode light on nord: rc $rc $(theme-get name)"
    theme-mode purple 2>/dev/null; rc=$?
    (( rc == 2 )) && ok "mode purple: usage error" || bad "mode purple: rc $rc"
    rm -f -- "$_THEME_STATE/overrides.json"

    # Hue anchoring: a scheme whose red is blue, orange grey and green pink.
    sed -e 's/^  base08: .*/  base08: "#5c7cfa"/' -e 's/^  base09: .*/  base09: "#8a8a8a"/' \
        -e 's/^  base0B: .*/  base0B: "#f06595"/' -e '/^slug:/d' "$_THEME_CONFIG/schemes/catppuccin-mocha.yaml" > "$scratch/off-hue.yaml"
    theme-check "$scratch/off-hue.yaml" > "$scratch/check" 2>&1; rc=$?
    _theme-load-source "$scratch/off-hue.yaml" && _theme-resolve
    local -a bad_hue=()
    for k in urgent busy ok; do
        colour-to-oklch "${_THEME_ROLE[$k]}"
        _theme-hue-in ${reply[3]} ${=_THEME_HUE_WINDOW[$k]} || bad_hue+=("$k ${_THEME_ROLE[$k]} ${reply[3]}")
    done
    [[ $rc == 0 && "${_THEME_ANCHORED[*]}" == "urgent busy ok" && ${#bad_hue} -eq 0 ]] &&
       grep -q 'anchored: urgent, busy, ok' "$scratch/check" && grep -q 'busy: #8a8a8a is too grey' "$scratch/check" &&
        ok "anchoring: blue urgent, grey busy, pink ok -> red ${_THEME_ROLE[urgent]}, orange ${_THEME_ROLE[busy]}, green ${_THEME_ROLE[ok]} (in their windows, noted)" ||
        bad "anchoring: rc $rc anchored '${_THEME_ANCHORED[*]}' ${bad_hue[*]}"
    _theme-load-source catppuccin-mocha && _theme-resolve
    (( ! ${#_THEME_ANCHORED} )) && ok "anchoring leaves catppuccin-mocha alone" || bad "mocha anchored: ${_THEME_ANCHORED[*]}"

    # next/previous/random over the images (fake.png skipped), with wrap;
    # schemes of the current mode.
    theme-wallpaper 10 --keep-palette 2>/dev/null
    local walk=
    theme-next --keep-palette 2>/dev/null;     walk+="${$(theme-get wallpaper):t:r} "
    theme-next --keep-palette 2>/dev/null;     walk+="${$(theme-get wallpaper):t:r} "
    theme-previous --keep-palette 2>/dev/null; walk+="${$(theme-get wallpaper):t:r} "
    theme-previous --keep-palette 2>/dev/null; walk+="${$(theme-get wallpaper):t:r}"
    [[ "$walk" == "beach 0001 beach 0010" ]] && ok "next/previous wallpapers from 0010: beach, 0001 (wrapped past fake.png), beach, 0010" ||
        bad "wallpaper walk: $walk"
    theme-next 2>/dev/null
    [[ "$(theme-get source)" == "image:$wbeach" ]] && ok "next without --keep-palette: beach with its own colours" ||
        bad "next with palette: $(theme-get source)"
    local seen=
    for k in 1 2 3 4 5 6; do
        before=$(theme-get wallpaper)
        theme-random --keep-palette 2>/dev/null
        [[ "$(theme-get wallpaper)" == "$before" ]] && seen+="repeat "
    done
    [[ -z "$seen" ]] && ok "random: never the current wallpaper (6 tries)" || bad "random repeated: $seen"
    theme-apply catppuccin-mocha 2>/dev/null
    walk=
    theme-next schemes 2>/dev/null;     walk+="$(theme-get name) "
    theme-apply tokyo-night 2>/dev/null
    theme-next schemes 2>/dev/null;     walk+="$(theme-get name) "
    theme-previous schemes 2>/dev/null; walk+="$(theme-get name) "
    theme-apply gruvbox-light 2>/dev/null
    theme-next schemes 2>/dev/null;     walk+="$(theme-get name)"
    [[ "$walk" == "dracula catppuccin-frappe tokyo-night rose-pine-dawn" ]] &&
        ok "next/previous schemes keep to the mode: mocha -> dracula, tokyo-night -> frappe (wrap) -> tokyo-night; gruvbox-light -> rose-pine-dawn" ||
        bad "scheme walk: $walk"
    theme-next schemes --keep-palette 2>/dev/null; rc=$?
    theme-next sideways 2>/dev/null; rc+=" $?"
    [[ "$rc" == "2 2" ]] && ok "next schemes --keep-palette and next sideways: usage errors" || bad "walk usage: $rc"

    # matugen failing or missing: nothing is swapped in.
    _theme-link-id current; before=$REPLY
    bl=("$_THEME_STATE"/builds/*(N/)); n=${#bl}
    THEME_SELFTEST_MATUGEN_FAIL=1 theme-apply colour:#abcdef 2>"$scratch/err"; rc=$?
    THEME_MATUGEN="$scratch/none/matugen" theme-apply colour:#fedcba 2>>"$scratch/err"; rc+=" $?"
    _theme-link-id current
    bl=("$_THEME_STATE"/builds/*(N/))
    [[ "$rc" == "1 1" && "$REPLY" == "$before" && ${#bl} -eq $n ]] && grep -q 'matugen failed: stub failure' "$scratch/err" &&
       grep -q "matugen isn't installed" "$scratch/err" &&
        ok "matugen failing, or not installed: apply fails with a message, current unchanged" ||
        bad "matugen failure: rc $rc, current $REPLY (was $before): $(<"$scratch/err")"

    # A generated build missing an output is re-rendered from its source,
    # with its mode and knobs, on apply <id>.
    theme-apply colour:#6750a4 --mode light --variant vibrant 2>/dev/null
    _theme-link-id current; id=$REPLY
    rm -f -- "$_THEME_STATE/builds/$id/polybar.ini"
    theme-apply nord 2>/dev/null; theme-apply "$id" 2>/dev/null
    _theme-source-current
    [[ "$(jq -r '[.source.kind, .source.ref, .mode, .source.variant] | join(" ")' "$_THEME_STATE/current/spec.json")" == "colour #6750a4 light scheme-vibrant" &&
       "${THEME_META[id]}" != "$id" && -r "$_THEME_STATE/current/polybar.ini" ]] &&
        ok "apply <id> of an incomplete colour build re-renders it as colour #6750a4, light, vibrant" ||
        bad "re-render of a generated build: $(jq -c .source "$_THEME_STATE/current/spec.json")"
}

# Commands self-test shadows with logging guard stubs for its whole run.
declare -gr _THEME_SELFTEST_GUARDED='betterlockscreen feh polybar-msg bspc coord dunstctl xrdb gsettings xsettingsd'

# Renders every scheme into a scratch state dir under ~/.cache and checks the
# swap, undo, rollback and known-good behaviour. The real state is untouched.
theme-self-test() {
    local base="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
    mkdir -p "$base" || return 1
    local scratch f
    scratch=$(mktemp -d "$base/self-test.XXXXXX") || return 1
    # Wallpaper dirs of 1x1 PNGs, so no test depends on (or sets) a real
    # image: 0002 in both dirs (the first wins), fake.png isn't an image.
    mkdir -p "$scratch/walls" "$scratch/pics" || return 1
    for f in walls/0001.png walls/0002.png walls/0010.png pics/0002.png pics/beach.png; do
        print -rn -- 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==' |
            base64 -d > "$scratch/$f" || return 1
    done
    # beach.png has other pixels, so it has its own matugen cache entry.
    print -rn -- 'iVBORw0KGgoAAAANSUhEUgAAAAIAAAABAQMAAADO7O3JAAAAA1BMVEXAOSuU7d9gAAAACklEQVQI12NgAAAAAgAB4iG8MwAAAABJRU5ErkJggg==' |
        base64 -d > "$scratch/pics/beach.png" || return 1
    print -r -- 'not an image' > "$scratch/pics/fake.png"
    # matugen is a stub that logs its arguments and prints a captured 4.2
    # result (tests/), so no test depends on the installed version or an
    # image; the real one, if any, is checked against the same fixture.
    _theme-paths
    local fixture="$_THEME_CONFIG/tests/matugen-4.2-color-6750a4.json"
    mkdir -p "$scratch/mbin" || return 1
    print -rl -- '#!/bin/sh' "printf '%s\\n' \"\$*\" >> '$scratch/matugen-calls'" \
        '[ -n "$THEME_SELFTEST_MATUGEN_FAIL" ] && { echo "stub failure" >&2; exit 1; }' \
        "cat '$fixture'" > "$scratch/mbin/matugen" && chmod +x "$scratch/mbin/matugen" || return 1
    # Every command that reaches the running desktop is a guard stub that
    # only logs to $scratch/escaped-calls, so no test (in any environment,
    # whatever the caller's PATH) can run the real one; the tests that
    # exercise a reloader put their own stubs in front.
    mkdir -p "$scratch/guard" || return 1
    for f in $_THEME_SELFTEST_GUARDED; do
        print -rl -- '#!/bin/sh' "echo \"$f \$*\" >> '$scratch/escaped-calls'" > "$scratch/guard/$f" &&
            chmod +x "$scratch/guard/$f" || return 1
    done
    # THEME_CONFIG_DIR is pinned to this config: the reloader tests point
    # XDG_CONFIG_HOME at a scratch dir, which would otherwise move the
    # schemes and templates out from under them.
    ( XDG_STATE_HOME="$scratch/state" THEME_STATE_DIR="$scratch/state/theme" THEME_CACHE_DIR="$scratch/cache" \
      THEME_CONFIG_DIR="$_THEME_CONFIG" \
      THEME_SELFTEST_REAL_MATUGEN="$(whence -p matugen)" THEME_SELFTEST_FIXTURE="$fixture" \
      THEME_WALLPAPER_DIRS="$scratch/walls:$scratch/pics:$scratch/missing" _theme-self-test-run "$scratch" )
    local rc=$?
    if [[ -n "${THEME_SELF_TEST_KEEP:-}" ]]; then print -r -- "scratch kept: $scratch"
    else rm -rf -- "$scratch"; fi
    return $rc
}

_theme-self-test-run() {
    local scratch=$1 f slug id before after t0 kg
    local -i pass=0 failed=0
    local -a schemes
    ok()  { print -r -- "  ✓ $*"; (( pass++ )) || true; }
    bad() { print -r -- "  ✗ $*"; (( failed++ )) || true; }
    # A minimal system PATH behind the stubs, so a dir the caller put first
    # can't shadow them; the guards must win before anything runs.
    path=("$scratch/mbin" "$scratch/guard" /usr/local/bin /usr/bin /bin)
    hash -r
    _theme-paths
    print -r -- "theme self-test (state: $_THEME_STATE)"
    for f in $_THEME_SELFTEST_GUARDED; do
        [[ "$(whence -w $f)" == "$f: command" && "$(whence -p $f)" == "$scratch/guard/$f" ]] ||
            { bad "desktop command $f resolves to $(whence -v $f), not the guard stub; aborting"; return 1; }
    done
    ok "desktop commands (${_THEME_SELFTEST_GUARDED// /, }) resolve to guard stubs"

    schemes=("$_THEME_CONFIG"/schemes/*.y(a|)ml(N:t:r))
    (( ${#schemes} )) && ok "${#schemes} schemes found" || bad "no schemes in $_THEME_CONFIG/schemes"

    print -r -- "  per scheme: apply time, contrast level, roles adjusted"
    for slug in "${schemes[@]}"; do
        t0=$EPOCHREALTIME
        if theme-apply "$slug" 2>"$scratch/err"; then
            _theme-ms-since $t0
            _theme-source-current
            printf '    %-22s %4d ms  %-3s%s  adjusted: %s\n' "$slug" $REPLY "${THEME_META[contrast]}" \
                "${${THEME_META[degraded]:#false}:+ (AA DEGRADATION)}" "${THEME_META[adjusted]:-none}"
            (( pass++ )) || true
        else
            bad "$slug: $(<"$scratch/err")"
        fi
    done

    theme-apply catppuccin-mocha 2>/dev/null
    [[ "$(theme-get accent)" == '#b4befe' ]] && ok "catppuccin-mocha accent is #b4befe (lavender, D3)" ||
        bad "catppuccin-mocha accent is $(theme-get accent)"
    local role drift=
    _theme-source-current
    for role in "${_THEME_ROLES[@]}"; do
        [[ "${THEME_ROLE[$role]}" == "${_THEME_FALLBACK[$role]}" ]] || drift+=" $role=${THEME_ROLE[$role]}"
    done
    for role in ${(k)_THEME_FALLBACK}; do
        (( ${_THEME_ROLES[(Ie)$role]} )) && continue
        [[ "${THEME_METRIC[$role]:-}" == "${_THEME_FALLBACK[$role]}" ]] || drift+=" $role=${THEME_METRIC[$role]:-}"
    done
    [[ -z "$drift" ]] && ok "fallback table matches resolved catppuccin-mocha" || bad "fallback drift:$drift"
    local -A strip=()
    theme-roles strip waiting=urgent ink=on_urgent gap=cell_gap 2>/dev/null
    [[ "${strip[waiting]} ${strip[ink]} ${strip[gap]}" == "#f38ba8 #11111b 8" ]] &&
        ok "roles: waiting=urgent ink=on_urgent gap=cell_gap fill an assoc (#f38ba8 #11111b 8)" ||
        bad "roles: ${(kv)strip}"
    strip=()
    ( THEME_STATE_DIR="$scratch/none" theme-roles strip shown=accent 2>/dev/null && print -r -- "${strip[shown]}" ) |
        read -r role
    [[ "$role" == "${_THEME_FALLBACK[accent]}" ]] && ok "roles: no state falls back to ${_THEME_FALLBACK[accent]}" ||
        bad "roles with no state gave '$role'"
    [[ "${THEME_SIZE[terminal]} ${THEME_SIZE[menu]} ${THEME_SIZE[bar]} ${THEME_METRIC[gap]} ${THEME_METRIC[bar_height]}" == "16.25 13.75 12.5 5 50" ]] &&
        ok "sizes: terminal 16.25, menu 13.75, bar 12.5; gap 5 and bar_height 50 unscaled" ||
        bad "sizes: ${(kv)THEME_SIZE} gap ${THEME_METRIC[gap]} bar_height ${THEME_METRIC[bar_height]}"

    # Under the default the consumers must look as their static fallbacks do.
    local cur="$_THEME_STATE/current"
    grep -q '^    font: *"Source Code Pro for Powerline 14";' "$cur/rofi.rasi" &&
       grep -q '^    radius: *8px;' "$cur/rofi.rasi" && grep -q '^    border-color: *#45475a;' "$cur/rofi.rasi" &&
       grep -q '^size = 16.0$' "$cur/alacritty.toml" && grep -q '^black = "#45475a"$' "$cur/alacritty.toml" &&
        ok "catppuccin-mocha: rofi 14pt, radius 8px, border #45475a; alacritty 16pt, black #45475a" ||
        bad "catppuccin-mocha rofi.rasi/alacritty.toml differ from the static fallbacks"
    # The bar stays 50px with base00 behind it; text 10 and icons 13 x 1.25.
    grep -qx 'bg = #1e1e2e' "$cur/polybar.ini" && grep -qx 'bg-alt = #313244' "$cur/polybar.ini" &&
       grep -qx 'fg = #cdd6f4' "$cur/polybar.ini" && grep -qx 'height = 50' "$cur/polybar.ini" &&
       grep -qx 'line-size = 2' "$cur/polybar.ini" &&
       grep -q '^font-text = "Roboto Mono for Powerline:size=12.5:' "$cur/polybar.ini" &&
       grep -q '^font-icon = "Symbols Nerd Font Mono:style=2048-em:size=16.25;' "$cur/polybar.ini" &&
       grep -q '^font-spacer = .*:size=50;' "$cur/polybar.ini" &&
        ok "catppuccin-mocha polybar.ini: bg #1e1e2e, bg-alt #313244, height 50, text 12.5pt, icons 16.25pt" ||
        bad "catppuccin-mocha polybar.ini: $(grep -E '^(bg|bg-alt|fg|height|font-text|font-icon) ' "$cur/polybar.ini" | tr '\n' ' ')"

    # bspwm, dunst and X resources: today's sizes (border 1, gap 5, bottom
    # padding 32 under the 50px bar, D15), Mocha colours, cursor 24 x 1.25.
    grep -qx '\[\[ "$(bspc config border_width)" == 1 \]\] || bspc config border_width 1' "$cur/bspwm.sh" &&
       grep -qx '\[\[ "$(bspc config window_gap)" == 5 \]\] || bspc config window_gap 5' "$cur/bspwm.sh" &&
       grep -qx '\[\[ "$(bspc config bottom_padding)" == 32 \]\] || bspc config bottom_padding 32' "$cur/bspwm.sh" &&
       grep -qx "bspc config focused_border_color '#b4befe'" "$cur/bspwm.sh" &&
       grep -qx "bspc config normal_border_color '#313244'" "$cur/bspwm.sh" &&
        ok "catppuccin-mocha bspwm.sh: border 1, gap 5, bottom_padding 32; focused #b4befe, normal #313244" ||
        bad "catppuccin-mocha bspwm.sh: $(grep -v '^#' "$cur/bspwm.sh" | tr '\n' ' ')"
    grep -qx '    font = Source Code Pro for Powerline Medium 12.5' "$cur/dunst.conf" &&
       grep -qx '    corner_radius = 8' "$cur/dunst.conf" && grep -qx '    frame_color = "#f38ba8"' "$cur/dunst.conf" &&
       grep -qx '*.color0: #45475a' "$cur/xresources" && grep -qx '*.color15: #a6adc8' "$cur/xresources" &&
       grep -qx 'Xcursor.theme: Adwaita' "$cur/xresources" && grep -qx 'Xcursor.size: 30' "$cur/xresources" &&
        ok "catppuccin-mocha dunst.conf 12.5pt, radius 8, critical #f38ba8; xresources color0 #45475a, Adwaita 30" ||
        bad "catppuccin-mocha dunst.conf/xresources: $(grep -E 'font|radius|color0:|Xcursor' "$cur/dunst.conf" "$cur/xresources" | tr '\n' ' ')"

    # The desktop reloaders: a scratch state never reaches bspc, dunstctl,
    # xrdb or coord. Then, with every command stubbed and the live check
    # forced, each makes the right calls. In a subshell, so no stub or
    # forced check outlives it.
    (
        local calls="$scratch/desktop-calls" out c
        pass=0 failed=0
        trap 'print -r -- "$pass $failed" >| "$scratch/desktop-counts"' EXIT
        bspc()     { print -r -- "bspc $*" >> "$calls"; [[ "$1 $#" == "config 2" ]] && print -r -- "${_st_bspc:-0}"; return 0; }
        coord()    { print -r -- "coord $*" >> "$calls"; (( $# == 1 )) && print -r -- left; return 0; }
        dunstctl() { print -r -- "dunstctl $*" >> "$calls"; }
        xrdb()     { print -r -- "xrdb $*" >> "$calls"; }
        pgrep()    { return 0; }
        timeout()  { shift; "$@"; }
        DISPLAY=:theme-self-test XDG_CONFIG_HOME="$scratch/config"
        mkdir -p "$scratch/config/dunst"
        _theme-reload-bspwm; _theme-reload-dunst; _theme-reload-xresources
        [[ ! -e "$calls" && ! -e "$scratch/config/$_THEME_DUNST_DROPIN" ]] &&
            ok "bspwm, dunst and xresources reloads skipped for a scratch state dir" ||
            bad "a scratch state reached the desktop: $(cat "$calls" 2>/dev/null)"
        for c in bspc coord dunstctl xrdb pgrep timeout; do
            [[ "$(whence -w $c)" == "$c: function" ]] ||
                { bad "stub for $c not in place; live reloaders not exercised"; exit; }
        done
        _theme-live() { return 0; }
        _theme-reload-bspwm
        out=$(<"$calls")
        [[ "$out" == *"bspc config border_width 1"* && "$out" == *"bspc config window_gap 5"* &&
           "$out" == *"bspc config bottom_padding 32"* && "$out" == *"bspc config focused_border_color #b4befe"* &&
           "$out" == *"bspc config presel_feedback_color #6c7086"* && "${${(f)out}[-1]}" == "coord side left" ]] &&
            ok "bspwm reload: sizes and colours from bspwm.sh, then coord side left (re-dock)" ||
            bad "bspwm reload calls: ${(f)out}"
        : >| "$calls"
        _st_bspc=5 _theme-reload-bspwm >/dev/null
        out=$(<"$calls")
        [[ "$out" == *"bspc config window_gap"$'\n'* && "$out" != *"bspc config window_gap 5"* ]] &&
            ok "bspwm reload: an unchanged size isn't re-set (no reset of per-node values)" ||
            bad "bspwm reload re-set an unchanged gap: ${(f)out}"
        : >| "$calls"
        _theme-reload-dunst && _theme-reload-xresources
        out=$(<"$calls")
        [[ "$(readlink "$scratch/config/$_THEME_DUNST_DROPIN")" == "$_THEME_STATE/current/dunst.conf" &&
           "$out" == "dunstctl reload"$'\n'"xrdb -nocpp -merge $_THEME_STATE/current/xresources" ]] &&
            ok "dunst reload links dunstrc.d/90-theme.conf -> current/dunst.conf and runs dunstctl reload; xrdb -nocpp -merge" ||
            bad "dunst/xresources reload: link $(readlink "$scratch/config/$_THEME_DUNST_DROPIN"), calls ${(f)out}"
    )
    local -a counts=(${=$(<"$scratch/desktop-counts")})
    (( pass += counts[1], failed += counts[2] )) || true

    # The dunst and xresources validators catch what their apps would
    # silently ignore.
    print -rl -- '[global]' '    font = x 12' '[urgency_critical]' '    frame_color = #f38ba8' > "$scratch/bad.conf"
    print -rl -- '*.color0: #000000' 'Xcursor.theme: Adwaita' 'Xcursor.size: 30' > "$scratch/bad.xresources"
    ! _theme-validate-dunst "$scratch/bad.conf" >/dev/null &&
       ! _theme-validate-xresources "$scratch/bad.xresources" >/dev/null &&
       _theme-validate-dunst "$cur/dunst.conf" && _theme-validate-xresources "$cur/xresources" &&
        ok "validators: unquoted dunst colour and missing *.color1-15 fail; Mocha's pass" ||
        bad "dunst/xresources validators"

    # Wallpaper: every build records one, apply keeps it, `theme wallpaper`
    # changes only it. The lock screen fragment comes from the roles.
    local w1="$scratch/walls/0001.png" w2="$scratch/walls/0002.png" w10="$scratch/walls/0010.png"
    local wbeach="$scratch/pics/beach.png" roles_before wb
    [[ "$(theme-get wallpaper)" == "$w1" ]] &&
        ok "wallpaper: a fresh state records the default, 0001 from the first dir" ||
        bad "wallpaper after the scheme loop: $(theme-get wallpaper)"
    grep -qx 'ringcolor=b4befeff' "$cur/betterlockscreen.sh" && grep -qx 'insidecolor=1e1e2e80' "$cur/betterlockscreen.sh" &&
       grep -qx 'ringwrongcolor=f38ba8ff' "$cur/betterlockscreen.sh" && grep -qx 'ringvercolor=94e2d5ff' "$cur/betterlockscreen.sh" &&
       grep -qx 'timecolor=cdd6f4ff' "$cur/betterlockscreen.sh" &&
       grep -qx "font='Roboto Mono for Powerline'" "$cur/betterlockscreen.sh" && bash -n "$cur/betterlockscreen.sh" &&
        ok "catppuccin-mocha betterlockscreen.sh: ring #b4befe, inside #1e1e2e 50%, verify #94e2d5, wrong #f38ba8, text #cdd6f4, Roboto Mono; bash -n" ||
        bad "catppuccin-mocha betterlockscreen.sh: $(grep -v '^#' "$cur/betterlockscreen.sh" | tr '\n' ' ')"
    print -rl -- 'font=x' 'ringcolor=#b4befe' > "$scratch/betterlockscreen.sh"
    ! _theme-validate-betterlockscreen "$scratch/betterlockscreen.sh" >/dev/null &&
       _theme-validate-betterlockscreen "$cur/betterlockscreen.sh" &&
        ok "validator: a #-prefixed lock colour and missing keys fail; Mocha's passes" ||
        bad "betterlockscreen.sh validator"
    roles_before=$(jq -c '[.roles, .palette, .font, .metrics, .name]' "$cur/spec.json")
    _theme-link-id current; before=$REPLY
    theme-wallpaper 2 --keep-palette 2>/dev/null
    _theme-link-id current
    [[ "$REPLY" != "$before" && "$(theme-get wallpaper)" == "$w2" &&
       "$(jq -c '[.roles, .palette, .font, .metrics, .name]' "$cur/spec.json")" == "$roles_before" &&
       "$(jq -r .wallpaper "$_THEME_STATE/builds/$before/spec.json")" == "$w1" ]] &&
        ok "wallpaper 2 --keep-palette: a new build with walls/0002.png (first dir over pics/), colours, sizes and name unchanged" ||
        bad "wallpaper 2: current $REPLY (was $before), wallpaper $(theme-get wallpaper)"
    grep -qx 'ringcolor=b4befeff' "$cur/betterlockscreen.sh" && grep -qxF "    [wallpaper]='$w2'" "$cur/theme.zsh" &&
        ok "wallpaper 2: betterlockscreen.sh unchanged, theme.zsh THEME_META[wallpaper] updated" ||
        bad "wallpaper 2 outputs: $(grep wallpaper "$cur/theme.zsh")"
    theme-apply nord 2>/dev/null
    [[ "$(theme-get wallpaper)" == "$w2" && "$(jq -r .name "$cur/spec.json")" == nord ]] &&
        ok "apply nord keeps the wallpaper (0002)" || bad "apply nord: wallpaper $(theme-get wallpaper)"
    theme-wallpaper beach --keep-palette 2>/dev/null; wb=$(theme-get wallpaper)
    theme-wallpaper 0010.png --keep-palette 2>/dev/null
    [[ "$wb" == "$wbeach" && "$(theme-get wallpaper)" == "$w10" ]] &&
        ok "wallpaper by name from the second dir (beach) and by file name (0010.png)" ||
        bad "wallpaper beach -> $wb, 0010.png -> $(theme-get wallpaper)"
    theme-wallpaper "$w1" --keep-palette 2>/dev/null && [[ "$(theme-get wallpaper)" == "$w1" ]] &&
        ok "wallpaper by absolute path" || bad "wallpaper by path: $(theme-get wallpaper)"
    _theme-link-id current; before=$REPLY
    bl=("$_THEME_STATE"/builds/*(N/)); nb=${#bl}
    local wbad wrc= 
    for wbad in nope fake 99 "$scratch/none.png" "$scratch/pics" /etc/hostname; do
        theme-wallpaper "$wbad" 2>/dev/null; wrc+="$? "
    done
    theme-wallpaper 2 --palette 2>/dev/null; wrc+="$? "
    theme-wallpaper 2>/dev/null; wrc+="$?"
    _theme-link-id current
    bl=("$_THEME_STATE"/builds/*(N/))
    [[ "$wrc" == "1 1 1 1 1 1 2 2" && "$REPLY" == "$before" && ${#bl} -eq $nb && "$(theme-get wallpaper)" == "$w1" ]] &&
        ok "bad wallpapers (unknown name or number, not an image, missing, a dir, bad option) fail; current unchanged" ||
        bad "bad wallpapers: exit codes $wrc, current $REPLY (was $before), builds $nb->${#bl}"
    theme-undo 2>/dev/null
    [[ "$(theme-get wallpaper)" == "$w10" ]] && ok "undo brings back the previous wallpaper (0010)" ||
        bad "undo: wallpaper $(theme-get wallpaper)"
    local -a wl=("${(@f)$(theme-list wallpapers)}")
    [[ ${#wl} -eq 5 && "${wl[(r)\* 0010*]}" == *"${w10/#$HOME/~}" && -z "${(@M)wl:#*pics/0002.png}" ]] &&
        ok "list wallpapers: 5 (pics/0002 shadowed by walls/0002), * on 0010" ||
        bad "list wallpapers: ${(j:|:)wl}"
    theme-wallpaper restore >/dev/null 2>&1 && ok "wallpaper restore in a scratch state: succeeds, sets nothing" ||
        bad "wallpaper restore in a scratch state failed"

    # The wallpaper and lockscreen reloaders: skipped for a scratch state;
    # forced live, with feh and betterlockscreen stubbed first on PATH (nice
    # and ionice exec them) and every other desktop command stubbed, feh
    # sets the wallpaper and betterlockscreen -u runs once per new wallpaper.
    # The subshell takes the theme lock, so this process lets go of it.
    _theme-unlock
    (
        local calls="$scratch/wall-calls" bin="$scratch/bin" w out c
        local -i i
        pass=0 failed=0
        trap 'print -r -- "$pass $failed" >| "$scratch/wall-counts"' EXIT
        mkdir -p "$bin"
        for c in feh betterlockscreen; do
            print -rl -- '#!/bin/sh' "echo \"$c \$*\" >> '$calls'" > "$bin/$c" && chmod +x "$bin/$c"
        done
        path=("$bin" $path)
        for c in bspc coord dunstctl xrdb polybar-msg; do functions[$c]="print -r -- \"$c \$*\" >> ${(q)calls}"; done
        pgrep()   { return 1; }
        timeout() { shift; "$@"; }
        [[ "$(whence -p feh) $(whence -p betterlockscreen)" == "$bin/feh $bin/betterlockscreen" ]] ||
            { bad "feh/betterlockscreen stubs not first on PATH; live reloaders not exercised"; exit; }
        for c in bspc coord dunstctl xrdb polybar-msg pgrep timeout; do
            [[ "$(whence -w $c)" == "$c: function" ]] ||
                { bad "stub for $c not in place; live reloaders not exercised"; exit; }
        done
        DISPLAY=:theme-self-test XDG_CONFIG_HOME="$scratch/config"
        _theme-reload wallpaper lockscreen
        sleep 0.2
        [[ ! -e "$calls" ]] && ok "wallpaper and lockscreen reloads skipped for a scratch state dir" ||
            bad "a scratch state reached feh/betterlockscreen: $(<"$calls")"
        _theme-live() { return 0; }
        _wait-cached() {
            for (( i = 0; i < 50; i++ )); do
                [[ "$(<"$_THEME_STATE/lockscreen.cached")" == "$1"$'\t'* ]] 2>/dev/null && return 0
                sleep 0.1
            done
            return 1
        }
        theme-wallpaper restore >/dev/null 2>&1; _wait-cached "$w10"
        out=$(<"$calls")
        [[ "$out" == "feh --no-fehbg --bg-fill $w10"$'\n'"betterlockscreen -u $w10" ]] &&
            ok "restore: feh --no-fehbg --bg-fill, then betterlockscreen -u in the background (nice/ionice)" ||
            bad "restore calls: ${(f)out}"
        : >| "$calls"
        theme-wallpaper restore >/dev/null 2>&1; sleep 0.3
        [[ "$(<"$calls")" == "feh --no-fehbg --bg-fill $w10" ]] &&
            ok "restore again: feh only, the lock cache is already from this wallpaper" ||
            bad "second restore calls: ${(f)$(<"$calls")}"
        : >| "$calls"
        theme-wallpaper 2 --keep-palette >/dev/null 2>&1; _wait-cached "$w2"
        out=$(<"$calls")
        [[ "$out" == "feh --no-fehbg --bg-fill $w2"$'\n'"betterlockscreen -u $w2" ]] &&
            ok "wallpaper 2 --keep-palette: feh and one lock cache refresh; no other target reloaded" ||
            bad "wallpaper 2 calls: ${(f)out}"
        : >| "$calls"
        theme-apply dracula >/dev/null 2>&1; sleep 0.3
        out=$(<"$calls")
        [[ "${(@M)${(@f)out}:#feh *}" == "feh --no-fehbg --bg-fill $w2" && "$out" != *betterlockscreen* ]] &&
            ok "apply dracula: same wallpaper set again, no lock cache refresh" ||
            bad "apply dracula calls: ${(f)out}"
        [[ "$(<"$_THEME_STATE/lockscreen.log")" == *"nice -n 19"*"betterlockscreen -u $w2" ]] &&
            ok "lockscreen.log records the niced refresh" || bad "lockscreen.log: $(<"$_THEME_STATE/lockscreen.log")"
    )
    local -a wcounts=(${=$(<"$scratch/wall-counts")})
    (( pass += wcounts[1], failed += wcounts[2] )) || true
    theme-apply catppuccin-mocha 2>/dev/null

    _theme-self-test-generated "$scratch"
    theme-apply catppuccin-mocha 2>/dev/null

    # polybar includes ~/.local/state/theme only; a scratch state never restarts it.
    polybar-msg() { : > "$scratch/polybar-msg"; }
    timeout() { : > "$scratch/polybar-msg"; }
    _theme-reload-polybar
    [[ ! -e "$scratch/polybar-msg" ]] && ok "polybar reload skipped for a scratch state dir" ||
        bad "polybar reload ran polybar-msg for a scratch state dir"
    unfunction polybar-msg timeout

    # A frozen bar is relaunched from its recorded command line and exactly
    # its environment: a stand-in process makes the round trip.
    local -i sp np=0
    ( THEME_SELFTEST_ENV='a b' exec sleep 30 ) </dev/null >/dev/null 2>&1 &!
    sp=$!
    sleep 0.1
    if _theme-polybar-cmd $sp && THEME_SELFTEST_OTHER=1 _theme-polybar-start "$REPLY"; then
        np=$REPLY
        sleep 0.2
        local -a nargv nenv
        nargv=("${(@ps:\0:)$(</proc/$np/cmdline)}") nenv=("${(@ps:\0:)$(</proc/$np/environ)}")
        [[ "${nargv[1,2]}" == "sleep 30" ]] && (( ${nenv[(Ie)THEME_SELFTEST_ENV=a b]} )) &&
            (( ! ${nenv[(I)THEME_SELFTEST_OTHER=*]} )) &&
            ok "polybar relaunch keeps a bar's command line and environment" ||
            bad "polybar relaunch got argv '${nargv[*]}', env THEME_SELFTEST_*: ${(M)nenv:#THEME_SELFTEST_*}"
    else
        bad "polybar relaunch couldn't record or start a stand-in process"
    fi
    kill $sp $np 2>/dev/null

    [[ -L "$_THEME_STATE/current" && ! -e "$_THEME_STATE/current.tmp" ]] &&
        ok "current is a symlink; no current.tmp left" || bad "current link state"

    # undo
    theme-apply nord 2>/dev/null
    _theme-link-id current; before=$REPLY
    theme-undo 2>/dev/null
    _theme-source-current
    [[ "${THEME_META[name]}" == catppuccin-mocha ]] && ok "undo: nord -> catppuccin-mocha (no re-render)" ||
        bad "undo landed on ${THEME_META[name]}"
    _theme-build-ok "$before" && ok "undo keeps the undone build for re-apply" || bad "undone build vanished"

    # failed render: broken template syntax
    _theme-link-id current; before=$REPLY
    local -a bl=("$_THEME_STATE"/builds/*(N/)); local nb=${#bl}
    mkdir -p "$scratch/bad-render" "$scratch/bad-zsh" "$scratch/bad-toml"
    print -r -- '{{ .spec.roles.nope }}' > "$scratch/bad-render/theme.zsh.tmpl"
    if THEME_TEMPLATE_DIR="$scratch/bad-render" theme-apply gruvbox-dark 2>"$scratch/err"; then
        bad "a failing render was applied"
    else
        _theme-link-id current
        bl=("$_THEME_STATE"/builds/*(N/)); local na=${#bl}
        [[ "$REPLY" == "$before" && $na -eq $nb ]] &&
            ok "failed render: current unchanged ($before), build discarded" ||
            bad "failed render left current=$REPLY builds $nb->$na"
        print -r -- "      error: <${$(<"$scratch/err")#*at <}"
    fi

    # failed validation: renders, but not valid zsh
    print -r -- 'typeset -gA THEME_ROLE=( [bg]={{ .spec.roles.bg }}' > "$scratch/bad-zsh/theme.zsh.tmpl"
    if THEME_TEMPLATE_DIR="$scratch/bad-zsh" theme-apply gruvbox-dark 2>"$scratch/err"; then
        bad "an invalid render was applied"
    else
        _theme-link-id current
        [[ "$REPLY" == "$before" && -z "$(print -l "$_THEME_STATE"/builds/*.tmp(N))" ]] &&
            ok "failed validation (zsh -n): current unchanged, no .tmp build left" ||
            bad "failed validation left current=$REPLY"
    fi

    # failed validation: TOML that doesn't parse
    print -r -- '[font' > "$scratch/bad-toml/alacritty.toml.tmpl"
    if THEME_TEMPLATE_DIR="$scratch/bad-toml" theme-apply gruvbox-dark 2>"$scratch/err"; then
        bad "an invalid TOML render was applied"
    else
        _theme-link-id current
        [[ "$REPLY" == "$before" ]] && ok "failed validation (TOML): current unchanged" ||
            bad "failed TOML validation left current=$REPLY"
    fi

    # failed validation: a polybar fragment with a key twice (polybar refuses it)
    mkdir -p "$scratch/bad-ini"
    print -rl -- '[colors]' 'bg = {{ .spec.roles.bg }}' 'bg = {{ .spec.roles.fg }}' '[theme]' 'height = 50' \
        > "$scratch/bad-ini/polybar.ini.tmpl"
    if THEME_TEMPLATE_DIR="$scratch/bad-ini" theme-apply gruvbox-dark 2>"$scratch/err"; then
        bad "a polybar.ini with a duplicate key was applied"
    else
        _theme-link-id current
        [[ "$REPLY" == "$before" ]] && ok "failed validation (polybar.ini duplicate key): current unchanged" ||
            bad "failed polybar.ini validation left current=$REPLY"
    fi

    # failed reload: roll back to the previous build; known-good stays
    _theme-link-id known-good; kg=$REPLY
    _theme-reload() { return 1; }
    if theme-apply dracula 2>"$scratch/err"; then
        bad "apply succeeded despite a failing reload"
    else
        _theme-link-id current
        local cur=$REPLY
        _theme-link-id known-good
        [[ "$cur" == "$before" && "$REPLY" == "$kg" ]] &&
            ok "failed reload: rolled back to $before, known-good unchanged" ||
            bad "failed reload: current=$cur known-good=$REPLY"
    fi
    _theme-reload() { return 0; }

    # ensure: missing current -> known-good; no state -> default
    rm -f "$_THEME_STATE/current"
    theme-ensure 2>/dev/null
    _theme-link-id current && [[ "$REPLY" == "$kg" ]] &&
        ok "ensure: missing current re-activated known-good" || bad "ensure did not restore known-good"
    t0=$EPOCHREALTIME; theme-ensure; _theme-ms-since $t0
    ok "ensure with a current theme: ${REPLY} ms (no-op)"
    # A build from before a template existed is re-rendered from its own scheme.
    theme-apply nord 2>/dev/null
    rm -f "$_THEME_STATE/current/polybar.ini"
    theme-ensure 2>/dev/null
    _theme-source-current
    [[ "${THEME_META[name]}" == nord && -r "$_THEME_STATE/current/polybar.ini" ]] &&
        ok "ensure: a build missing polybar.ini is re-rendered (still nord)" ||
        bad "ensure on an incomplete build left ${THEME_META[name]}"
    # apply <id>, undo and a known-good fallback re-render a build from
    # before a template existed rather than swap it in and break polybar.
    local old new
    theme-apply nord 2>/dev/null; _theme-link-id current; old=$REPLY
    rm -f "$_THEME_STATE/builds/$old/polybar.ini"
    theme-apply dracula 2>/dev/null
    theme-apply "$old" 2>"$scratch/err"; _theme-link-id current; new=$REPLY
    [[ "$new" != "$old" ]] && _theme-build-complete "$new" && grep -q 're-rendering nord' "$scratch/err" &&
       [[ "$(jq -r .name "$_THEME_STATE/current/spec.json")" == nord ]] &&
        ok "apply <old id>: a build missing polybar.ini is re-rendered as a new nord build, with a warning" ||
        bad "apply <old id>: current=$new (old $old): $(<"$scratch/err")"
    rm -f "$_THEME_STATE/builds/$new/polybar.ini"
    theme-apply dracula 2>/dev/null
    theme-undo 2>"$scratch/err"; _theme-link-id current
    [[ "$REPLY" != "$new" ]] && _theme-build-complete "$REPLY" && grep -q 're-rendering nord' "$scratch/err" &&
       [[ "$(jq -r .name "$_THEME_STATE/current/spec.json")" == nord ]] &&
        ok "undo to a build missing polybar.ini re-renders it (still nord)" ||
        bad "undo to an incomplete build: current=$REPLY: $(<"$scratch/err")"
    _theme-link known-good "$new"; rm -f "$_THEME_STATE/current"
    theme-ensure 2>/dev/null; _theme-link-id current
    [[ "$REPLY" != "$new" ]] && _theme-build-complete "$REPLY" &&
       [[ "$(jq -r .name "$_THEME_STATE/current/spec.json")" == nord ]] &&
        ok "ensure: an incomplete known-good is re-rendered (still nord)" ||
        bad "ensure with an incomplete known-good: current=$REPLY"
    # A build whose scheme is gone can't be re-rendered: refused, nothing swapped.
    jq '.source.ref = "self-test-gone" | .name = "self-test-gone"' "$_THEME_STATE/builds/$new/spec.json" \
        > "$scratch/spec.json" && mv -f "$scratch/spec.json" "$_THEME_STATE/builds/$new/spec.json"
    _theme-link-id current; before=$REPLY
    bl=("$_THEME_STATE"/builds/*(N/)); nb=${#bl}
    if theme-apply "$new" 2>/dev/null; then
        bad "apply <old id> with its scheme gone succeeded"
    else
        _theme-link-id current
        bl=("$_THEME_STATE"/builds/*(N/))
        [[ "$REPLY" == "$before" && ${#bl} -eq $nb ]] &&
            ok "apply <old id> with its scheme gone: refused, current unchanged" ||
            bad "apply <old id> with its scheme gone left current=$REPLY builds $nb->${#bl}"
    fi
    _theme-link-id known-good; kg=$REPLY
    rm -rf -- "$_THEME_STATE"
    theme-ensure 2>/dev/null
    _theme-source-current && [[ "${THEME_META[name]}" == "$_THEME_DEFAULT_SCHEME" && -r "$_THEME_STATE/current/polybar.ini" ]] &&
        ok "ensure with no state rendered the default, polybar.ini included" || bad "ensure from nothing failed"

    # pruning
    local -i i
    for (( i = 0; i < _THEME_KEEP_BUILDS + 2; i++ )); do theme-apply nord 2>/dev/null; done
    bl=("$_THEME_STATE"/builds/*(N/)); local nbuilds=${#bl}
    (( nbuilds <= _THEME_KEEP_BUILDS + 1 )) && ok "pruned to $nbuilds builds" || bad "$nbuilds builds kept"

    theme-get accent >/dev/null && ok "theme get accent: $(theme-get accent) under nord" || bad "get failed"

    # AAA -> AA degradation: on a mid-grey background 7.0 is out of reach.
    {
        print -r -- 'system: "base16"'; print -r -- 'name: "Self-test grey"'; print -r -- 'variant: "dark"'
        print -r -- 'palette:'
        local slot
        for slot in base0{0..7}; do print -r -- "  $slot: \"#767676\""; done
        print -rl -- '  base08: "#ff5555"' '  base09: "#ffb86c"' '  base0A: "#f1fa8c"' '  base0B: "#50fa7b"'
        print -rl -- '  base0C: "#8be9fd"' '  base0D: "#bd93f9"' '  base0E: "#ff79c6"' '  base0F: "#993333"'
    } > "$scratch/grey.yaml"
    if theme-apply "$scratch/grey.yaml" 2>/dev/null && _theme-source-current &&
       [[ "${THEME_META[contrast]} ${THEME_META[degraded]}" == "aa true" ]]; then
        ok "unreachable AAA degrades to AA and is recorded (fg/bg $(jq '.contrast.ratios["fg/bg"]' "$_THEME_STATE/current/spec.json"))"
    else
        bad "grey scheme: contrast ${THEME_META[contrast]:-?} degraded ${THEME_META[degraded]:-?}"
    fi

    # overrides.json merges over prefs.toml.
    print -r -- '{"fonts": {"scale": 1.5}, "accent": "base0E"}' > "$_THEME_STATE/overrides.json"
    theme-apply catppuccin-mocha 2>/dev/null
    _theme-source-current
    [[ "${THEME_SIZE[terminal]} ${THEME_ROLE[accent]}" == "19.5 #cba6f7" ]] &&
        ok "overrides.json: scale 1.5 -> terminal 19.5, accent base0E -> #cba6f7" ||
        bad "overrides: terminal ${THEME_SIZE[terminal]} accent ${THEME_ROLE[accent]}"
    rm -f "$_THEME_STATE/overrides.json"

    sleep 0.3
    [[ ! -s "$scratch/escaped-calls" ]] && ok "no desktop command escaped to a guard stub" ||
        bad "desktop commands reached the guard stubs: ${(f)$(<"$scratch/escaped-calls")}"

    print -r -- "self-test: $pass passed, $failed failed"
    (( failed == 0 ))
}
