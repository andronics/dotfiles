#!/usr/bin/env zsh

# _coord - coordinator switchboard: one hidden floating terminal per Claude
# Code coordinator, summoned one at a time.
#
# The switchboard order is _COORD_NAMES (brain, template, folio, homelab,
# metalayerlab, apps, dotfiles, ideas): `menu` lists it in a rofi menu and `cycle`
# steps through it, wrapping. `toggle`, `stop` and `restart` accept any valid
# name.
#
# Menu: `menu` (super + c) is two levels. The first lists every coordinator
# with its state, as the strip shows it, and a "Stop all" cell; the second
# offers what can be done to the one picked: show or hide it, start it if it
# is stopped, stop or restart it. Escape there goes back to the first.
#
# Stop: whether a coordinator may be stopped, and the stopping itself, are
# the brain's, not this module's: `stop` and `restart` run the brain's stop
# script (COORD_STOP_SCRIPT, default /mnt/brain/tools/coordinator-stop.py;
# the brain's design record 0015) with --by switchboard. It judges the
# coordinator's resume notes clean or not, kills its tmux session (which
# closes its window) and logs the stop in its home's stop.log. Notes that
# aren't clean are asked about first, with the script's reason (a Yes/No in
# rofi/themes/prompt.rasi, as power's), and Yes reruns it with --force;
# --yes forces at once. The brain coordinator is always asked about, clean
# or not, --yes or not: it is ended only by Stephen. What the script won't
# end (a session outside tmux, or the brain from inside a Claude session) or
# fails at is shown in a notification. `stop --all` checks each running one
# with --check, asks once naming those that aren't clean, then stops each.
# After any stop, whoever asked, the script runs `stopped`, the desktop half:
# drop the strip's state, wait for the window to close, give the strip back
# and refresh the bar. It may run with no DISPLAY (a detached child of a
# Claude session), so with none set, coord windows are found through bspc,
# whose socket has a default path, rather than xprop.
#
# Each coordinator window is alacritty with class `coord` and the
# coordinator's name as instance. bspwmrc's `coord` rule makes it floating,
# sticky and hidden at birth; showing one docks it to the left or right edge
# of the focused monitor and sets that monitor's left_padding or right_padding
# to cover it, so tiled windows give the strip up only while a coordinator is
# shown. The panel keeps bspwm's window gap as a tiled window would; the width
# is its visible width, gap excluded. The width and side are persisted in
# ${XDG_STATE_HOME}/coord/{width,side}, and the last coordinator shown in
# ${XDG_STATE_HOME}/coord/last, which `cycle` re-shows when none is shown.
# Width can be set absolutely, by delta, or by moving the panel's inner edge
# `left`/`right`, which resolves to wider or narrower from the side. The
# session runs inside tmux (`<name>-coordinator`), so closing the window only
# detaches it, and a session started from another terminal is attached rather
# than duplicated. `hide` hides whichever coordinator is shown, focused or not,
# and gives its strip back; `hide --toggle` re-shows the last one shown when
# none is.
#
# Snap back: the shown panel stays docked. Every show starts `guard`, a
# detached singleton that follows bspwm's node events for coord windows and,
# once they settle (COORD_GUARD_SETTLE, default 0.2s, after the last event,
# and never while a pointer drag is still in progress), puts the shown panel
# back to floating and re-docks it to the stored side and width. A
# super+drag, a super+resize or a state change such as tiling therefore
# springs back, while `width` and `side`, which write the state before
# re-docking, leave nothing to undo. It exits once no coordinator is shown,
# giving back the strip of one that was closed rather than hidden.
#
# Status: `status` is fed by Claude Code hooks in the user's Claude settings
# (~/.claude/settings.json, not this repo), which fire in every Claude session
# on the machine with the hook's JSON on stdin; the hook command only calls it
# when $PWD is under the actors dir, so other sessions pay a bare `case`. A
# session whose cwd is /pool/local/actors/<name>(/...) (COORD_ACTORS_DIR) for a
# name in _COORD_NAMES moves <name> between idle, busy and waiting in
# ${XDG_RUNTIME_DIR}/coord/state/<name>; any other session is a silent no-op.
# Entering waiting raises a dunst notification whose default action shows the
# coordinator. Every state change, show and hide pokes the polybar `coord`
# module (custom/ipc), whose hook runs `bar` to draw one icon per coordinator
# styled by its state.
#
# Usage:
#   source "${DOTLIB}/_coord"
#
# Dependencies:
#   Required:
#     - _common, _log
#     - _theme (bar and menu only, sourced on first use)
#   External:
#     - bspwm (bspc), xprop, jq, alacritty, tmux, flock, setsid
#     - rofi (menu, and stop's question)
#     - python3 and the brain's coordinator-stop.py (stop, restart)
#     - notify-send (libnotify >= 0.7.9 for --action) and a notification
#       daemon whose click runs the default action, e.g. dunst with
#       mouse_left_click = do_action (status)
#     - polybar-msg (show, hide, launch, status; optional)
#     - _coordinator from shell/.config/zsh/.zshrc.d/55-coordinators

[[ -n "${COORD_LOADED:-}" ]] && return 0
declare -gr COORD_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _coord requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

# COORD_CLASS points the module at other windows, e.g. a throwaway class for
# testing that never matches the live panels.
declare -g _COORD_CLASS="${COORD_CLASS:-coord}"
# COORD_TMUX_SOCKET points every tmux call at another server, for testing:
# a path is -S, a name -L. Unset, the default server.
typeset -ga _COORD_TMUX=(tmux)
if [[ "${COORD_TMUX_SOCKET:-}" == */* ]]; then
    _COORD_TMUX+=(-S "$COORD_TMUX_SOCKET")
elif [[ -n "${COORD_TMUX_SOCKET:-}" ]]; then
    _COORD_TMUX+=(-L "$COORD_TMUX_SOCKET")
fi
declare -g _COORD_LAUNCH_TIMEOUT="${COORD_LAUNCH_TIMEOUT:-10}"
declare -g _COORD_WIDTH_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coord/width"
declare -gi _COORD_WIDTH_DEFAULT=1280 _COORD_WIDTH_MIN=640 _COORD_WIDTH_MAX=2560
declare -gi _COORD_WIDTH_STEP=128
declare -g _COORD_SIDE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coord/side"
declare -g _COORD_SIDE_DEFAULT=right
declare -g _COORD_LAST_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coord/last"
typeset -ga _COORD_NAMES=(brain template folio homelab metalayerlab apps dotfiles ideas)
declare -g _COORD_ACTORS_DIR="${COORD_ACTORS_DIR:-/pool/local/actors}"
declare -g _COORD_STATE_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/coord/state"
declare -gi _COORD_NOTIFY_BODY_MAX=200
# Seconds of quiet after a coord window's last event before `guard` re-docks.
declare -g _COORD_GUARD_SETTLE="${COORD_GUARD_SETTLE:-0.2}"
# rofi themes for menu's two levels and stop's question: a name resolves to
# ~/.config/rofi/themes/<name>.rasi.
declare -g _COORD_MENU_THEME="${COORD_MENU_THEME:-coord}"
declare -g _COORD_ACTION_THEME="${COORD_ACTION_THEME:-prompt}"
declare -g _COORD_CONFIRM_THEME="${COORD_CONFIRM_THEME:-prompt}"
# The brain's stop script, which judges and ends a coordinator (stop, restart).
declare -g _COORD_STOP_SCRIPT="${COORD_STOP_SCRIPT:-/mnt/brain/tools/coordinator-stop.py}"
declare -g _COORD_STOP_ICON=$'\U000F0667'   # md-stop_circle_outline

# Symbols Nerd Font Mono (polybar font-0) Material Design glyphs.
typeset -gA _COORD_ICONS=(
    [brain]=$'\U000F09D1'          # md-brain
    [template]=$'\U000F1517'       # md-file_document_multiple
    [folio]=$'\U000F00D6'          # md-briefcase
    [homelab]=$'\U000F048D'        # md-server_network
    [metalayerlab]=$'\U000F0F58'   # md-layers_triple
    [apps]=$'\U000F003B'           # md-apps
    [dotfiles]=$'\U000F0493'       # md-cog
    [ideas]=$'\U000F0335'          # md-lightbulb
)

# Colours for `bar` and `menu`: key=theme role. polybar can't interpolate
# references inside a command, so the hook is a plain `coord bar`, and `bar`
# and `menu` fill _COORD_BAR_COLORS from the current theme.zsh each time they
# run (theme-roles; Catppuccin Mocha when no theme is applied). A new theme
# shows on the next poke. key=#rrggbb args to `bar` still override.
# _theme is sourced then, not here, so `status`, which every hook runs,
# doesn't pay for loading it.
typeset -ga _COORD_BAR_ROLES=(dim=dim busy=busy waiting=urgent ink=on_urgent shown=accent)
typeset -gA _COORD_BAR_COLORS=()

typeset -gA _COORD_DESCRIPTIONS=(
    [toggle]="Show <name>'s window docked on the dock side's edge (launching it if needed), or hide it if it is focused"
    [menu]="Two-level rofi menu: pick one of ${(j:, :)_COORD_NAMES} (shown with its state; type its first letter to filter) or Stop all, then show/hide, start, stop or restart it; Escape on the second level goes back"
    [stop]="Stop <name>, or with --all every running coordinator, through the brain's stop script (${_COORD_STOP_SCRIPT:t}), which ends its tmux session; one whose resume notes aren't clean is asked about first with the script's reason, unless --yes (which forces it); what it won't end, such as a session outside tmux, is shown in a notification; a running brain coordinator is always asked about, even with --yes"
    [restart]="Stop <name> as stop does, through the brain's stop script (asking unless --yes or its notes are clean, and always for the brain coordinator), then start it again: shown if it was shown, else hidden"
    [stopped]="The desktop half of a stop, run by the stop script after it ends <name>'s session: drop its strip state, wait for its window to close, give the dock strip back and refresh the bar; works without DISPLAY"
    [cycle]="Show the {next|prev} coordinator in the order menu lists them, wrapping and launching it if needed; with none shown, re-show the last one shown (or ${_COORD_NAMES[1]})"
    [width]="Print the dock panel's visible width (the reserved strip is that plus bspwm's window_gap), or set it with {+N|-N|N} (${_COORD_WIDTH_MIN}-${_COORD_WIDTH_MAX}) or move the inner edge with {left|right} [N] (default ${_COORD_WIDTH_STEP}), resizing a shown coordinator"
    [side]="Print the dock side, or set it with {left|right}, re-docking a shown coordinator"
    [hide]="Hide the shown coordinator, focused or not, and give its strip back; with --toggle and none shown, re-show the last one shown (or ${_COORD_NAMES[1]})"
    [guard]="Keep the shown coordinator docked: put it back to floating at the stored side and width after it is dragged, resized or tiled; started detached by every show, a singleton, exits once none is shown"
    [launch]="Start <name>'s window hidden, attaching to its tmux session if one exists"
    [list]="List coordinator windows and whether each is hidden or visible"
    [status]="Claude Code hook: read the hook JSON on stdin and, for a session under ${_COORD_ACTORS_DIR}/<name>, record <name> busy, idle, or waiting on a question (AskUserQuestion), permission or elicitation, notifying on waiting and refresh polybar; [event] overrides hook_event_name; always exits 0"
    [bar]="Print the polybar strip: one clickable icon per coordinator styled not running, idle, busy, waiting or shown, coloured from the current theme; [key=#rrggbb ...] overrides a colour (key=role): ${(j:, :)_COORD_BAR_ROLES}"
)

# ------------------------------
# Private Helpers
# ------------------------------

_coord-check-name() {
    [[ "$1" =~ '^[a-z0-9][a-z0-9-]*$' ]] && return 0
    log-error "[coord] invalid coordinator name: '$1'"
    return 1
}

# Prints "<node> <instance>" for each coord window bspwm manages, narrowed by
# an optional node-selector modifier such as `.!hidden`.
_coord-windows() {
    local _modifier=${1:-} _node _wm_class
    for _node in ${(f)"$(bspc query -N -n ".window${_modifier}" 2>/dev/null)"}; do
        if [[ -n "${DISPLAY:-}" ]]; then
            _wm_class=$(xprop -id "$_node" WM_CLASS 2>/dev/null) || continue
        else
            # bspwm's copy of WM_CLASS, in xprop's shape.
            _wm_class=$(bspc query -T -n "$_node" 2>/dev/null \
                | jq -r '.client | "= \"\(.instanceName)\", \"\(.className)\""' 2>/dev/null) || continue
        fi
        [[ "$_wm_class" =~ "= \"([^\"]*)\", \"${_COORD_CLASS}\"\$" ]] && print -r -- "$_node ${match[1]}"
    done
}

_coord-node() {
    local _node _instance
    _coord-windows | while read -r _node _instance; do
        [[ "$_instance" == "$1" ]] && { print -r -- "$_node"; return 0; }
    done
}

# Polls bspwm rather than X: the window exists in X a moment before bspwm
# manages it, and bspc rejects a node it doesn't know yet.
_coord-wait() {
    local _node _tries=$(( _COORD_LAUNCH_TIMEOUT * 10 ))
    while (( _tries-- > 0 )); do
        _node=$(_coord-node "$1")
        [[ -n "$_node" ]] && { print -r -- "$_node"; return 0; }
        sleep 0.1
    done
    log-error "[coord] $1: no window after ${_COORD_LAUNCH_TIMEOUT}s"
    return 1
}

_coord-width-clamp() {
    local -i _width=$1
    (( _width < _COORD_WIDTH_MIN )) && _width=_COORD_WIDTH_MIN
    (( _width > _COORD_WIDTH_MAX )) && _width=_COORD_WIDTH_MAX
    print -r -- "$_width"
}

_coord-width-get() {
    local _width
    _width=$(<"$_COORD_WIDTH_FILE") 2>/dev/null
    [[ "$_width" =~ '^[0-9]+$' ]] || _width=$_COORD_WIDTH_DEFAULT
    _coord-width-clamp "$_width"
}

_coord-side-get() {
    local _side
    _side=$(<"$_COORD_SIDE_FILE") 2>/dev/null
    [[ "$_side" == (left|right) ]] || _side=$_COORD_SIDE_DEFAULT
    print -r -- "$_side"
}

# Prints the last coordinator shown, if it is still in _COORD_NAMES.
_coord-last-get() {
    local _name
    _name=$(<"$_COORD_LAST_FILE") 2>/dev/null
    (( ${_COORD_NAMES[(Ie)$_name]} )) && print -r -- "$_name"
}

# Prints the shown coordinator, if one in _COORD_NAMES is shown.
_coord-current() {
    local _node _instance
    _coord-windows '.!hidden' | while read -r _node _instance; do
        (( ${_COORD_NAMES[(Ie)$_instance]} )) && { print -r -- "$_instance"; return 0; }
    done
}

# Takes ${XDG_RUNTIME_DIR}/coord-<lock>.lock. `dock` serialises the
# read-modify-write of the width and side files, e.g. a held-down key's
# repeats. `switch` serialises showing and hiding, so a double-tapped chord or
# a repeating cycle key finds the window the previous press launched and the
# coordinator it left shown, instead of launching another or stepping from a
# stale one. Sets the caller's _fd; the caller closes it.
_coord-lock() {
    local _lock="${XDG_RUNTIME_DIR:-${HOME}/.cache}/coord-$1.lock"
    exec {_fd}>"$_lock"
    flock -w "$_COORD_LAUNCH_TIMEOUT" "$_fd" && return 0
    exec {_fd}>&-
    log-error "[coord] $1 lock busy"
    return 1
}

# Refreshes the polybar `coord` module. Backgrounded with its output
# discarded: polybar may not be running, and a hook must never wait on it.
_coord-poke() {
    (( ${+commands[polybar-msg]} )) || return 0
    polybar-msg action coord hook 0 </dev/null >/dev/null 2>&1 &!
}

# Shows <name> under the switch lock.
_coord-summon() {
    local _fd
    _coord-lock switch || return 1
    {
        _coord-show "$1"
    } always {
        exec {_fd}>&-
    }
}

# Runs <command> in its own session with stdio on /dev/null and no other fd
# open, returning at once. Whatever started the caller (polybar's click
# handler, sxhkd, a hook) may have left pipes open in it, and a long-lived
# child holding one keeps its reader waiting on output that never ends.
_coord-detach() {
    (
        local _n
        for _n in /proc/self/fd/*(N:t); do
            (( _n > 2 )) && exec {_n}>&-
        done 2>/dev/null
        exec setsid -f "$@" </dev/null >/dev/null 2>&1
    )
}

# Starts `coord guard` unless it is already running: the guard's own lock
# makes a second one exit at once, so this is safe to call on every show.
_coord-guard-start() {
    (( ${+commands[coord]} )) || { log-debug "[coord] coord not on PATH, no guard"; return 0; }
    _coord-detach "${commands[coord]}" guard
}

# Pops a notification that <name> is waiting, unless it is the shown and
# focused window. notify-send blocks until the notification is clicked or
# closed, so the wait runs detached and the hook returns at once; clicking it
# shows <name> (never hides it, as toggle would).
_coord-notify() {
    local _name=$1 _body=$2 _node
    (( ${+commands[notify-send]} )) || return 0
    _node=$(_coord-node "$_name")
    [[ -n "$_node" ]] && bspc query -N -n "${_node}.focused.!hidden" >/dev/null 2>&1 && return 0

    (( ${#_body} > _COORD_NOTIFY_BODY_MAX )) && _body="${_body[1,_COORD_NOTIFY_BODY_MAX - 1]}…"
    # dunstrc sets markup = full.
    _body=${_body//&/&amp;} _body=${_body//</&lt;} _body=${_body//>/&gt;}
    {
        [[ "$(notify-send --app-name="$_COORD_CLASS" --action=default=Show \
            --hint="string:x-dunst-stack-tag:coord-${_name}" \
            "${_name} needs you" "$_body")" == default ]] && _coord-summon "$_name"
    } </dev/null >/dev/null 2>&1 &!
}

# Docks the node to the <side> edge of <monitor> (default: the focused one,
# moving it there) as if it were one more tiled window: <width> wide including
# its border, inset by the window gap from the monitor edge and from the top
# and bottom padding, and reserves the strip with that side's padding,
# releasing the other side's. bspc only moves and resizes floating windows
# relatively, hence the deltas from the current floating rectangle.
#
# bspwm's gap model, measured with xwininfo (gap 5, border 1): the tiling
# area is the monitor minus monitor and desktop padding; its root is inset by
# the gap on the left and top only, and every leaf gives up the gap on its
# right and bottom, so tiled windows sit the gap away from every area edge
# and from each other. The panel takes the gap on all four sides, and the
# padding is <width> + gap: the tiled area's own trailing gap supplies the
# space between it and the panel, and the extra gap is the panel's outer inset.
_coord-place() {
    local _node=$1 _width=$2 _side=$3 _mon=${4:-} _other _layout _gapless
    local -i _mx _my _mw _mh _top _bottom _dtop _dbottom _gap _bw _fx _fy _fw _fh _x _y _w _h

    [[ -n "$_mon" ]] || _mon=$(bspc query -M -m focused) || return 1
    if [[ "$(bspc query -M -n "$_node")" != "$_mon" ]]; then
        bspc node "$_node" --to-monitor "$_mon" || return 1
    fi

    read -r _mx _my _mw _mh <<< "$(bspc query -T -m "$_mon" \
        | jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')"
    read -r _bw _fx _fy _fw _fh <<< "$(bspc query -T -n "$_node" \
        | jq -r '.client | "\(.borderWidth) \(.floatingRectangle | "\(.x) \(.y) \(.width) \(.height)")"')"
    # Per-monitor, not the global `bspc config`: tiled windows obey the
    # monitor's own padding, which can differ from bspwmrc's global value.
    _top=$(bspc config -m "$_mon" top_padding)
    _bottom=$(bspc config -m "$_mon" bottom_padding)
    # Gap and desktop padding are per-desktop, and the panel is sticky, so it
    # matches the desktop shown at place time; others may differ.
    read -r _gap _dtop _dbottom _layout <<< "$(bspc query -T -d "${_mon}:focused" \
        | jq -r '"\(.windowGap // "") \(.padding.top) \(.padding.bottom) \(.layout)"')"
    [[ -n "$_gap" ]] || _gap=$(bspc config window_gap)
    _gapless=$(bspc config gapless_monocle)
    [[ "$_gapless" == true && "$_layout" == monocle ]] && _gap=0
    (( _gap < 0 )) && _gap=0

    # X draws the border outside the floating rectangle.
    if [[ "$_side" == left ]]; then
        _x=$(( _mx + _gap )) _other=right
    else
        _x=$(( _mx + _mw - _gap - _width )) _other=left
    fi
    _y=$(( _my + _top + _dtop + _gap ))
    _w=$(( _width - 2 * _bw ))
    _h=$(( _mh - _top - _bottom - _dtop - _dbottom - 2 * _gap - 2 * _bw ))

    if (( _w != _fw || _h != _fh )); then
        bspc node "$_node" --resize bottom_right $(( _w - _fw )) $(( _h - _fh ))
    fi
    if (( _x != _fx || _y != _fy )); then
        bspc node "$_node" --move $(( _x - _fx )) $(( _y - _fy ))
    fi
    # The new side is padded before the old one is released, so re-docking
    # never lets tiled windows reflow through the full monitor width.
    bspc config -m "$_mon" "${_side}_padding" $(( _width + _gap ))
    [[ "$(bspc config -m "$_mon" "${_other}_padding")" == 0 ]] || bspc config -m "$_mon" "${_other}_padding" 0
}

# Re-places every shown coordinator on its own monitor.
_coord-redock() {
    local _width=$1 _side=$2 _node _instance
    _coord-windows '.!hidden' | while read -r _node _instance; do
        _coord-place "$_node" "$_width" "$_side" "$(bspc query -M -n "$_node")"
    done
}

# Gives the strip back to tiled windows on every monitor no coordinator is
# shown on, whichever side it was on. Assumes left_padding and right_padding
# are otherwise 0, as bspwmrc sets them.
_coord-unpad() {
    local _node _instance _mon _pad
    local -A _held
    _coord-windows '.!hidden' | while read -r _node _instance; do
        _held[$(bspc query -M -n "$_node")]=1
    done
    for _mon in ${(f)"$(bspc query -M)"}; do
        (( ${+_held[$_mon]} )) && continue
        for _pad in left_padding right_padding; do
            [[ "$(bspc config -m "$_mon" "$_pad")" == 0 ]] || bspc config -m "$_mon" "$_pad" 0
        done
    done
}

# Shows <name>'s window (node <node> if the caller already looked it up)
# docked, launching it if needed, hides any other shown coordinator and
# records <name> as the last shown. Already shown, it is re-docked and
# focused, never hidden. The caller holds the switch lock in _fd.
_coord-show() {
    local _name=$1 _node=${2:-} _other _instance
    [[ -n "$_node" ]] || _node=$(_coord-node "$_name")
    if [[ -z "$_node" ]]; then
        # Subshell closes its copy of the lock fd so alacritty doesn't
        # inherit it and hold the lock for its lifetime.
        ( exec {_fd}>&-; coord-launch "$_name" ) || return 1
        _node=$(_coord-wait "$_name") || return 1
    fi

    # Padding is set before the swap and released only after it, so
    # swapping coordinators never lets tiled windows reflow into the strip.
    _coord-place "$_node" "$(_coord-width-get)" "$(_coord-side-get)" || return 1

    _coord-windows '.!hidden' | while read -r _other _instance; do
        [[ "$_other" != "$_node" ]] && bspc node "$_other" --flag hidden=on
    done

    bspc node "$_node" --flag hidden=off --focus
    _coord-unpad

    mkdir -p "${_COORD_LAST_FILE:h}" && print -r -- "$_name" >| "$_COORD_LAST_FILE"
    _coord-guard-start
    _coord-poke
    return 0
}

# One settled look for `guard`: puts every shown coordinator back to floating
# and re-docks it to the stored side and width on its own monitor, then gives
# back the strip of any monitor it was dragged off. _coord-place moves and
# resizes only what differs, so the events of a re-dock are answered by a
# no-op, never another move. Fills the caller's _known (local -A there) with
# every coord window, hidden or not, and returns 1 with none shown, after
# giving every strip back and closing the caller's guard lock fd _gfd. All
# under the switch lock, which _coord-show holds from before it hides the old
# panel until after it shows the new one, so a guard never quits mid-swap,
# and a show after it quits finds the guard lock free and starts a new one.
_coord-guard-tick() {
    local _fd _sfd _node _instance
    local -a _shown
    _coord-lock switch || return 0
    _sfd=$_fd
    {
        _known=()
        _coord-windows | while read -r _node _instance; do
            _known[$_node]=1
            bspc query -N -n "${_node}.!hidden" >/dev/null 2>&1 && _shown+=("$_node")
        done
        if (( ! ${#_shown} )); then
            # A panel closed rather than hidden leaves its strip reserved.
            _coord-unpad
            exec {_gfd}>&-
            _gfd=
            return 1
        fi
        for _node in "${_shown[@]}"; do
            bspc query -N -n "${_node}.!floating" >/dev/null 2>&1 && bspc node "$_node" --state floating
        done
        _coord-lock dock || return 0
        {
            _coord-redock "$(_coord-width-get)" "$(_coord-side-get)"
            _coord-unpad
        } always {
            exec {_fd}>&-
        }
        return 0
    } always {
        exec {_sfd}>&-
    }
}

# ------------------------------
# Public
# ------------------------------

coord-launch() {
    local _name=$1
    _coord-check-name "$_name" || return 1

    # `; exec zsh -i`: if claude exits or fails to start (e.g. 55-coordinators
    # isn't loaded), the window keeps a shell showing why instead of vanishing.
    setsid -f alacritty \
        --class "${_COORD_CLASS},${_name}" \
        --title "${_COORD_CLASS} - ${_name}" \
        -e "${_COORD_TMUX[@]}" new-session -A -s "${_name}-coordinator" \
            "zsh -ic '_coordinator ${_name}; exec zsh -i'" \
        </dev/null >/dev/null 2>&1
    # The strip counts a coordinator as running once its window or tmux
    # session exists, which is after setsid returns.
    { _coord-wait "$_name" && _coord-poke } </dev/null >/dev/null 2>&1 &!
}

coord-toggle() {
    local _name=$1 _node _fd
    _coord-check-name "$_name" || return 1

    _coord-lock switch || return 1
    {
        _node=$(_coord-node "$_name")
        if [[ -n "$_node" ]] && bspc query -N -n "${_node}.focused.!hidden" >/dev/null 2>&1; then
            bspc node "$_node" --flag hidden=on
            _coord-unpad
            _coord-poke
            return
        fi
        _coord-show "$_name" "$_node"
    } always {
        exec {_fd}>&-
    }
}

# Fills _COORD_BAR_COLORS from the current theme.
_coord-colors() {
    source "${DOTLIB}/_theme" || { log-error "[coord] _theme missing"; return 1; }
    theme-roles _COORD_BAR_COLORS "${_COORD_BAR_ROLES[@]}"
}

# Fills the caller's _running and _shown (local -A there). Running means the
# coordinator's window or its tmux session exists; shown, a visible window.
_coord-scan() {
    local _name _node _instance
    for _name in ${(f)"$("${_COORD_TMUX[@]}" list-sessions -F '#S' 2>/dev/null)"}; do
        [[ "$_name" == *-coordinator ]] && _running[${_name%-coordinator}]=1
    done
    _coord-windows | while read -r _node _instance; do
        _running[$_instance]=1
        bspc query -N -n "${_node}.!hidden" >/dev/null 2>&1 && _shown[$_instance]=1
    done
}

# Sets REPLY to <name>'s activity (off, idle, busy, waiting) from the caller's
# _running. The state file of one that isn't running is stale and removed.
_coord-activity() {
    local _file="${_COORD_STATE_DIR}/$1"
    REPLY=off
    if (( ${+_running[$1]} )); then
        REPLY=
        [[ -r "$_file" ]] && REPLY=$(<"$_file")
        [[ "$REPLY" == (busy|waiting) ]] || REPLY=idle
    else
        [[ -e "$_file" ]] && rm -f -- "$_file" 2>/dev/null
    fi
}

# Sets reply to the -theme arguments for theme $1. A missing theme would make
# rofi exit with an error, so an unstowed themes/ falls back to the default
# look instead of a dead menu.
_coord-theme-args() {
    local _theme=$1
    [[ "$_theme" == */* ]] || _theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/themes/${_theme}.rasi"
    reply=()
    [[ -r "$_theme" ]] && reply=(-theme "$_theme")
    return 0
}

# Sets REPLY to one menu cell as pango markup (rofi -markup-rows), three
# centred lines for rofi/themes/coord.rasi's grid: the strip's glyph, large
# and coloured as the strip colours it, the name, and a small faint state.
# rofi takes icons only as image names, so the glyph has to be text, and a
# row can't hold a newline, so the line breaks are &#10; entities. Shown is
# only named here: menu marks those cells active and the theme rings them.
#
# The menu filters with -matching prefix, which rofi applies to the cell's
# text without its markup at every word start, so the state words avoid the
# coordinators' initials (b: brain is listed first, so busy is harmless) and
# a first letter leaves the cursor on that coordinator.
_coord-menu-row() {
    local _name=$1 _activity=$2 _shown=${3:-} _glyph _label
    # size is in 1024ths of a point: 36pt, about 48px.
    _glyph="<span font_family='Symbols Nerd Font Mono' size='36864'> ${_COORD_ICONS[$_name]:-${_name[1]}} </span>"
    case "$_activity" in
        off)     _glyph="<span foreground='${_COORD_BAR_COLORS[dim]}'>${_glyph}</span>"
                 _label="not running" ;;
        busy)    _glyph="<span foreground='${_COORD_BAR_COLORS[busy]}'>${_glyph}</span>"
                 _label=busy ;;
        waiting) _glyph="<span background='${_COORD_BAR_COLORS[waiting]}' foreground='${_COORD_BAR_COLORS[ink]}'>${_glyph}</span>"
                 _label=waiting ;;
        *)       _label=running ;;
    esac
    [[ -n "$_shown" ]] && _label+=" · visible"
    REPLY="${_glyph}&#10;${_name}&#10;<span size='small' fgalpha='55%'>${_label}</span>"
}

# Sets REPLY to the menu's last cell, Stop all, in _coord-menu-row's shape,
# dim when nothing is running. $1 is how many are.
_coord-menu-stop-row() {
    local -i _count=$1
    local _glyph="<span font_family='Symbols Nerd Font Mono' size='36864'> ${_COORD_STOP_ICON} </span>"
    (( _count )) || _glyph="<span foreground='${_COORD_BAR_COLORS[dim]}'>${_glyph}</span>"
    REPLY="${_glyph}&#10;Stop all&#10;<span size='small' fgalpha='55%'>$(( _count )) running</span>"
}

# Level one: sets REPLY to the coordinator picked, or --all for Stop all;
# returns 1 on Escape. The cursor starts on $1 if given (the one just backed
# out of), else the shown coordinator (also highlighted as active), else the
# last one shown. rofi runs outside the lock: it can sit open indefinitely,
# and the state it lists is only a hint.
_coord-menu-pick() {
    local _name _current _choice
    local -i _row=0 _count=0
    local -a _rows _active
    local -A _running _shown

    _coord-colors
    _coord-scan
    _current=$(_coord-current)
    for _name in "${_COORD_NAMES[@]}"; do
        _coord-activity "$_name"
        [[ "$REPLY" == off ]] || (( _count++ ))
        _coord-menu-row "$_name" "$REPLY" "${_shown[$_name]:-}"
        _rows+=("$REPLY")
        (( ${+_shown[$_name]} )) && _active+=($(( ${#_rows} - 1 )))
    done
    _coord-menu-stop-row "$_count"
    _rows+=("$REPLY")
    _name=${1:-${_current:-$(_coord-last-get)}}
    [[ -n "$_name" ]] && _row=$(( ${_COORD_NAMES[(Ie)$_name]} - 1 ))
    (( _row < 0 )) && _row=0

    _coord-theme-args "$_COORD_MENU_THEME"
    # -format i returns the row index, so the markup never has to be parsed
    # back out. Escape exits non-zero with no output.
    _choice=$(print -rl -- "${_rows[@]}" | rofi -dmenu -i -no-custom -markup-rows -format i \
        -matching prefix "${reply[@]}" -p "Coordinator" -selected-row "$_row" \
        ${_active:+-a} ${_active:+${(j:,:)_active}}) || return 1
    [[ "$_choice" == <-> ]] && (( _choice <= ${#_COORD_NAMES} )) || return 1
    if (( _choice == ${#_COORD_NAMES} )); then
        REPLY=--all
    else
        REPLY=${_COORD_NAMES[_choice + 1]}
    fi
}

# Level two: sets REPLY to what to do to coordinator $1 (toggle, start, stop
# or restart); returns 1 on Escape. A stopped one can only be started;
# a running one's first action reads Hide when toggle would hide it, i.e. it
# is shown and focused.
_coord-menu-act() {
    local _name=$1 _node _state _choice
    local -a _actions _labels
    local -A _running _shown

    _coord-scan
    _coord-activity "$_name"
    case "$REPLY" in
        off)     _state=stopped ;;
        waiting) _state="waiting on you" ;;
        busy)    _state="running, busy" ;;
        *)       _state=running ;;
    esac
    if [[ "$REPLY" == off ]]; then
        _actions=(start) _labels=(Start)
    else
        _actions=(toggle stop restart) _labels=(Show Stop Restart)
        _node=$(_coord-node "$_name")
        [[ -n "$_node" ]] && bspc query -N -n "${_node}.focused.!hidden" >/dev/null 2>&1 && _labels[1]=Hide
    fi

    _coord-theme-args "$_COORD_ACTION_THEME"
    _choice=$(print -rl -- "${_labels[@]}" | rofi -dmenu -i -no-custom -format i \
        "${reply[@]}" -p "${_name} (${_state})" -selected-row 0) || return 1
    [[ "$_choice" == <-> ]] && (( _choice < ${#_actions} )) || return 1
    REPLY=${_actions[_choice + 1]}
}

# Returns 0 only on an explicit Yes to question $1, as power's: No is
# selected, so Return on open, Escape, or rofi failing all mean No.
_coord-confirm() {
    local _choice
    _coord-theme-args "$_COORD_CONFIRM_THEME"
    _choice=$(print -rl -- Yes No | rofi -dmenu -i -no-custom -format s -selected-row 1 \
        "${reply[@]}" -p "$1") || return 1
    [[ "$_choice" == Yes ]]
}

# Exact (=) so a missing session never matches another by prefix.
_coord-has-session() {
    "${_COORD_TMUX[@]}" has-session -t "=${1}-coordinator" 2>/dev/null
}

# Tells Stephen why a stop didn't happen: the log, and a notification, since
# the switchboard runs from sxhkd and polybar with no terminal to read.
_coord-alert() {
    local _title=$1 _body=$2
    log-error "[coord] ${_title}: ${_body}"
    (( ${+commands[notify-send]} )) || return 0
    # dunstrc sets markup = full.
    _body=${_body//&/&amp;} _body=${_body//</&lt;} _body=${_body//>/&gt;}
    notify-send --app-name="$_COORD_CLASS" --hint="string:x-dunst-stack-tag:coord-stop" \
        "$_title" "$_body" </dev/null >/dev/null 2>&1 &!
}

# Returns 1, alerting, if the brain's stop script or python3 is missing:
# stopping is the script's alone, so there is no fallback here.
_coord-stop-ready() {
    (( ${+commands[python3]} )) && [[ -r "$_COORD_STOP_SCRIPT" ]] && return 0
    _coord-alert "coord: can't stop" \
        "no python3, or no stop script at ${_COORD_STOP_SCRIPT}; by hand: tmux kill-session -t =<name>-coordinator"
    return 1
}

# Runs the brain's stop script with $@ and returns its exit code: 0 stopped
# or not running (with --check, clean), 1 not clean and nothing ended,
# 2 usage, 3 not its to end, 4 the kill failed. Sets REPLY to what it
# printed, stdout and stderr together.
_coord-stop-script() {
    local -i _rc=0
    REPLY=$(python3 "$_COORD_STOP_SCRIPT" "$@" </dev/null 2>&1) || _rc=$?
    return $_rc
}

# Sets REPLY to the reason in coordinator $2's stop-script output $1: its
# last line, which is either a stop.log line, whose why="..." is taken, or a
# plain sentence (--check's "<name>: <why>", the outside-tmux advice, a usage
# error), less a leading "<name>: ".
_coord-stop-why() {
    local -a _lines=(${(f)1})
    REPLY=${${_lines[-1]:-}#"$2": }
    [[ "$REPLY" =~ ' why=("(([^"\\]|\\.)*)"|([^ ]*))' ]] || return 0
    REPLY=${match[2]:-${match[4]}}
    REPLY=${${REPLY//\\\"/\"}//\\\\/\\}
}

# Returns 0 if coordinator $1's resume notes are clean, as the brain's stop
# script judges them (--check); otherwise sets REPLY to why not.
_coord-paused() {
    local -i _rc=0
    _coord-stop-script "$1" --check --by switchboard || _rc=$?
    _coord-stop-why "$REPLY" "$1"
    return $_rc
}

# Stops coordinator $1 through the stop script, forced with reason $2 if one
# is given. Not clean: with a verb in $3 (stop, restart), asks "<name>: <why>:
# <verb> anyway?" and Yes forces it; without, alerts. What the script won't
# end or fails at is alerted. Returns 0 if it stopped or wasn't running.
_coord-end() {
    local _name=$1 _reason=${2:-} _verb=${3:-}
    local -a _args=("$_name" --by switchboard)
    local -i _rc=0
    [[ -n "$_reason" ]] && _args+=(--force --reason "$_reason")
    _coord-stop-script "${_args[@]}" || _rc=$?
    (( _rc == 0 )) && return 0
    _coord-stop-why "$REPLY" "$_name"
    case $_rc in
        1)
            if [[ -n "$_verb" && -z "$_reason" ]]; then
                _coord-confirm "${_name}: ${REPLY}: ${_verb} anyway?" || return 1
                _coord-end "$_name" "Stephen: Yes to ${_verb} anyway"
                return
            fi
            _coord-alert "${_name}: not stopped" "$REPLY" ;;
        3) _coord-alert "${_name}: not stopped" "$REPLY" ;;
        *) _coord-alert "${_name}: stop failed (exit ${_rc})" "$REPLY" ;;
    esac
    return 1
}

# Stops coordinator $2 for `stop` or `restart` ($1), --yes if $3 is set. The
# brain coordinator is ended only by Stephen, so a running one is always
# asked about, clean or not, --yes or not (decision 0015 §4, §5).
_coord-end-asking() {
    local _verb=$1 _name=$2 _yes=${3:-}
    if [[ "$_name" == brain ]] && _coord-has-session brain; then
        if _coord-paused brain; then
            _coord-confirm "the brain coordinator: ${_verb} it?" || return 1
            _coord-end brain "" "$_verb"
        else
            _coord-confirm "the brain coordinator: ${REPLY}: ${_verb} it anyway?" || return 1
            _coord-end brain "Stephen: Yes to ${_verb} the brain coordinator anyway"
        fi
    elif [[ -n "$_yes" ]]; then
        _coord-end "$_name" "Stephen: coord ${_verb} --yes"
    else
        _coord-end "$_name" "" "$_verb"
    fi
}

# Waits up to _COORD_LAUNCH_TIMEOUT for the windows of the coordinators named
# to close (each runs only the tmux client). Sets REPLY to one still open.
_coord-wait-gone() {
    local _node _instance
    local -a _names=("$@")
    local -i _tries=$(( _COORD_LAUNCH_TIMEOUT * 10 ))
    while :; do
        REPLY=
        _coord-windows | while read -r _node _instance; do
            (( ${_names[(Ie)$_instance]} )) && REPLY=$_instance
        done
        [[ -z "$REPLY" ]] && return 0
        (( _tries-- > 0 )) || return 1
        sleep 0.1
    done
}

# Escape on level one returns 0: closing the menu is not a failure.
coord-menu() {
    local _name=
    [[ "${1:-}" == (-h|--help) ]] && { print -r -- "usage: coord menu: ${_COORD_DESCRIPTIONS[menu]}"; return 0; }
    while _coord-menu-pick "$_name"; do
        _name=$REPLY
        [[ "$_name" == --all ]] && { coord-stop --all; return }
        _coord-menu-act "$_name" || continue
        case "$REPLY" in
            toggle|start) coord-toggle "$_name" ;;
            stop)         coord-stop "$_name" ;;
            restart)      coord-restart "$_name" ;;
        esac
        return
    done
    return 0
}

# One name always goes to the script, running in tmux or not: it clears a
# stale strip cell, and finds a session started outside tmux, which it
# won't end. --all stops those whose tmux session exists. Asking is
# declined: returns 1 having stopped nothing.
coord-stop() {
    local _arg _name _yes= _all= _question _reason
    local -a _names _targets _unclean _failed
    local -A _why
    for _arg; do
        case "$_arg" in
            -h|--help) print -r -- "usage: coord stop {<name>|--all} [--yes]: ${_COORD_DESCRIPTIONS[stop]}"; return 0 ;;
            -y|--yes) _yes=1 ;;
            --all)    _all=1 ;;
            -*)       log-error "[coord] stop: unknown option '${_arg}'"; return 2 ;;
            *)        _names+=("$_arg") ;;
        esac
    done
    if [[ -z "$_all" ]]; then
        (( ${#_names} == 1 )) || { log-error "[coord] stop: expected one name or --all"; return 2; }
        _coord-check-name "${_names[1]}" || return 2
        _coord-stop-ready || return 1
        _coord-end-asking stop "${_names[1]}" "$_yes"
        return
    fi
    (( ! ${#_names} )) || { log-error "[coord] stop: --all takes no name"; return 2; }

    # The brain last: it is the one that would notice the others going.
    for _name in "${(@)_COORD_NAMES:#brain}" brain; do
        (( ${_COORD_NAMES[(Ie)$_name]} )) && _coord-has-session "$_name" || continue
        _targets+=("$_name")
    done
    if (( ! ${#_targets} )); then
        log-info "[coord] no coordinator is running"
        return 0
    fi
    _coord-stop-ready || return 1
    for _name in "${_targets[@]}"; do
        _coord-paused "$_name" && continue
        _unclean+=("$_name")
        _why[$_name]=$REPLY
    done

    if (( ${#_unclean} == 1 )); then
        _question="${_unclean[1]}: ${_why[${_unclean[1]}]}"
    elif (( ${#_unclean} )); then
        _question="notes not clean for ${(j:, :)_unclean}"
    fi
    if (( ${_targets[(Ie)brain]} )); then
        _question="${_question:+${_question}; }the brain coordinator too"
    elif [[ -n "$_yes" ]]; then
        _question=
    fi
    [[ -z "$_question" ]] || _coord-confirm "${_question}: stop all anyway?" || return 1

    _reason="Stephen: Yes to stop all anyway"
    [[ -n "$_yes" ]] && _reason="Stephen: coord stop --all --yes"
    for _name in "${_targets[@]}"; do
        if (( ${_unclean[(Ie)$_name]} )); then
            _coord-end "$_name" "$_reason" || _failed+=("$_name")
        else
            _coord-end "$_name" || _failed+=("$_name")
        fi
    done
    (( ! ${#_failed} ))
}

# The desktop half of a stop, run by the brain's stop script once it has
# ended the sessions (0015 §2 step 5): it drops their state, waits for their
# windows to close, gives back any strip a shown one held and refreshes the
# strip. Needs no DISPLAY (see _coord-windows). Returns 1 if a window is
# still open.
coord-stopped() {
    local _arg _fd
    local -a _names
    for _arg; do
        case "$_arg" in
            -h|--help) print -r -- "usage: coord stopped <name>...: ${_COORD_DESCRIPTIONS[stopped]}"; return 0 ;;
            -*)        log-error "[coord] stopped: unknown option '${_arg}'"; return 2 ;;
            *)         _coord-check-name "$_arg" || return 2
                       _names+=("$_arg") ;;
        esac
    done
    (( ${#_names} )) || { log-error "[coord] stopped: expected a name"; return 2; }

    for _arg in "${_names[@]}"; do
        rm -f -- "${_COORD_STATE_DIR}/${_arg}" 2>/dev/null
    done
    _coord-wait-gone "${_names[@]}"
    _arg=$REPLY
    if _coord-lock switch; then
        _coord-unpad
        exec {_fd}>&-
    fi
    _coord-poke
    if [[ -n "$_arg" ]]; then
        log-error "[coord] ${_arg}: window still open ${_COORD_LAUNCH_TIMEOUT}s after its session was stopped"
        return 1
    fi
    return 0
}

# Started as it was: shown again if it was shown, else hidden. Not running,
# it is just started, hidden. The stop goes through the script even when no
# tmux session exists, so one running outside tmux isn't started twice.
coord-restart() {
    local _arg _name= _yes= _shown= _node
    for _arg; do
        case "$_arg" in
            -h|--help) print -r -- "usage: coord restart <name> [--yes]: ${_COORD_DESCRIPTIONS[restart]}"; return 0 ;;
            -y|--yes) _yes=1 ;;
            -*)       log-error "[coord] restart: unknown option '${_arg}'"; return 2 ;;
            *)        [[ -z "$_name" ]] || { log-error "[coord] restart: expected one name"; return 2; }
                      _name=$_arg ;;
        esac
    done
    [[ -n "$_name" ]] || { log-error "[coord] restart: expected a name"; return 2; }
    _coord-check-name "$_name" || return 2
    _coord-stop-ready || return 1

    if _coord-has-session "$_name"; then
        _node=$(_coord-node "$_name")
        [[ -n "$_node" ]] && bspc query -N -n "${_node}.!hidden" >/dev/null 2>&1 && _shown=1
    fi
    _coord-end-asking restart "$_name" "$_yes" || return 1
    # The script's `coord stopped` has waited for the window; this covers a
    # script that couldn't run it, so the old window is never re-shown.
    _coord-wait-gone "$_name" || {
        log-error "[coord] ${REPLY}: window still open, not restarting"
        return 1
    }

    if [[ -n "$_shown" ]]; then
        _coord-summon "$_name"
    else
        coord-launch "$_name"
    fi
}

# Steps from the shown coordinator. With none shown, both directions re-show
# the last one shown rather than stepping past it: after hiding a coordinator,
# the first press brings back what was just there.
coord-cycle() {
    local _dir=${1:-next} _name _fd
    local -i _i _n=${#_COORD_NAMES}
    [[ "$_dir" == (next|prev) ]] || { log-error "[coord] cycle: expected next or prev, got '$_dir'"; return 1; }

    _coord-lock switch || return 1
    {
        _name=$(_coord-current)
        if [[ -n "$_name" ]]; then
            _i=${_COORD_NAMES[(Ie)$_name]}
            if [[ "$_dir" == next ]]; then
                _i=$(( _i % _n + 1 ))
            else
                _i=$(( (_i + _n - 2) % _n + 1 ))
            fi
        else
            _i=${_COORD_NAMES[(Ie)$(_coord-last-get)]}
            (( _i )) || _i=1
        fi
        _coord-show "${_COORD_NAMES[_i]}"
    } always {
        exec {_fd}>&-
    }
}

# `left`/`right` move the panel's inner edge, so the sign depends on the side:
# docked right, moving the inner edge left widens it; docked left, narrows it.
coord-width() {
    local _arg=${1:-} _step=${2:-$_COORD_WIDTH_STEP} _width _side _fd
    if [[ -z "$_arg" ]]; then
        _coord-width-get
        return
    fi
    case "$_arg" in
        left|right)
            [[ "$_step" =~ '^[0-9]+$' ]] || { log-error "[coord] width: expected a step N after '$_arg', got '$_step'"; return 1; } ;;
        *)
            [[ "$_arg" =~ '^[+-]?[0-9]+$' ]] || { log-error "[coord] width: expected +N, -N, N, left [N] or right [N], got '$_arg'"; return 1; } ;;
    esac

    _coord-lock dock || return 1
    {
        _width=$(_coord-width-get)
        _side=$(_coord-side-get)
        case "$_arg" in
            left|right)
                if [[ "$_arg" == "$_side" ]]; then
                    _width=$(( _width - _step ))
                else
                    _width=$(( _width + _step ))
                fi ;;
            [+-]*) _width=$(( _width + _arg )) ;;
            *)     _width=$_arg ;;
        esac
        _width=$(_coord-width-clamp "$_width")

        mkdir -p "${_COORD_WIDTH_FILE:h}" && print -r -- "$_width" >| "$_COORD_WIDTH_FILE" || return 1

        _coord-redock "$_width" "$_side"
        print -r -- "$_width"
    } always {
        exec {_fd}>&-
    }
}

coord-side() {
    local _side=${1:-} _fd
    if [[ -z "$_side" ]]; then
        _coord-side-get
        return
    fi
    [[ "$_side" == (left|right) ]] || { log-error "[coord] side: expected left or right, got '$_side'"; return 1; }

    _coord-lock dock || return 1
    {
        mkdir -p "${_COORD_SIDE_FILE:h}" && print -r -- "$_side" >| "$_COORD_SIDE_FILE" || return 1
        _coord-redock "$(_coord-width-get)" "$_side"
        print -r -- "$_side"
    } always {
        exec {_fd}>&-
    }
}

coord-hide() {
    local _arg=${1:-} _name _node _instance _fd
    local -i _hidden=0
    [[ -z "$_arg" || "$_arg" == --toggle ]] || { log-error "[coord] hide: expected --toggle or nothing, got '$_arg'"; return 1; }

    _coord-lock switch || return 1
    {
        _coord-windows '.!hidden' | while read -r _node _instance; do
            bspc node "$_node" --flag hidden=on && _hidden=1
        done
        if (( _hidden )); then
            _coord-unpad
            _coord-poke
        elif [[ "$_arg" == --toggle ]]; then
            _name=$(_coord-last-get)
            _coord-show "${_name:-${_COORD_NAMES[1]}}"
        fi
    } always {
        exec {_fd}>&-
    }
}

# Runs detached (_coord-guard-start), never from a terminal it would tie up.
# Events are only read here; the work happens in _coord-guard-tick once a
# coord window has had no event for _COORD_GUARD_SETTLE seconds (a deadline,
# so other windows' events don't keep pushing it back). bspwm reports every
# motion step of a pointer drag, and a re-dock then would fight the pointer,
# so a drag of a coord window between its pointer_action begin and end holds
# the tick off. Adds and removes of any window are looked at, since a new or
# closed window may be a coordinator. bspc subscribe runs as a coprocess
# without the guard lock, and is killed on every way out.
coord-guard() {
    local _lock="${XDG_RUNTIME_DIR:-${HOME}/.cache}/coord-guard.lock"
    local _gfd _sub _line _event
    local -F _due _wait
    local -i _dragging=0
    local -a _f
    local -A _known

    zmodload -F zsh/datetime p:EPOCHREALTIME || return 1
    exec {_gfd}>"$_lock"
    flock -n "$_gfd" || { exec {_gfd}>&-; return 0; }

    coproc {
        exec {_gfd}>&-
        exec bspc subscribe node_add node_remove node_geometry node_state node_flag pointer_action 2>/dev/null
    }
    _sub=$!
    trap 'kill "$_sub" 2>/dev/null; exit 143' TERM INT HUP

    {
        # A first look at once: fills _known, and quits if nothing is shown.
        _due=$EPOCHREALTIME
        while :; do
            if (( _due && ! _dragging )); then
                _wait=$(( _due - EPOCHREALTIME ))
                if (( _wait <= 0 )) || ! read -r -t "$_wait" -p _line; then
                    _coord-guard-tick || break
                    _due=0
                    # A failed read before the deadline is EOF: bspwm is gone.
                    kill -0 "$_sub" 2>/dev/null || break
                    continue
                fi
            else
                read -r -p _line || break
            fi
            _f=(${=_line})
            _event=${_f[1]}
            if [[ "$_event" != node_(add|remove) ]]; then
                (( ${+_known[${_f[4]:-}]} )) || continue
                [[ "$_event" == pointer_action ]] && { [[ "${_f[6]}" == begin ]] && _dragging=1 || _dragging=0 }
            fi
            _due=$(( EPOCHREALTIME + _COORD_GUARD_SETTLE ))
        done
    } always {
        kill "$_sub" 2>/dev/null
        trap - TERM INT HUP
        [[ -n "$_gfd" ]] && exec {_gfd}>&-
    }
    return 0
}

coord-list() {
    local _node _instance _state
    _coord-windows | while read -r _node _instance; do
        _state=visible
        bspc query -N -n "${_node}.hidden" >/dev/null 2>&1 && _state=hidden
        printf '%-14s %-8s %s\n' "$_instance" "$_state" "$_node"
    done
}

# Runs in every Claude Code session's hooks, so it never prints to stdout and
# always returns 0. Sessions outside the actors dir are rejected on a plain
# substring test before jq is spawned. Only a change of state is written
# (atomically, by rename) or pokes polybar, so the per-tool events cost a
# read when nothing changes. Event to state:
#   UserPromptSubmit, PostToolUse, PostToolUseFailure  busy (an answered
#                                                      question or granted
#                                                      permission clears waiting)
#   PreToolUse for AskUserQuestion                     waiting (the question
#                                                      is the notification)
#   Notification (permission and elicitation types)    waiting
#   Stop, StopFailure, SessionStart                    idle
#   SessionEnd                                         state removed
# idle_prompt is not waiting: coordinators run self-paced /loops that end a
# turn every tick, so it would fire about 60s after each one and keep the
# strip red.
coord-status() {
    local _json _cwd _event _type _tool _message _name _rest _state _old _file _tmp
    [[ -t 0 ]] && return 0
    read -r -d '' _json || :
    [[ "$_json" == *"\"cwd\""*"\"${_COORD_ACTORS_DIR}/"* ]] || return 0
    (( ${+commands[jq]} )) || return 0

    {
        read -r _cwd
        read -r _event
        read -r _type
        read -r _tool
        read -r -d '' _message
    } < <(jq -r '.cwd // "", .hook_event_name // "", .notification_type // "", .tool_name // "",
        (.message // (.tool_input.questions[0].question)? // "" | tostring | gsub("\\s+"; " "))' <<< "$_json" 2>/dev/null)
    _event=${1:-$_event} _message=${_message%$'\n'}

    _rest=${_cwd#${_COORD_ACTORS_DIR}/}
    [[ "$_rest" != "$_cwd" ]] || return 0
    _name=${_rest%%/*}
    (( ${_COORD_NAMES[(Ie)$_name]} )) || return 0

    case "$_event" in
        UserPromptSubmit|PostToolUse|PostToolUseFailure) _state=busy ;;
        PreToolUse)
            [[ "$_tool" == AskUserQuestion ]] || return 0
            _state=waiting ;;
        Notification)
            [[ "$_type" == (permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input) ]] || return 0
            _state=waiting ;;
        Stop|StopFailure|SessionStart) _state=idle ;;
        SessionEnd) _state= ;;
        *) return 0 ;;
    esac

    _file="${_COORD_STATE_DIR}/${_name}"
    [[ -r "$_file" ]] && _old=$(<"$_file")
    [[ "$_state" == "$_old" ]] && return 0

    if [[ -z "$_state" ]]; then
        rm -f -- "$_file" 2>/dev/null
    else
        _tmp="${_file}.$$"
        { mkdir -p -- "$_COORD_STATE_DIR" && print -r -- "$_state" >| "$_tmp" && mv -f -- "$_tmp" "$_file" } 2>/dev/null \
            || { rm -f -- "$_tmp" 2>/dev/null; return 0 }
        [[ "$_state" == waiting ]] && _coord-notify "$_name" "${_message:-Waiting for input}" 2>/dev/null
    fi
    _coord-poke
    return 0
}

# Styles stack: the activity state colours the icon (not running dim, idle the
# module's foreground, busy, or waiting as a filled pill), and shown adds an
# underline. Running means the coordinator's window or its tmux session
# exists; the state file of one that isn't running is stale and removed.
# Polybar action tags wrap each icon, so a left-click is `toggle <name>`;
# right-click and scroll are the module's own handlers.
coord-bar() {
    local _arg _name _icon _cell _out=
    local -A _color _running _shown

    _coord-colors
    _color=("${(@kv)_COORD_BAR_COLORS}")
    for _arg in "$@"; do
        [[ "$_arg" =~ '^([a-z]+)=(#[0-9A-Fa-f]{6,8})$' ]] && (( ${+_color[${match[1]}]} )) \
            && _color[${match[1]}]=${match[2]}
    done

    _coord-scan
    for _name in "${_COORD_NAMES[@]}"; do
        _coord-activity "$_name"
        _icon=" ${_COORD_ICONS[$_name]:-${_name[1]}} "
        case "$REPLY" in
            off)     _cell="%{F${_color[dim]}}${_icon}%{F-}" ;;
            busy)    _cell="%{F${_color[busy]}}${_icon}%{F-}" ;;
            waiting) _cell="%{B${_color[waiting]}}%{F${_color[ink]}}${_icon}%{F-}%{B-}" ;;
            *)       _cell=$_icon ;;
        esac
        (( ${+_shown[$_name]} )) && _cell="%{u${_color[shown]}}%{+u}${_cell}%{-u}"
        _out+="%{A1:coord toggle ${_name}:}${_cell}%{A}"
    done
    print -r -- "$_out"
}
