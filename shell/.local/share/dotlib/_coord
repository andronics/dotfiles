#!/usr/bin/env zsh

# _coord - coordinator switchboard: one hidden floating terminal per Claude
# Code coordinator, summoned one at a time.
#
# Each coordinator window is alacritty with class `coord` and the
# coordinator's name as instance. bspwmrc's `coord` rule makes it floating,
# sticky and hidden at birth; showing one docks it to the left or right edge
# of the focused monitor and sets that monitor's left_padding or right_padding
# to cover it, so tiled windows give the strip up only while a coordinator is
# shown. The panel keeps bspwm's window gap as a tiled window would; the width
# is its visible width, gap excluded. The width and side are persisted in
# ${XDG_STATE_HOME}/coord/{width,side}.
# Width can be set absolutely, by delta, or by moving the panel's inner edge
# `left`/`right`, which resolves to wider or narrower from the side. The
# session runs inside tmux (`<name>-coordinator`), so closing the window only
# detaches it, and a session started from another terminal is attached rather
# than duplicated.
#
# Usage:
#   source "${DOTLIB}/_coord"
#
# Dependencies:
#   Required:
#     - _common, _log
#   External:
#     - bspwm (bspc), xprop, jq, alacritty, tmux, flock
#     - _coordinator from shell/.config/zsh/.zshrc.d/55-coordinators

[[ -n "${COORD_LOADED:-}" ]] && return 0
declare -gr COORD_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _coord requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

declare -g _COORD_CLASS="coord"
declare -g _COORD_LAUNCH_TIMEOUT="${COORD_LAUNCH_TIMEOUT:-10}"
declare -g _COORD_WIDTH_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coord/width"
declare -gi _COORD_WIDTH_DEFAULT=1280 _COORD_WIDTH_MIN=640 _COORD_WIDTH_MAX=2560
declare -gi _COORD_WIDTH_STEP=128
declare -g _COORD_SIDE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coord/side"
declare -g _COORD_SIDE_DEFAULT=right

typeset -gA _COORD_DESCRIPTIONS=(
    [toggle]="Show <name>'s window docked on the dock side's edge (launching it if needed), or hide it if it is focused"
    [width]="Print the dock panel's visible width (the reserved strip is that plus bspwm's window_gap), or set it with {+N|-N|N} (${_COORD_WIDTH_MIN}-${_COORD_WIDTH_MAX}) or move the inner edge with {left|right} [N] (default ${_COORD_WIDTH_STEP}), resizing a shown coordinator"
    [side]="Print the dock side, or set it with {left|right}, re-docking a shown coordinator"
    [launch]="Start <name>'s window hidden, attaching to its tmux session if one exists"
    [list]="List coordinator windows and whether each is hidden or visible"
)

# ------------------------------
# Private Helpers
# ------------------------------

_coord-check-name() {
    [[ "$1" =~ '^[a-z0-9][a-z0-9-]*$' ]] && return 0
    log-error "[coord] invalid coordinator name: '$1'"
    return 1
}

# Prints "<node> <instance>" for each coord window bspwm manages, narrowed by
# an optional node-selector modifier such as `.!hidden`.
_coord-windows() {
    local _modifier=${1:-} _node _wm_class
    for _node in ${(f)"$(bspc query -N -n ".window${_modifier}" 2>/dev/null)"}; do
        _wm_class=$(xprop -id "$_node" WM_CLASS 2>/dev/null) || continue
        [[ "$_wm_class" =~ "= \"([^\"]*)\", \"${_COORD_CLASS}\"\$" ]] && print -r -- "$_node ${match[1]}"
    done
}

_coord-node() {
    local _node _instance
    _coord-windows | while read -r _node _instance; do
        [[ "$_instance" == "$1" ]] && { print -r -- "$_node"; return 0; }
    done
}

# Polls bspwm rather than X: the window exists in X a moment before bspwm
# manages it, and bspc rejects a node it doesn't know yet.
_coord-wait() {
    local _node _tries=$(( _COORD_LAUNCH_TIMEOUT * 10 ))
    while (( _tries-- > 0 )); do
        _node=$(_coord-node "$1")
        [[ -n "$_node" ]] && { print -r -- "$_node"; return 0; }
        sleep 0.1
    done
    log-error "[coord] $1: no window after ${_COORD_LAUNCH_TIMEOUT}s"
    return 1
}

_coord-width-clamp() {
    local -i _width=$1
    (( _width < _COORD_WIDTH_MIN )) && _width=_COORD_WIDTH_MIN
    (( _width > _COORD_WIDTH_MAX )) && _width=_COORD_WIDTH_MAX
    print -r -- "$_width"
}

_coord-width-get() {
    local _width
    _width=$(<"$_COORD_WIDTH_FILE") 2>/dev/null
    [[ "$_width" =~ '^[0-9]+$' ]] || _width=$_COORD_WIDTH_DEFAULT
    _coord-width-clamp "$_width"
}

_coord-side-get() {
    local _side
    _side=$(<"$_COORD_SIDE_FILE") 2>/dev/null
    [[ "$_side" == (left|right) ]] || _side=$_COORD_SIDE_DEFAULT
    print -r -- "$_side"
}

# Serialises the read-modify-write of the width and side files, e.g. a
# held-down key's repeats. Sets the caller's _fd; the caller closes it.
_coord-dock-lock() {
    local _lock="${XDG_RUNTIME_DIR:-${HOME}/.cache}/coord-dock.lock"
    exec {_fd}>"$_lock"
    flock -w "$_COORD_LAUNCH_TIMEOUT" "$_fd" && return 0
    exec {_fd}>&-
    log-error "[coord] dock lock busy"
    return 1
}

# Docks the node to the <side> edge of <monitor> (default: the focused one,
# moving it there) as if it were one more tiled window: <width> wide including
# its border, inset by the window gap from the monitor edge and from the top
# and bottom padding, and reserves the strip with that side's padding,
# releasing the other side's. bspc only moves and resizes floating windows
# relatively, hence the deltas from the current floating rectangle.
#
# bspwm's gap model, measured with xwininfo (gap 5, border 1): the tiling
# area is the monitor minus monitor and desktop padding; its root is inset by
# the gap on the left and top only, and every leaf gives up the gap on its
# right and bottom, so tiled windows sit the gap away from every area edge
# and from each other. The panel takes the gap on all four sides, and the
# padding is <width> + gap: the tiled area's own trailing gap supplies the
# space between it and the panel, and the extra gap is the panel's outer inset.
_coord-place() {
    local _node=$1 _width=$2 _side=$3 _mon=${4:-} _other _layout _gapless
    local -i _mx _my _mw _mh _top _bottom _dtop _dbottom _gap _bw _fx _fy _fw _fh _x _y _w _h

    [[ -n "$_mon" ]] || _mon=$(bspc query -M -m focused) || return 1
    if [[ "$(bspc query -M -n "$_node")" != "$_mon" ]]; then
        bspc node "$_node" --to-monitor "$_mon" || return 1
    fi

    read -r _mx _my _mw _mh <<< "$(bspc query -T -m "$_mon" \
        | jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')"
    read -r _bw _fx _fy _fw _fh <<< "$(bspc query -T -n "$_node" \
        | jq -r '.client | "\(.borderWidth) \(.floatingRectangle | "\(.x) \(.y) \(.width) \(.height)")"')"
    # Per-monitor, not the global `bspc config`: tiled windows obey the
    # monitor's own padding, which can differ from bspwmrc's global value.
    _top=$(bspc config -m "$_mon" top_padding)
    _bottom=$(bspc config -m "$_mon" bottom_padding)
    # Gap and desktop padding are per-desktop, and the panel is sticky, so it
    # matches the desktop shown at place time; others may differ.
    read -r _gap _dtop _dbottom _layout <<< "$(bspc query -T -d "${_mon}:focused" \
        | jq -r '"\(.windowGap // "") \(.padding.top) \(.padding.bottom) \(.layout)"')"
    [[ -n "$_gap" ]] || _gap=$(bspc config window_gap)
    _gapless=$(bspc config gapless_monocle)
    [[ "$_gapless" == true && "$_layout" == monocle ]] && _gap=0
    (( _gap < 0 )) && _gap=0

    # X draws the border outside the floating rectangle.
    if [[ "$_side" == left ]]; then
        _x=$(( _mx + _gap )) _other=right
    else
        _x=$(( _mx + _mw - _gap - _width )) _other=left
    fi
    _y=$(( _my + _top + _dtop + _gap ))
    _w=$(( _width - 2 * _bw ))
    _h=$(( _mh - _top - _bottom - _dtop - _dbottom - 2 * _gap - 2 * _bw ))

    if (( _w != _fw || _h != _fh )); then
        bspc node "$_node" --resize bottom_right $(( _w - _fw )) $(( _h - _fh ))
    fi
    if (( _x != _fx || _y != _fy )); then
        bspc node "$_node" --move $(( _x - _fx )) $(( _y - _fy ))
    fi
    # The new side is padded before the old one is released, so re-docking
    # never lets tiled windows reflow through the full monitor width.
    bspc config -m "$_mon" "${_side}_padding" $(( _width + _gap ))
    [[ "$(bspc config -m "$_mon" "${_other}_padding")" == 0 ]] || bspc config -m "$_mon" "${_other}_padding" 0
}

# Re-places every shown coordinator on its own monitor.
_coord-redock() {
    local _width=$1 _side=$2 _node _instance
    _coord-windows '.!hidden' | while read -r _node _instance; do
        _coord-place "$_node" "$_width" "$_side" "$(bspc query -M -n "$_node")"
    done
}

# Gives the strip back to tiled windows on every monitor no coordinator is
# shown on, whichever side it was on. Assumes left_padding and right_padding
# are otherwise 0, as bspwmrc sets them.
_coord-unpad() {
    local _node _instance _mon _pad
    local -A _held
    _coord-windows '.!hidden' | while read -r _node _instance; do
        _held[$(bspc query -M -n "$_node")]=1
    done
    for _mon in ${(f)"$(bspc query -M)"}; do
        (( ${+_held[$_mon]} )) && continue
        for _pad in left_padding right_padding; do
            [[ "$(bspc config -m "$_mon" "$_pad")" == 0 ]] || bspc config -m "$_mon" "$_pad" 0
        done
    done
}

# ------------------------------
# Public
# ------------------------------

coord-launch() {
    local _name=$1
    _coord-check-name "$_name" || return 1

    # `; exec zsh -i`: if claude exits or fails to start (e.g. 55-coordinators
    # isn't loaded), the window keeps a shell showing why instead of vanishing.
    setsid -f alacritty \
        --class "${_COORD_CLASS},${_name}" \
        --title "${_COORD_CLASS} - ${_name}" \
        -e tmux new-session -A -s "${_name}-coordinator" \
            "zsh -ic '_coordinator ${_name}; exec zsh -i'" \
        </dev/null >/dev/null 2>&1
}

coord-toggle() {
    local _name=$1 _node _other _instance
    _coord-check-name "$_name" || return 1

    # Serialises a double-tapped chord, so the second press finds the window
    # the first one launched instead of launching another.
    local _lock="${XDG_RUNTIME_DIR:-${HOME}/.cache}/coord-${_name}.lock" _fd
    exec {_fd}>"$_lock"
    flock -w "$_COORD_LAUNCH_TIMEOUT" "$_fd" || { exec {_fd}>&-; log-error "[coord] $_name: lock busy"; return 1; }

    {
        _node=$(_coord-node "$_name")
        if [[ -z "$_node" ]]; then
            # Subshell closes its copy of the lock fd so alacritty doesn't
            # inherit it and hold the lock for its lifetime.
            ( exec {_fd}>&-; coord-launch "$_name" ) || return 1
            _node=$(_coord-wait "$_name") || return 1
        fi

        if bspc query -N -n "${_node}.focused.!hidden" >/dev/null 2>&1; then
            bspc node "$_node" --flag hidden=on
            _coord-unpad
            return
        fi

        # Padding is set before the swap and released only after it, so
        # swapping coordinators never lets tiled windows reflow into the strip.
        _coord-place "$_node" "$(_coord-width-get)" "$(_coord-side-get)" || return 1

        _coord-windows '.!hidden' | while read -r _other _instance; do
            [[ "$_other" != "$_node" ]] && bspc node "$_other" --flag hidden=on
        done

        bspc node "$_node" --flag hidden=off --focus
        _coord-unpad
    } always {
        exec {_fd}>&-
    }
}

# `left`/`right` move the panel's inner edge, so the sign depends on the side:
# docked right, moving the inner edge left widens it; docked left, narrows it.
coord-width() {
    local _arg=${1:-} _step=${2:-$_COORD_WIDTH_STEP} _width _side _fd
    if [[ -z "$_arg" ]]; then
        _coord-width-get
        return
    fi
    case "$_arg" in
        left|right)
            [[ "$_step" =~ '^[0-9]+$' ]] || { log-error "[coord] width: expected a step N after '$_arg', got '$_step'"; return 1; } ;;
        *)
            [[ "$_arg" =~ '^[+-]?[0-9]+$' ]] || { log-error "[coord] width: expected +N, -N, N, left [N] or right [N], got '$_arg'"; return 1; } ;;
    esac

    _coord-dock-lock || return 1
    {
        _width=$(_coord-width-get)
        _side=$(_coord-side-get)
        case "$_arg" in
            left|right)
                if [[ "$_arg" == "$_side" ]]; then
                    _width=$(( _width - _step ))
                else
                    _width=$(( _width + _step ))
                fi ;;
            [+-]*) _width=$(( _width + _arg )) ;;
            *)     _width=$_arg ;;
        esac
        _width=$(_coord-width-clamp "$_width")

        mkdir -p "${_COORD_WIDTH_FILE:h}" && print -r -- "$_width" >| "$_COORD_WIDTH_FILE" || return 1

        _coord-redock "$_width" "$_side"
        print -r -- "$_width"
    } always {
        exec {_fd}>&-
    }
}

coord-side() {
    local _side=${1:-} _fd
    if [[ -z "$_side" ]]; then
        _coord-side-get
        return
    fi
    [[ "$_side" == (left|right) ]] || { log-error "[coord] side: expected left or right, got '$_side'"; return 1; }

    _coord-dock-lock || return 1
    {
        mkdir -p "${_COORD_SIDE_FILE:h}" && print -r -- "$_side" >| "$_COORD_SIDE_FILE" || return 1
        _coord-redock "$(_coord-width-get)" "$_side"
        print -r -- "$_side"
    } always {
        exec {_fd}>&-
    }
}

coord-list() {
    local _node _instance _state
    _coord-windows | while read -r _node _instance; do
        _state=visible
        bspc query -N -n "${_node}.hidden" >/dev/null 2>&1 && _state=hidden
        printf '%-14s %-8s %s\n' "$_instance" "$_state" "$_node"
    done
}
