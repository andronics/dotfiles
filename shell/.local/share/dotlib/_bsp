# Get focus history
#
# Function: bsp-focus-history
# Description: Get the focus history (recently focused nodes)
# Parameters:
#   $1 - Number of entries (optional, default: all)
# Output: Node IDs, one per line
# Example:
#   bsp-focus-history 5
#
bsp-focus-history() {
    local count="${1:-${#_BSP_FOCUS_HISTORY[@]}}"

    for ((i=0; i<count && i<${#_BSP_FOCUS_HISTORY[@]}; i++)); do
        echo "${_BSP_FOCUS_HISTORY[$i]}"
    done
}

# Focus previous node from history
#
# Function: bsp-focus-previous
# Description: Focus the previously focused node from history
# Returns:
#   0 - Success
#   3 - No previous node in history
# Example:
#   bsp-focus-previous
#
bsp-focus-previous() {
    if [[ ${#_BSP_FOCUS_HISTORY[@]} -gt 0 ]]; then
        local prev="${_BSP_FOCUS_HISTORY[0]}"
        bsp-node-focus "$prev"
    else
        log-warning "No previous node in focus history"
        return 3
    fi
}

# Balance tree
#
# Function: bsp-balance
# Description: Balance the window tree to equalize area
# Parameters:
#   $1 - Desktop selector (optional, default: focused)
# Returns:
#   0 - Success
# Example:
#   bsp-balance
#   bsp-balance web
#
bsp-balance() {
    local desktop="${1:-focused}"

    if _bsp-exec node "@$desktop:/" -B; then
        log-debug "Balanced desktop: $desktop"
        return 0
    else
        return 1
    fi
}

# Equalize splits
#
# Function: bsp-equalize
# Description: Reset all splits to equal size
# Parameters:
#   $1 - Desktop selector (optional, default: focused)
# Returns:
#   0 - Success
# Example:
#   bsp-equalize
#
bsp-equalize() {
    local desktop="${1:-focused}"

    if _bsp-exec node "@$desktop:/" -E; then
        log-debug "Equalized desktop: $desktop"
        return 0
    else
        return 1
    fi
}

# ------------------------------
# Daemon Loops
# ------------------------------
#
# Long-running, event-driven loops meant to run under a supervisor (systemd
# etc), one per feature, so each can be enabled/disabled independently. Each
# blocks forever subscribing to the same bspc event set - kept as two
# separate subscribe streams (not merged into one) so bsp-balance-daemon
# and bsp-desktops-daemon stay independently startable/stoppable processes.

# Auto-balance the window tree on every layout-affecting event
#
# Function: bsp-balance-daemon
# Description: Subscribe to node events and rebalance the tree after each
#   one. Blocks forever - run under a supervisor (systemd, etc).
# Returns:
#   1 - Singleton lock held by another instance
# Example:
#   bsp-balance-daemon
#
bsp-balance-daemon() {
    # Explicit lock name: singleton-get-process-name's basename "$0" always
    # resolves to its own function name under zsh's FUNCTION_ARGZERO (every
    # function reassigns $0 to itself on entry), so the bare/auto-detected
    # form silently collides with any other function-based singleton-lock
    # caller instead of naming this daemon.
    [[ "$BSP_SINGLETON_AVAILABLE" == "true" ]] && { singleton-lock "bsp-balance-daemon" || return 1; }

    log-info "bsp-balance-daemon: subscribing to node events"

    bspc subscribe node_add node_remove node_state node_geometry | while read -r _event; do
        log-debug "event: $_event"
        _bsp-balance-tree
    done
}

# Balance every window and every intermediate node on the focused desktop
#
# Function: _bsp-balance-tree
# Description: Private helper for bsp-balance-daemon. Differs from
#   bsp-balance (single root -B) by balancing each window's north anchor
#   individually, then each non-leaf/non-window node - matches the
#   granularity the standalone bsp-balance script used.
#
_bsp-balance-tree() {
    # `|| true` on both -B calls: most windows/nodes have no @north neighbor
    # or nothing left to balance, so bspc legitimately exits non-zero here
    # on every other event. The bsp wrapper runs under set -e, so a bare
    # unguarded failure here would kill the whole daemon on the very next
    # window move - this loop must tolerate the expected no-op case.
    local _window
    for _window in $(bspc query -N -d -n .window); do
        log-debug "balancing window: $_window"
        _bsp-exec node "${_window}#@north" -B || true
    done

    local _root _node
    _root=$(bspc query -N '@/' -n)
    for _node in $(bspc query -N '@/' -n '.descendant_of.!window' | grep -v "$_root"); do
        log-debug "balancing node: $_node"
        _bsp-exec node "$_node" -B || true
    done

    _bsp-emit "$BSP_EVENT_BALANCE_TICK"
}

# Auto-manage desktop count on a monitor: always keep exactly one spare
#
# Function: bsp-desktops-daemon
# Description: Subscribe to node events; add a desktop when the monitor is
#   fully occupied, remove unoccupied desktops down to one spare. Blocks
#   forever - run under a supervisor (systemd, etc).
# Parameters:
#   $1 - Monitor selector (optional, default: focused)
# Returns:
#   1 - Singleton lock held by another instance
# Example:
#   bsp-desktops-daemon
#   bsp-desktops-daemon HDMI-1
#
bsp-desktops-daemon() {
    local _monitor="${1:-focused}"

    # Explicit lock name (see bsp-balance-daemon) - also correctness-load-
    # bearing here: a concurrent second instance could race
    # _bsp-desktops-manage and add/remove desktops in duplicate.
    [[ "$BSP_SINGLETON_AVAILABLE" == "true" ]] && { singleton-lock "bsp-desktops-daemon" || return 1; }

    log-info "bsp-desktops-daemon: subscribing to node events (monitor=$_monitor)"

    _bsp-desktops-manage "$_monitor"

    bspc subscribe node_add node_remove node_state node_geometry | while read -r _event; do
        log-debug "event: $_event"
        _bsp-desktops-manage "$_monitor"
    done
}

# Private helpers for bsp-desktops-daemon. Kept underscore-prefixed (not
# bsp-desktop-*) because they auto-number desktops by an incrementing
# counter rather than taking an explicit name like bsp-desktop-add/remove -
# a different contract from the public named-desktop API above.
_bsp-desktops-manage() {
    local _monitor="$1"
    local _total _occupied

    _total=$(_bsp-desktops-total "$_monitor")
    _occupied=$(_bsp-desktops-occupied "$_monitor")

    [[ "$_occupied" -eq "$_total" ]] && _bsp-desktops-auto-add "$_monitor"
    [[ "$_occupied" -lt $((_total - 1)) ]] && _bsp-desktops-auto-remove "$_monitor"

    _bsp-emit "$BSP_EVENT_DESKTOPS_TICK" "monitor=$_monitor"
}

_bsp-desktops-total() {
    _bsp-exec query -D -m "$1" | wc -l
}

_bsp-desktops-occupied() {
    _bsp-exec query -D -d ".occupied" -m "$1" | wc -l
}

_bsp-desktops-auto-add() {
    local _monitor="$1"
    log-debug "adding desktop $_BSP_DESKTOPS_NEXT_ID on $_monitor"
    # || true: e.g. a name collision with an existing desktop. bsp runs
    # under set -e - an unguarded failure here would kill the whole daemon.
    # Counter still advances so the next event's attempt uses a fresh id.
    _bsp-exec monitor "$_monitor" -a "$_BSP_DESKTOPS_NEXT_ID" || true
    ((_BSP_DESKTOPS_NEXT_ID++)) || true
}

_bsp-desktops-auto-remove() {
    local _monitor="$1"
    local _total _occupied

    _total=$(_bsp-desktops-total "$_monitor")
    _occupied=$(_bsp-desktops-occupied "$_monitor")

    while [[ "$_occupied" -lt $((_total - 1)) ]]; do
        log-debug "removing unoccupied desktop on $_monitor"
        # || break, not || true: if -r fails, occupied/total won't change
        # and the while condition stays true forever - break instead of
        # busy-looping. set -e still needs the guard either way.
        _bsp-exec desktop "any.!occupied" -r || break

        _total=$(_bsp-desktops-total "$_monitor")
        _occupied=$(_bsp-desktops-occupied "$_monitor")
    done
}

