#!/usr/bin/env zsh

# _bsp - Binary Space Partition Window Manager Integration
# Part of the dotfiles library v2.0
# Version: 1.0.0
#
# Usage:
#   source "${DOTLIB}/_bsp"
#
# Provides:
#   - BSP state management and queries
#   - Desktop and monitor operations
#   - Node (window) manipulation
#   - Rule management
#   - Configuration management
#   - Event monitoring and subscription
#   - Layout presets and saving
#   - Focus and selection history
#
# Dependencies:
#   Required:
#     - _common v2.0: Core utilities
#     - bsp: Window manager
#     - bspc: BSP client
#   Optional (gracefully degraded):
#     - _log v2.0: Structured logging
#     - _events v2.0: Event system integration
#     - _cache v2.0: Query result caching
#     - _config v2.0: Configuration persistence
#     - _lifecycle v2.0: Process management
#     - jq: JSON parsing for complex queries

# ------------------------------
# Source Guard
# ------------------------------

[[ -n "${BSP_LOADED:-}" ]] && return 0
declare -g BSP_LOADED=1

# ------------------------------
# Version
# ------------------------------

declare -r BSP_VERSION="1.0.0"

# ------------------------------
# Dependency Loading
# ------------------------------

# Load foundation (required)
if ! source "${DOTLIB}/_common" 2>/dev/null; then
    echo "[ERROR] _bsp requires _common - cannot load" >&2
    return 1
fi

# Load _validation (required)
if ! source "${DOTLIB}/_validation" 2>/dev/null; then
    echo "[ERROR] _bsp requires _validation - cannot load" >&2
    return 1
fi

# Load _xdg (required)
if ! source "${DOTLIB}/_xdg" 2>/dev/null; then
    echo "[ERROR] _bsp requires _xdg - cannot load" >&2
    return 1
fi

# Check for required commands
if ! common-command-exists bspc; then
    echo "[ERROR] _bsp requires bspc command - is BSP installed?" >&2
    return 1
fi

# Load infrastructure (optional with fallbacks)
if ! source "${DOTLIB}/_log" 2>/dev/null; then
    log-info() { echo "[INFO] $*"; }
    log-error() { echo "[ERROR] $*" >&2; }
    log-warn() { echo "[WARN] $*" >&2; }
    log-warning() { echo "[WARN] $*" >&2; }
    log-debug() { [[ "${BSP_DEBUG:-false}" == "true" ]] && echo "[DEBUG] $*" >&2 || true; }
    log-trace() { [[ "${BSP_TRACE:-false}" == "true" ]] && echo "[TRACE] $*" >&2 || true; }
    log-success() { echo "[SUCCESS] $*"; }
fi

# Check for optional extensions
if source "${DOTLIB}/_events" 2>/dev/null; then
    declare -g BSP_EVENTS_AVAILABLE=true
else
    declare -g BSP_EVENTS_AVAILABLE=false
fi

if source "${DOTLIB}/_cache" 2>/dev/null; then
    declare -g BSP_CACHE_AVAILABLE=true
else
    declare -g BSP_CACHE_AVAILABLE=false
fi

if source "${DOTLIB}/_config" 2>/dev/null; then
    declare -g BSP_CONFIG_AVAILABLE=true
else
    declare -g BSP_CONFIG_AVAILABLE=false
fi

if source "${DOTLIB}/_lifecycle" 2>/dev/null; then
    declare -g BSP_LIFECYCLE_AVAILABLE=true
else
    declare -g BSP_LIFECYCLE_AVAILABLE=false
fi

if source "${DOTLIB}/_singleton" 2>/dev/null; then
    declare -g BSP_SINGLETON_AVAILABLE=true
else
    declare -g BSP_SINGLETON_AVAILABLE=false
fi

# ------------------------------
# Configuration
# ------------------------------

# XDG paths
declare -g BSP_CONFIG_DIR="$(xdg-config-dir bsp)"
declare -g BSP_CACHE_DIR="$(xdg-cache-dir bsp)"
declare -g BSP_STATE_DIR="$(xdg-state-dir bsp)"
declare -g BSP_DATA_DIR="$(xdg-data-dir bsp)"

# Behavior configuration
declare -g BSP_DEBUG="${BSP_DEBUG:-false}"
declare -g BSP_VERBOSE="${BSP_VERBOSE:-false}"
declare -g BSP_DRY_RUN="${BSP_DRY_RUN:-false}"
declare -g BSP_EMIT_EVENTS="${BSP_EMIT_EVENTS:-true}"

# Cache configuration
declare -g BSP_CACHE_TTL="${BSP_CACHE_TTL:-5}"  # 5 seconds for dynamic data
declare -g BSP_CACHE_STATIC_TTL="${BSP_CACHE_STATIC_TTL:-300}"  # 5 minutes for static data

# BSP specific configuration
declare -g BSP_SOCKET="${BSP_SOCKET:-/tmp/bspwm_0_0-socket}"
declare -g BSP_DEFAULT_MONITOR="${BSP_DEFAULT_MONITOR:-}"
declare -g BSP_DEFAULT_DESKTOP="${BSP_DEFAULT_DESKTOP:-}"

# Event names
declare -r BSP_EVENT_NODE_ADD="bsp.node.add"
declare -r BSP_EVENT_NODE_REMOVE="bsp.node.remove"
declare -r BSP_EVENT_NODE_FOCUS="bsp.node.focus"
declare -r BSP_EVENT_NODE_STATE="bsp.node.state"
declare -r BSP_EVENT_DESKTOP_FOCUS="bsp.desktop.focus"
declare -r BSP_EVENT_DESKTOP_LAYOUT="bsp.desktop.layout"
declare -r BSP_EVENT_MONITOR_FOCUS="bsp.monitor.focus"
declare -r BSP_EVENT_BALANCE_TICK="bsp.balance.tick"
declare -r BSP_EVENT_DESKTOPS_TICK="bsp.desktops.tick"

# ------------------------------
# Internal State
# ------------------------------

# Event monitor state
declare -g _BSP_EVENT_MONITOR_PID=""
declare -g _BSP_EVENT_MONITOR_ACTIVE=false

# Focus history
declare -g -a _BSP_FOCUS_HISTORY=()
declare -g -i _BSP_FOCUS_HISTORY_SIZE=10

# Saved layouts
declare -g -A _BSP_SAVED_LAYOUTS=()

# Auto-desktop numbering (bsp-desktops-daemon)
declare -g -i _BSP_DESKTOPS_NEXT_ID=1

# ------------------------------
# Internal Helpers
# ------------------------------

# Initialize directories
_bsp-init() {
    mkdir -p "$BSP_CONFIG_DIR" 2>/dev/null || true
    mkdir -p "$BSP_CACHE_DIR" 2>/dev/null || true
    mkdir -p "$BSP_STATE_DIR" 2>/dev/null || true
    mkdir -p "$BSP_DATA_DIR" 2>/dev/null || true
    mkdir -p "$BSP_DATA_DIR/layouts" 2>/dev/null || true
    mkdir -p "$BSP_DATA_DIR/rules" 2>/dev/null || true
}

# Emit an event (uses _events if available)
_bsp-emit() {
    [[ "$BSP_EMIT_EVENTS" != "true" ]] && return 0
    [[ "$BSP_EVENTS_AVAILABLE" != "true" ]] && return 0

    events-emit "$@"
}

# Execute bspc command with error handling
_bsp-exec() {
    local -a cmd=("$@")

    if [[ "$BSP_DRY_RUN" == "true" ]]; then
        log-info "[DRY RUN] Would execute: bspc ${cmd[*]}"
        return 0
    fi

    log-trace "Executing: bspc ${cmd[*]}"

    local output
    if output=$(bspc "${cmd[@]}" 2>&1); then
        echo "$output"
        return 0
    else
        log-error "BSPC command failed" "command=${cmd[*]}" "error=$output"
        return 1
    fi
}

# Cache-aware bspc query
_bsp-query-cached() {
    local cache_key="$1"
    local ttl="${2:-$BSP_CACHE_TTL}"
    shift 2
    local -a query_args=("$@")

    # Check cache if available
    if [[ "$BSP_CACHE_AVAILABLE" == "true" ]]; then
        local cached=$(cache-get "bsp:$cache_key")
        if [[ -n "$cached" ]]; then
            log-trace "Cache hit for: $cache_key"
            echo "$cached"
            return 0
        fi
    fi

    # Execute query
    local result
    if result=$(_bsp-exec "${query_args[@]}"); then
        # Cache result if available
        if [[ "$BSP_CACHE_AVAILABLE" == "true" && -n "$result" ]]; then
            cache-set "bsp:$cache_key" "$result" "$ttl"
        fi
        echo "$result"
        return 0
    else
        return 1
    fi
}

# ------------------------------
# Availability and Status
# ------------------------------

# Check if BSP is running
#
# Function: bsp-is-running
# Description: Verify BSP window manager is running and responsive
# Returns:
#   0 - BSP is running
#   1 - BSP not running or not responsive
# Example:
#   bsp-is-running || echo "BSP not available"
#
bsp-is-running() {
    # Check if bspc can connect to BSP
    bspc wm -g >/dev/null 2>&1
}

# Get BSP version
#
# Function: bsp-version
# Description: Get the version of the running BSP instance
# Output: Version string
# Example:
#   version=$(bsp-version)
#
bsp-version() {
    bsp -v 2>/dev/null
}

# ------------------------------
# Query Operations
# ------------------------------

# Get all desktops
#
# Function: bsp-desktop-list
# Description: List all desktops across all monitors
# Parameters:
#   $1 - Monitor name (optional, filter by monitor)
# Output: Desktop names, one per line
# Example:
#   bsp-desktop-list
#   bsp-desktop-list "HDMI-1"
#
bsp-desktop-list() {
    local monitor="${1:-}"

    if [[ -n "$monitor" ]]; then
        _bsp-query-cached "desktops:$monitor" "$BSP_CACHE_TTL" \
            query -D -m "$monitor" --names
    else
        _bsp-query-cached "desktops:all" "$BSP_CACHE_TTL" \
            query -D --names
    fi
}

# Get all monitors
#
# Function: bsp-monitor-list
# Description: List all connected monitors
# Output: Monitor names, one per line
# Example:
#   monitors=$(bsp-monitor-list)
#
bsp-monitor-list() {
    _bsp-query-cached "monitors" "$BSP_CACHE_STATIC_TTL" \
        query -M --names
}

# Get focused desktop
#
# Function: bsp-desktop-focused
# Description: Get the name of the currently focused desktop
# Output: Desktop name
# Example:
#   current=$(bsp-desktop-focused)
#
bsp-desktop-focused() {
    _bsp-exec query -D -d focused --names
}

# Get focused monitor
#
# Function: bsp-monitor-focused
# Description: Get the name of the currently focused monitor
# Output: Monitor name
# Example:
#   current=$(bsp-monitor-focused)
#
bsp-monitor-focused() {
    _bsp-exec query -M -m focused --names
}

# Get focused node (window) ID
#
# Function: bsp-node-focused
# Description: Get the ID of the currently focused window
# Output: Node ID (hexadecimal)
# Returns:
#   0 - Success
#   3 - No focused node
# Example:
#   node_id=$(bsp-node-focused)
#
bsp-node-focused() {
    local node_id
    node_id=$(_bsp-exec query -N -n focused) || return 3

    [[ -n "$node_id" ]] || return 3
    echo "$node_id"
}

# Get node information
#
# Function: bsp-node-info
# Description: Get detailed information about a node (window)
# Parameters:
#   $1 - Node selector (optional, default: focused)
# Output: JSON object with node information (requires jq)
# Example:
#   info=$(bsp-node-info)
#   info=$(bsp-node-info "0x01234567")
#
bsp-node-info() {
    local node="${1:-focused}"

    if ! common-command-exists jq; then
        log-warning "jq not found, returning raw output"
        _bsp-exec query -T -n "$node"
    else
        _bsp-exec query -T -n "$node" | /usr/bin/jq '.'
    fi
}

# ------------------------------
# Desktop Operations
# ------------------------------

# Focus a desktop
#
# Function: bsp-desktop-focus
# Description: Switch focus to a specific desktop
# Parameters:
#   $1 - Desktop selector (name, index, or direction)
# Returns:
#   0 - Success
#   1 - Failed to focus
# Events:
#   bsp.desktop.focus - Emitted on successful focus change
# Example:
#   bsp-desktop-focus "web"
#   bsp-desktop-focus next
#   bsp-desktop-focus ^3
#
bsp-desktop-focus() {
    local desktop="$1"

    validate-type-string "$desktop" || return 2

    if _bsp-exec desktop -f "$desktop"; then
        _bsp-emit "$BSP_EVENT_DESKTOP_FOCUS" "desktop=$desktop"

        # Invalidate cache
        [[ "$BSP_CACHE_AVAILABLE" == "true" ]] && \
            cache-clear-namespace "bsp:desktop"

        log-debug "Focused desktop: $desktop"
        return 0
    else
        return 1
    fi
}

# Add a new desktop
#
# Function: bsp-desktop-add
# Description: Create a new desktop on a monitor
# Parameters:
#   $1 - Desktop name (required)
#   $2 - Monitor name (optional, default: focused)
# Returns:
#   0 - Success
#   4 - Desktop already exists
# Example:
#   bsp-desktop-add "work"
#   bsp-desktop-add "games" "HDMI-1"
#
bsp-desktop-add() {
    local name="$1"
    local monitor="${2:-focused}"

    validate-type-string "$name" || return 2

    # Check if desktop already exists
    if bsp-desktop-list | grep -q "^${name}$"; then
        log-warning "Desktop already exists: $name"
        return 4
    fi

    if _bsp-exec monitor "$monitor" -a "$name"; then
        log-info "Created desktop: $name on monitor $monitor"

        # Invalidate cache
        [[ "$BSP_CACHE_AVAILABLE" == "true" ]] && \
            cache-clear-namespace "bsp:desktop"

        return 0
    else
        return 1
    fi
}

# Remove a desktop
#
# Function: bsp-desktop-remove
# Description: Remove a desktop (must be empty)
# Parameters:
#   $1 - Desktop name (required)
# Returns:
#   0 - Success
#   1 - Failed (desktop not empty or doesn't exist)
# Example:
#   bsp-desktop-remove "temp"
#
bsp-desktop-remove() {
    local name="$1"

    validate-type-string "$name" || return 2

    if _bsp-exec desktop "$name" -r; then
        log-info "Removed desktop: $name"

        # Invalidate cache
        [[ "$BSP_CACHE_AVAILABLE" == "true" ]] && \
            cache-clear-namespace "bsp:desktop"

        return 0
    else
        log-error "Failed to remove desktop: $name (not empty or doesn't exist)"
        return 1
    fi
}

# Rename a desktop
#
# Function: bsp-desktop-rename
# Description: Rename an existing desktop
# Parameters:
#   $1 - Current desktop name (required)
#   $2 - New desktop name (required)
# Returns:
#   0 - Success
#   3 - Desktop not found
#   4 - New name already exists
# Example:
#   bsp-desktop-rename "temp" "work"
#
bsp-desktop-rename() {
    local current="$1"
    local new="$2"

    validate-type-string "$current" || return 2
    validate-type-string "$new" || return 2

    # Check if current desktop exists
    if ! bsp-desktop-list | grep -q "^${current}$"; then
        log-error "Desktop not found: $current"
        return 3
    fi

    # Check if new name already exists
    if bsp-desktop-list | grep -q "^${new}$"; then
        log-error "Desktop name already exists: $new"
        return 4
    fi

    if _bsp-exec desktop "$current" -n "$new"; then
        log-info "Renamed desktop: $current -> $new"

        # Invalidate cache
        [[ "$BSP_CACHE_AVAILABLE" == "true" ]] && \
            cache-clear-namespace "bsp:desktop"

        return 0
    else
        return 1
    fi
}

# Set desktop layout
#
# Function: bsp-desktop-layout
# Description: Set the layout mode for a desktop
# Parameters:
#   $1 - Layout (tiled|monocle)
#   $2 - Desktop selector (optional, default: focused)
# Returns:
#   0 - Success
#   2 - Invalid layout
# Events:
#   bsp.desktop.layout - Emitted on layout change
# Example:
#   bsp-desktop-layout monocle
#   bsp-desktop-layout tiled "web"
#
bsp-desktop-layout() {
    local layout="$1"
    local desktop="${2:-focused}"

    validate-type-string "$layout" || return 2

    # Validate layout
    if [[ "$layout" != "tiled" && "$layout" != "monocle" ]]; then
        log-error "Invalid layout: $layout (must be tiled or monocle)"
        return 2
    fi

    if _bsp-exec desktop "$desktop" -l "$layout"; then
        _bsp-emit "$BSP_EVENT_DESKTOP_LAYOUT" \
            "desktop=$desktop" \
            "layout=$layout"

        log-debug "Set layout for desktop $desktop: $layout"
        return 0
    else
        return 1
    fi
}

# ------------------------------
# Node (Window) Operations
# ------------------------------

# Focus a node
#
# Function: bsp-node-focus
# Description: Focus a specific node (window)
# Parameters:
#   $1 - Node selector (ID or direction: north|south|east|west|next|prev)
# Returns:
#   0 - Success
#   1 - Failed to focus
# Events:
#   bsp.node.focus - Emitted on focus change
# Example:
#   bsp-node-focus next
#   bsp-node-focus "0x01234567"
#
bsp-node-focus() {
    local node="$1"

    validate-type-string "$node" || return 2

    # Track focus history
    local current
    current=$(bsp-node-focused 2>/dev/null) && {
        _BSP_FOCUS_HISTORY=("$current" "${_BSP_FOCUS_HISTORY[@]:0:$_BSP_FOCUS_HISTORY_SIZE-1}")
    }

    if _bsp-exec node -f "$node"; then
        _bsp-emit "$BSP_EVENT_NODE_FOCUS" "node=$node"
        log-trace "Focused node: $node"
        return 0
    else
        return 1
    fi
}

# Close a node
#
# Function: bsp-node-close
# Description: Close a window gracefully
# Parameters:
#   $1 - Node selector (optional, default: focused)
# Returns:
#   0 - Success
#   1 - Failed to close
# Events:
#   bsp.node.remove - Emitted when node is closed
# Example:
#   bsp-node-close
#   bsp-node-close "0x01234567"
#
bsp-node-close() {
    local node="${1:-focused}"

    if _bsp-exec node "$node" -c; then
        _bsp-emit "$BSP_EVENT_NODE_REMOVE" "node=$node"
        log-debug "Closed node: $node"
        return 0
    else
        return 1
    fi
}

# Kill a node
#
# Function: bsp-node-kill
# Description: Forcefully kill a window
# Parameters:
#   $1 - Node selector (optional, default: focused)
# Returns:
#   0 - Success
#   1 - Failed to kill
# Example:
#   bsp-node-kill
#
bsp-node-kill() {
    local node="${1:-focused}"

    if _bsp-exec node "$node" -k; then
        _bsp-emit "$BSP_EVENT_NODE_REMOVE" "node=$node" "forced=true"
        log-debug "Killed node: $node"
        return 0
    else
        return 1
    fi
}

# Set node state
#
# Function: bsp-node-state
# Description: Change the state of a node (tiled, floating, fullscreen, pseudo_tiled)
# Parameters:
#   $1 - State (tiled|floating|fullscreen|pseudo_tiled)
#   $2 - Node selector (optional, default: focused)
# Returns:
#   0 - Success
#   2 - Invalid state
# Events:
#   bsp.node.state - Emitted on state change
# Example:
#   bsp-node-state floating
#   bsp-node-state tiled "0x01234567"
#
bsp-node-state() {
    local state="$1"
    local node="${2:-focused}"

    validate-type-string "$state" || return 2

    # Validate state
    case "$state" in
        tiled|floating|fullscreen|pseudo_tiled)
            ;;
        *)
            log-error "Invalid state: $state"
            return 2
            ;;
    esac

    if _bsp-exec node "$node" -t "$state"; then
        _bsp-emit "$BSP_EVENT_NODE_STATE" \
            "node=$node" \
            "state=$state"

        log-debug "Set node $node state: $state"
        return 0
    else
        return 1
    fi
}

# Set node flags
#
# Function: bsp-node-flag
# Description: Toggle node flags (hidden, sticky, private, locked, marked, urgent)
# Parameters:
#   $1 - Flag name
#   $2 - Value (on|off|toggle) (optional, default: toggle)
#   $3 - Node selector (optional, default: focused)
# Returns:
#   0 - Success
#   2 - Invalid flag or value
# Example:
#   bsp-node-flag sticky on
#   bsp-node-flag hidden toggle
#
bsp-node-flag() {
    local flag="$1"
    local value="${2:-toggle}"
    local node="${3:-focused}"

    validate-type-string "$flag" || return 2

    # Validate flag
    case "$flag" in
        hidden|sticky|private|locked|marked|urgent)
            ;;
        *)
            log-error "Invalid flag: $flag"
            return 2
            ;;
    esac

    # Validate value
    case "$value" in
        on|off|toggle)
            ;;
        *)
            log-error "Invalid value: $value (must be on, off, or toggle)"
            return 2
            ;;
    esac

    local flag_arg=""
    case "$value" in
        on) flag_arg="=$flag" ;;
        off) flag_arg="~$flag" ;;
        toggle) flag_arg="$flag" ;;
    esac

    if _bsp-exec node "$node" -g "$flag_arg"; then
        log-debug "Set node $node flag: $flag=$value"
        return 0
    else
        return 1
    fi
}

# Move node to desktop
#
# Function: bsp-node-to-desktop
# Description: Move a node to a different desktop
# Parameters:
#   $1 - Desktop selector (required)
#   $2 - Node selector (optional, default: focused)
#   $3 - Follow flag (--follow to switch to desktop) (optional)
# Returns:
#   0 - Success
#   1 - Failed to move
# Example:
#   bsp-node-to-desktop web
#   bsp-node-to-desktop ^3 focused --follow
#
bsp-node-to-desktop() {
    local desktop="$1"
    local node="${2:-focused}"
    local follow="${3:-}"

    validate-type-string "$desktop" || return 2

    local -a cmd=(node "$node" -d "$desktop")
    [[ "$follow" == "--follow" ]] && cmd+=(-f)

    if _bsp-exec "${cmd[@]}"; then
        log-debug "Moved node $node to desktop $desktop"
        return 0
    else
        return 1
    fi
}

# ------------------------------
# Visibility Operations
# ------------------------------

# Toggle polybar visibility. Internal helper shared by bsp-hide/bsp-unhide.
_bsp-polybar-toggle() {
    local action="$1"  # hide|show

    if pgrep "polybar" >/dev/null 2>&1; then
        log-debug "polybar found... $action"
        polybar-msg cmd "$action" >/dev/null 2>&1
    fi
}

# Hide all windows on the focused desktop
#
# Function: bsp-hide
# Description: Hide every leaf node on the focused desktop and hide polybar
# Returns:
#   0 - Success
# Example:
#   bsp-hide
#
bsp-hide() {
    _bsp-polybar-toggle hide

    local _node
    for _node in $(bspc query -N -n .leaf -d focused); do
        log-info "node $_node... hiding"
        bspc node "$_node" -g hidden=on
    done

    return 0
}

# Reveal all hidden windows on the focused desktop
#
# Function: bsp-unhide
# Description: Reveal every hidden node on the focused desktop and show polybar
# Returns:
#   0 - Success
# Example:
#   bsp-unhide
#
bsp-unhide() {
    _bsp-polybar-toggle show

    local _node
    for _node in $(bspc query -N -n .hidden -d focused); do
        log-info "node $_node... unhiding"
        bspc node "$_node" -g hidden=off
    done

    return 0
}

# ------------------------------
# Rule Management
# ------------------------------

# Add a rule
#
# Function: bsp-rule-add
# Description: Add a window rule for automatic placement and behavior
# Parameters:
#   $1 - Class name pattern (required)
#   $@ - Rule options (state=, desktop=, etc.)
# Returns:
#   0 - Success
#   2 - Invalid arguments
# Example:
#   bsp-rule-add "Firefox" desktop=web state=tiled
#   bsp-rule-add "Gimp-*" state=floating
#
bsp-rule-add() {
    local class="$1"
    shift
    local -a options=("$@")

    validate-type-string "$class" || return 2

    if _bsp-exec rule -a "$class" "${options[@]}"; then
        log-info "Added rule for class: $class"

        # Save rule if config available
        if [[ "$BSP_CONFIG_AVAILABLE" == "true" ]]; then
            config-set "bsp.rules.$class" "${options[*]}"
        fi

        return 0
    else
        return 1
    fi
}

# Remove a rule
#
# Function: bsp-rule-remove
# Description: Remove a window rule
# Parameters:
#   $1 - Class name pattern (required)
# Returns:
#   0 - Success
#   3 - Rule not found
# Example:
#   bsp-rule-remove "Firefox"
#
bsp-rule-remove() {
    local class="$1"

    validate-type-string "$class" || return 2

    if _bsp-exec rule -r "$class"; then
        log-info "Removed rule for class: $class"

        # Remove from config if available
        if [[ "$BSP_CONFIG_AVAILABLE" == "true" ]]; then
            config-unset "bsp.rules.$class"
        fi

        return 0
    else
        log-warning "Rule not found: $class"
        return 3
    fi
}

# List all rules
#
# Function: bsp-rule-list
# Description: List all configured window rules
# Output: Rule definitions, one per line
# Example:
#   bsp-rule-list
#
bsp-rule-list() {
    _bsp-exec rule -l
}

# ------------------------------
# Layout Management
# ------------------------------

# Save current layout
#
# Function: bsp-layout-save
# Description: Save the current desktop layout to a file
# Parameters:
#   $1 - Layout name (required)
#   $2 - Desktop selector (optional, default: focused)
# Returns:
#   0 - Success
#   1 - Failed to save
# Example:
#   bsp-layout-save "work-layout"
#   bsp-layout-save "web-layout" web
#
bsp-layout-save() {
    local name="$1"
    local desktop="${2:-focused}"

    validate-type-string "$name" || return 2

    local layout_file="$BSP_DATA_DIR/layouts/${name}.json"
    local layout

    # Get current layout
    if layout=$(_bsp-exec query -T -d "$desktop"); then
        echo "$layout" > "$layout_file"
        _BSP_SAVED_LAYOUTS[$name]="$layout_file"

        log-info "Saved layout: $name"
        return 0
    else
        log-error "Failed to save layout: $name"
        return 1
    fi
}

# Restore saved layout
#
# Function: bsp-layout-restore
# Description: Restore a previously saved desktop layout
# Parameters:
#   $1 - Layout name (required)
#   $2 - Desktop selector (optional, default: focused)
# Returns:
#   0 - Success
#   3 - Layout not found
# Example:
#   bsp-layout-restore "work-layout"
#
bsp-layout-restore() {
    local name="$1"
    local desktop="${2:-focused}"

    validate-type-string "$name" || return 2

    local layout_file="$BSP_DATA_DIR/layouts/${name}.json"

    if [[ ! -f "$layout_file" ]]; then
        log-error "Layout not found: $name"
        return 3
    fi

    # This would require a more complex implementation to actually restore
    # the tree structure - simplified for now
    log-warning "Layout restoration requires external tooling (not yet implemented)"
    return 1
}

# List saved layouts
#
# Function: bsp-layout-list
# Description: List all saved layout names
# Output: Layout names, one per line
# Example:
#   bsp-layout-list
#
bsp-layout-list() {
    local layout_dir="$BSP_DATA_DIR/layouts"

    if [[ -d "$layout_dir" ]]; then
        find "$layout_dir" -name "*.json" -type f | \
            xargs -r basename -s .json | sort
    fi
}

# ------------------------------
# Event Monitoring
# ------------------------------

# Start event monitor
#
# Function: bsp-event-monitor-start
# Description: Start monitoring BSP events and emit them via event system
# Returns:
#   0 - Monitor started
#   4 - Monitor already running
# Example:
#   bsp-event-monitor-start
#
bsp-event-monitor-start() {
    if [[ "$_BSP_EVENT_MONITOR_ACTIVE" == "true" ]]; then
        log-warning "Event monitor already running"
        return 4
    fi

    if [[ "$BSP_EVENTS_AVAILABLE" != "true" ]]; then
        log-warning "Event system not available, monitoring disabled"
        return 1
    fi

    # Start monitor in background
    (
        bspc subscribe all | while read -r event; do
            # Parse event and emit
            local event_type="${event%% *}"
            local event_data="${event#* }"

            case "$event_type" in
                node_add)
                    events-emit "$BSP_EVENT_NODE_ADD" "$event_data"
                    ;;
                node_remove)
                    events-emit "$BSP_EVENT_NODE_REMOVE" "$event_data"
                    ;;
                node_focus)
                    events-emit "$BSP_EVENT_NODE_FOCUS" "$event_data"
                    ;;
                desktop_focus)
                    events-emit "$BSP_EVENT_DESKTOP_FOCUS" "$event_data"
                    ;;
                *)
                    events-emit "bsp.event.${event_type}" "$event_data"
                    ;;
            esac
        done
    ) &

    _BSP_EVENT_MONITOR_PID=$!
    _BSP_EVENT_MONITOR_ACTIVE=true

    # Track with lifecycle if available
    if [[ "$BSP_LIFECYCLE_AVAILABLE" == "true" ]]; then
        lifecycle-track-job $_BSP_EVENT_MONITOR_PID
    fi

    log-info "Started BSP event monitor (PID: $_BSP_EVENT_MONITOR_PID)"
    return 0
}

# Stop event monitor
#
# Function: bsp-event-monitor-stop
# Description: Stop the BSP event monitor
# Returns:
#   0 - Monitor stopped
#   3 - Monitor not running
# Example:
#   bsp-event-monitor-stop
#
bsp-event-monitor-stop() {
    if [[ "$_BSP_EVENT_MONITOR_ACTIVE" != "true" ]]; then
        log-warning "Event monitor not running"
        return 3
    fi

    if [[ -n "$_BSP_EVENT_MONITOR_PID" ]]; then
        kill "$_BSP_EVENT_MONITOR_PID" 2>/dev/null || true

        # Untrack with lifecycle if available
        if [[ "$BSP_LIFECYCLE_AVAILABLE" == "true" ]]; then
            lifecycle-untrack-job $_BSP_EVENT_MONITOR_PID
        fi
    fi

    _BSP_EVENT_MONITOR_PID=""
    _BSP_EVENT_MONITOR_ACTIVE=false

    log-info "Stopped BSP event monitor"
    return 0
}

# ------------------------------
# Configuration Management
# ------------------------------

# Apply configuration
#
# Function: bsp-config-apply
# Description: Apply BSP configuration settings
# Parameters:
#   $1 - Config file path (optional, default: $BSP_CONFIG_DIR/config)
# Returns:
#   0 - Configuration applied
#   3 - Config file not found
# Example:
#   bsp-config-apply
#   bsp-config-apply "/path/to/config"
#
bsp-config-apply() {
    local config_file="${1:-$BSP_CONFIG_DIR/config}"

    if [[ ! -f "$config_file" ]]; then
        log-error "Config file not found: $config_file"
        return 3
    fi

    log-info "Applying BSP configuration from: $config_file"

    # Source the configuration file
    source "$config_file"

    return 0
}

# Set configuration value
#
# Function: bsp-config-set
# Description: Set a BSP configuration value
# Parameters:
#   $1 - Config key (e.g., border_width, window_gap)
#   $2 - Config value
# Returns:
#   0 - Success
#   2 - Invalid arguments
# Example:
#   bsp-config-set border_width 2
#   bsp-config-set window_gap 10
#
bsp-config-set() {
    local key="$1"
    local value="$2"

    validate-type-string "$key" || return 2
    validate-type-string "$value" || return 2

    if _bsp-exec config "$key" "$value"; then
        log-debug "Set config: $key = $value"

        # Save to persistent config if available
        if [[ "$BSP_CONFIG_AVAILABLE" == "true" ]]; then
            config-set "bsp.config.$key" "$value"
        fi

        return 0
    else
        return 1
    fi
}

# Get configuration value
#
# Function: bsp-config-get
# Description: Get a BSP configuration value
# Parameters:
#   $1 - Config key
# Output: Configuration value
# Example:
#   value=$(bsp-config-get border_width)
#
bsp-config-get() {
    local key="$1"

    validate-type-string "$key" || return 2

    _bsp-exec config "$key"
}

# ------------------------------
# Utility Functions
