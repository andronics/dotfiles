# Run self-tests
#
# Usage: bsp-self-test
#
bsp-self-test() {
    log-info "Running _bsp v$BSP_VERSION self-test..."
    local tests_passed=0
    local tests_failed=0

    # Test 1: BSP availability
    if bsp-is-running; then
        log-info "✓ BSP is running"
        ((tests_passed++)) || true
    else
        log-warning "⚠ BSP is not running (some tests will be skipped)"
    fi

    # Test 2: Command availability
    if common-command-exists bspc; then
        log-info "✓ bspc command available"
        ((tests_passed++)) || true
    else
        log-error "✗ bspc command not found"
        ((tests_failed++)) || true
    fi

    # Test 3: Directory creation
    if [[ -d "$BSP_CONFIG_DIR" ]]; then
        log-info "✓ Config directory exists"
        ((tests_passed++)) || true
    else
        log-error "✗ Config directory missing"
        ((tests_failed++)) || true
    fi

    # Test 4: Cache functionality (if available)
    if [[ "$BSP_CACHE_AVAILABLE" == "true" ]]; then
        local test_key="bsp:test:$(date +%s)"
        cache-set "$test_key" "test_value" 1
        if [[ "$(cache-get "$test_key")" == "test_value" ]]; then
            log-info "✓ Cache integration works"
            ((tests_passed++)) || true
        else
            log-error "✗ Cache integration failed"
            ((tests_failed++)) || true
        fi
        cache-delete "$test_key"
    else
        log-info "⚠ Cache not available (skipping cache test)"
    fi

    # Test 5: Query operations (if BSP running)
    if bsp-is-running; then
        if bsp-monitor-list >/dev/null 2>&1; then
            log-info "✓ Query operations work"
            ((tests_passed++)) || true
        else
            log-error "✗ Query operations failed"
            ((tests_failed++)) || true
        fi
    fi

    # Test 6: Event system (if available)
    if [[ "$BSP_EVENTS_AVAILABLE" == "true" ]]; then
        local test_event_received=false
        test_handler() { test_event_received=true; }

        events-on "bsp.test.event" test_handler
        _bsp-emit "bsp.test.event"

        if [[ "$test_event_received" == "true" ]]; then
            log-info "✓ Event system integration works"
            ((tests_passed++)) || true
        else
            log-error "✗ Event system integration failed"
            ((tests_failed++)) || true
        fi

        events-off "bsp.test.event" test_handler
        unfunction test_handler 2>/dev/null
    else
        log-info "⚠ Events not available (skipping event test)"
    fi

    # Summary
    log-info ""
    log-info "Self-tests complete: $tests_passed passed, $tests_failed failed"

    if [[ $tests_failed -eq 0 ]]; then
        return 0
    else
        return 1
    fi
}

