#!/usr/bin/env zsh

# _remote_patterns - unit name pattern matching for _remote
# Part of the dotfiles library v2.0
#
# Usage:
#   source "${DOTLIB}/_remote_patterns"
#
# Dependencies:
#   Required:
#     - _common: core utilities
#     - _remote_config: unit list source

[[ -n "${REMOTE_PATTERNS_LOADED:-}" ]] && return 0
declare -gr REMOTE_PATTERNS_LOADED=1

source "${DOTLIB}/_common"        || { echo "[ERROR] _remote_patterns requires _common" >&2; return 1; }
source "${DOTLIB}/_log"           2>/dev/null || true
source "${DOTLIB}/_remote_config" || { echo "[ERROR] _remote_patterns requires _remote_config" >&2; return 1; }

# Usage: _remote-patterns-match-units "pattern"
# Supports glob (video-*), comma-separated (audio,video), exact match, or
# empty pattern (matches every unit). Prints one matching unit name per line.
_remote-patterns-match-units() {
    local _pattern="$1"
    local _all_units
    _all_units=$(_remote-config-units)

    [[ -z "${_pattern}" ]] && {
        echo "${_all_units}"
        return 0
    }

    local _matched_units=""

    if [[ "${_pattern}" == *","* ]]; then
        local -a _patterns=("${(@s:,:)_pattern}")
        local _p _unit
        for _p in "${_patterns[@]}"; do
            _p=$(echo "$_p" | xargs)
            while read -r _unit; do
                [[ "${_unit}" == ${~_p} ]] && _matched_units="${_matched_units}${_unit}\n"
            done <<< "${_all_units}"
        done
    else
        local _unit
        while read -r _unit; do
            [[ "${_unit}" == ${~_pattern} ]] && _matched_units="${_matched_units}${_unit}\n"
        done <<< "${_all_units}"
    fi

    # grep exits non-zero when nothing matches (the normal "no units matched
    # this pattern" case) - under a caller running with `set -e`, that would
    # otherwise abort the caller right here instead of letting it see an
    # empty result and report "no units match".
    echo -e "${_matched_units}" | grep -v '^$' || true
}
