    [simple-scan]=$'\U000F06AB'        # md-scanner
    [gnome-calculator]=$'\U000F00EC'   # md-calculator
)
declare -g _DESK_ICON_FALLBACK=$'\U000F0614'   # md-application_outline
declare -g _DESK_ICON_EMPTY=$'\U000F0130'      # md-checkbox_blank_circle_outline
declare -g _DESK_ICON_NEW=$'\U000F0415'        # md-plus
# Mode glyphs; floating, fullscreen and sticky are modules/bspwm.ini's.
typeset -gA _DESK_MODE_ICONS=(
    [monocle]=$'\U000F0C0F'            # md-alpha_m_box_outline
    [floating]=$''               # fa-window_restore
    [fullscreen]=$''             # fa-window_maximize
    [sticky]=$''                 # fa-sticky_note
)

# Colours for `bar`. These mirror polybar's [colors] (lavender, red, crust,
# text, overlay0) because polybar can't interpolate references inside a
# command, as in _coord. key=value args still override.
typeset -gA _DESK_BAR_COLORS=(
    [focused]='#b4befe' [urgent]='#f38ba8' [ink]='#11111b' [mode]='#cdd6f4' [dim]='#6c7086'
)

typeset -gA _DESK_DESCRIPTIONS=(
    [bar]="Print the polybar strip for [monitor] (default \$DESK_MONITOR, \$HOST_MONITOR, else focused): one fixed-width cell per non-empty desktop showing one app icon, rotating through its distinct apps every ${_DESK_ROTATE}s (DESK_ROTATE), focused underlined, urgent as a pill, then the focused desktop's mode and a + cell; [key=#rrggbb ...] overrides the built-in colours: ${(kj:, :)_DESK_BAR_COLORS}"
    [watch]="Print the strip, then reprint it after each burst of bspc events and on each rotation tick when it changed, pruning first after desktop focus, node removal or node transfer, and repeat it after ${_DESK_IDLE}s unprinted (DESK_IDLE); for a polybar custom/script with tail = true, exits when its reader goes away"
    [new]="Create a desktop named the lowest free integer right after the focused one on the focused monitor and focus it; --take moves the focused window there and follows (not a ${_DESK_SKIP_CLASS} panel)"
    [prune]="Remove every desktop with no nodes at all (hidden windows count) that isn't its monitor's focused desktop, never desktop '${_DESK_KEEP_NAME}' nor a monitor's last; prints the names removed"
)

# Per desktop of the monitor tree on stdin, one tab-separated line: decimal
# id, focused, urgent, layout, the focused window's state and sticky flag (or
# -), then one id<US>class<US>instance field per visible window. Tabs never
# sit next to each other, so zsh's whitespace IFS splitting loses nothing.
declare -g _DESK_JQ_BAR='
    def nz: if . == null or . == "" then "-" else . end;
    .focusedDesktopId as $f
    | .desktops[] | . as $d
    | [.root | .. | objects | select(.client? != null and .client.className != $skip)] as $all
    | [$all[] | select(.hidden | not)] as $w
    | ([$w[] | select(.id == $d.focusedNodeId)] | first) as $fn
    | [($d.id | tostring),
       (if $d.id == $f then "1" else "0" end),
       (if any($all[]; .client.urgent) then "1" else "0" end),
       $d.layout,
       ($fn.client.state | nz),
       (if $fn.sticky then "1" else "0" end)]
      + [$w[] | "\(.id)\u001f\(.client.className | nz)\u001f\(.client.instanceName | nz)"]
    | join("\t")'

# Ids and names of desktops `prune` may remove, from `bspc wm -d`. root ==
# null means no node at all: hidden windows and receptacles keep a desktop.
declare -g _DESK_JQ_PRUNE='
    .monitors[]
    | .focusedDesktopId as $f
    | (.desktops | length) as $n
    | [.desktops[] | select(.root == null and .id != $f and .name != $keep)]
    | if length >= $n then .[1:] else . end
    | .[] | "\(.id)\t\(.name)"'

# ------------------------------
# Private Helpers
# ------------------------------

_desk-hex() {
    printf '0x%08X' "$1"
}

_desk-tree() {
    local _monitor=${1:-${DESK_MONITOR:-${HOST_MONITOR:-}}}
    [[ -n "$_monitor" ]] && bspc query -T -m "$_monitor" 2>/dev/null && return 0
    bspc query -T -m focused
}

# Sets REPLY to the glyph for a window. bspwm records WM_CLASS when it
# manages a window; apps that set it later (Spotify) arrive blank, so ask X.
_desk-icon() {
    local _wid=$1 _class=${(L)2} _instance=${(L)3} _xclass
    if [[ "$_class" == - && "$_instance" == - ]]; then
        _xclass=$(xprop -id "$_wid" WM_CLASS 2>/dev/null)
        [[ "$_xclass" =~ '= "([^"]*)", "([^"]*)"$' ]] && { _instance=${(L)match[1]}; _class=${(L)match[2]}; }
    fi
    REPLY=${_DESK_ICONS[$_class]:-${_DESK_ICONS[$_instance]:-$_DESK_ICON_FALLBACK}}
}

_desk-is-prune-event() {
    [[ "$1" == (desktop_focus|node_remove|node_transfer)(| *) ]]
}

# Sets REPLY to the strip and _DESK_ROTATING to whether any cell rotates.
# Runs in the caller's shell (watch needs _DESK_ROTATING); one tree query.
# Cell styles stack as in coord-bar: urgent fills the cell, focused adds an
# underline. Polybar action tags wrap each cell; right-click and scroll are
# the module's own handlers.
_desk-render() {
    local _arg _monitor= _tree _line _id _focused _urgent _layout _state _sticky
    local _win _icon _cell _mode=
    local -i _tick
    local -A _color=("${(@kv)_DESK_BAR_COLORS}")
    local -a _f _w _order _cells _modes

    _DESK_ROTATING=0
    for _arg in "$@"; do
        if [[ "$_arg" =~ '^([a-z]+)=(#[0-9A-Fa-f]{6,8})$' ]]; then
            (( ${+_color[${match[1]}]} )) && _color[${match[1]}]=${match[2]}
        else
            _monitor=$_arg
        fi
    done

    _tree=$(_desk-tree "$_monitor") || { log-error "[desk] bspwm not reachable"; return 1; }
    (( _tick = EPOCHREALTIME / _DESK_ROTATE ))

    for _line in ${(f)"$(jq -r --arg skip "$_DESK_SKIP_CLASS" "$_DESK_JQ_BAR" <<<"$_tree")"}; do
        _f=("${(@ps:\t:)_line}")
        _id=$(_desk-hex "${_f[1]}")
        _focused=${_f[2]} _urgent=${_f[3]} _layout=${_f[4]} _state=${_f[5]} _sticky=${_f[6]}

        # Distinct glyphs in first-appearance order, so the rotation is
        # stable while the desktop's windows don't change.
        _order=()
        for _win in "${(@)_f[7,-1]}"; do
            _w=("${(@ps:\x1f:)_win}")
            _desk-icon "${_w[1]}" "${_w[2]}" "${_w[3]}"
            (( ${_order[(Ie)$REPLY]} )) || _order+=("$REPLY")
        done

        case ${#_order} in
            0) (( _focused )) || continue
               _icon=$_DESK_ICON_EMPTY ;;
            1) _icon=${_order[1]} ;;
            *) _icon=${_order[_tick % ${#_order} + 1]}
               _DESK_ROTATING=1 ;;
        esac

        _cell=" ${_icon} "
        (( _urgent )) && _cell="%{B${_color[urgent]}}%{F${_color[ink]}}${_cell}%{F-}%{B-}"
        (( _focused )) && _cell="%{u${_color[focused]}}%{+u}${_cell}%{-u}"
        _cells+=("%{A1:bspc desktop -f ${_id}:}%{A2:bspc node -d ${_id}:}${_cell}%{A}%{A}")

        if (( _focused )); then
            _modes=()
            [[ "$_layout" == monocle ]] && _modes+=("${_DESK_MODE_ICONS[monocle]}")
            [[ "$_state" == (floating|fullscreen) ]] && _modes+=("${_DESK_MODE_ICONS[$_state]}")
            (( _sticky )) && _modes+=("${_DESK_MODE_ICONS[sticky]}")
            (( ${#_modes} )) && _mode="%{F${_color[mode]}} ${(j: :)_modes} %{F-}"
        fi
    done

    REPLY="${(pj:$_DESK_GAP:)_cells}${_mode}"
    REPLY+="%{A1:desk new:}%{A2:desk new --take:}%{F${_color[dim]}} ${_DESK_ICON_NEW} %{F-}%{A}%{A}"
}

# ------------------------------
# Public Functions
# ------------------------------

desk-bar() {
    _desk-render "$@" || return 1
    print -r -- "$REPLY"
}

desk-prune() {
    local _line _id _name
    for _line in ${(f)"$(bspc wm -d | jq -r --arg keep "$_DESK_KEEP_NAME" "$_DESK_JQ_PRUNE")"}; do
        _id=${_line%%$'\t'*} _name=${_line#*$'\t'}
        # bspwm itself refuses to remove a desktop holding nodes or a
        # monitor's last one, so a window landing after the dump is safe.
        bspc desktop "$(_desk-hex "$_id")" -r 2>/dev/null && print -r -- "$_name"
    done
    return 0
}

# bspwm appends new desktops at the monitor's end; bubbling it back past the
# desktops after the focused one lands it right after the focused one, by id,
# so duplicate names elsewhere can't confuse it (unlike `monitor -o`).
desk-new() {
    local _take=0 _name=1 _current _new _node _class _i
    local -a _names _before _after

    case "${1:-}" in
        "")     ;;
        --take) _take=1 ;;
        *)      log-error "[desk] new: unknown option '$1' (expected --take)"; return 1 ;;
    esac

    _names=(${(f)"$(bspc query -D --names)"})
    while (( ${_names[(Ie)$_name]} )); do (( _name++ )); done

    _current=$(bspc query -D -d focused) || return 1
    _before=(${(f)"$(bspc query -D -m focused)"})
    if (( _take )); then
        _node=$(bspc query -N -n focused.window 2>/dev/null) || _node=
        [[ -n "$_node" ]] && _class=$(bspc query -T -n "$_node" | jq -r '.client.className // ""')
        [[ "$_class" == "$_DESK_SKIP_CLASS" ]] && _node=
    fi

    bspc monitor focused -a "$_name" || { log-error "[desk] new: could not add desktop '$_name'"; return 1; }
    _after=(${(f)"$(bspc query -D -m focused)"})
    _new=${${_after:|_before}[1]}
    [[ -n "$_new" ]] || { log-error "[desk] new: added '$_name' but could not find it"; return 1; }

    for (( _i = ${#_before} - ${_before[(Ie)$_current]}; _i > 0; _i-- )); do
        bspc desktop "$_new" -b prev || break
    done

    if [[ -n "$_node" ]]; then
        bspc node "$_node" -d "$_new" --follow
    else
        bspc desktop -f "$_new"
    fi
}

# Each redraw, event burst or rotation tick alike, costs one `bspc query -T`
# and one jq; a rotation tick happens once per _DESK_ROTATE seconds and only
# while some desktop has two or more glyphs.
desk-watch() {
    local _pid _event _last= _prune _wait
    local -i _printed

    coproc bspc subscribe "${_DESK_EVENTS[@]}"
    _pid=$!
    # A function's EXIT trap fires on its return; TERM from polybar and PIPE
    # from a closed stdout exit through it, so subscribe is never orphaned.
    trap "kill $_pid 2>/dev/null" EXIT
    trap "kill $_pid 2>/dev/null; exit 0" TERM INT HUP PIPE

    _desk-render "$@" || return 1
    _last=$REPLY _printed=$EPOCHSECONDS
    print -r -- "$_last" 2>/dev/null || return 0

    while :; do
        _wait=$_DESK_IDLE
        # Sleep to just past the next tick boundary, so the clock-derived
        # index has moved on when we redraw.
        (( _DESK_ROTATING )) && (( _wait = _DESK_ROTATE - EPOCHREALTIME % _DESK_ROTATE + 0.01 ))
        _prune=0
        if read -r -p -t "$_wait" _event; then
            _desk-is-prune-event "$_event" && _prune=1
            while read -r -p -t "$_DESK_SETTLE" _event; do
                _desk-is-prune-event "$_event" && _prune=1
            done
        else
            # Timeout or subscribe gone. Without a rotation, a timeout is
            # only the _DESK_IDLE repeat below and needs no fresh query.
            kill -0 "$_pid" 2>/dev/null || return 0
            if (( ! _DESK_ROTATING )); then
                print -r -- "$_last" 2>/dev/null || return 0
                _printed=$EPOCHSECONDS
                continue
            fi
        fi
        (( _prune )) && desk-prune >/dev/null
        _desk-render "$@" || continue
        # A closed stdout only shows on a write and an unchanged bar never
        # writes, so a line unprinted for _DESK_IDLE seconds is repeated: a
        # reader that went away (polybar killed with SIGKILL can't signal
        # us) ends us then instead of on the next change.
        [[ "$REPLY" == "$_last" ]] && (( EPOCHSECONDS - _printed < _DESK_IDLE )) && continue
        print -r -- "$REPLY" 2>/dev/null || return 0
        _last=$REPLY _printed=$EPOCHSECONDS
    done
}
