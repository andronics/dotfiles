#!/usr/bin/env zsh

# _desk - polybar desktop strip: one fixed-width cell per non-empty bspwm
# desktop, showing the icon of an app on it (rotating through them when it
# holds several), in the coordinator strip's visual language.
#
# `bar` draws the bar monitor's desktops in bspwm's order. A desktop is empty
# when it has no visible window once coordinator panels (class `coord`,
# sticky, so they ride along on the focused desktop) are set aside; empty
# desktops are hidden, except the focused one, which shows a placeholder so
# the strip never loses track of where you are. Each window's WM_CLASS (class,
# then instance, case-insensitively) picks a glyph from _DESK_ICONS. A cell
# holds one glyph, so it keeps a fixed width: a desktop whose windows map to
# several distinct glyphs (in order of first appearance in the tree) shows
# them one at a time, rotating every _DESK_ROTATE seconds. The index is
# floor(now / _DESK_ROTATE) mod the glyph count, taken from the clock, so
# every desktop ticks together and `bar` keeps no state. The focused desktop
# is underlined, an urgent one is a filled pill, a mode glyph follows for a
# monocle desktop or a floating, fullscreen or sticky focused window, and a
# dim + cell ends the strip. Left-click focuses a desktop, middle-click
# sends the focused window there; on the + cell they run `new` and
# `new --take`.
#
# `watch` is the polybar custom/script (tail = true) loop: it prints `bar`,
# then reprints after each burst of bspc events (lines arriving within
# _DESK_SETTLE of each other), only when the line changed. Bursts that
# include a desktop focus, node removal or node transfer run `prune` first,
# so leaving an empty desktop removes it. While some desktop rotates it also
# wakes on each _DESK_ROTATE boundary to redraw; otherwise, and whenever the
# line has gone _DESK_IDLE seconds unprinted, it repeats the line so a
# vanished reader is noticed. TERM, PIPE and the end of `bspc subscribe` all
# end it and its subscribe process.
#
# The monitor is the argument, else $DESK_MONITOR, else $HOST_MONITOR (the
# bar's monitor in polybar's bars/base, inherited by its scripts), else the
# focused one; one bar per monitor gives one strip per monitor.
#
# `new` and `prune` own desktop creation and removal. Names don't matter
# here: cells and clicks use desktop ids.
#
# Usage:
#   source "${DOTLIB}/_desk"
#
# Dependencies:
#   Required:
#     - _common, _log
#   External:
#     - bspwm (bspc), jq, xprop (windows bspwm saw before they set WM_CLASS)
#     - polybar, Symbols Nerd Font Mono (bar font-0); every glyph here is
#       in it, and a mono font gives them one advance, so a cell's width
#       doesn't change as it rotates

[[ -n "${DESK_LOADED:-}" ]] && return 0
declare -gr DESK_LOADED=1

zmodload -F zsh/datetime p:EPOCHREALTIME p:EPOCHSECONDS

source "${DOTLIB}/_common" || { echo "[ERROR] _desk requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

# Mirrors _coord's _COORD_CLASS; sourcing _coord just for it would drag in
# its dependencies.
declare -g _DESK_SKIP_CLASS="coord"
declare -g _DESK_GAP="%{O8}"   # polybar offset between desktop cells
declare -g _DESK_KEEP_NAME="0"
declare -g _DESK_SETTLE="${DESK_SETTLE:-0.05}"
declare -gi _DESK_IDLE="${DESK_IDLE:-10}"
# Seconds per icon on a rotating cell; fractions work (1.5).
declare -g _DESK_ROTATE="${DESK_ROTATE:-1}"
[[ "$_DESK_ROTATE" == (<->|<->.<->|.<->) ]] && (( _DESK_ROTATE > 0 )) || _DESK_ROTATE=1
# Set by _desk-render: 1 when some cell has more than one glyph to rotate.
declare -gi _DESK_ROTATING=0
# Urgency has no event of its own; bspwm only reports it through `report`.
typeset -ga _DESK_EVENTS=(
    desktop_add desktop_remove desktop_rename desktop_swap desktop_transfer
    desktop_focus desktop_layout
    node_add node_remove node_transfer node_swap node_focus node_flag node_state
    monitor_add monitor_remove monitor_swap monitor_focus
    report
)

# Symbols Nerd Font Mono (polybar font-0) glyphs, keyed by lower-cased
# WM_CLASS class or instance. Where polybar's apps.ini launches the app, its
# glyph is reused so launcher and strip agree.
typeset -gA _DESK_ICONS=(
    [alacritty]=$''              # dev-terminal
    [terminal]=$''
    [terminal-drop]=$''
    [terminal-draw]=$''
    [kitty]=$''
    [xterm]=$''
    [urxvt]=$''
    [firefox]=$'\U000F0239'            # md-firefox
    [navigator]=$'\U000F0239'
    [librewolf]=$'\U000F0239'
    [google-chrome]=$'\U000F02AF'      # md-google_chrome
    [chromium]=$'\U000F02AF'
    [brave-browser]=$'\U000F02AF'
    [code]=$''                   # cod-code
    [com.microsoft.vscode]=$''
    [code-oss]=$''
    [vscodium]=$''
    [nemo]=$''                   # oct-file_directory
