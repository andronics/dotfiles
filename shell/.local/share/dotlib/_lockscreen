#!/usr/bin/env zsh

# _lockscreen - betterlockscreen + xidlehook idle-lock control
#
# Wraps betterlockscreen (actual locking), _xidlehook (idle-timeout daemon
# that triggers the lock), and _systemd (the lockscreen.service user unit
# that keeps the idle daemon running from login).
#
# Usage:
#   source "${DOTLIB}/_lockscreen"
#
# Dependencies:
#   Required:
#     - _common, _log, _xdg: core utilities
#     - _xidlehook: idle-timeout daemon control
#     - _systemd: lockscreen.service management
#   External:
#     - betterlockscreen (system package, wraps i3lock-color)

[[ -n "${LOCKSCREEN_LOADED:-}" ]] && return 0
declare -gr LOCKSCREEN_LOADED=1

source "${DOTLIB}/_common"    || { echo "[ERROR] _lockscreen requires _common" >&2; return 1; }
source "${DOTLIB}/_log"       2>/dev/null || true
source "${DOTLIB}/_xdg"       || { echo "[ERROR] _lockscreen requires _xdg" >&2; return 1; }
source "${DOTLIB}/_xidlehook" || { echo "[ERROR] _lockscreen requires _xidlehook" >&2; return 1; }
source "${DOTLIB}/_systemd"   || { echo "[ERROR] _lockscreen requires _systemd" >&2; return 1; }

declare -g _LOCKSCREEN_UNIT="lockscreen"
declare -g _LOCKSCREEN_SUSPEND_UNIT="lockscreen-suspend"
declare -g _LOCKSCREEN_SCOPE="--user"
declare -g _LOCKSCREEN_WALLPAPER="$(xdg-data-file "backgrounds" "0001.png")"

# Seconds to wait before the first idle-time check after (re)starting the
# daemon. xidlehook reads real X idle time, not time-since-daemon-start, so
# without this a service (re)start after the machine was already idle past
# the timer duration locks the screen instantly instead of giving a fresh
# countdown.
declare -g _LOCKSCREEN_GRACE_PERIOD="${LOCKSCREEN_GRACE_PERIOD:-10}"

typeset -gA _LOCKSCREEN_DESCRIPTIONS=(
    [activate]="Lock the screen now"
    [wallpaper-update]="Regenerate betterlockscreen's cached lock wallpaper"
    [hook-init]="Start the idle daemon in the foreground (used by the systemd unit)"
    [hook-stop]="Stop the idle daemon"
    [hook-enable]="Resume the idle timer"
    [hook-disable]="Pause the idle timer"
    [hook-trigger]="Lock immediately via the idle daemon"
    [hook-query]="Query the idle daemon's timer state"
    [hook-status]="Show comprehensive idle daemon status"
    [status]="Show armed/paused/not-running state (for status bars)"
    [service-install]="Enable and start the lockscreen service (idle + pre-suspend lock)"
    [service-start]="Start the lockscreen.service user unit"
    [service-stop]="Stop the lockscreen.service user unit"
    [service-restart]="Restart the lockscreen.service user unit"
    [service-status]="Show lockscreen service status (idle + pre-suspend units)"
    [service-uninstall]="Stop and disable the lockscreen service (idle + pre-suspend lock)"
)

# ------------------------------
# Private Helpers
# ------------------------------

_lockscreen-check() {
    if ! common-command-exists "betterlockscreen"; then
        log-error "[lockscreen] betterlockscreen not found - install it first"
        return 1
    fi
}

_lockscreen-timer-disabled() {
    xidlehook-query 2>/dev/null | grep -q "disabled: true"
}

# ------------------------------
# Locking
# ------------------------------

lockscreen-activate() {
    _lockscreen-check || return 1
    betterlockscreen --lock -- -n
}

lockscreen-wallpaper-update() {
    _lockscreen-check || return 1
    log-info "Updating lockscreen wallpaper cache"
    betterlockscreen --update "${_LOCKSCREEN_WALLPAPER}"
}

# ------------------------------
# Idle Daemon (xidlehook)
# ------------------------------

# Runs as the systemd unit's foreground process: starts xidlehook (which
# backgrounds itself) then waits on it, so the unit's main PID tracks the
# daemon's actual lifetime instead of exiting the instant this returns.
lockscreen-hook-init() {
    xidlehook-init "lockscreen activate" || return 1

    sleep "${_LOCKSCREEN_GRACE_PERIOD}"
    xidlehook-reset-idle

    wait "${_XIDLEHOOK_PID}"
}

lockscreen-hook-stop() {
    xidlehook-stop
}

lockscreen-hook-enable() {
    xidlehook-enable
}

lockscreen-hook-disable() {
    xidlehook-disable
}

lockscreen-hook-trigger() {
    xidlehook-trigger
}

lockscreen-hook-query() {
    xidlehook-query
}

lockscreen-hook-status() {
    xidlehook-status
}

# Armed/paused/not-running, for consumption by a status bar module.
# Usage: lockscreen-status
lockscreen-status() {
    if ! xidlehook-is-running; then
        echo "not running"
        return 0
    fi

    if _lockscreen-timer-disabled; then
        echo "paused"
    else
        echo "armed"
    fi
}

# ------------------------------
# Service (systemd)
# ------------------------------

lockscreen-service-install() {
    log-info "Installing lockscreen service"
    systemd-daemon-reload "${_LOCKSCREEN_SCOPE}"
    systemd-enable-start "${_LOCKSCREEN_UNIT}" "${_LOCKSCREEN_SCOPE}"
    # Oneshot, WantedBy=sleep.target - nothing to start now, just enable so it
    # fires on the next suspend/hibernate.
    systemd-enable "${_LOCKSCREEN_SUSPEND_UNIT}" "${_LOCKSCREEN_SCOPE}"
}

lockscreen-service-start() {
    log-info "Starting lockscreen service"
    systemd-start "${_LOCKSCREEN_UNIT}" "${_LOCKSCREEN_SCOPE}"
}

lockscreen-service-stop() {
    log-info "Stopping lockscreen service"
    systemd-stop "${_LOCKSCREEN_UNIT}" "${_LOCKSCREEN_SCOPE}"
}

lockscreen-service-restart() {
    log-info "Restarting lockscreen service"
    systemd-restart "${_LOCKSCREEN_UNIT}" "${_LOCKSCREEN_SCOPE}"
}

lockscreen-service-status() {
    systemd-get-status "${_LOCKSCREEN_UNIT}" "${_LOCKSCREEN_SCOPE}"
    echo ""
    systemd-get-status "${_LOCKSCREEN_SUSPEND_UNIT}" "${_LOCKSCREEN_SCOPE}"
}

lockscreen-service-uninstall() {
    log-info "Uninstalling lockscreen service"
    systemd-disable-stop "${_LOCKSCREEN_UNIT}" "${_LOCKSCREEN_SCOPE}"
    systemd-disable "${_LOCKSCREEN_SUSPEND_UNIT}" "${_LOCKSCREEN_SCOPE}"
    systemd-daemon-reload "${_LOCKSCREEN_SCOPE}"
}
