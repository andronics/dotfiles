#!/usr/bin/env zsh

# _lockscreen - betterlockscreen + xidlehook idle-lock control
#
# Wraps betterlockscreen (actual locking) and _xidlehook (idle-timeout daemon
# that triggers the lock). `sleep-lock` is the locker xss-lock runs before
# every suspend or hibernate (desktop's xss-lock.service).
#
# A timed pause (`hook-disable 1h`) is a transient user timer,
# lockscreen-resume.timer, that runs `lockscreen hook-enable` when it fires;
# `status --json` reports its end, for barmenu's lock menu (desktop-tools
# design record 0001).
#
# The idle daemon is started per X session by desktop's
# .zlogin.d/50-lockscreen, not by a systemd unit: with lingering the user
# manager is up at boot, long before there is an X display to watch.
#
# Usage:
#   source "${DOTLIB}/_lockscreen"
#
# Dependencies:
#   Required:
#     - _common, _log, _xdg: core utilities
#     - _xidlehook: idle-timeout daemon control
#   Optional:
#     - _notify: forget-passphrase's notification
#   External:
#     - betterlockscreen (system package, wraps i3lock-color), pgrep
#     - systemd-run, systemctl (timed pauses), gpg-connect-agent, timeout

[[ -n "${LOCKSCREEN_LOADED:-}" ]] && return 0
declare -gr LOCKSCREEN_LOADED=1

source "${DOTLIB}/_common"    || { echo "[ERROR] _lockscreen requires _common" >&2; return 1; }
source "${DOTLIB}/_log"       2>/dev/null || true
source "${DOTLIB}/_xdg"       || { echo "[ERROR] _lockscreen requires _xdg" >&2; return 1; }
source "${DOTLIB}/_xidlehook" || { echo "[ERROR] _lockscreen requires _xidlehook" >&2; return 1; }
source "${DOTLIB}/_notify"    2>/dev/null || true

# The lock picture when the theme records no wallpaper (see _lockscreen-wallpaper).
declare -g _LOCKSCREEN_FALLBACK_WALLPAPER="$(xdg-data-file "backgrounds" "0001.png")"

# Seconds to wait before the first idle-time check after (re)starting the
# daemon. xidlehook reads real X idle time, not time-since-daemon-start, so
# without this a daemon (re)start after the machine was already idle past
# the timer duration locks the screen instantly instead of giving a fresh
# countdown.
declare -g _LOCKSCREEN_GRACE_PERIOD="${LOCKSCREEN_GRACE_PERIOD:-10}"

# Seconds sleep-lock waits for the locker. logind lets a delay inhibitor
# hold sleep for InhibitDelayMaxSec (5s by default), so stay under it.
declare -g _LOCKSCREEN_SLEEP_TIMEOUT="${LOCKSCREEN_SLEEP_TIMEOUT:-4}"
# betterlockscreen runs i3lock-color under either name.
declare -g _LOCKSCREEN_LOCKER='i3lock(-color)?'
# The transient user timer (and its service) behind a timed pause.
declare -g _LOCKSCREEN_RESUME_UNIT=lockscreen-resume
# systemd time spans: `30m`, `1h`, `1h 30min`, `90s`.
declare -g _LOCKSCREEN_TIMESPAN='^([0-9]+ *(us|ms|s|sec|seconds?|m|min|minutes?|h|hr|hours?|d|days?|w|weeks?)? *)+$'

typeset -gA _LOCKSCREEN_DESCRIPTIONS=(
    [activate]="Lock the screen now"
    [wallpaper-update]="Regenerate betterlockscreen's cached lock picture from the theme's wallpaper (or [image])"
    [hook-init]="Start the idle daemon in the foreground (used by .zlogin.d/50-lockscreen)"
    [hook-stop]="Stop the idle daemon"
    [hook-enable]="Resume the idle timer (and cancel a timed pause)"
    [hook-disable]="Pause the idle timer; [duration] (30m, 1h) resumes it after that long"
    [hook-trigger]="Lock immediately via the idle daemon"
    [hook-query]="Query the idle daemon's timer state"
    [hook-status]="Show comprehensive idle daemon status"
    [status]="Show armed/paused/not-running state (for status bars); --json adds a timed pause's end"
    [forget-passphrase]="Clear gpg-agent's cached passphrases, with a notification"
    [sleep-lock]="Lock and return once the locker is up (xss-lock's locker before sleep)"
)

# ------------------------------
# Private Helpers
# ------------------------------

_lockscreen-check() {
    if ! common-command-exists "betterlockscreen"; then
        log-error "[lockscreen] betterlockscreen not found - install it first"
        return 1
    fi
}

# REPLY = the wallpaper the theme records (`theme wallpaper`; read with
# _theme's theme-get in a subshell, so this module doesn't load it), when it
# is readable; else _LOCKSCREEN_FALLBACK_WALLPAPER.
_lockscreen-wallpaper() {
    local wall
    wall=$(source "${DOTLIB}/_theme" 2>/dev/null && theme-get wallpaper 2>/dev/null)
    [[ -n "$wall" && -r "$wall" ]] || wall=$_LOCKSCREEN_FALLBACK_WALLPAPER
    REPLY=$wall
}

_lockscreen-locker-up() {
    pgrep -u "$UID" -x "$_LOCKSCREEN_LOCKER" >/dev/null
}

_lockscreen-timer-disabled() {
    xidlehook-query 2>/dev/null | grep -q "disabled: true"
}

# Cancel a timed pause: stop the resume timer, if there is one. Never fails.
_lockscreen-resume-cancel() {
    common-command-exists systemctl || return 0
    systemctl --user stop "${_LOCKSCREEN_RESUME_UNIT}.timer" >/dev/null 2>&1 || :
}

# REPLY = when the resume timer fires (ISO 8601, local time with its
# offset); fails when no timed pause runs.
_lockscreen-resume-at() {
    REPLY=
    common-command-exists systemctl || return 1
    local -A prop
    local line
    for line in "${(@f)$(systemctl --user show "${_LOCKSCREEN_RESUME_UNIT}.timer" \
            -p ActiveState -p NextElapseUSecRealtime --timestamp=unix 2>/dev/null)}"; do
        [[ $line == *=* ]] && prop[${line%%=*}]=${line#*=}
    done
    [[ ${prop[ActiveState]:-} == active && ${prop[NextElapseUSecRealtime]:-} == @<-> ]] || return 1
    zmodload -F zsh/datetime b:strftime 2>/dev/null || return 1
    local at
    strftime -s at '%Y-%m-%dT%H:%M:%S%z' ${prop[NextElapseUSecRealtime]#@}
    REPLY="${at[1,-3]}:${at[-2,-1]}"
}

# ------------------------------
# Locking
# ------------------------------

lockscreen-activate() {
    _lockscreen-check || return 1
    betterlockscreen --lock -- -n
}

# Usage: lockscreen-wallpaper-update [image]  (default: the theme's wallpaper)
# `theme wallpaper` already does this in the background when the wallpaper
# changes; this is the manual, foreground way.
lockscreen-wallpaper-update() {
    _lockscreen-check || return 1
    local wall=${1:-}
    [[ -n "$wall" ]] || { _lockscreen-wallpaper; wall=$REPLY; }
    log-info "Updating lockscreen wallpaper cache from ${wall}"
    betterlockscreen --update "${wall}"
}

# ------------------------------
# Idle Daemon (xidlehook)
# ------------------------------

# Starts xidlehook (which backgrounds itself) then waits on it, so this
# process tracks the daemon's actual lifetime instead of exiting the
# instant the start returns.
lockscreen-hook-init() {
    xidlehook-init "lockscreen activate" || return 1

    sleep "${_LOCKSCREEN_GRACE_PERIOD}"
    xidlehook-reset-idle

    wait "${_XIDLEHOOK_PID}"
}

lockscreen-hook-stop() {
    xidlehook-stop
}

# Resume the idle timer; a timed pause still running is cancelled first, so
# the last choice wins.
lockscreen-hook-enable() {
    _lockscreen-resume-cancel
    xidlehook-enable
}

# Usage: lockscreen-hook-disable [duration]
# Without a duration the pause lasts until hook-enable. With one (systemd
# time syntax: 30m, 1h), a transient user timer runs `lockscreen hook-enable`
# after that long; it carries PATH and DOTLIB so the dispatcher is found.
# Either way a timed pause already running is cancelled first.
lockscreen-hook-disable() {
    local duration=${1:-}
    if [[ -n "$duration" && ! "$duration" =~ $_LOCKSCREEN_TIMESPAN ]]; then
        log-error "[lockscreen] not a duration: ${duration} (try 30m or 1h)"
        return 2
    fi
    _lockscreen-resume-cancel
    xidlehook-disable || return 1
    [[ -n "$duration" ]] || return 0
    if ! systemd-run --user --quiet --collect --unit="${_LOCKSCREEN_RESUME_UNIT}" \
            --on-active="$duration" --timer-property=AccuracySec=1s \
            --setenv=PATH="$PATH" --setenv=DOTLIB="$DOTLIB" \
            --setenv=XIDLEHOOK_SOCKET="$XIDLEHOOK_SOCKET" \
            lockscreen hook-enable >/dev/null 2>&1; then
        # A pause with no end was not what was asked for: undo it.
        log-error "[lockscreen] could not start the resume timer; idle lock left on"
        xidlehook-enable
        return 1
    fi
}

lockscreen-hook-trigger() {
    xidlehook-trigger
}

lockscreen-hook-query() {
    xidlehook-query
}

lockscreen-hook-status() {
    xidlehook-status
}

# Armed/paused/not-running, for consumption by a status bar module.
# Usage: lockscreen-status [--json]
# --json: {"state": "armed" | "paused" | "not running", "until": "<ISO time>" | null},
# `until` being a timed pause's end (barmenu's lock menu reads it).
lockscreen-status() {
    local state
    if ! xidlehook-is-running; then
        state="not running"
    elif _lockscreen-timer-disabled; then
        state=paused
    else
        state=armed
    fi
    if [[ ${1:-} != --json ]]; then
        print -r -- "$state"
        return 0
    fi
    local until=null
    [[ $state == paused ]] && _lockscreen-resume-at && until="\"${REPLY}\""
    print -r -- "{\"state\": \"${state}\", \"until\": ${until}}"
}

# ------------------------------
# GPG passphrase
# ------------------------------

# What every lock does (betterlockscreen/custom-pre.sh): gpg-agent forgets
# its cached passphrases. Bounded by a 2 s timeout, as there; a notification
# says whether it worked, since it runs from a menu click.
lockscreen-forget-passphrase() {
    local -i st=0
    if ! common-command-exists gpg-connect-agent; then
        st=1
    elif common-command-exists timeout; then
        timeout 2 gpg-connect-agent reloadagent /bye >/dev/null 2>&1 || st=1
    else
        gpg-connect-agent reloadagent /bye >/dev/null 2>&1 || st=1
    fi
    if (( st )); then
        log-error "[lockscreen] gpg-connect-agent failed or is missing"
        (( $+functions[notify-error] )) \
            && notify-error "GPG passphrase not forgotten" "gpg-connect-agent failed or is missing" &>/dev/null || :
    else
        (( $+functions[notify-info] )) \
            && notify-info "GPG passphrase forgotten" "gpg-agent asks for it again on next use" &>/dev/null || :
    fi
    return st
}

# ------------------------------
# Lock before sleep (xss-lock)
# ------------------------------

# Run by xss-lock --transfer-sleep-lock: XSS_SLEEP_LOCK_FD is logind's delay
# inhibitor, and sleep waits until every copy is closed. betterlockscreen
# can't take the fd, so the lock starts detached without it and the fd is
# closed once i3lock is up, or after _LOCKSCREEN_SLEEP_TIMEOUT. Returning
# then, not at unlock, means xss-lock never holds the locker: stopping the
# service or `loginctl unlock-session` can't kill i3lock. A locker already
# running (power menu) is left alone. Without the fd (lock-session) it
# just locks.
lockscreen-sleep-lock() {
    local fd=${XSS_SLEEP_LOCK_FD:-}
    local -i i up=0
    [[ "$fd" == <-> && -e /proc/self/fd/$fd ]] || fd=
    if _lockscreen-locker-up; then
        up=1
    else
        ( [[ -n "$fd" ]] && exec {fd}<&-; lockscreen-activate ) &!
        for (( i = 0; i < _LOCKSCREEN_SLEEP_TIMEOUT * 10; i++ )); do
            # The process exists a moment before i3lock has mapped its window
            # and grabbed the keyboard.
            _lockscreen-locker-up && { up=1; sleep 0.5; break; }
            sleep 0.1
        done
    fi
    [[ -n "$fd" ]] && exec {fd}<&-
    (( up )) || { log-error "[lockscreen] the locker did not start within ${_LOCKSCREEN_SLEEP_TIMEOUT}s"; return 1; }
}
