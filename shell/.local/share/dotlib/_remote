#!/usr/bin/env zsh

# _remote - Google Drive mount/sync management via rclone
# Part of the dotfiles library v2.0
#
# Usage:
#   source "${DOTLIB}/_remote"
#
# CLI flag convention: --dry-run is a LOCAL per-subcommand flag, placed
# right after the subcommand word (e.g. `remote mount --dry-run <unit>`),
# not the dispatcher's global --dry-run. _dispatcher's function-mode dry-run
# is all-or-nothing: DISPATCHER_DRY_RUN=true makes dispatcher-execute-command
# skip calling the subcommand function entirely and just log "[DRY RUN]
# Would call: ...". That would lose the informative per-command dry-run
# output this module produces (e.g. mount's "would mount" line, or sync
# actually submitting a DryRun job), so subcommands read their own
# --dry-run instead of relying on dispatcher-is-dry-run.
#
# remote-mount is deliberately NOT delegated to _rclone's rclone-mount: that
# function always runs `rclone mount --daemon` (backgrounds itself), but
# remote-mount@.service is Type=notify and requires ExecStart to stay in the
# foreground for systemd's process tracking / Restart=on-failure to work
# (rclone itself sends READY once the mount is live).
#
# remote-mount-all / remote-unmount-all trigger the systemd template unit
# rather than calling remote-mount/remote-unmount in-process: remote-mount's
# foreground rclone process would never return, so a synchronous loop over
# multiple units would block forever after the first one.
#
# Dependencies:
#   Required:
#     - _common, _log, _jq, _xdg: core utilities
#     - _rclone, _systemd: delegated unmount/rc calls/service-control
#     - _singleton: per-unit sync lock (prevents overlapping remote-sync runs)
#     - _remote_config, _remote_patterns, _remote_pool: domain modules

[[ -n "${REMOTE_LOADED:-}" ]] && return 0
declare -gr REMOTE_LOADED=1

source "${DOTLIB}/_common"        || { echo "[ERROR] _remote requires _common" >&2; return 1; }
source "${DOTLIB}/_log"           2>/dev/null || true
source "${DOTLIB}/_jq"            || { echo "[ERROR] _remote requires _jq" >&2; return 1; }
source "${DOTLIB}/_xdg"           || { echo "[ERROR] _remote requires _xdg" >&2; return 1; }
source "${DOTLIB}/_rclone"        || { echo "[ERROR] _remote requires _rclone" >&2; return 1; }
source "${DOTLIB}/_systemd"       || { echo "[ERROR] _remote requires _systemd" >&2; return 1; }
source "${DOTLIB}/_singleton"     || { echo "[ERROR] _remote requires _singleton" >&2; return 1; }
source "${DOTLIB}/_remote_config"   || { echo "[ERROR] _remote requires _remote_config" >&2; return 1; }
source "${DOTLIB}/_remote_patterns" || { echo "[ERROR] _remote requires _remote_patterns" >&2; return 1; }
source "${DOTLIB}/_remote_pool"     || { echo "[ERROR] _remote requires _remote_pool" >&2; return 1; }

typeset -gA _REMOTE_DESCRIPTIONS=(
    [mount]="Mount a unit"
    [unmount]="Unmount a unit"
    [mount-all]="Mount all units matching a pattern (via systemd)"
    [unmount-all]="Unmount all units matching a pattern (via systemd)"
    [sync]="Move a unit's local files to its remote (an rc job inside the unit's mount)"
    [list]="List units with status and cache size"
    [verify]="Verify unit configuration and mount status"
    [health]="Check enabled units are actually mounted and responsive, restart if not"
    [warm]="Preload a mounted unit's whole directory tree into rclone's dir cache"
    [cleanup]="Remove stale runtime configs and empty caches"
    [enable]="Enable and start a unit's mount and sync systemd units"
    [disable]="Stop and disable a unit's mount and sync systemd units"
    [restart]="Restart a unit's systemd service"
    [enable-all]="Enable all units matching a pattern"
    [disable-all]="Disable all units matching a pattern"
    [restart-all]="Restart the running units matching a pattern"
    [status]="Show systemd status for all remote-mount units"
    [rotate]="Advance a credential pool to its next key and move live mounts onto it"
    [pool]="Show credential pool state (current key, exhausted keys, key-file health)"
    [stats]="Live transfer stats per mounted unit (speed, bytes, files, errors)"
    [jobs]="Running rc jobs per mounted unit (sync, dir-cache refresh)"
    [throttle]="Set or clear a bandwidth limit on mounted units without a restart"
)

# Usage: _remote-require-unit <unit> || return 1
# Guards the single-unit subcommands: without it a typo reaches systemd as
# a template instance (remote-mount@<typo>), which `enable` happily enables
# and Restart=on-failure then retries every 5s forever.
_remote-require-unit() {
    [[ -z "$1" ]] && { log-error "No unit specified."; return 1; }
    _remote-config-unit-exists "$1" && return 0
    log-error "Unknown unit: $1 (not in units.json - see \`remote list\`)"
    return 1
}

# ------------------------------
# Mount / unmount
# ------------------------------

remote-mount() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }

    [[ $# -eq 0 ]] && { log-error "No unit specified for mounting."; return 1; }
    local _unit_name="$1"

    _remote-config-unit-exists "${_unit_name}" || { log-error "Specified unit does not exist."; return 1; }

    local _mountpoint _root_remote _uid _gid _cache_max_size _cache_dir _runtime_dir _mount_path
    _mountpoint=$(_remote-config-unit-mountpoint "${_unit_name}")
    _root_remote=$(_remote-config-root "remote")
    _uid=$(_remote-config-unit-uid "${_unit_name}")
    _gid=$(_remote-config-unit-gid "${_unit_name}")
    _cache_max_size=$(_remote-config-unit-cache-max-size "${_unit_name}")
    _mount_path="${_root_remote}/${_mountpoint}"
    _cache_dir="$(xdg-cache-dir "remote")/${_unit_name}"
    _runtime_dir="$(xdg-runtime-dir "remote")/${_unit_name}"

    rclone-clear-stale-mount "${_mount_path}" || return 1
    mkdir -p "${_mount_path}" "${_cache_dir}" "${_runtime_dir}"

    _remote-pool-render-rclone-conf "${_unit_name}" "$(_remote-config-unit-pool "${_unit_name}")" > "${_runtime_dir}/rclone.conf" || return 1
    # A socket left by a crashed run would make rclone's rc listener fail to bind.
    rm -f "${_runtime_dir}/rc.sock"

    if [[ "${_dry_run}" == "true" ]]; then
        log-info "[DRY RUN] Would mount ${_unit_name} @ ${_mount_path}"
        return 0
    fi

    rclone-check-available || return 1

    log-debug "mounting ${_unit_name} @ ${_mount_path} (uid=${_uid}, gid=${_gid}, cache=${_cache_max_size})"

    # Read-ahead is deliberately small (default --buffer-size, no
    # --vfs-read-ahead): library scanners open every video just to probe
    # its header, and each open downloads the whole read-ahead window into
    # the VFS cache. At 256M+256M that churned ~600G through a 64G cache in
    # under three days.
    #
    # The dir cache is in-memory only and --poll-interval keeps it correct, so
    # --dir-cache-time is long on purpose: expiry would just make directories
    # cold again (one Drive API call each) after remote-warm has loaded them.
    # --rc on a unix socket is what remote-warm talks to. --rc-no-auth is
    # required for vfs/refresh; access control is the socket living under
    # the 0700 XDG_RUNTIME_DIR, with no TCP listener at all.
    #
    # --vfs-cache-max-size is per mount, so the caps don't bound total disk
    # use; --vfs-cache-min-free-space is the guard for the shared cache disk.
    rclone mount "${_unit_name}:" "${_mount_path}" \
        --allow-non-empty \
        --allow-other \
        --buffer-size "16M" \
        --cache-dir "${_cache_dir}" \
        --config "${_runtime_dir}/rclone.conf" \
        --default-permissions \
        --dir-cache-time "1000h" \
        --gid "${_gid}" \
        --log-level "INFO" \
        --log-file "${_runtime_dir}/rclone.log" \
        --poll-interval "15s" \
        --rc \
        --rc-addr "unix://${_runtime_dir}/rc.sock" \
        --rc-no-auth \
        --uid "${_uid}" \
        --umask "002" \
        --vfs-cache-mode "full" \
        --vfs-cache-max-age "336h" \
        --vfs-cache-max-size "${_cache_max_size}" \
        --vfs-cache-poll-interval "5m" \
        --vfs-cache-min-free-space "100G"
}

remote-unmount() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }

    [[ $# -eq 0 ]] && { log-error "No unit specified for unmounting."; return 1; }
    local _unit_name="$1"

    _remote-config-unit-exists "${_unit_name}" || { log-error "Specified unit does not exist."; return 1; }

    local _mountpoint _root_remote _mount_path
    _mountpoint=$(_remote-config-unit-mountpoint "${_unit_name}")
    _root_remote=$(_remote-config-root "remote")
    _mount_path="${_root_remote}/${_mountpoint}"

    if [[ "${_dry_run}" == "true" ]]; then
        log-info "[DRY RUN] Would unmount ${_unit_name} @ ${_mount_path}"
        return 0
    fi

    log-debug "unmounting ${_unit_name} at ${_mount_path}"
    rclone-unmount "${_mount_path}"
}

remote-mount-all() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _pattern="${1:-*}"
    local _units _count=0
    _units=$(_remote-patterns-match-units "${_pattern}")

    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    log-info "Mounting units matching: ${_pattern}"
    local _unit
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        log-info "Mounting: ${_unit}"
        if [[ "${_dry_run}" == "true" ]]; then
            log-info "[DRY RUN] Would mount: ${_unit}"
        else
            systemd-start "remote-mount@${_unit}"
        fi
        ((_count++)) || true
    done <<< "${_units}"

    log-info "Mounted ${_count} unit(s)"
}

remote-unmount-all() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _pattern="${1:-*}"
    local _units _count=0
    _units=$(_remote-patterns-match-units "${_pattern}")

    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    log-info "Unmounting units matching: ${_pattern}"
    local _unit
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        log-info "Unmounting: ${_unit}"
        if [[ "${_dry_run}" == "true" ]]; then
            log-info "[DRY RUN] Would unmount: ${_unit}"
        else
            systemd-stop "remote-mount@${_unit}"
        fi
        ((_count++)) || true
    done <<< "${_units}"

    log-info "Unmounted ${_count} unit(s)"
}

# ------------------------------
# Sync
# ------------------------------

# Usage: remote-sync [--dry-run] <unit>
# Runs as an rc job inside the unit's own mount process, not as a second
# rclone: one fs instance and one credential per unit, so a pool rotation
# moves the mount and the sync together, and the job's result comes back
# over the socket instead of an exit code plus a log grep. The per-job
# _config carries what a move needs (eight transfers: at Drive's
# per-request latency one stream idles about half the time, eight of
# them fill the uplink). The drive-side tuning (128M chunks,
# stop_on_upload_limit) is in the rendered rclone.conf, see
# _remote-pool-render-rclone-conf. A mount restart aborts the job; the
# next timer run resumes, since moved files are gone from the source.
# --dry-run submits the job with DryRun set: the "would move" lines land
# in the unit's rclone.log.
remote-sync() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }

    _remote-require-unit "$1" || return 1
    local _unit_name="$1"

    local _lock_name="remote-sync-${_unit_name}"
    singleton-try-lock "${_lock_name}" || { log-error "Sync already in progress for ${_unit_name}"; return 1; }

    local _runtime_dir="$(xdg-runtime-dir "remote")/${_unit_name}"
    local _sock="${_runtime_dir}/rc.sock"

    local _mountpoint _root_local _root_remote _local_mount_point
    _mountpoint=$(_remote-config-unit-mountpoint "${_unit_name}")
    _root_local=$(_remote-config-root "local")
    _root_remote=$(_remote-config-root "remote")
    _local_mount_point="${_root_local}/${_mountpoint}"

    # Most units never have local content staged, so a missing local dir is
    # the normal "nothing to sync" case, not a failure.
    if [[ ! -d "${_local_mount_point}" ]]; then
        log-info "Nothing to sync for ${_unit_name}: ${_local_mount_point} does not exist"
        singleton-unlock "${_lock_name}"
        return 0
    fi

    rclone-is-mounted "${_root_remote}/${_mountpoint}" || { log-error "Unit not currently mounted: ${_unit_name}"; singleton-unlock "${_lock_name}"; return 1; }
    [[ -S "${_sock}" ]] || { log-error "No control socket for ${_unit_name}"; singleton-unlock "${_lock_name}"; return 1; }

    local _group="sync-${_unit_name}" _config
    _config=$(jq -nc --argjson dry "${_dry_run}" '{Transfers: 8, Checkers: 8, BufferSize: "16M", DryRun: $dry}')

    # On a multi-key pool a cap-hit rotates the pool and resubmits the job
    # under the next key. Bounded by pool size.
    local _pool _multi=false _attempts=1
    _pool=$(_remote-config-unit-pool "${_unit_name}")
    if _remote-pool-rotates "${_pool}"; then
        _multi=true
        _attempts=$(_remote-config-pool-keys "${_pool}" | grep -c .)
    fi

    # Stopping remote-sync@<unit> must stop the job too, or it would carry
    # on inside the mount with nothing watching it. The handler only flags
    # and stops the job; the loop below notices and cleans up. The wait
    # runs in the foreground (no command substitution) so the handler
    # runs in this shell and the loop resumes after it.
    _REMOTE_SYNC_SOCK="${_sock}" _REMOTE_SYNC_JOB="" _REMOTE_SYNC_ABORTED=false
    trap '_remote-sync-abort' TERM INT

    # Stats groups outlive their jobs, so without this a run would report
    # (and remote-stats would show) the previous run's counters and errors.
    rclone-rc-unix "${_sock}" core/stats-reset "group=${_group}" >/dev/null 2>&1 || true

    local _rc=0 _key _reply _jobid _status _err
    while (( _attempts-- > 0 )); do
        [[ "${_REMOTE_SYNC_ABORTED}" == "true" ]] && { _rc=143; break; }
        _rc=0
        [[ "${_multi}" == "true" ]] && _key=$(_remote-pool-current "${_pool}")
        _reply=$(rclone-rc-unix "${_sock}" sync/move "srcFs=${_local_mount_point}" "dstFs=${_unit_name}:" \
            deleteEmptySrcDirs=true _async=true "_group=${_group}" "_config=${_config}") || { _rc=1; break; }
        _jobid=$(jq -r '.jobid // empty' <<< "${_reply}")
        [[ -n "${_jobid}" ]] || { log-error "Sync job for ${_unit_name} not accepted: ${_reply}"; _rc=1; break; }
        _REMOTE_SYNC_JOB="${_jobid}"
        printf '%s\n' "${_jobid}" > "${_runtime_dir}/sync.job"
        log-info "Sync job ${_jobid} started for ${_unit_name}${_key:+ on ${_key}}"

        rclone-rc-job-wait "${_sock}" "${_jobid}" > "${_runtime_dir}/sync.status" || _rc=1
        _status=$(<"${_runtime_dir}/sync.status")
        [[ "${_REMOTE_SYNC_ABORTED}" == "true" ]] && { _rc=143; break; }
        (( _rc == 0 )) && break
        _err=$(jq -r '.error // ""' <<< "${_status}")
        if [[ "${_multi}" != "true" || "${_err}" != *"${_REMOTE_POOL_QUOTA_MSG}"* ]]; then
            log-error "Sync job ${_jobid} failed for ${_unit_name}: ${_err:-rc socket stopped answering}"
            break
        fi
        log-warning "Upload cap hit on ${_key} while syncing ${_unit_name}"
        remote-rotate --if-current "${_key}" "${_pool}" || break
        # Clears the group's lastError so remote-health does not rotate
        # again for the same hit on its next sweep.
        rclone-rc-unix "${_sock}" core/stats-reset "group=${_group}" >/dev/null 2>&1 || true
    done

    trap - TERM INT
    rm -f "${_runtime_dir}/sync.job" "${_runtime_dir}/sync.status"
    singleton-unlock "${_lock_name}"
    (( _rc != 0 )) && return ${_rc}
    log-info "Sync complete for ${_unit_name}: $(_remote-sync-summary "${_sock}" "${_group}")"
}

typeset -g _REMOTE_SYNC_SOCK="" _REMOTE_SYNC_JOB="" _REMOTE_SYNC_ABORTED=false

_remote-sync-abort() {
    _REMOTE_SYNC_ABORTED=true
    log-warning "Sync interrupted: stopping job ${_REMOTE_SYNC_JOB:-<none>}"
    [[ -n "${_REMOTE_SYNC_JOB}" ]] && rclone-rc-job-stop "${_REMOTE_SYNC_SOCK}" "${_REMOTE_SYNC_JOB}" 2>/dev/null
    return 0
}

# Usage: _remote-sync-summary <socket> <group>
_remote-sync-summary() {
    local _st _bytes
    _st=$(rclone-rc-unix "$1" core/stats "group=$2" short=true 2>/dev/null) || { echo "no stats"; return 0; }
    _bytes=$(jq -r '.bytes // 0' <<< "${_st}" | numfmt --to=iec --suffix=B 2>/dev/null)
    jq -r --arg b "${_bytes}" '"\(.transfers // 0) file(s), \($b), \(.errors // 0) error(s)"' <<< "${_st}"
}

# ------------------------------
# Systemd service control
# ------------------------------

remote-enable() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _unit="$1"
    _remote-require-unit "${_unit}" || return 1

    if [[ "${_dry_run}" == "true" ]]; then
        log-info "[DRY RUN] Would enable: ${_unit} (mount, sync service, sync timer)"
        return 0
    fi
    # Mount first: remote-sync@.service Requisite=remote-mount@%i.service, so
    # enabling sync before the mount is active would just fail fast.
    #
    # sync's start is --no-block: it's Type=oneshot and its ExecStart runs a
    # full remote-sync (file scan + rclone move), which can take minutes to
    # hours. A blocking `systemctl start` would stall this command - and
    # every remote-enable-all fanning out over it - for the sync's entire
    # runtime instead of just kicking it off. Check progress via
    # `systemctl --user status remote-sync@<unit>.service` or the journal.
    systemd-enable-start "remote-mount@${_unit}" &&
        systemd-enable-start --no-block "remote-sync@${_unit}.service" &&
        systemd-enable-start "remote-sync@${_unit}.timer"
}

remote-disable() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _unit="$1"
    # Deliberately not _remote-require-unit: disabling must still work for a
    # unit that has since been removed from units.json.
    [[ -z "${_unit}" ]] && { log-error "No unit specified."; return 1; }

    if [[ "${_dry_run}" == "true" ]]; then
        log-info "[DRY RUN] Would disable: ${_unit} (mount, sync service, sync timer)"
        return 0
    fi
    # Reverse of enable's order: tear down sync before pulling the mount out
    # from under it.
    systemd-disable-stop "remote-sync@${_unit}.timer"
    systemd-disable-stop "remote-sync@${_unit}.service"
    systemd-disable-stop "remote-mount@${_unit}"
}

remote-restart() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _unit="$1"
    _remote-require-unit "${_unit}" || return 1

    if [[ "${_dry_run}" == "true" ]]; then
        log-info "[DRY RUN] Would restart: ${_unit}"
        return 0
    fi
    systemd-restart "remote-mount@${_unit}"
}

remote-enable-all() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _pattern="${1:-*}"
    local _units _count=0
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    log-info "Enabling units matching: ${_pattern}"
    local _unit
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        log-info "Enabling: ${_unit}"
        if [[ "${_dry_run}" == "true" ]]; then
            remote-enable --dry-run "${_unit}"
        else
            remote-enable "${_unit}"
        fi
        ((_count++)) || true
    done <<< "${_units}"
    log-info "Enabled ${_count} unit(s)"
}

remote-disable-all() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _pattern="${1:-*}"
    local _units _count=0
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    log-info "Disabling units matching: ${_pattern}"
    local _unit
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        log-info "Disabling: ${_unit}"
        if [[ "${_dry_run}" == "true" ]]; then
            remote-disable --dry-run "${_unit}"
        else
            remote-disable "${_unit}"
        fi
        ((_count++)) || true
    done <<< "${_units}"
    log-info "Disabled ${_count} unit(s)"
}

remote-restart-all() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _pattern="${1:-*}"
    local _units _count=0
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    # A systemd restart of a stopped unit starts it, so without this
    # filter a sweep would bring up every unit in units.json. `remote
    # restart <unit>` stays unfiltered: naming one unit is explicit.
    log-info "Restarting active units matching: ${_pattern}"
    local _unit _skipped=0
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        systemd-is-active "remote-mount@${_unit}" || { ((_skipped++)) || true; continue; }
        log-info "Restarting: ${_unit}"
        if [[ "${_dry_run}" == "true" ]]; then
            remote-restart --dry-run "${_unit}"
        else
            remote-restart "${_unit}"
        fi
        ((_count++)) || true
    done <<< "${_units}"
    log-info "Restarted ${_count} unit(s), skipped ${_skipped} not running"
}

remote-status() {
    # No _systemd equivalent for a glob-filtered unit listing; kept direct.
    systemctl --user list-units "remote-mount@*"
}

# ------------------------------
# Service-account pools
# ------------------------------

# Usage: remote-rotate [--if-current <key>] <pool>
# Advances the pool, then moves every live mount on it to the new key in
# place through rclone's rc `backend set`: no remount, the VFS and dir
# caches survive, a sync job running in the process carries on under the
# new key, and an upload in flight on the old key fails once and is
# retried.
remote-rotate() {
    local _expected=""
    [[ "$1" == "--if-current" ]] && { _expected="$2"; shift 2; }
    local _pool="$1"
    _remote-pool-require "${_pool}" || return 1

    local _key _file _opt
    _key=$(_remote-pool-advance "${_pool}" "${_expected}") || return 1
    _file=$(_remote-pool-key-file "${_pool}" "${_key}") || return 1
    _opt=$(jq -nc --arg f "${_file}" '{service_account_file: $f}')

    local _unit _dir _switched=0 _failed=0
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        _dir="$(xdg-runtime-dir "remote")/${_unit}"
        [[ -S "${_dir}/rc.sock" ]] || continue
        if rclone-rc-unix "${_dir}/rc.sock" backend/command command=set "fs=${_unit}:" "opt=${_opt}" >/dev/null 2>&1; then
            log-info "Switched mount ${_unit} to ${_key}"
            # The runtime conf keeps saying what the process actually runs on.
            _remote-pool-render-rclone-conf "${_unit}" "${_pool}" > "${_dir}/rclone.conf.tmp" &&
                mv -f "${_dir}/rclone.conf.tmp" "${_dir}/rclone.conf"
            ((_switched++)) || true
        else
            log-error "Failed to switch mount ${_unit} to ${_key} (restart it to pick up the new key)"
            ((_failed++)) || true
        fi
    done <<< "$(_remote-pool-mount-units "${_pool}")"

    log-info "Pool ${_pool} now on ${_key}: ${_switched} mount(s) switched, ${_failed} failed"
    [[ ${_failed} -eq 0 ]]
}

remote-pool() {
    local _pools
    _pools="${1:-$(_remote-config-pool-names)}"
    [[ -z "${_pools}" ]] && { log-error "No pools in pools.json"; return 1; }

    local _pool _state _current _now _key _ex _frees _file _mark
    _now=$(date +%s)
    while read -r _pool; do
        [[ -z "${_pool}" ]] && continue
        _remote-pool-require "${_pool}" || continue
        _state=$(_remote-pool-state "${_pool}")
        _current=$(jq -r '.current // ""' <<< "${_state}")
        echo "${_pool} (window: ${REMOTE_POOL_QUOTA_WINDOW}s)"
        printf "  %-3s %-66s %-8s %s\n" "" "KEY" "FILE" "STATE"
        while read -r _key; do
            [[ -z "${_key}" ]] && continue
            _mark=""; [[ "${_key}" == "${_current}" ]] && _mark="*"
            _file="bad"; _remote-pool-key-file "${_pool}" "${_key}" >/dev/null 2>&1 && _file="ok"
            _ex=$(jq -r --arg k "${_key}" '.exhausted[$k] // 0' <<< "${_state}")
            if (( _ex + REMOTE_POOL_QUOTA_WINDOW > _now )); then
                _frees=$(date -d "@$(( _ex + REMOTE_POOL_QUOTA_WINDOW ))" '+%F %T')
                printf "  %-3s %-66s %-8s exhausted, frees %s\n" "${_mark}" "${_key}" "${_file}" "${_frees}"
            else
                printf "  %-3s %-66s %-8s available\n" "${_mark}" "${_key}" "${_file}"
            fi
        done <<< "$(_remote-config-pool-keys "${_pool}")"
        echo ""
    done <<< "${_pools}"
}

# ------------------------------
# rc views
# ------------------------------

# Usage: remote-stats [pattern]
# What each mounted unit's rclone process is doing right now, from
# core/stats: the sum over the sync job and the VFS. SPEED is the current
# rate over files in flight; BYTES and FILES count since the process
# started or its stats were last reset.
remote-stats() {
    local _pattern="${1:-*}" _units
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    printf "%-22s %10s %10s %6s %6s  %s\n" "UNIT" "SPEED" "BYTES" "FILES" "ERRORS" "LAST ERROR"
    local _unit _sock _st
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        _sock="$(xdg-runtime-dir "remote")/${_unit}/rc.sock"
        [[ -S "${_sock}" ]] || continue
        _st=$(rclone-rc-unix "${_sock}" core/stats 2>/dev/null) ||
            { printf "%-22s %s\n" "${_unit}" "(rc not answering)"; continue; }
        jq -r --arg u "${_unit}" '
            def iec: if . >= 1073741824 then "\((. / 1073741824 * 10 | round) / 10)G"
                     elif . >= 1048576 then "\(. / 1048576 | round)M"
                     elif . >= 1024 then "\(. / 1024 | round)K"
                     else "\(. | round)B" end;
            [ $u,
              (([.transferring[]?.speedAvg // 0] | add // 0 | iec) + "/s"),
              (.bytes // 0 | iec),
              (.transfers // 0 | tostring),
              (.errors // 0 | tostring),
              ((.lastError // "") | .[0:60]) ] | @tsv' <<< "${_st}" |
            awk -F'\t' '{ printf "%-22s %10s %10s %6s %6s  %s\n", $1, $2, $3, $4, $5, $6 }'
    done <<< "${_units}"
}

# Usage: remote-jobs [pattern]
# Jobs running inside each mounted unit's process: a sync (group
# sync-<unit>) or a dir-cache refresh from remote-warm.
remote-jobs() {
    local _pattern="${1:-*}" _units
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    printf "%-22s %6s %-24s %s\n" "UNIT" "JOB" "GROUP" "RUNNING FOR"
    local _unit _sock _list _id _st _started _found=0 _t0
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        _sock="$(xdg-runtime-dir "remote")/${_unit}/rc.sock"
        [[ -S "${_sock}" ]] || continue
        # rclone runs every rc call as a job, so job/list reports itself as
        # running; anything started after this timestamp is our own call.
        _t0=$(date +%s.%N)
        _list=$(rclone-rc-unix "${_sock}" job/list 2>/dev/null) || continue
        while read -r _id; do
            [[ -z "${_id}" ]] && continue
            _st=$(rclone-rc-unix "${_sock}" job/status "jobid=${_id}" 2>/dev/null) || continue
            _started=$(date -d "$(jq -r '.startTime' <<< "${_st}")" +%s.%N 2>/dev/null) || continue
            (( _started >= _t0 )) && continue
            printf "%-22s %6s %-24s %.0fs\n" "${_unit}" "${_id}" "$(jq -r '.group // "-"' <<< "${_st}")" "$(( _t0 - _started ))"
            ((_found++)) || true
        done <<< "$(jq -r '.runningIds[]?' <<< "${_list}")"
    done <<< "${_units}"
    (( _found == 0 )) && echo "(no running jobs)"
    return 0
}

# Usage: remote-throttle <unit|pattern> <rate|off>
# core/bwlimit on each matching mounted unit, same syntax as --bwlimit
# ("10M", "5M:1M" for up:down, "off"). Takes effect on transfers in
# flight and lasts until the mount restarts; nothing persists it.
remote-throttle() {
    local _pattern="$1" _rate="$2"
    [[ -z "${_pattern}" || -z "${_rate}" ]] && { log-error "Usage: remote throttle <unit|pattern> <rate|off>"; return 1; }
    local _units
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    local _unit _sock _r _n=0
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        _sock="$(xdg-runtime-dir "remote")/${_unit}/rc.sock"
        [[ -S "${_sock}" ]] || continue
        _r=$(rclone-rc-unix "${_sock}" core/bwlimit "rate=${_rate}" 2>/dev/null) ||
            { log-error "Failed to set bandwidth limit on ${_unit}"; continue; }
        log-info "${_unit}: bandwidth limit $(jq -r '.rate' <<< "${_r}")"
        ((_n++)) || true
    done <<< "${_units}"
    (( _n > 0 )) || { log-error "No mounted unit matches ${_pattern}"; return 1; }
}

# ------------------------------
# List / verify / cleanup
# ------------------------------

remote-list() {
    local _pattern="${1:-*}"
    local _units _count=0
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    printf "%-25s %-20s %-15s %-20s\n" "UNIT" "MOUNTPOINT" "STATUS" "CACHE SIZE"
    printf "%-25s %-20s %-15s %-20s\n" "----" "----------" "------" "----------"

    local _unit
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue

        local _mountpoint=$(_remote-config-unit-mountpoint "${_unit}")
        local _status=$(systemd-get-state "remote-mount@${_unit}")
        local _cache_dir="$(xdg-cache-dir "remote")/${_unit}"
        local _cache_size="0"
        [[ -d "${_cache_dir}" ]] && _cache_size=$(du -sh "${_cache_dir}" 2>/dev/null | cut -f1 || echo "0")

        printf "%-25s %-20s %-15s %-20s\n" "${_unit}" "${_mountpoint}" "${_status}" "${_cache_size}"
        ((_count++)) || true
    done <<< "${_units}"

    echo ""
    log-info "Total: ${_count} unit(s)"
}

remote-verify() {
    local _pattern="${1:-*}"
    local _units _failed=0 _passed=0
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    log-info "Verifying units matching: ${_pattern}"
    echo ""

    # Loop-scoped names declared once: a repeated bare `local x` on a set
    # variable makes zsh print it (see remote-health).
    local _unit _k
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        local _errors=""

        _remote-config-unit-exists "${_unit}" || _errors="${_errors}\n  - Unit not found in units.json"

        local _pool=$(_remote-config-unit-pool "${_unit}")
        if [[ "${_pool}" == "null" ]]; then
            _errors="${_errors}\n  - Pool not configured"
        elif ! _remote-pool-require "${_pool}" 2>/dev/null; then
            _errors="${_errors}\n  - Pool '${_pool}' not found or has no keys"
        else
            while read -r _k; do
                [[ -z "${_k}" ]] && continue
                _remote-pool-key-file "${_pool}" "${_k}" >/dev/null 2>&1 ||
                    _errors="${_errors}\n  - Pool '${_pool}': unusable key file for ${_k}"
            done <<< "$(_remote-config-pool-keys "${_pool}")"
        fi

        local _mountpoint=$(_remote-config-unit-mountpoint "${_unit}")
        [[ "${_mountpoint}" == "null" ]] && _errors="${_errors}\n  - Mountpoint not configured"

        local _root_remote=$(_remote-config-root "remote")
        local _status=""
        if rclone-is-mounted "${_root_remote}/${_mountpoint}"; then
            _status="mounted"
        else
            _status="not mounted"
        fi

        local _runtime_cfg="$(xdg-runtime-dir "remote")/${_unit}/rclone.conf"
        [[ ! -f "${_runtime_cfg}" && "${_status}" == "mounted" ]] && \
            _errors="${_errors}\n  - Runtime config missing but unit is mounted"

        if [[ -n "${_errors}" ]]; then
            echo "[FAIL] ${_unit}"
            echo -e "${_errors}"
            ((_failed++)) || true
        else
            echo "[PASS] ${_unit} (${_status})"
            ((_passed++)) || true
        fi
    done <<< "${_units}"

    echo ""
    log-info "Verification complete: ${_passed} passed, ${_failed} failed"
    return ${_failed}
}

# Liveness sweep for remote-healthcheck.timer: unlike remote-verify (a
# read-only diagnostic also used as remote-mount@.service's ExecStartPre
# gate), this restarts what it finds unhealthy. Only considers units whose
# remote-mount@<unit>.service is actually enabled - "should be running" per
# systemd, not just present in units.json. rclone-is-mounted alone only
# checks the kernel mount table; a wedged-but-still-mounted FUSE endpoint
# (network drop, revoked token) passes that check while I/O hangs, so a
# bounded stat is also required to catch it.
remote-health() {
    local _pattern="${1:-*}"
    local _units _checked=0 _restarted=0 _rotated=0
    _units=$(_remote-patterns-match-units "${_pattern}")
    [[ -z "${_units}" ]] && { log-error "No units match pattern: ${_pattern}"; return 1; }

    # Declared outside the loop: re-running a bare `local x` on an already
    # set variable makes zsh print it, which spammed the journal every run.
    local _unit _mountpoint _root_remote _mount_path _pool _sock _stats _healthy
    while read -r _unit; do
        [[ -z "${_unit}" ]] && continue
        systemd-is-enabled "remote-mount@${_unit}" || continue
        ((_checked++)) || true

        _mountpoint=$(_remote-config-unit-mountpoint "${_unit}")
        _root_remote=$(_remote-config-root "remote")
        _mount_path="${_root_remote}/${_mountpoint}"
        _sock="$(xdg-runtime-dir "remote")/${_unit}/rc.sock"

        _healthy=true
        rclone-is-mounted "${_mount_path}" || _healthy=false
        if [[ "${_healthy}" == "true" ]]; then
            timeout --kill-after=5s 10s stat "${_mount_path}" >/dev/null 2>&1 || _healthy=false
        fi
        # Sync and rotate both go through the socket, so a mount that still
        # serves I/O but no longer answers rc is unhealthy too.
        if [[ "${_healthy}" == "true" ]]; then
            rclone-rc-alive "${_sock}" || _healthy=false
        fi

        if [[ "${_healthy}" != "true" ]]; then
            log-warning "Unhealthy mount detected: ${_unit} - restarting"
            systemd-restart "remote-mount@${_unit}"
            ((_restarted++)) || true
            continue
        fi
        log-debug "Healthy: ${_unit}"

        # A cap hit that nothing handled - a VFS writeback upload, or a
        # sync job whose `remote sync` died before it could rotate - sits
        # in the process's stats as lastError. remote-sync resets its own
        # group after rotating, so what is still there here is unhandled.
        _pool=$(_remote-config-unit-pool "${_unit}")
        _remote-pool-rotates "${_pool}" || continue
        _stats=$(rclone-rc-unix "${_sock}" core/stats short=true 2>/dev/null) || continue
        if [[ "$(jq -r '.lastError // ""' <<< "${_stats}")" == *"${_REMOTE_POOL_QUOTA_MSG}"* ]]; then
            log-warning "Upload cap hit on mount ${_unit} - rotating pool ${_pool}"
            remote-rotate --if-current "$(_remote-pool-current "${_pool}")" "${_pool}" && ((_rotated++)) || true
            rclone-rc-unix "${_sock}" core/stats-reset >/dev/null 2>&1 || true
        fi
    done <<< "${_units}"

    log-info "Health check complete: ${_checked} checked, ${_restarted} restarted, ${_rotated} pool rotation(s)"
}

# Run as remote-mount@.service's ExecStartPost. rclone's dir cache lives in
# memory, so every (re)start leaves it empty and the first walk of the tree
# (e.g. an Emby library scan) pays a Drive API round trip per directory.
# A recursive vfs/refresh fetches the whole drive in bulk pages instead.
# _async: returns once the job is queued; the listing runs inside the mount.
remote-warm() {
    _remote-require-unit "$1" || return 1
    local _unit_name="$1"
    local _sock="$(xdg-runtime-dir "remote")/${_unit_name}/rc.sock"

    if [[ "$(_remote-config-unit-warm "${_unit_name}")" != "true" ]]; then
        log-info "Dir cache warm-up disabled for ${_unit_name} (units.json: warm=false)"
        return 0
    fi

    [[ -S "${_sock}" ]] || { log-error "No control socket for ${_unit_name} (not mounted?)"; return 1; }

    rclone rc --unix-socket "${_sock}" vfs/refresh recursive=true _async=true >/dev/null ||
        { log-error "Failed to start dir cache refresh for ${_unit_name}"; return 1; }
    log-info "Dir cache refresh started for ${_unit_name}"
}

remote-cleanup() {
    local _dry_run=false
    [[ "$1" == "--dry-run" ]] && { _dry_run=true; shift; }
    local _force=false
    [[ "$1" == "--force" ]] && _force=true

    log-info "Cleaning up stale runtime configs and empty caches..."
    local _cleaned=0
    local _runtime_root="$(xdg-runtime-dir "remote")"
    local _cache_root="$(xdg-cache-dir "remote")"

    if [[ -d "${_runtime_root}" ]]; then
        local _unit_dir
        for _unit_dir in "${_runtime_root}"/*; do
            [[ ! -d "${_unit_dir}" ]] && continue
            local _unit=$(basename "${_unit_dir}")
            local _mountpoint=$(_remote-config-unit-mountpoint "${_unit}")
            local _root_remote=$(_remote-config-root "remote")

            if ! rclone-is-mounted "${_root_remote}/${_mountpoint}"; then
                if [[ "${_dry_run}" == "true" ]]; then
                    log-info "[DRY RUN] Would remove runtime config: ${_unit_dir}"
                else
                    log-debug "Removing stale runtime config: ${_unit}"
                    rm -rf "${_unit_dir}"
                fi
                ((_cleaned++)) || true
            fi
        done
    fi

    if [[ -d "${_cache_root}" ]]; then
        local _cache_dir
        for _cache_dir in "${_cache_root}"/*; do
            [[ ! -d "${_cache_dir}" ]] && continue
            if [[ -z "$(ls -A "${_cache_dir}")" || "${_force}" == "true" ]]; then
                if [[ "${_dry_run}" == "true" ]]; then
                    log-info "[DRY RUN] Would remove cache: ${_cache_dir}"
                else
                    log-debug "Removing empty cache: $(basename "${_cache_dir}")"
                    rm -rf "${_cache_dir}"
                fi
                ((_cleaned++)) || true
            fi
        done
    fi

    log-info "Cleanup complete: ${_cleaned} item(s) removed"
}
