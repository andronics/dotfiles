#!/usr/bin/env zsh

# _tour - live showcase of dotlib's framework and its never-before-run modules
# Part of the dotfiles library
#
# Usage:
#   source "${DOTLIB}/_tour"
#
# Most of dotlib's modules are written but never exercised by a real
# wrapper (see the dotlib README's "Module status" note). This module
# runs real demos through them -- _ui, _format, _string, _validation,
# _events, _async, _rules, _crypto, _schema, _notify, _test -- using
# each module's actual public functions. Business logic stays in
# those modules; this file only supplies narration, sample data, and
# pacing.
#
# Dependencies:
#   Required:
#     - _common, _ui, _format, _string, _validation, _events, _async,
#       _rules, _crypto, _schema, _notify, _test
#   Optional:
#     - _log

[[ -n "${TOUR_LOADED:-}" ]] && return 0
declare -gr TOUR_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _tour requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

source "${DOTLIB}/_ui"         || { echo "[ERROR] _tour requires _ui" >&2; return 1; }
source "${DOTLIB}/_format"     || { echo "[ERROR] _tour requires _format" >&2; return 1; }
source "${DOTLIB}/_string"     || { echo "[ERROR] _tour requires _string" >&2; return 1; }
source "${DOTLIB}/_validation" || { echo "[ERROR] _tour requires _validation" >&2; return 1; }
source "${DOTLIB}/_events"     || { echo "[ERROR] _tour requires _events" >&2; return 1; }
source "${DOTLIB}/_async"      || { echo "[ERROR] _tour requires _async" >&2; return 1; }
source "${DOTLIB}/_rules"      || { echo "[ERROR] _tour requires _rules" >&2; return 1; }
source "${DOTLIB}/_crypto"     || { echo "[ERROR] _tour requires _crypto" >&2; return 1; }
source "${DOTLIB}/_schema"     || { echo "[ERROR] _tour requires _schema" >&2; return 1; }
source "${DOTLIB}/_notify"     || { echo "[ERROR] _tour requires _notify" >&2; return 1; }
source "${DOTLIB}/_test"       || { echo "[ERROR] _tour requires _test" >&2; return 1; }

typeset -gA _TOUR_DESCRIPTIONS=(
    [intro]="Show the opening banner"
    [ui]="Tour _ui: colored output, tables, progress, spinner"
    [format]="Tour _format: alignment, wrapping, lists, boxes"
    [string]="Tour _string: case conversion and predicates"
    [validate]="Tour _validation: type checks against sample data"
    [events]="Tour _events: pub/sub handler registration and emission"
    [async]="Tour _async: parallel execution and retry-until-success"
    [rules]="Tour _rules: condition/action rule evaluation"
    [crypto]="Tour _crypto: hashing, HMAC, and roundtrip encryption"
    [schema]="Tour _schema: action/v1 schema validation and querying"
    [notify]="Tour _notify: a real desktop notification"
    [framework]="Tour _dispatcher's own help/commands/completion/dry-run"
    [run]="Run the full tour end to end (--fast skips pacing)"
)

# ------------------------------
# Private helpers
# ------------------------------

# Fixed path so async-retry's subshelled attempts can share a counter
# (a shell variable wouldn't survive the command-substitution subshell).
declare -g _TOUR_FLAKY_COUNTER="${TMPDIR:-/tmp}/dotlib-tour-flaky-$$"

_tour-flaky() {
    local n=0
    [[ -f "$_TOUR_FLAKY_COUNTER" ]] && n=$(<"$_TOUR_FLAKY_COUNTER")
    n=$((n + 1))
    echo "$n" > "$_TOUR_FLAKY_COUNTER"
    [[ $n -ge 2 ]]
}

_tour-on-greet() {
    ui-info "handler fired: $*"
}

_tour-quiet() {
    "$@" >/dev/null 2>&1
}

# ------------------------------
# Sections
# ------------------------------

tour-intro() {
    ui-banner "DOTLIB TOUR"
    ui-color cyan "A live walkthrough of dotlib's framework and its never-before-run modules."
}

tour-ui() {
    ui-header "_ui — terminal UI kit"

    ui-success "This is what a successful operation looks like"
    ui-warning "This is a warning"
    ui-error   "This is an error (goes to stderr)"
    ui-info    "This is informational"

    echo ""
    ui-table-header "MODULE" "STATUS" "SIZE" "CLAIMED"
    ui-table-separator 80
    ui-table-row "_ui" "demoed" "~18K" "no"
    ui-table-row "_async" "demoed" "~40K" "no"
    ui-table-row "_bluetooth" "in use" "~51K" "yes"

    echo ""
    ui-list "Colored output" "Tables" "Progress bars" "Spinners"

    echo ""
    local total=20 i
    for ((i = 0; i <= total; i++)); do
        ui-progress "$i" "$total"
        sleep 0.03
    done
    ui-progress-complete

    ( sleep 1 ) &
    ui-spinner "$!" "Simulating background work"
}

tour-format() {
    ui-header "_format — text styling"

    format-titlecase "the quick brown fox jumps over the lazy dog"
    echo ""
    format-align-center "centered" 40
    echo ""
    format-wrap "dotlib is a personal zsh helper library with dispatcher-routed wrapper scripts and business logic pushed into sourced modules" 50
    echo ""
    format-list-bullet "Alignment" "Wrapping" "Lists" "Boxes"
    echo ""
    echo "1234567 formatted: $(format-number 1234567)"
    echo ""
    format-box "dotlib" "52 modules" "11 claimed before this tour" "10 more demoed here"
}

tour-string() {
    ui-header "_string — case conversion & predicates"

    local sample="Hello Dotlib World"
    printf "%-20s %s\n" "camelCase"       "$(string-camelcase "$sample")"
    printf "%-20s %s\n" "PascalCase"      "$(string-pascalcase "$sample")"
    printf "%-20s %s\n" "snake_case"      "$(string-snakecase "$sample")"
    printf "%-20s %s\n" "kebab-case"      "$(string-kebabcase "$sample")"
    printf "%-20s %s\n" "SCREAMING_SNAKE" "$(string-screamingsnakecase "$sample")"

    echo ""
    string-is-numeric "42"  && ui-success "'42' is numeric"  || ui-error "'42' is numeric"
    string-is-numeric "abc" && ui-success "'abc' is numeric" || ui-error "'abc' is not numeric"
    echo ""
    string-pad-center "dotlib" 20 "*"
    echo ""
}

tour-validate() {
    ui-header "_validation — type checks against sample data"

    local uuid; uuid="$(crypto-uuid)"
    local -a checks=(
        "validate-type-email|user@example.com|valid email"
        "validate-type-email|not-an-email|invalid email"
        "validate-type-ip|192.168.1.1|valid IPv4"
        "validate-type-ip|999.1.1.1|invalid IPv4 (octet out of range)"
        "validate-type-uuid|${uuid}|freshly generated UUID"
        "validate-type-port|8080|valid port"
        "validate-type-port|99999|invalid port (out of range)"
    )

    local check fn rest value label
    for check in "${checks[@]}"; do
        fn="${check%%|*}"
        rest="${check#*|}"
        value="${rest%%|*}"
        label="${rest#*|}"

        if "$fn" "$value" 2>/dev/null; then
            ui-success "$label: '$value'"
        else
            ui-error "$label: '$value'"
        fi
    done
}

tour-events() {
    ui-header "_events — pub/sub bus"

    events-init
    events-on "tour.greet" _tour-on-greet >/dev/null
    events-emit "tour.greet" "hello from the tour"

    echo ""
    ui-info "recent event history:"
    events-history --limit 3
}

tour-async() {
    ui-header "_async — parallel execution & retry"

    ui-info "running 3 tasks in parallel..."
    async-parallel \
        "echo 'task A done'; sleep 0.3" \
        "echo 'task B done'; sleep 0.5" \
        "echo 'task C done'; sleep 0.2"

    echo ""
    ui-info "retrying a flaky task until it succeeds..."
    rm -f "$_TOUR_FLAKY_COUNTER"
    if async-retry --times 3 --interval 1 _tour-flaky; then
        ui-success "flaky task succeeded (took $(<"$_TOUR_FLAKY_COUNTER") attempt(s))"
    else
        ui-error "flaky task never succeeded"
    fi
    rm -f "$_TOUR_FLAKY_COUNTER"
}

tour-rules() {
    ui-header "_rules — condition/action engine"

    rules-define "zsh-available" rules-cond-command-exists rules-action-echo 10 "zsh is installed"
    rules-define "business-hours" rules-cond-time-between rules-action-echo 20 "current hour is 9-17"

    echo ""
    if rules-eval "zsh-available" "zsh"; then
        ui-success "rule 'zsh-available' matched and ran"
    else
        ui-warning "rule 'zsh-available' did not match"
    fi

    if rules-eval "business-hours" 9 17; then
        ui-success "rule 'business-hours' matched and ran"
    else
        ui-warning "rule 'business-hours' did not match (outside 09:00-17:00)"
    fi
}

tour-crypto() {
    ui-header "_crypto — hashing, HMAC, and encryption"

    local secret="dotlib-tour-secret" plaintext="the quick brown fox"
    local id hash hmac
    id="$(crypto-uuid)"
    hash="$(crypto-sha256 "$plaintext")"
    hmac="$(crypto-hmac sha256 "$secret" "$plaintext")"

    ui-list "uuid:   $id" "sha256: $hash" "hmac:   $hmac"

    echo ""
    ui-info "roundtrip encrypt/decrypt..."
    local cipher decrypted
    cipher="$(crypto-encrypt "$plaintext" --password "$secret")"
    decrypted="$(crypto-decrypt "$cipher" --password "$secret")"

    if [[ "$decrypted" == "$plaintext" ]]; then
        ui-success "decrypted text matches original: '$decrypted'"
    else
        ui-error "roundtrip failed: got '$decrypted'"
    fi
}

tour-schema() {
    ui-header "_schema — action/v1 schema engine"

    local good_schema bad_schema
    good_schema="$(mktemp --suffix=.yaml "${TMPDIR:-/tmp}/dotlib-tour-schema-good.XXXXXX")"
    bad_schema="$(mktemp --suffix=.yaml "${TMPDIR:-/tmp}/dotlib-tour-schema-bad.XXXXXX")"

    cat > "$good_schema" <<'YAML'
schema: action/v1
metadata:
  name: dotlib-tour-demo
  description: A tiny sample action/v1 schema used by the tour
actions:
  - id: create-workspace
    type: fs.directory
    action: ensure
    resource: /tmp/dotlib-tour-workspace
    on_error: fail
  - id: write-marker
    type: fs.file
    action: write
    resource: /tmp/dotlib-tour-workspace/marker.txt
    depends_on:
      - create-workspace
    on_error: warn
YAML

    cat > "$bad_schema" <<'YAML'
schema: action/v1
actions:
  - id: BadID With Spaces
    type: not-a-valid-type-format
    action: ensure
    resource: /tmp/whatever
    on_error: explode
YAML

    ui-info "validating a well-formed action/v1 schema..."
    if schema-validate "$good_schema"; then
        ui-success "schema is valid"
    fi

    echo ""
    ui-info "validating a deliberately broken schema..."
    schema-validate "$bad_schema" && ui-error "expected this to fail" \
        || ui-warning "invalid, as expected (errors above are schema-validate's real output)"

    echo ""
    ui-info "loading the valid schema and querying it..."
    schema-load "$good_schema" >/dev/null

    ui-list \
        "version: $(schema-get-version)" \
        "name: $(schema-get-metadata name)" \
        "actions: $(schema-get-action-count) ($(schema-list-action-ids | tr '\n' ' '))"

    echo ""
    schema-stats

    schema-clear
    rm -f "$good_schema" "$bad_schema"
}

tour-notify() {
    ui-header "_notify — desktop notifications"

    if notify-is-available; then
        notify-info "dotlib tour" "This notification was sent by _notify" >/dev/null
        ui-success "sent a live desktop notification"
    else
        ui-warning "no notification backend found (notify-send/gdbus) - skipping"
    fi
}

tour-framework() {
    ui-header "_dispatcher — framework built-ins, live against 'tour' itself"

    ui-subheader "tour commands"
    tour commands

    ui-subheader "tour help (first 8 lines)"
    tour help | head -8

    ui-subheader "tour completion zsh (first 5 lines)"
    tour completion zsh | head -5

    ui-subheader "tour --dry-run ui"
    tour --dry-run ui
}

tour-run() {
    local fast=false
    [[ "$1" == "--fast" ]] && fast=true

    local -a sections=(intro ui format string validate events async rules crypto schema notify framework)
    local section

    for section in "${sections[@]}"; do
        "tour-${section}"
        $fast || sleep 0.6
    done

    echo ""
    ui-banner "TOUR COMPLETE"

    if notify-is-available; then
        notify-success "dotlib tour" "Walked through ${#sections[@]} sections without errors" >/dev/null
    fi
}

# ------------------------------
# Self-test (using _test itself)
# ------------------------------

_tour-selftest-cases() {
    test-it "intro section runs"    _tour-selftest-intro
    test-it "ui section runs"       _tour-selftest-ui
    test-it "format section runs"   _tour-selftest-format
    test-it "string section runs"   _tour-selftest-string
    test-it "validate section runs" _tour-selftest-validate
    test-it "events section runs"   _tour-selftest-events
    test-it "async section runs"    _tour-selftest-async
    test-it "rules section runs"    _tour-selftest-rules
    test-it "crypto section runs"   _tour-selftest-crypto
    test-it "schema section runs"   _tour-selftest-schema
}

_tour-selftest-intro()    { test-assert-exit-code 0 _tour-quiet tour-intro; }
_tour-selftest-ui()       { test-assert-exit-code 0 _tour-quiet tour-ui; }
_tour-selftest-format()   { test-assert-exit-code 0 _tour-quiet tour-format; }
_tour-selftest-string()   { test-assert-exit-code 0 _tour-quiet tour-string; }
_tour-selftest-validate() { test-assert-exit-code 0 _tour-quiet tour-validate; }
_tour-selftest-events()   { test-assert-exit-code 0 _tour-quiet tour-events; }
_tour-selftest-async()    { test-assert-exit-code 0 _tour-quiet tour-async; }
_tour-selftest-rules()    { test-assert-exit-code 0 _tour-quiet tour-rules; }
_tour-selftest-crypto()   { test-assert-exit-code 0 _tour-quiet tour-crypto; }
_tour-selftest-schema()   { test-assert-exit-code 0 _tour-quiet tour-schema; }

tour-self-test() {
    test-describe "dotlib tour sections" _tour-selftest-cases
    test-summary
}
