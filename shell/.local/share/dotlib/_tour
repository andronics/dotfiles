#!/usr/bin/env zsh

# _tour - live showcase of dotlib's framework and its never-before-run modules
# Part of the dotfiles library
#
# Usage:
#   source "${DOTLIB}/_tour"
#
# Most of dotlib's modules are written but never exercised by a real
# wrapper (see the dotlib README's "Module status" note). This module
# runs real demos through them -- _ui, _format, _string, _validation,
# _events, _async, _rules,
# _bspwm, _rofi, _network, _patterns, _args, _server,
# _xidlehook, _notify, _test -- using each
# module's actual public functions. Business logic stays in those
# modules; this file only supplies narration, sample data, and
# pacing.
#
# _crypto, _wifi, and _vpn were removed 2026-08-27 (unused outside this
# tour, and _wifi/_crypto carried real security bugs not worth keeping
# around unexercised). _acpi, _docker, and _http were removed the same
# way in a follow-up pass. _template, _schema, _actions, and _plugins
# (a self-contained action/v1 schema -> execution -> plugin-loading
# chain with zero real schemas/handlers/plugins anywhere in the repo)
# were removed together in a third pass - see REVIEW.md for the
# rationale on all three passes.
#
# House rule for every section: never do anything that would surprise
# someone running `tour run` unattended. Concretely:
#   - No interactive prompts (tour-rofi skips rofi-select/-confirm/
#     -input/-menu; try them yourself, see that section's output).
#   - No real network calls beyond one bounded ping + DNS lookup in
#     tour-network (an earlier draft of the now-removed tour-http also
#     opened a real loopback listener, which got killed unpredictably
#     by this sandbox's network policy - avoid that class of thing).
#   - No mutation of live system/daemon state: tour-bspwm, tour-rofi,
#     tour-server, and tour-xidlehook are all read-only against real
#     subsystems (window manager, rofi config, port probes, idle
#     timers) -- every mutating function in those modules (connect,
#     start, kill, forget, prune, trigger, login, ...) is deliberately
#     never called here.
#   - Graceful skip, not failure, when a subsystem isn't present
#     (bspwm/xidlehook check availability first and return 0 with a
#     warning rather than erroring).
#
# Dependencies:
#   Required:
#     - _common, _ui, _format, _string, _validation, _events, _async,
#       _rules, _rofi,
#       _network, _patterns, _args, _server,
#       _xidlehook, _notify, _test
#   Optional:
#     - _log
#     - _bspwm (requires the bspc binary; tour-bspwm degrades
#       gracefully when unavailable, e.g. on servers)

[[ -n "${TOUR_LOADED:-}" ]] && return 0
declare -gr TOUR_LOADED=1

source "${DOTLIB}/_common" || { echo "[ERROR] _tour requires _common" >&2; return 1; }
source "${DOTLIB}/_log"    2>/dev/null || true

source "${DOTLIB}/_ui"         || { echo "[ERROR] _tour requires _ui" >&2; return 1; }
source "${DOTLIB}/_format"     || { echo "[ERROR] _tour requires _format" >&2; return 1; }
source "${DOTLIB}/_string"     || { echo "[ERROR] _tour requires _string" >&2; return 1; }
source "${DOTLIB}/_validation" || { echo "[ERROR] _tour requires _validation" >&2; return 1; }
source "${DOTLIB}/_events"     || { echo "[ERROR] _tour requires _events" >&2; return 1; }
source "${DOTLIB}/_async"      || { echo "[ERROR] _tour requires _async" >&2; return 1; }
source "${DOTLIB}/_rules"      || { echo "[ERROR] _tour requires _rules" >&2; return 1; }
# _bspwm requires the bspc binary and hard-fails to source without it; shell/
# (and this tour) must still work on hosts with no desktop package installed,
# so this stays optional and tour-bspwm checks availability itself.
source "${DOTLIB}/_bspwm" 2>/dev/null || true
source "${DOTLIB}/_rofi"       || { echo "[ERROR] _tour requires _rofi" >&2; return 1; }
source "${DOTLIB}/_network"    || { echo "[ERROR] _tour requires _network" >&2; return 1; }
source "${DOTLIB}/_patterns"   || { echo "[ERROR] _tour requires _patterns" >&2; return 1; }
source "${DOTLIB}/_args"       || { echo "[ERROR] _tour requires _args" >&2; return 1; }
source "${DOTLIB}/_server"     || { echo "[ERROR] _tour requires _server" >&2; return 1; }
source "${DOTLIB}/_xidlehook"  || { echo "[ERROR] _tour requires _xidlehook" >&2; return 1; }
source "${DOTLIB}/_notify"     || { echo "[ERROR] _tour requires _notify" >&2; return 1; }
source "${DOTLIB}/_test"       || { echo "[ERROR] _tour requires _test" >&2; return 1; }

typeset -gA _TOUR_DESCRIPTIONS=(
    [intro]="Show the opening banner"
    [ui]="Tour _ui: colored output, tables, progress, spinner"
    [format]="Tour _format: alignment, wrapping, lists, boxes"
    [string]="Tour _string: case conversion and predicates"
    [validate]="Tour _validation: type checks against sample data"
    [events]="Tour _events: pub/sub handler registration and emission"
    [async]="Tour _async: parallel execution and retry-until-success"
    [rules]="Tour _rules: condition/action rule evaluation"
    [bspwm]="Tour _bspwm: live window manager introspection (read-only, skips if unavailable)"
    [rofi]="Tour _rofi: config, theme discovery, and formatting (no menus popped)"
    [network]="Tour _network: connectivity, interfaces, and routing"
    [patterns]="Tour _patterns: glob matching and bulk operations"
    [args]="Tour _args: declarative CLI arg parsing"
    [server]="Tour _server: port/type checks and status queries (never starts a server)"
    [xidlehook]="Tour _xidlehook: idle-timer status (read-only, skips if unavailable)"
    [notify]="Tour _notify: a real desktop notification"
    [framework]="Tour _dispatcher's own help/commands/completion/dry-run"
    [run]="Run the full tour end to end (--fast skips pacing)"
)

# ------------------------------
# Private helpers
# ------------------------------

# Fixed path so async-retry's subshelled attempts can share a counter
# (a shell variable wouldn't survive the command-substitution subshell).
declare -g _TOUR_FLAKY_COUNTER="${TMPDIR:-/tmp}/dotlib-tour-flaky-$$"

_tour-flaky() {
    local n=0
    [[ -f "$_TOUR_FLAKY_COUNTER" ]] && n=$(<"$_TOUR_FLAKY_COUNTER")
    n=$((n + 1))
    echo "$n" > "$_TOUR_FLAKY_COUNTER"
    [[ $n -ge 2 ]]
}

_tour-on-greet() {
    ui-info "handler fired: $*"
}

_tour-quiet() {
    "$@" >/dev/null 2>&1
}

# ------------------------------
# Sections
# ------------------------------

tour-intro() {
    ui-banner "DOTLIB TOUR"
    ui-color cyan "A live walkthrough of dotlib's framework and its never-before-run modules."
}

tour-ui() {
    ui-header "_ui — terminal UI kit"

    ui-success "This is what a successful operation looks like"
    ui-warning "This is a warning"
    ui-error   "This is an error (goes to stderr)"
    ui-info    "This is informational"

    echo ""
    ui-table-header "MODULE" "STATUS" "SIZE" "CLAIMED"
    ui-table-separator 80
    ui-table-row "_ui" "demoed" "~18K" "no"
    ui-table-row "_async" "demoed" "~40K" "no"
    ui-table-row "_bluetooth" "in use" "~51K" "yes"

    echo ""
    ui-list "Colored output" "Tables" "Progress bars" "Spinners"

    echo ""
    local total=20 i
    for ((i = 0; i <= total; i++)); do
        ui-progress "$i" "$total"
        sleep 0.03
    done
    ui-progress-complete

    ( sleep 1 ) &
    ui-spinner "$!" "Simulating background work"
}

tour-format() {
    ui-header "_format — text styling"

    format-titlecase "the quick brown fox jumps over the lazy dog"
    echo ""
    format-align-center "centered" 40
    echo ""
    format-wrap "dotlib is a personal zsh helper library with dispatcher-routed wrapper scripts and business logic pushed into sourced modules" 50
    echo ""
    format-list-bullet "Alignment" "Wrapping" "Lists" "Boxes"
    echo ""
    echo "1234567 formatted: $(format-number 1234567)"
    echo ""
    format-box "dotlib" "52 modules" "11 claimed before this tour" "10 more demoed here"
}

tour-string() {
    ui-header "_string — case conversion & predicates"

    local sample="Hello Dotlib World"
    printf "%-20s %s\n" "camelCase"       "$(string-camelcase "$sample")"
    printf "%-20s %s\n" "PascalCase"      "$(string-pascalcase "$sample")"
    printf "%-20s %s\n" "snake_case"      "$(string-snakecase "$sample")"
    printf "%-20s %s\n" "kebab-case"      "$(string-kebabcase "$sample")"
    printf "%-20s %s\n" "SCREAMING_SNAKE" "$(string-screamingsnakecase "$sample")"

    echo ""
    string-is-numeric "42"  && ui-success "'42' is numeric"  || ui-error "'42' is numeric"
    string-is-numeric "abc" && ui-success "'abc' is numeric" || ui-error "'abc' is not numeric"
    echo ""
    string-pad-center "dotlib" 20 "*"
    echo ""
}

tour-validate() {
    ui-header "_validation — type checks against sample data"

    local uuid="4f8e1b2a-6c3d-4a9e-8f7b-2d5e9c1a3b6f"
    local -a checks=(
        "validate-type-email|user@example.com|valid email"
        "validate-type-email|not-an-email|invalid email"
        "validate-type-ip|192.168.1.1|valid IPv4"
        "validate-type-ip|999.1.1.1|invalid IPv4 (octet out of range)"
        "validate-type-uuid|${uuid}|freshly generated UUID"
        "validate-type-port|8080|valid port"
        "validate-type-port|99999|invalid port (out of range)"
    )

    local check fn rest value label
    for check in "${checks[@]}"; do
        fn="${check%%|*}"
        rest="${check#*|}"
        value="${rest%%|*}"
        label="${rest#*|}"

        if "$fn" "$value" 2>/dev/null; then
            ui-success "$label: '$value'"
        else
            ui-error "$label: '$value'"
        fi
    done
}

tour-events() {
    ui-header "_events — pub/sub bus"

    events-init
    events-on "tour.greet" _tour-on-greet >/dev/null
    events-emit "tour.greet" "hello from the tour"

    echo ""
    ui-info "recent event history:"
    events-history --limit 3
}

tour-async() {
    ui-header "_async — parallel execution & retry"

    ui-info "running 3 tasks in parallel..."
    async-parallel \
        "echo 'task A done'; sleep 0.3" \
        "echo 'task B done'; sleep 0.5" \
        "echo 'task C done'; sleep 0.2"

    echo ""
    ui-info "retrying a flaky task until it succeeds..."
    rm -f "$_TOUR_FLAKY_COUNTER"
    if async-retry --times 3 --interval 1 _tour-flaky; then
        ui-success "flaky task succeeded (took $(<"$_TOUR_FLAKY_COUNTER") attempt(s))"
    else
        ui-error "flaky task never succeeded"
    fi
    rm -f "$_TOUR_FLAKY_COUNTER"
}

tour-rules() {
    ui-header "_rules — condition/action engine"

    rules-define "zsh-available" rules-cond-command-exists rules-action-echo 10 "zsh is installed"
    rules-define "business-hours" rules-cond-time-between rules-action-echo 20 "current hour is 9-17"

    echo ""
    if rules-eval "zsh-available" "zsh"; then
        ui-success "rule 'zsh-available' matched and ran"
    else
        ui-warning "rule 'zsh-available' did not match"
    fi

    if rules-eval "business-hours" 9 17; then
        ui-success "rule 'business-hours' matched and ran"
    else
        ui-warning "rule 'business-hours' did not match (outside 09:00-17:00)"
    fi
}

tour-bspwm() {
    ui-header "_bspwm — live window manager introspection (read-only)"

    if ! typeset -f bspwm-is-running >/dev/null 2>&1 || ! bspwm-is-running; then
        ui-warning "bspwm not available on this host - skipping (this section only queries, never mutates)"
        return 0
    fi

    ui-list \
        "bspwm version: $(bspwm-version)" \
        "monitors: $(bspwm-monitor-list | tr '\n' ' ')" \
        "focused monitor: $(bspwm-monitor-focused)" \
        "desktops: $(bspwm-desktop-list | tr '\n' ' ')" \
        "focused desktop: $(bspwm-desktop-focused)"

    echo ""
    ui-info "focused window (bspwm-node-focused + bspwm-node-info)..."
    local node_id
    node_id="$(bspwm-node-focused)"
    if [[ -n "$node_id" ]]; then
        local info
        info="$(bspwm-node-info "$node_id")"
        ui-list \
            "id: $node_id" \
            "$(echo "$info" | /usr/bin/jq -r '"\(.rectangle.width)x\(.rectangle.height) at (\(.rectangle.x),\(.rectangle.y))"')" \
            "$(echo "$info" | /usr/bin/jq -r '"vacant: \(.vacant), sticky: \(.sticky), locked: \(.locked)"')"
    else
        ui-warning "no focused window"
    fi

    echo ""
    ui-info "window rules (bspwm-rule-list)..."
    local -a rules
    rules=("${(@f)$(bspwm-rule-list)}")
    if [[ -n "${rules[1]}" ]]; then
        ui-list "${rules[@]}"
    else
        ui-info "(none configured)"
    fi

    echo ""
    bspwm-info
}

tour-rofi() {
    ui-header "_rofi — config, theme discovery & formatting"

    if ! rofi-check; then
        ui-warning "rofi not available on this host - skipping"
        return 0
    fi

    ui-info "configuring rofi for this demo (theme/prompt/format setters)..."
    rofi-set-theme "Arc-Dark"
    rofi-set-prompt "tour"
    rofi-set-lines 8
    rofi-get-config

    echo ""
    ui-info "discovering installed themes (rofi-list-themes)..."
    local -a themes
    themes=("${(@f)$(rofi-list-themes)}")
    ui-list "${themes[1]}" "${themes[2]}" "${themes[3]}" "... (${#themes[@]} total)"

    echo ""
    ui-info "available modi (rofi-list-modi, parsed from rofi -help)..."
    local -a modi
    modi=("${(@f)$(rofi-list-modi)}")
    ui-list "${modi[@]}"

    echo ""
    ui-info "formatting helpers (pure string builders, no rofi invocation)..."
    ui-list \
        "$(rofi-format-icon "🚀" "Launch")" \
        "$(rofi-format-markup "warning text" "#f38ba8" "bold")" \
        "$(rofi-separator "─" 30)"

    echo ""
    ui-info "note: rofi-select/-confirm/-input/-menu/... exist and pop real"
    ui-info "menus, but this tour never calls them - they'd block waiting"
    ui-info "for you to click something, which would hang 'tour run'."
    ui-info "try one yourself: rofi-select 'pick one' <<< \$'a\\\\nb\\\\nc'"
}

tour-network() {
    ui-header "_network — connectivity, interfaces & routing"

    ui-info "checking dependencies (network-check-dependencies)..."
    if network-check-dependencies; then
        ui-success "ping + ip/ifconfig available"
    else
        ui-error "missing required network tools"
    fi

    echo ""
    ui-info "connectivity check (network-is-online: 1 ping, 2s timeout)..."
    local online=false
    if network-is-online; then
        online=true
        ui-success "online"
    else
        ui-warning "offline (or ICMP blocked)"
    fi

    echo ""
    ui-info "local routing..."
    ui-list \
        "local IP: $(network-get-local-ip)" \
        "gateway: $(network-get-gateway)"

    echo ""
    ui-info "interfaces (network-list-interfaces + per-interface status/mac)..."
    local -a ifaces
    ifaces=("${(@f)$(network-list-interfaces)}")
    ui-table-header "INTERFACE" "STATUS" "MAC" ""
    ui-table-separator 70
    local iface shown=0
    for iface in "${ifaces[@]}"; do
        (( shown >= 5 )) && break
        printf "%-25s %-20s %s\n" "$iface" "$(network-get-interface-status "$iface" 2>/dev/null)" "$(network-get-interface-mac "$iface" 2>/dev/null)"
        ((shown++)) || true
    done
    (( ${#ifaces[@]} > 5 )) && ui-info "... and $(( ${#ifaces[@]} - 5 )) more (this host runs a lot of docker veth/bridge interfaces)"

    echo ""
    if $online; then
        ui-info "DNS resolution (network-resolve-host, only attempted since we're online)..."
        ui-list "example.com -> $(network-resolve-host example.com 2>/dev/null || echo 'unresolved')"
    else
        ui-info "skipping DNS resolution demo (offline)"
    fi
}

tour-patterns() {
    ui-header "_patterns — glob matching & bulk operations"

    local -a items=(audio-play audio-pause audio-stop video-play video-pause bluetooth-connect network-status)
    ui-info "sample items: ${items[*]}"

    echo ""
    ui-info "patterns-match 'audio-*'..."
    ui-success "$(patterns-match "audio-*" "${items[@]}")"

    echo ""
    ui-info "patterns-info for '*-play'..."
    patterns-info "*-play" "${items[@]}"

    echo ""
    ui-info "pattern type detection (patterns-get-type)..."
    local p
    for p in "*" "a,b,c" "config.json" "audio-*"; do
        printf "  %-15s -> %s\n" "$p" "$(patterns-get-type "$p")"
    done

    echo ""
    ui-info "patterns-filter (inverse match) 'audio-*,video-*'..."
    ui-success "$(patterns-filter "audio-*,video-*" "${items[@]}")"

    echo ""
    ui-info "patterns-validate..."
    if patterns-validate "audio-*" >/dev/null 2>&1; then
        ui-success "'audio-*' is a valid pattern"
    fi
    if patterns-validate 'bad$(cmd)' >/dev/null 2>&1; then
        ui-error "'bad\$(cmd)' should have been rejected"
    else
        ui-warning "'bad\$(cmd)' rejected (disallowed characters)"
    fi

    echo ""
    ui-info "bulk operation (patterns-foreach 'audio-*' -- echo)..."
    patterns-foreach "audio-*" "${items[@]}" -- echo "matched:"
}

tour-args() {
    ui-header "_args — declarative CLI argument parsing"

    args-clear
    args-set-program-name "backup"
    args-set-description "A demo CLI defined and parsed by _args"
    args-define-flag "verbose" "v" "Enable verbose output"
    args-define-option "output" "o" "string" "Output directory" "/tmp/backup"
    args-define-required "source" "s" "path" "Source directory to back up"
    args-define-positional "extra" "Extra freeform args" false

    ui-info "parsing: --verbose --source /home/user --output /mnt/backups extra1 extra2"
    args-parse --verbose --source /home/user --output /mnt/backups extra1 extra2

    echo ""
    ui-list \
        "verbose: $(args-is-set verbose && echo true || echo false)" \
        "source:  $(args-get source)" \
        "output:  $(args-get output)" \
        "extra:   $(args-get-all-positional)"

    echo ""
    ui-info "args-show-help (auto-generated from the definitions above)..."
    args-show-help

    echo ""
    args-stats

    args-clear
}

tour-server() {
    ui-header "_server — port/type checks & status (never starts a server)"

    ui-info "this section only probes and queries -- server-start would"
    ui-info "spawn a real listening process, which is exactly the kind"
    ui-info "of thing this tour avoids."

    echo ""
    ui-info "which server backends are installed (server-check-type)..."
    local -a backends=(python php node)
    local b
    for b in "${backends[@]}"; do
        if server-check-type "$b" 2>/dev/null; then
            ui-success "$b: available"
        else
            ui-warning "$b: not available"
        fi
    done

    echo ""
    ui-info "server-find-available-port (probes with nc -z, never binds)..."
    ui-list "first free port from 30000: $(server-find-available-port 30000)"

    echo ""
    ui-info "server-list / server-info (no servers running, none started)..."
    server-info
}

tour-xidlehook() {
    ui-header "_xidlehook — idle-timer status (read-only)"

    if ! xidlehook-check 2>/dev/null; then
        ui-warning "xidlehook not available on this host - skipping"
        return 0
    fi

    ui-info "current idle time (xidlehook-get-idle-time)..."
    ui-list "idle for: $(xidlehook-get-idle-time)s"

    echo ""
    xidlehook-status
}

tour-notify() {
    ui-header "_notify — desktop notifications"

    if notify-is-available; then
        notify-info "dotlib tour" "This notification was sent by _notify" >/dev/null
        ui-success "sent a live desktop notification"
    else
        ui-warning "no notification backend found (notify-send/gdbus) - skipping"
    fi
}

tour-framework() {
    ui-header "_dispatcher — framework built-ins, live against 'tour' itself"

    ui-subheader "tour commands"
    tour commands

    ui-subheader "tour help (first 8 lines)"
    tour help | head -8

    ui-subheader "tour completion zsh (first 5 lines)"
    tour completion zsh | head -5

    ui-subheader "tour --dry-run ui"
    tour --dry-run ui
}

tour-run() {
    local fast=false
    [[ "$1" == "--fast" ]] && fast=true

    local -a sections=(intro ui format string validate events async rules bspwm rofi network patterns args server xidlehook notify framework)
    local section

    for section in "${sections[@]}"; do
        "tour-${section}"
        $fast || sleep 0.6
    done

    echo ""
    ui-banner "TOUR COMPLETE"

    if notify-is-available; then
        notify-success "dotlib tour" "Walked through ${#sections[@]} sections without errors" >/dev/null
    fi
}

# ------------------------------
# Self-test (using _test itself)
# ------------------------------

_tour-selftest-cases() {
    test-it "intro section runs"    _tour-selftest-intro
    test-it "ui section runs"       _tour-selftest-ui
    test-it "format section runs"   _tour-selftest-format
    test-it "string section runs"   _tour-selftest-string
    test-it "validate section runs" _tour-selftest-validate
    test-it "events section runs"   _tour-selftest-events
    test-it "async section runs"    _tour-selftest-async
    test-it "rules section runs"    _tour-selftest-rules
    test-it "bspwm section runs"    _tour-selftest-bspwm
    test-it "rofi section runs"     _tour-selftest-rofi
    test-it "network section runs"  _tour-selftest-network
    test-it "patterns section runs" _tour-selftest-patterns
    test-it "args section runs"     _tour-selftest-args
    test-it "server section runs"   _tour-selftest-server
    test-it "xidlehook section runs" _tour-selftest-xidlehook
}

_tour-selftest-intro()    { test-assert-exit-code 0 _tour-quiet tour-intro; }
_tour-selftest-ui()       { test-assert-exit-code 0 _tour-quiet tour-ui; }
_tour-selftest-format()   { test-assert-exit-code 0 _tour-quiet tour-format; }
_tour-selftest-string()   { test-assert-exit-code 0 _tour-quiet tour-string; }
_tour-selftest-validate() { test-assert-exit-code 0 _tour-quiet tour-validate; }
_tour-selftest-events()   { test-assert-exit-code 0 _tour-quiet tour-events; }
_tour-selftest-async()    { test-assert-exit-code 0 _tour-quiet tour-async; }
_tour-selftest-rules()    { test-assert-exit-code 0 _tour-quiet tour-rules; }
_tour-selftest-bspwm()    { test-assert-exit-code 0 _tour-quiet tour-bspwm; }
_tour-selftest-rofi()     { test-assert-exit-code 0 _tour-quiet tour-rofi; }
_tour-selftest-network()  { test-assert-exit-code 0 _tour-quiet tour-network; }
_tour-selftest-patterns() { test-assert-exit-code 0 _tour-quiet tour-patterns; }
_tour-selftest-args()     { test-assert-exit-code 0 _tour-quiet tour-args; }
_tour-selftest-server()   { test-assert-exit-code 0 _tour-quiet tour-server; }
_tour-selftest-xidlehook() { test-assert-exit-code 0 _tour-quiet tour-xidlehook; }

tour-self-test() {
    test-describe "dotlib tour sections" _tour-selftest-cases
    test-summary
}
