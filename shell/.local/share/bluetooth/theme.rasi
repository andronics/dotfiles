/**
 * Bluetooth Rofi Theme
 *
 * Device menus from _bluetooth_ui: the shared rofi base (palette, font,
 * elements) in a compact centred window.
 */

/*
 * Absolute, not relative: this file is in the shell package and the base in
 * desktop, so only the stowed paths line up. Rofi menus need desktop anyway.
 */
@import "~/.config/rofi/base.rasi"

window {
    location:            center;
    anchor:              center;
    width:               500px;
}

listview {
    lines:               6;
}
