
[Unit]
Description=remote mount (%i)
Wants=default.target
After=default.target
Wants=network-online.target
After=network-online.target

[Service]
# rclone signals READY once the FUSE mount is live, so "started" means
# mounted - which is what remote-sync@'s Requisite=/After= and the warm-up
# below rely on. NotifyAccess=all: rclone is a child of the remote wrapper.
Type=notify
NotifyAccess=all
Environment=PATH="%h/.local/bin:%h/.local/bin/lib:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment=XDG_CACHE_HOME="%h/.cache"
Environment=XDG_CONFIG_HOME="%h/.config"
Environment=XDG_DATA_HOME="%h/.local/share"
Environment=XDG_RUNTIME_DIR="/run/user/%U"

# Validation before mount
ExecStartPre=%h/.local/bin/remote verify "%i"

# Mount the unit
ExecStart=%h/.local/bin/remote mount "%i"

# Preload the dir cache (non-fatal: the mount is usable without it)
ExecStartPost=-%h/.local/bin/remote warm "%i"

# Unmount the unit
ExecStop=%h/.local/bin/remote unmount "%i"

# Cleanup after unmount
ExecStopPost=/bin/sh -c 'rm -rf "${XDG_RUNTIME_DIR}/remote/%i"'

Restart=on-failure
RestartSec=5
CacheDirectory=%p
CacheDirectoryMode=0755
ConfigurationDirectory=%p
ConfigurationDirectoryMode=0755
LogsDirectory=%p
LogsDirectoryMode=0755
StateDirectory=%p
StateDirectoryMode=0755

[Install]
WantedBy=default.target