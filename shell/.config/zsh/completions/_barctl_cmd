#compdef barctl

# Generated by `barctl completion zsh` (dotlib _dispatcher). Don't edit by hand.

_barctl_cmd() {
    local -a commands
    commands=(
        'poke:Ask polybar to redraw <module> (polybar-msg action #<module>.hook.0)'
        'render:Print <module>'\''s current text, coloured from the theme'\''s roles by its tier (the module'\''s hook-0)'
        'run:The controller: follow every source (volume through pactl subscribe, players through playerctl --follow) and poke a module only when its text changes; one at a time, normally run by barctl.service'
        'status:Say whether the controller is running, and each module'\''s tier and text'
        'help:Show help, or a command'\''s help'
        'version:Show version'
        'commands:List commands with descriptions'
        'completion:Print a bash or zsh completion script'
    )

    _arguments -C \
        '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
        '(-q --quiet)'{-q,--quiet}'[Disable verbose output]' \
        '--debug[Enable debug output]' \
        '--dry-run[Show what would be done]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '--version[Show version]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe 'barctl command' commands
            ;;
        args)
            case $words[1] in
                help) (( CURRENT == 2 )) && _describe 'barctl command' commands ;;
                completion) (( CURRENT == 2 )) && compadd bash zsh ;;
            esac
            ;;
    esac
}

_barctl_cmd "$@"
