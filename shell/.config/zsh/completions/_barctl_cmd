#compdef barctl

# Completion for `barctl` (andronics/desktop-tools): the Polybar controller (dotfiles record 0003).
#
# Generated by scripts/gen-completions.py from the Typer app: don't edit it.
# Change the app and run `uv run scripts/gen-completions.py`; an installed desktop-tools
# writes the same file with `desktop-tools completions zsh --out <dir>`. Named
# _barctl_cmd, after the dotfiles' completions (see _coord_cmd).
#
# Live values come from the tool at TAB time (TOOL_STATS=skip: no run record), cached
# for the shell's life; nothing is offered, quietly, when it is missing or fails.

_barctl_cmd_modules() {
    local -a expl
    if (( ! ${#_barctl_cmd_cache_modules} )); then
        (( ${+commands[barctl]} )) || return 1
        typeset -ga _barctl_cmd_cache_modules
        _barctl_cmd_cache_modules=(${(f)"$(TOOL_STATS=skip barctl list 2>/dev/null </dev/null)"})
        (( ${#_barctl_cmd_cache_modules} )) || return 1
    fi
    _wanted modules expl module compadd "$@" -a _barctl_cmd_cache_modules
}

_barctl_cmd() {
    local curcontext=$curcontext state state_descr line
    typeset -A opt_args
    local -a commands
    commands=(
        'alert:Blink a module, or one segment, for a while'
        'click:Run what a click on a module does'
        'disable:Blank a module and stop its source'
        'doctor:Check everything barctl needs, each with a fix to try'
        'enable:Show a module again and start its source'
        'hide:Hide the bars (bsp-hide calls it)'
        'list:List every module, one per line, sorted'
        'menu:Open a module'\''s right-click menu'
        'push:Set a module'\''s state'
        'reload:Redraw every module, or one, without restarting polybar'
        'render:Print a module'\''s text for polybar'
        'restart:Restart the bars, or start one when none is running'
        'run:Run the controller (barctl.service runs it)'
        'show:Show one module in detail'
        'status:Show the controller, the bars and every module'
        'theme:Follow a new theme'
        'unhide:Show the bars again (bsp-unhide calls it)'
        'watch:Follow state changes as they happen, until interrupted'
    )

    _arguments -C \
        '(- *)'{-h,--help}'[Show help and exit]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'barctl command' commands
            ;;
        args)
            curcontext=${curcontext%:*:*}:barctl-$words[1]:
            case $words[1] in
                alert)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--for=[How long]:for_: ' \
                        '--segment=[Blink one segment only]:segment: ' \
                        ':module:_barctl_cmd_modules'
                    ;;
                click)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--segment=[The segment clicked]:segment: ' \
                        ':module:_barctl_cmd_modules' \
                        ':button:(left middle right scroll-up scroll-down)'
                    ;;
                disable)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':module:_barctl_cmd_modules'
                    ;;
                doctor)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--json[JSON instead of text]'
                    ;;
                enable)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':module:_barctl_cmd_modules'
                    ;;
                hide)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                list)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--json[JSON instead of text]'
                    ;;
                menu)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':module:_barctl_cmd_modules'
                    ;;
                push)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--tier=[The module'\''s tier]:tier:(unavailable idle active alert)' \
                        '--glyph=[Its icon]:glyph: ' \
                        '--label=[Text beside or instead of the icon]:label: ' \
                        '--count=[A count after the glyph]:count: ' \
                        '--detail=[A longer line for status and show]:detail: ' \
                        '--target=[What a click acts on]:target: ' \
                        '--ttl=[How long the state holds (30s, 5m); then unavailable]:ttl: ' \
                        '--source=[Who is pushing]:source: ' \
                        '--json=[`-`]:from_json: ' \
                        ':module:_barctl_cmd_modules'
                    ;;
                reload)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '::module:_barctl_cmd_modules'
                    ;;
                render)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':module:_barctl_cmd_modules'
                    ;;
                restart)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '::bar: '
                    ;;
                run)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                show)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--json[JSON instead of text]' \
                        ':module:_barctl_cmd_modules'
                    ;;
                status)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--json[JSON instead of text]'
                    ;;
                theme)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                unhide)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                watch)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--json[JSON instead of text]' \
                        '*:module:_barctl_cmd_modules'
                    ;;
            esac
            ;;
    esac
}

_barctl_cmd "$@"
