#compdef barmenu

# Completion for `barmenu` (andronics/desktop-tools): the polybar menu buttons as rofi menus.
#
# Generated by scripts/gen-completions.py from the Typer app: don't edit it.
# Change the app and run `uv run scripts/gen-completions.py`; an installed desktop-tools
# writes the same file with `desktop-tools completions zsh --out <dir>`. Named
# _barmenu_cmd, after the dotfiles' completions (see _coord_cmd).
#
# Live values come from the tool at TAB time (TOOL_STATS=skip: no run record), cached
# for the shell's life; nothing is offered, quietly, when it is missing or fails.

_barmenu_cmd_menus() {
    local -a expl
    if (( ! ${#_barmenu_cmd_cache_menus} )); then
        (( ${+commands[barmenu]} )) || return 1
        typeset -ga _barmenu_cmd_cache_menus
        _barmenu_cmd_cache_menus=(${(f)"$(TOOL_STATS=skip barmenu list 2>/dev/null </dev/null)"})
        (( ${#_barmenu_cmd_cache_menus} )) || return 1
    fi
    _wanted menus expl menu compadd "$@" -a _barmenu_cmd_cache_menus
}

_barmenu_cmd() {
    local curcontext=$curcontext state state_descr line
    typeset -A opt_args
    local -a commands
    commands=(
        'list:Every menu'\''s name, one per line (for completion)'
        'run:Run a command detached from the bar'\''s pipes (setsid, no inherited descriptors)'
    )

    _arguments -C \
        '(- *)'{-h,--help}'[Show help and exit]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'barmenu command' commands
            _barmenu_cmd_menus
            ;;
        args)
            curcontext=${curcontext%:*:*}:barmenu-$words[1]:
            case $words[1] in
                list)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                run)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '*::command:_normal'
                    ;;
            esac
            ;;
    esac
}

_barmenu_cmd "$@"
