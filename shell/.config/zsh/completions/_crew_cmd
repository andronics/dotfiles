#compdef crew

# Completion for `crew` (andronics/desktop-tools): the coordinator switchboard (brain record 0019).
#
# Generated by scripts/gen-completions.py from the Typer app: don't edit it.
# Change the app and run `uv run scripts/gen-completions.py`; an installed desktop-tools
# writes the same file with `desktop-tools completions zsh --out <dir>`. Named
# _crew_cmd, after the dotfiles' completions (see _coord_cmd).
#
# Live values come from the tool at TAB time (TOOL_STATS=skip: no run record), cached
# for the shell's life; nothing is offered, quietly, when it is missing or fails.

_crew_cmd_names() {
    local -a expl
    if (( ! ${#_crew_cmd_cache_names} )); then
        (( ${+commands[crew]} )) || return 1
        typeset -ga _crew_cmd_cache_names
        _crew_cmd_cache_names=(${(f)"$(TOOL_STATS=skip crew names 2>/dev/null </dev/null)"})
        (( ${#_crew_cmd_cache_names} )) || return 1
    fi
    _wanted names expl name compadd "$@" -a _crew_cmd_cache_names
}

_crew_cmd() {
    local curcontext=$curcontext state state_descr line
    typeset -A opt_args
    local -a commands
    commands=(
        'bar:Push the strip (a cell per coordinator) to barctl'\''s `crew` module and print its line'
        'cycle:Show the next or previous running coordinator in menu order, wrapping'
        'guard:Keep the shown coordinator docked (started detached by every show; exits when none is)'
        'hide:Hide the shown coordinator, focused or not, and give its strip back'
        'launch:Start a coordinator through `meta <name> launch`, hidden unless --show'
        'list:List crew'\''s windows and whether each is hidden or visible'
        'menu:Open the full menu, each coordinator then its actions (middle click, super + c)'
        'names:List the coordinators crew knows, in menu order, from the registry'
        'notify:The waiting notification, run detached by `status`; its click shows the coordinator'
        'quick:Open one coordinator'\''s quick menu above the pointer (its glyph'\''s right click)'
        'restart:Restart a coordinator through `meta <name> restart`, shown again if it was shown'
        'show:Show a coordinator docked, never hiding it and never starting it (exit 1 if stopped)'
        'side:Print the dock side, or set it, re-docking a shown coordinator'
        'status:Claude Code hook'
        'stop:Stop a coordinator through `meta <name> stop`, or all of them with --all'
        'stopped:The desktop half of a stop, run by the brain'\''s stop script after it ends a session'
        'toggle:Hide a coordinator if it is shown and focused, else show it docked'
        'width:Print the dock panel'\''s visible width, or set it (640 to 2560), resizing a shown panel'
    )

    _arguments -C \
        '(- *)'{-h,--help}'[Show help and exit]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'crew command' commands
            ;;
        args)
            curcontext=${curcontext%:*:*}:crew-$words[1]:
            case $words[1] in
                bar)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--quiet[Push only; print nothing]'
                    ;;
                cycle)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':direction:(next prev)'
                    ;;
                guard)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                hide)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--toggle[With none shown, show the last one shown (or the first), if running]'
                    ;;
                launch)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--show[Then show it docked (also if it was running)]' \
                        ':name:_crew_cmd_names'
                    ;;
                list)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                menu)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                names)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--keys[Each with its menu key first]'
                    ;;
                notify)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':name:_crew_cmd_names' \
                        '::body: '
                    ;;
                quick)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':name:_crew_cmd_names'
                    ;;
                restart)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':name:_crew_cmd_names'
                    ;;
                show)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        ':name:_crew_cmd_names'
                    ;;
                side)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '::value:(left right)'
                    ;;
                status)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '::event: '
                    ;;
                stop)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--force[End it even if its resume notes are not clean]' \
                        '--all[Every running coordinator but those only Stephen ends]' \
                        '(--yes -y)'{--yes,-y}'[With --all]' \
                        '::name:_crew_cmd_names'
                    ;;
                stopped)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '*:names_:_crew_cmd_names'
                    ;;
                toggle)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '--launch[Start it if it is stopped (the bar glyph'\''s left click)]' \
                        ':name:_crew_cmd_names'
                    ;;
                width)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]' \
                        '::value: ' \
                        '::step: '
                    ;;
            esac
            ;;
    esac
}

_crew_cmd "$@"
