#compdef brain-links

# Generated by `brain-links completion zsh` (dotlib _dispatcher). Don't edit by hand.

_brain-links_cmd() {
    local -a commands
    commands=(
        'sync:Link every brain tool into ~/.local/bin (--dry-run, --verbose)'
        'help:Show help, or a command'\''s help'
        'version:Show version'
        'commands:List commands with descriptions'
        'completion:Print a bash or zsh completion script'
    )

    _arguments -C \
        '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
        '(-q --quiet)'{-q,--quiet}'[Disable verbose output]' \
        '--debug[Enable debug output]' \
        '--dry-run[Show what would be done]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '--version[Show version]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe 'brain-links command' commands
            ;;
        args)
            case $words[1] in
                help) (( CURRENT == 2 )) && _describe 'brain-links command' commands ;;
                completion) (( CURRENT == 2 )) && compadd bash zsh ;;
            esac
            ;;
    esac
}

_brain-links_cmd "$@"
