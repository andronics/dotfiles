#compdef desk

# Generated by `desk completion zsh` (dotlib _dispatcher). Don't edit by hand.

_desk_cmd() {
    local -a commands
    commands=(
        'bar:Print the polybar strip for [monitor] (default $DESK_MONITOR, $HOST_MONITOR, else focused): one fixed-width cell per non-empty desktop showing one app icon, rotating through its distinct apps every 1s (DESK_ROTATE), focused underlined, urgent as a pill, then the focused desktop'\''s mode and a + cell, coloured from the current theme; [key=#rrggbb ...] overrides a colour (key=role): focused=accent, urgent=urgent, ink=on_urgent, mode=fg, dim=dim'
        'new:Create a desktop named the lowest free integer right after the focused one on the focused monitor and focus it; --take moves the focused window there and follows (not a coord panel)'
        'prune:Remove every desktop with no nodes at all (hidden windows count) that isn'\''t its monitor'\''s focused desktop, never desktop '\''0'\'' nor a monitor'\''s last; prints the names removed'
        'watch:Print the strip, then reprint it after each burst of bspc events and on each rotation tick when it changed, pruning first after desktop focus, node removal or node transfer, and repeat it after 10s unprinted (DESK_IDLE); for a polybar custom/script with tail = true, exits when its reader goes away'
        'help:Show help, or a command'\''s help'
        'version:Show version'
        'commands:List commands with descriptions'
        'completion:Print a bash or zsh completion script'
    )

    _arguments -C \
        '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
        '(-q --quiet)'{-q,--quiet}'[Disable verbose output]' \
        '--debug[Enable debug output]' \
        '--dry-run[Show what would be done]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '--version[Show version]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe 'desk command' commands
            ;;
        args)
            case $words[1] in
                help) (( CURRENT == 2 )) && _describe 'desk command' commands ;;
                completion) (( CURRENT == 2 )) && compadd bash zsh ;;
            esac
            ;;
    esac
}

_desk_cmd "$@"
