#compdef screenshot

# Generated by `screenshot completion zsh` (dotlib _dispatcher). Don't edit by hand.

_screenshot_cmd() {
    local -a commands
    commands=(
        'delayed:Wait a delay, then capture a region, a clicked window or the whole desktop'
        'fullscreen:Capture the whole screen immediately'
        'fullscreen_wait:Prompt for a delay, then capture the whole screen'
        'geometry:Capture an explicit WxH+X+Y region'
        'menu:Interactive rofi picker over all capture modes'
        'selection:Drag-select a region and capture it'
        'selection_wait:Prompt for a delay, then drag-select and capture'
        'window:Capture only the active window'
        'help:Show help, or a command'\''s help'
        'version:Show version'
        'commands:List commands with descriptions'
        'completion:Print a bash or zsh completion script'
    )

    _arguments -C \
        '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
        '(-q --quiet)'{-q,--quiet}'[Disable verbose output]' \
        '--debug[Enable debug output]' \
        '--dry-run[Show what would be done]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '--version[Show version]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe 'screenshot command' commands
            ;;
        args)
            case $words[1] in
                help) (( CURRENT == 2 )) && _describe 'screenshot command' commands ;;
                completion) (( CURRENT == 2 )) && compadd bash zsh ;;
            esac
            ;;
    esac
}

_screenshot_cmd "$@"
