#compdef power

# Generated by `power completion zsh` (dotlib _dispatcher). Don't edit by hand.

_power_cmd() {
    local -a commands
    commands=(
        'hibernate:Lock, then hibernate to disk'
        'lock:Lock the screen now (never asks)'
        'logout:Quit bspwm, ending the X session'
        'menu:Pick an action from a row of icons; it then asks like the action itself'
        'reboot:Reboot'
        'shutdown:Power off'
        'suspend:Lock, then suspend to RAM'
        'log-out:alias for logout'
        'poweroff:alias for shutdown'
        'help:Show help, or a command'\''s help'
        'version:Show version'
        'commands:List commands with descriptions'
        'completion:Print a bash or zsh completion script'
    )

    _arguments -C \
        '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
        '(-q --quiet)'{-q,--quiet}'[Disable verbose output]' \
        '--debug[Enable debug output]' \
        '--dry-run[Show what would be done]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '--version[Show version]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe 'power command' commands
            ;;
        args)
            case $words[1] in
                help) (( CURRENT == 2 )) && _describe 'power command' commands ;;
                completion) (( CURRENT == 2 )) && compadd bash zsh ;;
            esac
            ;;
    esac
}

_power_cmd "$@"
