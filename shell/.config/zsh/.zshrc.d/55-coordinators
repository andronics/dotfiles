# Claude Code coordinator launchers, generated from the coordinator registry
# at shell start (the brain's design record 0019 §9 step 3): one function
# <name>-coordinator per coordinator, which runs `meta <name> launch --attach`
# with its arguments. meta starts the coordinator's tmux session from its home
# (refusing if it, or its old name's, is already running) and attaches this
# terminal. Extra arguments go through to meta, e.g.
# `personal-coordinator -- --model opus` for claude. Vault cheatsheet:
# "📇 🤖 Launching a Coordinator".
#
# The names come from the copy of the registry that meta keeps, read as a
# file: no meta, uv or vault-query call on every new shell. Only with no copy
# yet (a new machine) is meta asked once, which also writes the copy. Each
# former name (old_names) is an alias that says "X is now Y" on stderr and
# runs the new one, until its old_names_until date. A new coordinator needs no
# change here: its actor note is enough. A test (tests/coordinator-launchers.zsh)
# fails if a coordinator's name is written in this file outside comments.
#
# The one name written here is the registry's own address, `meta brain
# coordinators` (record 0019 §4), which the test allows.
#
# For tests: COORD_REGISTRY_FILE moves the copy, and COORD_TODAY (YYYY-MM-DD)
# pretends today.

# The copy is one line of JSON: {"source", "generated", "coordinators": [{"name":
# ..., "old_names": [...], "old_names_until": "YYYY-MM-DD", ...}, ...]}, each
# entry starting with its name (vault-query's order). Split at every quote,
# a key is a token followed by its ": " token, and an entry runs from its
# "name" key to the next one; the (i) subscript searches keep it linear (a
# ${x#*pattern} on the file costs ~15 ms). A name is [a-z0-9-] only, so
# nothing else can be defined from it.
_coordinator-registry() {
  emulate -L zsh
  setopt extended_glob
  local file=${COORD_REGISTRY_FILE:-${XDG_CACHE_HOME:-$HOME/.cache}/meta/coordinators.json}
  local json name old until today q='"'
  local -a names olds t
  local -i i n k j
  if [[ ! -r $file ]] && (( ${+commands[meta]} )); then
    names=(${(M)${(f)"$(TOOL_STATS=skip command meta brain coordinators --names 2>/dev/null </dev/null)"}:#[a-z0-9][a-z0-9-]#})
  fi
  [[ -r $file ]] && json=$(<$file)
  if [[ -n $json ]]; then
    names=()
    # Prompt expansion, not strftime: no module to load at every shell start.
    today=${COORD_TODAY:-${(%):-%D{%Y-%m-%d}}}
    t=("${(@ps:$q:)json}")
    for (( i = ${t[(i)name]}; i <= $#t; i = n )); do
      n=${t[(ib:i+1:)name]}
      [[ ${t[i+1]} == :[[:space:]]# ]] || continue
      name=${t[i+2]}
      [[ $name == [a-z0-9][a-z0-9-]# ]] || continue
      names+=($name)
      k=${t[(ib:i:)old_names_until]}
      until=
      (( k < n )) && [[ ${t[k+1]} == :[[:space:]]# ]] && until=${t[k+2]}
      [[ -n $until && $today > $until ]] && continue
      k=${t[(ib:i:)old_names]}
      (( k < n )) || continue
      # After the key: ": [", then name, ", ", name ... up to the token with "]".
      for (( j = k + 1; j < n; j += 2 )); do
        [[ ${t[j]} == *\]* ]] && break
        old=${t[j+1]}
        [[ $old == [a-z0-9][a-z0-9-]# && $old != $name ]] && olds+=("$old $name")
      done
    done
  fi
  reply=($names)
  pairs=($olds)
}

() {
  local name old new pair
  local -a reply pairs   # pairs: "old new", set by _coordinator-registry
  _coordinator-registry
  for name in $reply; do
    functions[$name-coordinator]="meta $name launch --attach \"\$@\""
  done
  for pair in $pairs; do
    new=${pair#* } old=${pair% *}
    (( ${+functions[$old-coordinator]} )) && continue
    functions[$old-coordinator]="print -u2 -- '$old-coordinator is now $new-coordinator'; $new-coordinator \"\$@\""
  done
}
unfunction _coordinator-registry
