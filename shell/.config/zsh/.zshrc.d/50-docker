# docker compose
#
# Stacks live one per directory under $DCKR_DIR, each with its own compose
# file and .env. .zprofile.d/50-docker sets DCKR_DIR, keeping a caller's value,
# else /pool/distributed/iac/workstation/compose. Dot-directories such as
# .extend hold shared fragments, not stacks, and are skipped.

# List the stack names: every non-hidden directory holding a compose file.
_dc_stacks() {
    local d
    local -a f
    for d in "$DCKR_DIR"/*(N/); do
        f=($d/(compose|docker-compose).y(|a)ml(N.))
        (( $#f )) && print -r -- "${d:t}"
    done
}

# Run docker-compose in one stack's directory: _dc_in <stack> <args>...
_dc_in() {
    local dir="$DCKR_DIR/$1"
    [[ -n $1 && -d $dir ]] || {
        echo "${1:-<stack>}: does not exist in $DCKR_DIR" >&2
        return 1
    }
    shift
    ( cd "$dir" && docker-compose --env-file ./.env "$@" )
}

dcd() {
    [[ $1 == (-h|--help) ]] && { echo "Usage: dcd <stack>  (docker-compose down in \$DCKR_DIR/<stack>)"; return 0; }
    _dc_in "$1" down
}

dcda() {
    [[ $1 == (-h|--help) ]] && { echo "Usage: dcda  (dcd every stack in \$DCKR_DIR)"; return 0; }
    [[ -d $DCKR_DIR ]] || { echo "$DCKR_DIR: does not exist" >&2; return 1; }
    local s
    for s in $(_dc_stacks); do
        dcd "$s"
    done
}

dcu() {
    [[ $1 == (-h|--help) ]] && { echo "Usage: dcu <stack>  (docker-compose pull, then up -d, in \$DCKR_DIR/<stack>)"; return 0; }
    _dc_in "$1" pull && _dc_in "$1" up -d
}

dcua() {
    [[ $1 == (-h|--help) ]] && { echo "Usage: dcua  (dcu every stack in \$DCKR_DIR)"; return 0; }
    [[ -d $DCKR_DIR ]] || { echo "$DCKR_DIR: does not exist" >&2; return 1; }
    local s
    for s in $(_dc_stacks); do
        dcu "$s"
    done
}

dcru() {
    [[ $1 == (-h|--help) ]] && { echo "Usage: dcru <stack>  (docker-compose down, pull, then up -d, in \$DCKR_DIR/<stack>)"; return 0; }
    _dc_in "$1" down && _dc_in "$1" pull && _dc_in "$1" up -d
}

dcrua() {
    [[ $1 == (-h|--help) ]] && { echo "Usage: dcrua  (dcru every stack in \$DCKR_DIR)"; return 0; }
    [[ -d $DCKR_DIR ]] || { echo "$DCKR_DIR: does not exist" >&2; return 1; }
    local s
    for s in $(_dc_stacks); do
        dcru "$s"
    done
}

# docker network

# Print the `docker network create` invocation for a subnet, using the last
# IP in the range as the gateway. Was named `dnc` and shadowed by the
# `dnc` alias below — and the original sed/IFS implementation was broken
# under zsh anyway (sed `\{N\}` in the replacement isn't a quantifier;
# `IFS=. read` doesn't split into an array). Rewritten with zsh integer
# bit-ops so it actually works.
docker-network-create-with-gateway() {
    [[ $# -eq 0 ]] && {
        echo "Usage: ${0} <subnet>"
        echo "Example: ${0} 10.0.4.0/24"
        return 1
    }

    [[ ! "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] && {
        echo "Invalid subnet format. Use x.x.x.x/y"
        return 1
    }

    local subnet="$1"
    local network="${subnet%/*}"
    local cidr="${subnet#*/}"
    local host_bits=$(( 32 - cidr ))
    local -a octets=( "${(@s:.:)network}" )
    local ip_int=$(( (octets[1] << 24) | (octets[2] << 16) | (octets[3] << 8) | octets[4] ))
    local last_int=$(( ip_int | ((1 << host_bits) - 1) ))
    local gateway="$(( (last_int >> 24) & 0xff )).$(( (last_int >> 16) & 0xff )).$(( (last_int >> 8) & 0xff )).$(( last_int & 0xff ))"

    echo "docker network create --subnet=${subnet} --gateway=${gateway} backend"
}

