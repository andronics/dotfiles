# docker compose


dcd() {
    dir="$DCKR_DIR/svcs/$1"
    [[ ! -d $dir ]] && {
        echo "$1: does not exist"
    
    } || {
        # ths need to be a loop to do multiple svcs at once
        pushd "$DCKR_DIR/svcs/$1" > /dev/null
        docker-compose --env-file ./.env down
        popd  > /dev/null
    }
}

dcda() {
    dir="$DCKR_DIR/svcs"
    [[ ! -d $dir ]] && {
        echo "$dir: does not exist"
    
    } || {
        for i in $dir/*/; do
            dcd $(basename "$i")
        done
    }
}

dcu() {
    dir="$DCKR_DIR/svcs/$1"
    [[ ! -d $dir ]] && {
        echo "$1: does not exist"
    
    } || {
        pushd "$DCKR_DIR/svcs/$1"  > /dev/null
        docker-compose pull
        docker-compose --env-file ./.env up -d
        popd  > /dev/null
    }
}

dcua() {
    dir="$DCKR_DIR/svcs"
    [[ ! -d $dir ]] && {
        echo "$dir: does not exist"
    
    } || {
        for i in $dir/*/; do
            dcu $(basename "$i")
        done
    }
}

