        done
    }
}

# docker network

# Print the `docker network create` invocation for a subnet, using the last
# IP in the range as the gateway. Was named `dnc` and shadowed by the
# `dnc` alias below — and the original sed/IFS implementation was broken
# under zsh anyway (sed `\{N\}` in the replacement isn't a quantifier;
# `IFS=. read` doesn't split into an array). Rewritten with zsh integer
# bit-ops so it actually works.
docker-network-create-with-gateway() {
    [[ $# -eq 0 ]] && {
        echo "Usage: ${0} <subnet>"
        echo "Example: ${0} 10.0.4.0/24"
        return 1
    }

    [[ ! "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] && {
        echo "Invalid subnet format. Use x.x.x.x/y"
        return 1
    }

    local subnet="$1"
    local network="${subnet%/*}"
    local cidr="${subnet#*/}"
    local host_bits=$(( 32 - cidr ))
    local -a octets=( "${(@s:.:)network}" )
    local ip_int=$(( (octets[1] << 24) | (octets[2] << 16) | (octets[3] << 8) | octets[4] ))
    local last_int=$(( ip_int | ((1 << host_bits) - 1) ))
    local gateway="$(( (last_int >> 24) & 0xff )).$(( (last_int >> 16) & 0xff )).$(( (last_int >> 8) & 0xff )).$(( last_int & 0xff ))"

    echo "docker network create --subnet=${subnet} --gateway=${gateway} backend"
}

