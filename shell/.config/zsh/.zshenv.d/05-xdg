# Default the XDG base directories, but keep a value the caller already set
# (tests and scripts redirect state and cache this way). An empty value counts
# as unset and falls back to the default, as the XDG spec says.
: ${XDG_CONFIG_HOME:=${HOME}/.config}
: ${XDG_CACHE_HOME:=${HOME}/.cache}
: ${XDG_DATA_HOME:=${HOME}/.local/share}
: ${XDG_STATE_HOME:=${HOME}/.local/state}
: ${XDG_RUNTIME_DIR:=/run/user/$(id -u)}
export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_RUNTIME_DIR
