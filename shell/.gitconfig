[user]
	email = andronics@gmail.com
	name = Stephen Cox

[core]
	editor = nano
	hooksPath = ~/.git-hooks

[credential]
	# gh keeps its token in the system keyring; `store` kept one in plaintext
	# in ~/.git-credentials. The empty line clears any helper set earlier.
	helper =
	helper = !gh auth git-credential

[init]
	defaultbranch = main

[pull]
	rebase = true
	
[rebase]
	autoStash = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
