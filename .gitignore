# node
node_modules

# graphify
.graphify
graphify-out

# environs
.env

# logs / traces
*.log
*.traces
desktop/.local/share/icons/hicolor/icon-theme.cache

# credentials and secrets
**/credentials.json
**/tokens.json
**/**/hosts.yml

# git-crypt-encrypted exception: tracked (encrypted at rest), not a plaintext leak
!shell/.config/remote/credentials.json

# allow template files
!**/*.tmpl
!**/*.example
!**/test/config/*.json

# tmux: tpm clones plugins into ~/.config/tmux/plugins/ at runtime;
# tmux.conf bootstraps tpm itself, no need to track plugins.
shell/.config/tmux/plugins/
