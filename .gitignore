# node
node_modules

# graphify
.graphify
graphify-out

# environs
.env

# logs / traces
*.log
*.traces
desktop/.local/share/icons/hicolor/icon-theme.cache

# credentials and secrets
**/credentials.json
**/tokens.json
**/**/hosts.yml

# git-crypt files (patterns in .gitattributes) are tracked encrypted at rest,
# not a plaintext leak: an ignored path meant to be tracked that way gets a
# `!path` exception here. .githooks/pre-commit refuses them unencrypted.

# allow template files
!**/*.tmpl
!**/*.example
!**/test/config/*.json

# tmux: tpm clones plugins into ~/.config/tmux/plugins/ at runtime;
# tmux.conf bootstraps tpm itself, no need to track plugins.
shell/.config/tmux/plugins/
