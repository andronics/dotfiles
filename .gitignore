# node
node_modules

# environs
.env

# logs / traces
*.log
*.traces
themes/.local/share/icons/hicolor/icon-theme.cache

# credentials and secrets
**/credentials.json
**/tokens.json
**/**/hosts.yml
drive/.config/drive/config.json
remote/.config/remote/config.json
pastebin/.config/pastebin/config.json
mambembe/.config/mambembe/tokens.json

# allow template files
!**/*.tmpl
!**/*.example
!**/test/config/*.json

# tmux: tpm clones plugins into ~/.config/tmux/plugins/ at runtime;
# tmux.conf bootstraps tpm itself, no need to track plugins.
shell/.config/tmux/plugins/
