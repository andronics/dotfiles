/**
 * Rofi default theme
 *
 * What plain `rofi` (and anything without -theme) shows: the shared base
 * plus a centred list window. Per-job variants live in themes/.
 */

@import "base.rasi"

window {
    location:            center;
    anchor:              center;
    width:               1000px;
}

/* Named windows used by bsp menus. */
window.window-selector {
    width:               800px;
}

window.desktop-selector {
    width:               600px;
}

window.layout-selector {
    width:               700px;
}

window.feature-toggle {
    width:               500px;
}

window.config-editor {
    width:               700px;
}
