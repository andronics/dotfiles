/**
 * Coordinator menu, first level (crew menu: super + c, the crew strip's
 * middle-click; crew finds this theme by name, CREW_MENU_THEME to change
 * it): the launcher's look, sized for the ten coordinators in a
 * row and Stop all on a second row under them (a coordinator without a home
 * under its new name shows under its former name, or not at all if it has
 * none, and the cells move up). Each cell is pango markup from crew: a large
 * Nerd Font glyph coloured as on the strip, in the bar's colour tiers
 * (dotfiles design record 0001: dim not running, fg_dim idle, accent busy,
 * urgent pill waiting), the name with its filter key underlined, and a faint state. Shown coordinators are marked
 * active: a lavender ring in the selection's shape with a heavier bottom
 * edge, the strip's underline. The second level is themes/prompt.rasi.
 */

@import "launcher.rasi"

/*
 * rofi sizes every cell from an estimate of eh lines of element-text's
 * font, not from the markup it draws, so the launcher's eh of 1 cut the
 * cell after the glyph. Measured with pango at this display's 108 dpi, the
 * three lines need 98px (glyph 55, name 23, state 20) and a 12pt line is
 * 23px, so 5 lines (115px) fits them with room for descenders.
 */
configuration {
    eh:                  5;
}

/*
 * Cells are (width - 64 padding - 108 spacing) / 10 = 175px, the spacing
 * being nine 12px gaps between ten columns, so 1922px is 64 + 108 + 10 x
 * 175 and still fits a 2560px screen. Each cell is 155px inside the
 * element's padding and border: room for "network-tools" (143px at 12pt,
 * measured with pango at 108 dpi) and "waiting · open" (under the 153px
 * "waiting · visible" took, small).
 */
window {
    width:               1922px;
}

entry {
    placeholder:         "Search coordinators";
}

listview {
    columns:             10;
    lines:               2;
}

element {
    children:            [ element-text ];
    padding:             16px 8px 14px 8px;
    border:              2px 2px 4px 2px;
    border-color:        transparent;
}

element-text {
    font:                @font-sm;
    horizontal-align:    0.5;
}

element normal.active,
element alternate.active {
    background-color:    transparent;
    text-color:          @fg-color;
    border-color:        @accent-color;
}

element selected.active {
    background-color:    @accent-color;
    text-color:          @accent-fg-color;
    border-color:        @accent-color;
}
