/**
 * Bar menu: the polybar menu buttons (barmenu, andronics/desktop-tools). Opens just
 * above the bottom bar with its bottom-left corner at the clicked button:
 * barmenu reads the pointer and passes location, x-offset and width with
 * -theme-str. The values here are the fallback (bottom-left corner) and what
 * rofi-preview shows. The bar is 50px high, so a -60px y-offset clears it,
 * as in bar-popup.rasi.
 */

@import "../base.rasi"

window {
    location:            south west;
    anchor:              south west;
    x-offset:            8px;
    y-offset:            -60px;
    /* barmenu's WIDTH (desktop-tools barmenu/menus.py) must match this. */
    width:               360px;
    border:              1px solid;
    border-color:        @border-color;
    border-radius:       @radius-lg;
}

mainbox {
    padding:             8px;
    spacing:             6px;
    children:            [ inputbar, message, listview ];
}

inputbar {
    border:              0px;
    border-radius:       @radius;
    padding:             8px 12px;
}

entry {
    placeholder:         "Filter";
}

message {
    border:              0px;
    border-radius:       @radius;
    padding:             8px 12px;
}

listview {
    lines:               8;
    padding:             0px;
    spacing:             2px;
    scrollbar:           false;
}

/*
 * Rows carry their glyph in the text (pango), so there is no icon column:
 * base.rasi's element-icon would reserve its 1.25em plus padding on every
 * row, even one without an icon.
 */
element {
    padding:             6px 12px;
    children:            [ element-text ];
}

/* base.rasi pads the textbox 4px inside the message; the message has its own. */
textbox {
    padding:             0px;
}
