/**
 * Coordinator picker (coord pick, the coord strip's right-click): the
 * launcher's look, sized for seven cells in one row. Each cell is pango
 * markup from _coord: a large Nerd Font glyph coloured as on the strip (dim
 * not running, peach busy, red pill waiting), the name, and a faint state.
 * Shown coordinators are marked active: a lavender ring in the selection's
 * shape with a heavier bottom edge, the strip's underline.
 */

@import "launcher.rasi"

window {
    width:               1120px;
}

entry {
    placeholder:         "Search coordinators";
}

listview {
    columns:             7;
    lines:               1;
}

element {
    children:            [ element-text ];
    padding:             16px 8px 14px 8px;
    border:              2px 2px 4px 2px;
    border-color:        transparent;
}

element-text {
    font:                "Source Code Pro for Powerline 12";
    horizontal-align:    0.5;
}

element normal.active,
element alternate.active {
    background-color:    transparent;
    text-color:          @fg-color;
    border-color:        @accent-color;
}

element selected.active {
    background-color:    @accent-color;
    text-color:          @accent-fg-color;
    border-color:        @accent-color;
}
