/**
 * Coordinator menu, first level (coord menu: super + c, the coord strip's
 * right-click): the launcher's look, sized for the nine coordinators in a
 * row and Stop all after them (a second row once all nine have homes; until
 * then a coordinator not yet moved shows under its former name, and
 * security, which has none, not at all). Each cell is pango markup from _coord: a large
 * Nerd Font glyph coloured as on the strip (dim not running, peach busy, red
 * pill waiting), the name with its filter key underlined, and a faint state. Shown coordinators are marked
 * active: a lavender ring in the selection's shape with a heavier bottom
 * edge, the strip's underline. The second level is themes/prompt.rasi.
 */

@import "launcher.rasi"

/*
 * rofi sizes every cell from an estimate of eh lines of element-text's
 * font, not from the markup it draws, so the launcher's eh of 1 cut the
 * cell after the glyph. Measured with pango at this display's 108 dpi, the
 * three lines need 98px (glyph 55, name 23, state 20) and a 12pt line is
 * 23px, so 5 lines (115px) fits them with room for descenders.
 */
configuration {
    eh:                  5;
}

/*
 * Cells are (width - 64 padding - 96 spacing) / 9 = 175px, the spacing
 * being eight 12px gaps between nine columns, so 1735px is 64 + 96 + 9 x
 * 175 and still fits a 2560px screen. Each cell is 155px inside the
 * element's padding and border: room for "network-tools" (143px at 12pt,
 * measured with pango at 108 dpi) and "waiting · visible" (153px small).
 */
window {
    width:               1735px;
}

entry {
    placeholder:         "Search coordinators";
}

listview {
    columns:             9;
    lines:               2;
}

element {
    children:            [ element-text ];
    padding:             16px 8px 14px 8px;
    border:              2px 2px 4px 2px;
    border-color:        transparent;
}

element-text {
    font:                @font-sm;
    horizontal-align:    0.5;
}

element normal.active,
element alternate.active {
    background-color:    transparent;
    text-color:          @fg-color;
    border-color:        @accent-color;
}

element selected.active {
    background-color:    @accent-color;
    text-color:          @accent-fg-color;
    border-color:        @accent-color;
}
