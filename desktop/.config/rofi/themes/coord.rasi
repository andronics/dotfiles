/**
 * Coordinator picker (coord pick, the coord strip's right-click): the
 * launcher's look, sized for eight cells in one row. Each cell is pango
 * markup from _coord: a large Nerd Font glyph coloured as on the strip (dim
 * not running, peach busy, red pill waiting), the name, and a faint state.
 * Shown coordinators are marked active: a lavender ring in the selection's
 * shape with a heavier bottom edge, the strip's underline.
 */

@import "launcher.rasi"

/*
 * rofi sizes every cell from an estimate of eh lines of element-text's
 * font, not from the markup it draws, so the launcher's eh of 1 cut the
 * cell after the glyph. Measured with pango at this display's 108 dpi, the
 * three lines need 98px (glyph 55, name 23, state 20) and a 12pt line is
 * 23px, so 5 lines (115px) fits them with room for descenders.
 */
configuration {
    eh:                  5;
}

/*
 * Cells are (width - 64 padding - 84 spacing) / 8 = 175px, the spacing
 * being seven 12px gaps between eight columns, so 1548px is 64 + 84 + 8 x
 * 175 and still fits a 2560px screen. Each cell is 155px inside the
 * element's padding and border: room for "metalayerlab" (132px at 12pt) and
 * "waiting · shown" (135px small).
 */
window {
    width:               1548px;
}

entry {
    placeholder:         "Search coordinators";
}

listview {
    columns:             8;
    lines:               1;
}

element {
    children:            [ element-text ];
    padding:             16px 8px 14px 8px;
    border:              2px 2px 4px 2px;
    border-color:        transparent;
}

element-text {
    font:                @font-sm;
    horizontal-align:    0.5;
}

element normal.active,
element alternate.active {
    background-color:    transparent;
    text-color:          @fg-color;
    border-color:        @accent-color;
}

element selected.active {
    background-color:    @accent-color;
    text-color:          @accent-fg-color;
    border-color:        @accent-color;
}
