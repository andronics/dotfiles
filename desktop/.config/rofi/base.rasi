/**
 * Rofi base theme
 *
 * Palette, aliases, fonts, radii and element styling shared by every rofi
 * menu. Layout lives in what imports this: config.rasi (plain `rofi`) and
 * the per-job variants in themes/.
 *
 * Colours, fonts and radii come from the generated theme (`theme apply`),
 * imported below the static block. Without one, colours.rasi (Catppuccin
 * Mocha) and the literals here are the fallback, and look the same as the
 * default theme.
 */

/* Relative imports resolve against this file's directory. */
@import "colours.rasi"

configuration {
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
}

* {
    /*
     * Semantic aliases over the palette. Kept under these names so any
     * -theme-str override or theme importing this file still resolves them.
     */
    bg-color:            @base;
    bg-alt-color:        @surface0;
    fg-color:            @text;
    fg-alt-color:        @subtext0;
    /* Mocha's dim as the theme resolves it: overlay0 lifted to 3.0 on
       surface0 (dotfiles record 0004). */
    dim-color:           #767b91;

    accent-color:        @lavender;
    accent-fg-color:     @crust;
    urgent-color:        @red;
    urgent-fg-color:     @crust;
    active-color:        @green;
    busy-color:          @peach;

    border-color:        @surface1;
    separator-color:     @surface1;

    /* Same family as Alacritty; Nerd Font glyphs fall back to Symbols Nerd Font Mono. */
    font:                "Source Code Pro for Powerline 14";
    font-bold:           "Source Code Pro for Powerline Bold 14";
    font-sm:             "Source Code Pro for Powerline 12";
    font-lg:             "Source Code Pro for Powerline 16";
    font-xl:             "Source Code Pro for Powerline 22";

    radius:              8px;
    radius-lg:           12px;
    radius-xl:           16px;

    background-color:    transparent;
    text-color:          @fg-color;

    spacing:             8px;
    padding:             12px;
    margin:              0px;
}

/*
 * The generated theme: the same variables, so it must come after the block
 * above to win. `?import` skips a missing file (rofi 2.0), which leaves the
 * static values. rofi expands `~` from $HOME; the path is fixed because rofi
 * can't read an environment variable in an import.
 */
?import "~/.local/state/theme/current/rofi.rasi"

window {
    background-color:    @bg-color;
    border:              2px solid;
    border-color:        @accent-color;
    border-radius:       @radius;
    padding:             0px;
}

mainbox {
    background-color:    @bg-color;
    padding:             0px;
}

inputbar {
    background-color:    @bg-alt-color;
    border:              0px 0px 2px 0px solid;
    border-color:        @separator-color;
    padding:             12px;
    spacing:             8px;
    children:            [ prompt, entry ];
}

prompt {
    text-color:          @accent-color;
    font:                @font-bold;
}

entry {
    text-color:          @fg-color;
    placeholder:         "Type to filter...";
    placeholder-color:   @fg-alt-color;
}

listview {
    padding:             8px;
    spacing:             4px;
    lines:               8;
    columns:             1;
    scrollbar:           true;
    fixed-height:        false;
    dynamic:             true;
}

scrollbar {
    background-color:    @bg-alt-color;
    handle-color:        @accent-color;
    handle-width:        4px;
    border:              0px;
    margin:              0px 0px 0px 4px;
}

element {
    text-color:          @fg-color;
    padding:             8px 12px;
    spacing:             8px;
    border-radius:       @radius;
}

element normal.normal,
element alternate.normal {
    background-color:    transparent;
    text-color:          @fg-color;
}

element normal.urgent {
    background-color:    @urgent-color;
    text-color:          @urgent-fg-color;
}

element normal.active {
    background-color:    @active-color;
    text-color:          @accent-fg-color;
}

element alternate.urgent {
    background-color:    transparent;
    text-color:          @urgent-color;
}

element alternate.active {
    background-color:    transparent;
    text-color:          @active-color;
}

/* The selection is always an accent pill; urgent/active keep their fill and gain an accent ring. */
element selected.normal {
    background-color:    @accent-color;
    text-color:          @accent-fg-color;
}

element selected.urgent {
    background-color:    @urgent-color;
    text-color:          @urgent-fg-color;
    border:              2px solid;
    border-color:        @accent-color;
}

element selected.active {
    background-color:    @active-color;
    text-color:          @accent-fg-color;
    border:              2px solid;
    border-color:        @accent-color;
}

element-text {
    text-color:          inherit;
    vertical-align:      0.5;
}

/* em tracks the font size, so icons scale with it. */
element-icon {
    size:                1.25em;
    padding:             0px 8px 0px 0px;
}

message {
    background-color:    @bg-alt-color;
    border:              2px 0px 0px 0px solid;
    border-color:        @separator-color;
    padding:             12px;
}

textbox {
    text-color:          @fg-color;
    padding:             4px;
}

error-message {
    background-color:    @urgent-color;
    border:              2px solid;
    border-color:        @urgent-color;
    padding:             12px;
}

mode-switcher {
    background-color:    @bg-alt-color;
    border:              2px 0px 0px 0px solid;
    border-color:        @separator-color;
    padding:             8px;
}

button {
    text-color:          @fg-color;
    padding:             8px 16px;
    border-radius:       @radius;
}

button selected {
    background-color:    @accent-color;
    text-color:          @accent-fg-color;
}
