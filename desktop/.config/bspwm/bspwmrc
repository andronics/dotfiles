#!/usr/bin/env zsh

# source "$(which _onexit)"

# ------------------------------

# Desktops

bspc monitor "$(bspc query -M --names | head -1)" -d 0

# Global Settings
bspc config automatic_scheme longest_side
bspc config initial_polarity second_child
bspc config click_to_focus button1
bspc config focus_follows_pointer false
bspc config honor_size_hints true
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true

# External Rules
bspc config external_rules_command "$(which bsp-external-rules)"

# Pointer
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

# Borders, gap and the bar reservation: border colours and width,
# window_gap, bottom_padding and presel_feedback_color come from the theme
# (`theme reload bspwm` re-applies them and re-docks the coordinator panel).
# Without a theme, today's sizes and bspwm's default colours. bottom_padding
# 32 under the 50px bar is deliberate (D15).
if theme ensure >/dev/null 2>&1 && [[ -r ~/.local/state/theme/current/bspwm.sh ]]; then
    source ~/.local/state/theme/current/bspwm.sh
else
    bspc config border_width 1
    bspc config window_gap 5
    bspc config bottom_padding 32
fi

# Desktop Padding
bspc config top_padding 0
bspc config left_padding 0
bspc config right_padding 0

# Rules
bspc rule -r "*:*:*"
bspc rule -a Alacritty border=off

# Coordinator switchboard (crew, from andronics/desktop-tools): born hidden,
# summoned by `crew toggle <name>`, `crew menu` or `crew cycle`, which dock it
# to the left or right edge (`crew side`) and reserve that strip with
# left_padding or right_padding while it is shown, so no geometry here.
bspc rule -a crew state=floating sticky=on hidden=on
# crew's menus show a command's output in a floating terminal of this class.
bspc rule -a crew-view state=floating
# Windows still open from before crew (class coord, as coord made them) keep
# their rule until the coord alias goes on 2026-12-04; then this line goes too.
bspc rule -a coord state=floating sticky=on hidden=on
