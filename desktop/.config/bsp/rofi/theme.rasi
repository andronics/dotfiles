/**
 * BSP Rofi Theme
 *
 * bsp's interactive menus: the shared rofi base (palette, font, elements)
 * in a narrower centred window, plus named windows per menu.
 */

/* ~/.config/bsp/rofi -> ~/.config/rofi, in the repo and once stowed. */
@import "../../rofi/base.rasi"

window {
    location:            center;
    anchor:              center;
    width:               600px;
}

window.window-selector {
    width:               800px;
}

window.desktop-selector {
    width:               600px;
}

window.layout-selector {
    width:               700px;
}

window.feature-toggle {
    width:               500px;
}

window.config-editor {
    width:               700px;
}
