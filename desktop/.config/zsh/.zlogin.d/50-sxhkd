[[ -n "${DISPLAY}" || "${WAYLAND_DISPLAY}" ]] && {

    command -v "sxhkd" >/dev/null 2>&1 || {
        echo "Error: sxhkd is not installed."
        return 1
    }

    # Detached, stdio on /dev/null: sxhkd outlives this login terminal, and a
    # command it runs must never inherit a terminal that has since closed.
    pgrep -x "sxhkd" > /dev/null || sxhkd </dev/null >/dev/null 2>&1 &!
}
