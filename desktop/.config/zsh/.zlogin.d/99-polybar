[[ -n "${DISPLAY}" || "${WAYLAND_DISPLAY}" ]] && {
    (
        # Wait up to 10s for bspwm; bail rather than poll forever.
        _attempts=40
        while (( _attempts-- > 0 )); do
            pgrep -x bspwm >/dev/null && break
            sleep 0.25
        done

        pgrep -x bspwm   >/dev/null || exit 1
        pgrep -x polybar >/dev/null && exit 0

        export HOST_MONITOR="$(bspc query -M --names | head -1)"
        polybar -q -r "${POLYBAR_BAR:-main}" &
    ) &
}
