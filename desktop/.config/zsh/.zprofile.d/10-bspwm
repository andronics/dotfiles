[[ -n "${DISPLAY}" || -n "${WAYLAND_DISPLAY}" ]] && {
    (( $+commands[xdpyinfo] )) && export HOST_RESOLUTION=$(xdpyinfo | awk '/dimensions/ {print $2}')
    (( $+commands[xrandr] )) && export HOST_MONITOR=$(xrandr | awk '/ connected/ {print $1}')
    export WINDOW_GAP="20"
    export WINDOW_PADDING="20"
}
