[bar/base]
enable-ipc = true
fixed-center = true
monitor = ${env:HOST_MONITOR:DP-2}
monitor-exact = true
monitor-fallback = DP-2
monitor-strict = false 
;override-redirect = false
wm-restack = bspwm

background = ${colors.background}
foreground = ${colors.foreground}
border-size = 0

cursor-click = pointer
cursor-scroll = pointer

; font-0 - icons
font-0 = "Symbols Nerd Font Mono:style=2048-em:size=13;2"
; font-1 - spacers
font-1 = "Symbols Nerd Font Mono:style=2048-em:size=50;2"
; font-2 - text
font-2 = "Roboto Mono for Powerline:size=10:weight=medium;2"
font-3 = "Adwaita Mono:size=10:weight=medium;2"

height = 50
width = 5120

line-size = 2
module-margin-left = 0
module-margin-right = 0
offset-x = 0
offset-y = 0
padding-left = 0
padding-right = 0
radius = 0
