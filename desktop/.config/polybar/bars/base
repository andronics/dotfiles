[bar/base]
enable-ipc = true
fixed-center = true
monitor = ${env:HOST_MONITOR:DP-2}
monitor-exact = true
monitor-fallback = DP-2
monitor-strict = false 
;override-redirect = false
wm-restack = bspwm

background = ${colors.bg}
foreground = ${colors.fg}
border-size = 0

cursor-click = pointer
cursor-scroll = pointer

; Fonts and sizes from the generated theme ([theme] in polybar.ini). The
; height is fixed; the text and icons scale with prefs.toml's fonts.scale.
; font-0 - icons
font-0 = ${theme.font-icon}
; font-1 - spacers (powerline corners, sized to the height)
font-1 = ${theme.font-spacer}
; font-2 - text
font-2 = ${theme.font-text}
font-3 = ${theme.font-text-alt}

height = ${theme.height}
width = 5120

line-size = ${theme.line-size}
module-margin-left = 0
module-margin-right = 0
offset-x = 0
offset-y = 0
padding-left = 0
padding-right = 0
radius = 0
