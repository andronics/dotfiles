{{- /*
  Sourced by bspwmrc at start-up and by `theme reload bspwm`, which then
  re-docks a shown coordinator panel (its geometry follows the gap, the
  border and the bottom padding).

  Sizes: window_border (scaled, 1 at 1.25), gap and bar_reserve (unscaled).
  bottom_padding 32 under the 50px bar is deliberate (D15), so it is its own
  metric, not bar_height. A global `bspc config` size resets every node's,
  desktop's or monitor's own value (a border=off rule, a per-desktop gap),
  so a size is only written when it changes.

  Colours: normal = border (unfocused windows), active = dim (focused window
  of an unfocused monitor), focused = the focused role (accent), presel =
  dim (bspwmrc's old palette overlay0).
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $m := $s.metrics -}}
# Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
# change prefs.toml or the scheme and run `theme apply`.
[[ "$(bspc config border_width)" == {{ $m.window_border }} ]] || bspc config border_width {{ $m.window_border }}
[[ "$(bspc config window_gap)" == {{ $m.gap }} ]] || bspc config window_gap {{ $m.gap }}
[[ "$(bspc config bottom_padding)" == {{ $m.bar_reserve }} ]] || bspc config bottom_padding {{ $m.bar_reserve }}
bspc config normal_border_color '{{ $r.border }}'
bspc config active_border_color '{{ $r.dim }}'
bspc config focused_border_color '{{ $r.focused }}'
bspc config presel_feedback_color '{{ $r.dim }}'
