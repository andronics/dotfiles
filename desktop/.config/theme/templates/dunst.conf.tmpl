{{- /*
  Linked as ~/.config/dunst/dunstrc.d/90-theme.conf by `theme ensure` (and
  the dunst reloader), so it overrides dunstrc key by key; dunstrc keeps the
  layout and its own colours as the fallback. `theme reload dunst` runs
  `dunstctl reload`.

  Font: the mono family at fonts.base.notification x scale (10 x 1.25 =
  12.5, D5), Medium as before. Radius: metrics.radius unscaled, as rofi's.
  Frames: low = info, normal = accent, critical = urgent; text is fg on bg
  for every urgency (fg/bg is the guaranteed 7.0 pair). highlight (progress
  bars) is accent; dunst only reads it in the urgency sections.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $radius := math.Round (div (conv.ToFloat64 $s.metrics.radius) (conv.ToFloat64 $s.font.sizes.scale)) -}}
# Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
# change prefs.toml or the scheme and run `theme apply`.

[global]
    font = {{ $s.font.family.mono }} Medium {{ $s.font.sizes.notification }}
    corner_radius = {{ $radius }}
    frame_color = "{{ $r.accent }}"

[urgency_low]
    background = "{{ $r.bg }}"
    foreground = "{{ $r.fg }}"
    highlight = "{{ $r.accent }}"
    frame_color = "{{ $r.info }}"

[urgency_normal]
    background = "{{ $r.bg }}"
    foreground = "{{ $r.fg }}"
    highlight = "{{ $r.accent }}"
    frame_color = "{{ $r.accent }}"

[urgency_critical]
    background = "{{ $r.bg }}"
    foreground = "{{ $r.fg }}"
    highlight = "{{ $r.accent }}"
    frame_color = "{{ $r.urgent }}"
