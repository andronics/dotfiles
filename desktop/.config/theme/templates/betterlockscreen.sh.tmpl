{{- /*
  Sourced, as bash, by the last line of ~/.config/betterlockscreen/
  betterlockscreenrc, so each key here overrides the rc's own value; with no
  theme the rc's values stand. Only what i3lock-color draws at lock time:
  the ring and its inside in each state, the text colours and the font.

  loginbox, loginshadow and solid_color stay with the rc: betterlockscreen
  bakes them into the images it caches at `betterlockscreen -u`, and the
  theme refreshes that cache only when the wallpaper changes (`theme reload
  lockscreen`). Everything here is read at each lock, so a new scheme
  reaches the next lock without a cache refresh.

  Colours are rrggbbaa without the #. The ring is accent, verifying is info,
  wrong is urgent, typing highlights in ok and backspace in urgent, caps
  lock (modif) in warn; insides are bg at 50%, the wrong inside urgent at
  80%. The time, greeter and layout text sit on the rc's dark login box
  (00000066), so they take the lighter of fg and bg: fg in a dark theme, bg
  in a light one. font is the UI family.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $text := $r.fg -}}
{{- if eq $s.mode "light" }}{{ $text = $r.bg }}{{ end -}}
# Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
# change prefs.toml or the scheme and run `theme apply`.
font={{ $s.font.family.ui | strings.ShellQuote }}
ringcolor={{ $r.accent | strings.TrimPrefix "#" }}ff
insidecolor={{ $r.bg | strings.TrimPrefix "#" }}80
ringvercolor={{ $r.info | strings.TrimPrefix "#" }}ff
insidevercolor={{ $r.bg | strings.TrimPrefix "#" }}80
ringwrongcolor={{ $r.urgent | strings.TrimPrefix "#" }}ff
insidewrongcolor={{ $r.urgent | strings.TrimPrefix "#" }}cc
separatorcolor=00000000
keyhlcolor={{ $r.ok | strings.TrimPrefix "#" }}ff
bshlcolor={{ $r.urgent | strings.TrimPrefix "#" }}ff
timecolor={{ $text | strings.TrimPrefix "#" }}ff
greetercolor={{ $text | strings.TrimPrefix "#" }}ff
layoutcolor={{ $text | strings.TrimPrefix "#" }}ff
verifcolor={{ $text | strings.TrimPrefix "#" }}ff
wrongcolor={{ $r.urgent | strings.TrimPrefix "#" }}ff
modifcolor={{ $r.warn | strings.TrimPrefix "#" }}ff
bgcolor={{ $r.bg | strings.TrimPrefix "#" }}ff
