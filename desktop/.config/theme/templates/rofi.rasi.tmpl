{{- /*
  Read by rofi/base.rasi through `?import`, after its static Mocha block, so
  every value here wins and a missing file falls back to colours.rasi.

  Font sizes are whole points: rounding keeps the default (menu 11 x scale
  1.25 = 13.75) on today's 14. sm, lg and xl keep today's rofi ratios to the
  body size (12, 16, 22 against 14) rather than the spec's 1.2 type scale, so
  the variants look the same as before they used variables.

  Radii follow metrics.radius but not fonts.scale: the rest of rofi's
  geometry (padding, spacing, borders) is literal pixels, and a scaled radius
  alone would change the proportions.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $menu := conv.ToFloat64 $s.font.sizes.menu -}}
{{- $family := $s.font.family.mono -}}
{{- $radius := math.Round (div (conv.ToFloat64 $s.metrics.radius) (conv.ToFloat64 $s.font.sizes.scale)) -}}
/* Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
   change prefs.toml or the scheme and run `theme apply`. */

configuration {
    icon-theme:          "{{ $s.icons }}";
}

* {
{{- range $k, $v := $s.palette }}{{ if ne $k "names" }}
    {{ $k }}: {{ $v }};
{{- end }}{{ end }}
{{- if has $s.palette "names" }}{{ range $k, $v := $s.palette.names }}
    {{ $k }}: {{ $v }};
{{- end }}{{ end }}

    /* Roles, prefixed: several role names (border, ...) are rofi properties. */
{{- range $k, $v := $r }}
    role-{{ $k | strings.ReplaceAll "_" "-" }}: {{ $v }};
{{- end }}

    bg-color:            {{ $r.bg }};
    bg-alt-color:        {{ $r.bg_alt }};
    fg-color:            {{ $r.fg }};
    /* The placeholder sits on bg_alt: fg_dim, which the resolver keeps at
       4.5 there, in every scheme (record 0004). */
    fg-alt-color:        {{ $r.fg_dim }};
    dim-color:           {{ $r.dim }};

    accent-color:        {{ $r.accent }};
    accent-fg-color:     {{ $r.on_accent }};
    urgent-color:        {{ $r.urgent }};
    urgent-fg-color:     {{ $r.on_urgent }};
    active-color:        {{ $r.ok }};
    busy-color:          {{ $r.busy }};

    /* base03, a step past the border role: what the static Mocha base used (surface1). */
    border-color:        {{ $s.palette.base03 }};
    separator-color:     {{ $s.palette.base03 }};

    font:                "{{ $family }} {{ math.Round $menu }}";
    font-bold:           "{{ $family }} Bold {{ math.Round $menu }}";
    font-sm:             "{{ $family }} {{ math.Round (mul $menu (div 12.0 14.0)) }}";
    font-lg:             "{{ $family }} {{ math.Round (mul $menu (div 16.0 14.0)) }}";
    font-xl:             "{{ $family }} {{ math.Round (mul $menu (div 22.0 14.0)) }}";

    radius:              {{ $radius }}px;
    radius-lg:           {{ math.Round (mul $radius 1.5) }}px;
    radius-xl:           {{ math.Round (mul $radius 2) }}px;
}
