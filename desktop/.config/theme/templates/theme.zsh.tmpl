# Generated by `theme` from {{ .spec.name }} (build {{ .spec.id }}). Do not edit:
# change prefs.toml or the scheme and run `theme apply`.
typeset -gA THEME_META=(
    [id]={{ .spec.id | strings.ShellQuote }}
    [name]={{ .spec.name | strings.ShellQuote }}
    [title]={{ .spec.title | strings.ShellQuote }}
    [source]={{ printf "%s:%s" .spec.source.kind .spec.source.ref | strings.ShellQuote }}
    [mode]={{ .spec.mode | strings.ShellQuote }}
    [pair]={{ .spec.pair | strings.ShellQuote }}
    [contrast]={{ .spec.contrast.level | strings.ShellQuote }}
    [requested]={{ .spec.contrast.requested | strings.ShellQuote }}
    [degraded]={{ .spec.contrast.degraded }}
    [adjusted]={{ join .spec.contrast.adjusted " " | strings.ShellQuote }}
    [anchored]={{ if has .spec.contrast "anchored" }}{{ join .spec.contrast.anchored " " | strings.ShellQuote }}{{ else }}''{{ end }}
    [icons]={{ .spec.icons | strings.ShellQuote }}
    [gtk]={{ .spec.gtk | strings.ShellQuote }}
    [cursor]={{ .spec.cursor.theme | strings.ShellQuote }}
    [wallpaper]={{ .spec.wallpaper | strings.ShellQuote }}
)
typeset -gA THEME_ROLE=(
{{- range $k, $v := .spec.roles }}
    [{{ $k }}]={{ $v | strings.ShellQuote }}
{{- end }}
)
typeset -gA THEME_PALETTE=(
{{- range $k, $v := .spec.palette }}{{ if ne $k "names" }}
    [{{ $k }}]={{ $v | strings.ShellQuote }}
{{- end }}{{ end }}
{{- if has .spec.palette "names" }}{{ range $k, $v := .spec.palette.names }}
    [{{ $k }}]={{ $v | strings.ShellQuote }}
{{- end }}{{ end }}
)
typeset -ga THEME_ANSI=(
{{- range .spec.ansi }}
    {{ . | strings.ShellQuote }}
{{- end }}
)
typeset -gA THEME_SIZE=(
{{- range $k, $v := .spec.font.sizes }}
    [{{ $k }}]={{ $v }}
{{- end }}
)
typeset -gA THEME_METRIC=(
{{- range $k, $v := .spec.metrics }}
    [{{ $k }}]={{ $v }}
{{- end }}
)
typeset -gA THEME_FONT=(
{{- range $k, $v := .spec.font.family }}
    [{{ $k }}]={{ $v | strings.ShellQuote }}
{{- end }}
)
