{{- /*
  Linked as ~/.config/gtk-3.0/theme.css and ~/.config/gtk-4.0/theme.css by
  `theme ensure` (and the xsettingsd reloader); each gtk.css beside them
  starts with @import url("theme.css"). A relative url resolves against the
  importing file's own path, not the stow link's target, so the import stays
  free of a hardcoded home; GTK expands no ~.

  Only @define-color, which GTK 3 and 4 both read: adw-gtk3 (GTK 3 and plain
  GTK 4 apps) and libadwaita define their colours, and their GTK 4 CSS
  variables (--window-bg-color: @window_bg_color), from these names, and the
  user stylesheet outranks the theme's. No var() or :root, which GTK 3
  rejects. Derived names (theme_*_color, borders, insensitive_*) follow from
  these in the theme itself, as does libadwaita's --accent-color.

  Solid surfaces come from roles: window and view are bg; the raised ones
  (header bar, sidebar, popovers, dialogs, thumbnails) are bg_alt, one step
  toward fg as libadwaita's are in both modes. Shades and card fills are
  translucent, as libadwaita's are, so they work on any surface.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $dark := eq $s.mode "dark" -}}
/* Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
   change prefs.toml or the scheme and run `theme apply`. */

@define-color accent_bg_color {{ $r.accent }};
@define-color accent_fg_color {{ $r.on_accent }};
@define-color accent_color {{ $r.accent }};
@define-color destructive_bg_color {{ $r.urgent }};
@define-color destructive_fg_color {{ $r.on_urgent }};
@define-color destructive_color {{ $r.urgent }};
@define-color error_bg_color {{ $r.urgent }};
@define-color error_fg_color {{ $r.on_urgent }};
@define-color error_color {{ $r.urgent }};
@define-color success_bg_color {{ $r.ok }};
@define-color success_fg_color {{ $r.on_ok }};
@define-color success_color {{ $r.ok }};
@define-color warning_bg_color {{ $r.warn }};
@define-color warning_fg_color {{ $r.on_warn }};
@define-color warning_color {{ $r.warn }};

@define-color window_bg_color {{ $r.bg }};
@define-color window_fg_color {{ $r.fg }};
@define-color view_bg_color {{ $r.bg }};
@define-color view_fg_color {{ $r.fg }};

@define-color headerbar_bg_color {{ $r.bg_alt }};
@define-color headerbar_fg_color {{ $r.fg }};
@define-color headerbar_border_color {{ $r.fg }};
@define-color headerbar_backdrop_color {{ $r.bg }};
@define-color headerbar_shade_color {{ if $dark }}rgba(0, 0, 0, 0.36){{ else }}rgba(0, 0, 0, 0.12){{ end }};
@define-color headerbar_darker_shade_color {{ if $dark }}rgba(0, 0, 0, 0.9){{ else }}rgba(0, 0, 0, 0.12){{ end }};

@define-color sidebar_bg_color {{ $r.bg_alt }};
@define-color sidebar_fg_color {{ $r.fg }};
@define-color sidebar_backdrop_color {{ $r.bg }};
@define-color sidebar_border_color {{ $r.border }};
@define-color sidebar_shade_color {{ if $dark }}rgba(0, 0, 0, 0.25){{ else }}rgba(0, 0, 0, 0.07){{ end }};
@define-color secondary_sidebar_bg_color {{ $r.bg_alt }};
@define-color secondary_sidebar_fg_color {{ $r.fg }};
@define-color secondary_sidebar_backdrop_color {{ $r.bg }};
@define-color secondary_sidebar_border_color {{ $r.border }};
@define-color secondary_sidebar_shade_color {{ if $dark }}rgba(0, 0, 0, 0.25){{ else }}rgba(0, 0, 0, 0.07){{ end }};

@define-color card_bg_color {{ if $dark }}alpha({{ $r.fg }}, 0.08){{ else }}alpha({{ $r.fg }}, 0.04){{ end }};
@define-color card_fg_color {{ $r.fg }};
@define-color card_shade_color {{ if $dark }}rgba(0, 0, 0, 0.36){{ else }}rgba(0, 0, 0, 0.07){{ end }};
@define-color dialog_bg_color {{ $r.bg_alt }};
@define-color dialog_fg_color {{ $r.fg }};
@define-color popover_bg_color {{ $r.bg_alt }};
@define-color popover_fg_color {{ $r.fg }};
@define-color popover_shade_color {{ if $dark }}rgba(0, 0, 0, 0.25){{ else }}rgba(0, 0, 0, 0.07){{ end }};
@define-color thumbnail_bg_color {{ $r.bg_alt }};
@define-color thumbnail_fg_color {{ $r.fg }};

@define-color shade_color {{ if $dark }}rgba(0, 0, 0, 0.25){{ else }}rgba(0, 0, 0, 0.07){{ end }};
@define-color scrollbar_outline_color {{ if $dark }}rgba(0, 0, 0, 0.5){{ else }}rgba(255, 255, 255, 0.5){{ end }};
