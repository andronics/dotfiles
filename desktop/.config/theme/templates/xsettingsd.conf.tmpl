{{- /*
  Served by xsettingsd (.zlogin.d/20-xsettingsd) through
  ~/.local/state/theme/xsettingsd.conf, a link `theme ensure` keeps on
  current/xsettingsd.conf. `theme reload xsettingsd` HUPs it. XSETTINGS
  outrank gtk-3.0/settings.ini, which keeps every other GTK setting and is the
  fallback while xsettingsd isn't running.

  ThemeName (prefs [gtk], by mode) and IconThemeName (prefs [icons]) are
  written only when the theme is installed in an XDG data dir: a missing one
  would leave GTK on its built-in theme or icons, so without it the
  settings.ini value stays. Font: the UI family at fonts.base.gtk x scale.
  Cursor: as Xcursor.theme/size in the generated xresources.
*/ -}}
{{- $s := .spec -}}
{{- $home := env.Getenv "HOME" -}}
{{- $dirs := slice (env.Getenv "XDG_DATA_HOME" (print $home "/.local/share")) -}}
{{- range (strings.Split ":" (env.Getenv "XDG_DATA_DIRS" "/usr/local/share:/usr/share")) }}{{ if . }}{{ $dirs = $dirs | append . }}{{ end }}{{ end -}}
{{- $gtk := "" -}}{{- $icons := "" -}}
{{- if $s.gtk }}{{ range $dirs }}{{ if file.Exists (print . "/themes/" $s.gtk "/gtk-3.0/gtk.css") }}{{ $gtk = $s.gtk }}{{ end }}{{ end }}{{ if file.Exists (print $home "/.themes/" $s.gtk "/gtk-3.0/gtk.css") }}{{ $gtk = $s.gtk }}{{ end }}{{ end -}}
{{- if $s.icons }}{{ range $dirs }}{{ if file.Exists (print . "/icons/" $s.icons "/index.theme") }}{{ $icons = $s.icons }}{{ end }}{{ end }}{{ if file.Exists (print $home "/.icons/" $s.icons "/index.theme") }}{{ $icons = $s.icons }}{{ end }}{{ end -}}
# Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
# change prefs.toml or the scheme and run `theme apply`.
{{ if $gtk }}
Net/ThemeName {{ $gtk | data.ToJSON }}
{{- else }}
# Net/ThemeName: {{ $s.gtk | data.ToJSON }} is not installed; settings.ini's stays
{{- end }}
{{- if $icons }}
Net/IconThemeName {{ $icons | data.ToJSON }}
{{- else }}
# Net/IconThemeName: {{ $s.icons | data.ToJSON }} is not installed; settings.ini's stays
{{- end }}
Gtk/FontName {{ printf "%s %v" $s.font.family.ui $s.font.sizes.gtk | data.ToJSON }}
Gtk/CursorThemeName {{ $s.cursor.theme | data.ToJSON }}
Gtk/CursorThemeSize {{ $s.cursor.size }}
