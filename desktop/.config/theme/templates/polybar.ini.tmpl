{{- /*
  Included by polybar/config.ini (include-file). polybar can't start without
  it, so `theme ensure` runs before every launch and re-renders a build that
  predates this template.

  [colors] holds the roles (bg, bg-alt, fg, accent, ...; "_" becomes "-"),
  which is all the repo's modules use, then the raw palette and the scheme's
  named colours for hand-written additions. polybar refuses a key defined
  twice, so a name that matches a role or a slot is skipped.

  [theme] holds the bar's fonts and sizes. The height is metrics.bar_height
  unscaled: the bar stays 50px and its text and icons grow inside it (bar
  10pt and icon 13pt x fonts.scale). The spacer font draws the powerline
  corners, so its size follows the height, not the scale. line-size is the
  underline under shown coordinators and the focused desktop.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $f := $s.font.family -}}
{{- $z := $s.font.sizes -}}
{{- $keys := coll.Slice -}}
; Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
; change prefs.toml or the scheme and run `theme apply`.

[colors]
{{- range $k, $v := $r }}
{{- $keys = $keys | coll.Append ($k | strings.ReplaceAll "_" "-") }}
{{ $k | strings.ReplaceAll "_" "-" }} = {{ $v }}
{{- end }}
transparent = #00000000

{{- range $k, $v := $s.palette }}{{ if ne $k "names" }}
{{ $k }} = {{ $v }}
{{- end }}{{ end }}
{{- if has $s.palette "names" }}{{ range $k, $v := $s.palette.names }}
{{- if not (or (has $keys $k) (has $s.palette $k) (eq $k "transparent")) }}
{{ $k }} = {{ $v }}
{{- end }}{{ end }}{{ end }}

[theme]
height = {{ $s.metrics.bar_height }}
line-size = {{ $s.metrics.border }}
font-icon = "{{ $f.icon }}:style=2048-em:size={{ $z.icon }};2"
font-spacer = "{{ $f.icon }}:style=2048-em:size={{ $s.metrics.bar_height }};2"
font-text = "{{ $f.ui }}:size={{ $z.bar }}:weight=medium;2"
font-text-alt = "Adwaita Mono:size={{ $z.bar }}:weight=medium;2"
