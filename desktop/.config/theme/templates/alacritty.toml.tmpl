{{- /*
  The last entry in alacritty.toml's general.import, so it overrides the
  static theme and font files; alacritty skips it while it doesn't exist.
  The font size is a whole point: the default terminal 13 x scale 1.25 =
  16.25 stays on today's 16. Selection and the vi cursor follow
  catppuccin/alacritty's choices (cursor colour, accent), so Mocha renders
  as the static theme did.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
{{- $a := $s.ansi -}}
{{- $mono := $s.font.family.mono -}}
# Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
# change prefs.toml or the scheme and run `theme apply`.

[font]
size = {{ math.Round (conv.ToFloat64 $s.font.sizes.terminal) }}.0
normal = { family = {{ $mono | data.ToJSON }}, style = "Regular" }
bold = { family = {{ $mono | data.ToJSON }}, style = "Bold" }
italic = { family = {{ $mono | data.ToJSON }}, style = "Italic" }
bold_italic = { family = {{ $mono | data.ToJSON }}, style = "Bold Italic" }

[colors.primary]
background = "{{ $r.bg }}"
foreground = "{{ $r.fg }}"
dim_foreground = "{{ $r.fg }}"
bright_foreground = "{{ $r.fg }}"

[colors.cursor]
text = "{{ $r.bg }}"
cursor = "{{ $r.cursor }}"

[colors.vi_mode_cursor]
text = "{{ $r.bg }}"
cursor = "{{ $r.accent }}"

[colors.search.matches]
foreground = "{{ $r.bg }}"
background = "{{ $r.fg_dim }}"

[colors.search.focused_match]
foreground = "{{ $r.bg }}"
background = "{{ $r.ok }}"

[colors.hints.start]
foreground = "{{ $r.bg }}"
background = "{{ $r.warn }}"

[colors.hints.end]
foreground = "{{ $r.bg }}"
background = "{{ $r.fg_dim }}"

[colors.selection]
text = "{{ $r.bg }}"
background = "{{ $r.cursor }}"

{{- $names := slice "black" "red" "green" "yellow" "blue" "magenta" "cyan" "white" }}

[colors.normal]
{{- range $i, $n := $names }}
{{ $n }} = "{{ index $a $i }}"
{{- end }}

[colors.bright]
{{- range $i, $n := $names }}
{{ $n }} = "{{ index $a (add $i 8) }}"
{{- end }}

[colors.dim]
{{- range $i, $n := $names }}
{{ $n }} = "{{ index $a $i }}"
{{- end }}

[[colors.indexed_colors]]
index = 16
color = "{{ $r.busy }}"

[[colors.indexed_colors]]
index = 17
color = "{{ $r.cursor }}"
