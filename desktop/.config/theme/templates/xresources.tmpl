{{- /*
  Merged by .zlogin.d/10-x11 after ~/.Xresources, and by `theme reload
  xresources`, with `xrdb -nocpp -merge`. Every key is written on every
  build, so a merge replaces the previous theme's values.

  *.colorN are the terminal's 16 ANSI colours (URxvt and other X clients).
  Xcursor: Adwaita (D16) at cursor.size x scale (24 x 1.25 = 30, the size
  libXcursor already picked on this 1440px-high screen). theme.<role> are
  the roles for ${xrdb:theme.*} references.
*/ -}}
{{- $s := .spec -}}
{{- $r := $s.roles -}}
! Generated by `theme` from {{ $s.name }} (build {{ $s.id }}). Do not edit:
! change prefs.toml or the scheme and run `theme apply`.

*.foreground: {{ $r.fg }}
*.background: {{ $r.bg }}
*.cursorColor: {{ $r.cursor }}
{{- range $i, $c := $s.ansi }}
*.color{{ $i }}: {{ $c }}
{{- end }}

Xcursor.theme: {{ $s.cursor.theme }}
Xcursor.size: {{ $s.cursor.size }}
{{ range $k, $v := $r }}
theme.{{ $k }}: {{ $v }}
{{- end }}
