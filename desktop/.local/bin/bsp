#!/usr/bin/env zsh
set -e

source "${DOTLIB}/_dispatcher" || { echo "missing _dispatcher" >&2; exit 1; }
source "${DOTLIB}/_bsp"      || { echo "missing _bsp"      >&2; exit 1; }

dispatcher-init "bsp" \
    --route=function \
    --prefix=bsp \
    --description="BSP window manager utilities"

dispatcher-execute "$@"
