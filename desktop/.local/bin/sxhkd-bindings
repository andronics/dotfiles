#!/usr/bin/env zsh
# sxhkd-bindings - show the sxhkd key bindings in rofi, each with the comment above it.

source "${DOTLIB}/_log" || { echo "missing _log" >&2; exit 1; }

sxhkdrc="${XDG_CONFIG_HOME:-$HOME/.config}/sxhkd/sxhkdrc"

case "$1" in
    -h|--help)
        print -r -- "usage: ${0:t} [-h|--help]"
        print -r -- "Lists the bindings in ${sxhkdrc} in rofi (bound to super+F1)."
        exit 0 ;;
    "") ;;
    *) log-error "unknown option: $1 (see --help)"; exit 2 ;;
esac

[[ -r "$sxhkdrc" ]] || { log-error "cannot read ${sxhkdrc}"; exit 1; }

# rofi directly, not _rofi's rofi-dmenu: that passes -lines, which rofi 1.7+ rejects.
LC_ALL=C awk '/^[a-zA-Z]/ && last {print $0 "\t" last} {last=""} /^#/{last=$0}' "$sxhkdrc" \
    | LC_ALL=C column -t -s $'\t' \
    | LC_ALL=C sort -f \
    | rofi -dmenu -i -p "sxhkd bindings" >/dev/null
exit 0
