#!/usr/bin/env zsh
# polybar-reload [bar] - restart the running bars on the current theme, or
# start [bar] (default $POLYBAR_BAR, else main) when none is running.
#
# Kept so .zlogin.d/99-polybar and habits work; it is `barctl restart`
# (desktop-tools, dotfiles record 0003 §B7), which runs `theme ensure` first
# (config.ini includes ~/.local/state/theme/current/polybar.ini, and polybar
# won't start without it), restarts running bars in place, relaunches one
# that froze from its own command line and environment, and starts a bar
# with HOST_MONITOR set when none is running. Every bar it starts or
# relaunches gets TOOL_STATS=skip, so polled and clicked calls write no run
# entries (the brain's record 0017 §3). Goes when its callers say
# `barctl restart`.

exec barctl restart "$@"
