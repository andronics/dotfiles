#!/usr/bin/env zsh

name=$(basename $0)

# ------------------------------

if ! source "${DOTLIB}/_xdg" 2>/dev/null; then
    echo "[ERROR] _xdg requires _xdg v2.0 - cannot load" >&2
    return 1
fi


# Setup XDG directories using extension library
xdg-config-dir "${name}"

# Backward-compatible aliases
palette_cache_dir=$(xdg-cache-dir "${name}")
palette_config_dir=$(xdg-config-dir "${name}")
palette_data_dir=$(xdg-data-dir "${name}")

# ------------------------------



# ------------------------------

_palette() {
    local _filter=$1
    awk -v f="${_filter}" '$1==f {print $2}' "$(xdg-config-dir "${name}")/palette.conf"
}

# ------------------------------

_palette "$@"


