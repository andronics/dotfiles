#!/usr/bin/env zsh
set -e

source "${DOTLIB}/_dispatcher" || { echo "missing _dispatcher" >&2; exit 1; }
source "${DOTLIB}/_barmenu"    || { echo "missing _barmenu"    >&2; exit 1; }

dispatcher-init "barmenu" \
    --route=function \
    --description="The polybar menu buttons as rofi menus, opened above the pointer"

dispatcher-execute "$@"
