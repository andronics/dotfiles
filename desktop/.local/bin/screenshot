#!/usr/bin/env zsh
set -e

source "${DOTLIB}/_dispatcher"  || { echo "missing _dispatcher"  >&2; exit 1; }
source "${DOTLIB}/_screenshot"  || { echo "missing _screenshot"  >&2; exit 1; }

dispatcher-init "screenshot" \
    --route=function \
    --description="maim/xclip screenshot capture"

[[ $# -eq 0 ]] && set -- menu

dispatcher-execute "$@"
