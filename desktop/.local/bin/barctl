#!/usr/bin/env zsh
set -e

source "${DOTLIB}/_dispatcher" || { echo "missing _dispatcher" >&2; exit 1; }
source "${DOTLIB}/_barctl"     || { echo "missing _barctl"     >&2; exit 1; }

dispatcher-init "barctl" \
    --route=function \
    --description="Bar controller: follows volume and media players and redraws polybar's IPC modules when they change (design record 0001)"

dispatcher-execute "$@"
