#!/usr/bin/env zsh
# rofi-preview <variant> - open a rofi theme variant on harmless sample rows
# and print what was picked instead of acting on it. Themes and _power come
# from the checkout this script lives in (stow links resolve back to it), so a
# worktree previews its own, uninstalled themes; crew's cells come from the
# installed desktop-tools. Besides one variant per
# theme, `power-confirm` shows power's Yes/No question (themes/prompt.rasi)
# and `confirm` crew's (themes/confirm.rasi) on a sample question. The
# bar menus (barmenu) moved to andronics/desktop-tools (dotfiles record 0003),
# which has no preview mode, so `bar-menu` shows its theme on sample rows.
#
# THEME_STATE_DIR=<dir> previews against that theme state (e.g. one made by
# `THEME_STATE_DIR=<dir> theme apply nord`) instead of ~/.local/state/theme:
# each variant is wrapped in a cache file that imports its generated
# rofi.rasi last, since base.rasi's own import path is fixed.

_repo=${0:A:h:h:h:h}
_themes="${_repo}/desktop/.config/rofi/themes"
_variants=(${_themes}/*.rasi(N:t:r) power-confirm)

# REPLY = the theme file for variant $1, wrapped when THEME_STATE_DIR is set.
_theme_file() {
    REPLY="${_themes}/$1.rasi"
    [[ -n "${THEME_STATE_DIR:-}" ]] || return 0
    local gen="${THEME_STATE_DIR}/current/rofi.rasi"
    local wrap="${XDG_CACHE_HOME:-$HOME/.cache}/theme/rofi-preview/$1.rasi"
    [[ -r "$gen" ]] || { print -u2 "rofi-preview: no ${gen}; run: THEME_STATE_DIR=${THEME_STATE_DIR} theme apply <scheme>"; exit 1; }
    mkdir -p "${wrap:h}" || exit 1
    print -rl -- "@import \"${REPLY}\"" "@import \"${gen:A}\"" > "$wrap"
    REPLY=$wrap
}

_variant=${1:-}
if [[ -z "$_variant" || ${_variants[(Ie)$_variant]} -eq 0 ]]; then
    print -u2 "usage: ${0:t} <variant>   variants: ${_variants[*]}"
    exit 2
fi

_theme_name=${_variant/#power-confirm/prompt}
_theme_file "$_theme_name"
_args=(-dmenu -i -no-custom -theme "$REPLY")
_rows=()

case "$_variant" in
    launcher)
        for _app _icon in Firefox firefox Code visual-studio-code Files nemo Spotify spotify \
            Alacritty Alacritty GIMP gimp Thunderbird thunderbird Writer libreoffice-writer \
            VLC vlc Steam steam Discord discord OBS com.obsproject.Studio Inkscape inkscape \
            Blender blender Calculator accessories-calculator KeePassXC keepassxc \
            Transmission transmission VirtualBox virtualbox; do
            _rows+=("${_app}"$'\0icon\x1f'"${_icon}")
        done
        ;;
    bar-popup)
        _rows=(
            "firefox     GitHub - andronics/dotfiles"$'\0icon\x1f'"firefox"
            "code        _desk - dotfiles"$'\0icon\x1f'"visual-studio-code"
            "alacritty   ~/.dotfiles: zsh"$'\0icon\x1f'"Alacritty"
            "nemo        Downloads"$'\0icon\x1f'"nemo"
            "spotify     Spotify Premium"$'\0icon\x1f'"spotify"
        )
        _args+=(-p "window") ;;
    crew)
        # crew's own cells (its menus.cell and stop_cell, from the installed
        # desktop-tools) for the coordinators in its registry copy, in sample
        # states, the first shown; nothing is asked of meta or tmux.
        _py="$(uv tool dir 2>/dev/null)/desktop-tools/bin/python"
        [[ -x "$_py" ]] || { print -u2 "rofi-preview: no desktop-tools at ${_py:h:h}; run: ./dotfiles reinstall desktop"; exit 1; }
        _out=("${(@f)$(TOOL_STATS=skip "$_py" -c '
from desktop_tools.common import theme
from desktop_tools.crew import menus, registry
reg = registry.load(refresh=False)
colours = theme.roles(menus.COLOUR_ROLES)
keys = reg.keys()
states = ["idle", "busy", "waiting", "off", "idle", "off", "off"]
print(" ".join(reg.names))
for i, c in enumerate(reg.coordinators):
    state = states[i] if i < len(states) else "off"
    print(menus.cell(c.name, c.icon, keys.get(c.name, ""), state, i == 0, colours))
print(menus.stop_cell(3, colours))
')}") || exit 1
        _names=(${=_out[1]})
        _rows=("${(@)_out[2,-1]}")
        # The cursor starts off the shown cell so both the ring and the pill show.
        _args+=(-markup-rows -format i -matching prefix -p "Coordinator" -selected-row 1 -a 0) ;;
    power|power-confirm)
        # The real menu and question from _power, minus the acting.
        export DOTLIB="${_repo}/shell/.local/share/dotlib"
        _theme_file power;  export POWER_MENU_THEME=$REPLY
        _theme_file prompt; export POWER_CONFIRM_THEME=$REPLY
        source "${DOTLIB}/_power" || exit 1
        if [[ "$_variant" == power ]]; then
            _power-menu-choose -mesg "Power (preview: nothing runs)" \
                && print -r -- "power: picked '${REPLY}'" || print -r -- "power: cancelled"
        else
            _power-confirm-ask suspend \
                && print -r -- "power-confirm: picked 'Yes'" || print -r -- "power-confirm: No or cancelled"
        fi
        exit 0 ;;
    confirm)
        # crew's Yes/No (desktop-tools' crew life._ask): the question as the
        # message, No selected.
        _rows=(Yes No)
        _args+=(-format s -selected-row 1 -p crew
            -mesg "the sample coordinator: no PAUSED notes since its last RESUMED heading: stop it anyway? (preview: nothing runs)") ;;
    prompt)
        _args=(${_args:#-no-custom} -p "Rename") ;;
    *)
        _args+=(-p "$_variant")
        _rows=("first sample row" "second sample row" "third sample row") ;;
esac

if _choice=$(print -rn -- "${(pj:\n:)_rows}" | rofi "${_args[@]}"); then
    [[ "$_variant" == crew && "$_choice" == <-> ]] && _choice="${_choice} (${_names[_choice + 1]:-Stop all})"
    print -r -- "${_variant}: picked '${_choice}'"
else
    print -r -- "${_variant}: cancelled"
fi
