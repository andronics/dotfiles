! https://wiki.archlinux.org/title/x_resources
! https://stuff.mit.edu/afs/sipb/project/doc/ixresources/xres.html

! https://linux.die.net/man/1/urxvt
URxvt.font: xft:JetBrains Mono Medium:size=11
URxvt.boldFont: xft:DejaVu Sans Mono:size=11
URxvt.scrollBar: true
URxvt.perl-ext-common:resize-font
URxvt.keysym.C-minus:resize-font:smaller
URxvt.keysym.C-equal:resize-font:bigger
URxvt.keysym.C-0:resize-font:reset
URxvt*depth: 32
URxvt.shading: 114
URxvt*transparent: true
URxvt.tintColor: #3f3f3f

! Colours (*.foreground, *.background, *.colorN), Xcursor and theme.* come
! from the theme: .zlogin.d/10-x11 merges ~/.local/state/theme/current/xresources
! after this file.
