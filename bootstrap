#!/usr/bin/env bash
# bootstrap — install dotfile packages by profile via GNU stow.
#
# Usage:
#   ./bootstrap install <profile...>     stow packages from one or more profiles
#   ./bootstrap uninstall <profile...>   unstow
#   ./bootstrap restow <profile...>      restow (-R, useful after package updates)
#   ./bootstrap list                     show profiles and their packages
#   ./bootstrap status                   show which packages are currently stowed
#   ./bootstrap requires <profile...>    print system packages the profile needs
#
# Flags (place before the subcommand):
#   --dry-run    show what would happen without acting
#   --target=DIR stow target dir (default: $HOME)
#
# Profiles compose: `./bootstrap install core cli` stows the union.

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${HOME}"
DRY_RUN=0

# --- profile definitions -----------------------------------------------------

declare -A PROFILES=(
    [core]="zsh git ssh tmux gnupg password-store github-cli git-hooks git-crypt xdg lib claude profile"
    [cli]="zoxide starship ranger neofetch dir_colors deno go nano gprename"
    [desktop]="bspwm bsp sxhkd polybar picom dunst rofi gtk x11 alacritty fonts backgrounds themes screenshot polkit feh nemo terminal palette cava bluetooth"
    [services]="docker talos crowdsec spotifyd mambembe audio player"
    [optional]="homebrew"
)

# system packages (Arch/pacman names) needed for each profile to actually function
declare -A REQUIRES=(
    [core]="zsh git tmux gnupg pass github-cli git-crypt stow"
    [cli]="zoxide starship ranger neofetch eza bat fzf"
    [desktop]="bspwm sxhkd polybar picom dunst rofi gtk3 alacritty papirus-icon-theme feh nemo"
    [services]="docker spotifyd"
    [optional]=""
)

# --- helpers -----------------------------------------------------------------

err()  { printf '\033[0;31merror:\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[0;33mwarn:\033[0m  %s\n' "$*" >&2; }
info() { printf '\033[0;36m·\033[0m %s\n' "$*"; }
ok()   { printf '\033[0;32m✓\033[0m %s\n' "$*"; }

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# resolve profile names → unique list of package names
resolve_packages() {
    local -a profiles=("$@")
    local -A seen=()
    local prof pkg
    for prof in "${profiles[@]}"; do
        if [[ -z "${PROFILES[$prof]:-}" ]]; then
            err "unknown profile: $prof"
            echo "available: ${!PROFILES[*]}" >&2
            exit 2
        fi
        for pkg in ${PROFILES[$prof]}; do
            seen[$pkg]=1
        done
    done
    printf '%s\n' "${!seen[@]}" | sort
}

# does `dir/` look like a stow package on disk?
package_exists() {
    [[ -d "$DOTFILES_DIR/$1" ]]
}

run_stow() {
    local mode=$1; shift
    local -a flags=(-d "$DOTFILES_DIR" -t "$TARGET_DIR")
    case $mode in
        install)   flags+=(-S) ;;
        uninstall) flags+=(-D) ;;
        restow)    flags+=(-R) ;;
        *) err "internal: bad mode $mode"; exit 2 ;;
    esac
    (( DRY_RUN )) && flags+=(-n -v)
    stow "${flags[@]}" "$@"
}

cmd_list() {
    local prof
    for prof in "${!PROFILES[@]}"; do
        printf '\033[1m%s\033[0m\n' "$prof"
        for pkg in ${PROFILES[$prof]}; do
            if package_exists "$pkg"; then
                printf '  %s\n' "$pkg"
            else
                printf '  %s \033[0;33m(missing)\033[0m\n' "$pkg"
            fi
        done
        echo
    done
}

cmd_status() {
    local pkg link target
    info "stowed packages (symlinks under $TARGET_DIR pointing into $DOTFILES_DIR):"
    # find symlinks anywhere under target whose target is inside DOTFILES_DIR
    find "$TARGET_DIR" -maxdepth 6 -type l 2>/dev/null \
        | while read -r link; do
            target=$(readlink -f "$link" 2>/dev/null || true)
            [[ "$target" == "$DOTFILES_DIR"/* ]] || continue
            # extract the package name (first path segment after DOTFILES_DIR/)
            echo "${target#"$DOTFILES_DIR"/}" | cut -d/ -f1
        done | sort -u
}

cmd_requires() {
    local prof
    local -A all=()
    for prof in "$@"; do
        for pkg in ${REQUIRES[$prof]:-}; do all[$pkg]=1; done
    done
    if (( ${#all[@]} == 0 )); then
        warn "no system requirements declared"
        return
    fi
    info "system packages (pacman) needed:"
    printf '  %s\n' "${!all[@]}" | sort
    echo
    info "install with:"
    printf '  sudo pacman -S --needed %s\n' "$(printf '%s ' "${!all[@]}" | sort | tr -d '\n' | sed 's/ $//')"
}

cmd_act() {
    local mode=$1; shift
    [[ $# -gt 0 ]] || { err "no profiles given"; usage 2; }

    local resolved
    resolved=$(resolve_packages "$@")
    local -a packages=()
    while IFS= read -r p; do packages+=("$p"); done <<<"$resolved"

    local -a present=() missing=()
    for pkg in "${packages[@]}"; do
        if package_exists "$pkg"; then
            present+=("$pkg")
        else
            missing+=("$pkg")
        fi
    done

    if (( ${#missing[@]} )); then
        warn "skipping packages not on disk: ${missing[*]}"
    fi

    if (( ${#present[@]} == 0 )); then
        err "no packages to act on"
        exit 1
    fi

    info "${mode}ing ${#present[@]} packages: ${present[*]}"
    (( DRY_RUN )) && info "(dry run — no changes will be made)"
    run_stow "$mode" "${present[@]}"
    ok "${mode} complete"
}

# --- arg parsing -------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)        DRY_RUN=1; shift ;;
        --target=*)       TARGET_DIR=${1#--target=}; shift ;;
        --target)         TARGET_DIR=$2; shift 2 ;;
        -h|--help|help)   usage ;;
        list|ls)          cmd_list; exit 0 ;;
        status)           cmd_status; exit 0 ;;
        requires)         shift; cmd_requires "$@"; exit 0 ;;
        install|stow)     shift; cmd_act install "$@"; exit 0 ;;
        uninstall|unstow) shift; cmd_act uninstall "$@"; exit 0 ;;
        restow)           shift; cmd_act restow "$@"; exit 0 ;;
        *)                err "unknown subcommand: $1"; usage 2 ;;
    esac
done

usage
