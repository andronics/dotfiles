#!/usr/bin/env bash

# ------------------------------

dotfiles_source_root="$(cd "$(dirname "$0")" && pwd)"
dotfiles_target_root="${HOME}"
dotfiles_ignore="\.((?:pre|post)?(?:un)?install|fold)|README\.md|LICENSE|\.gitignore|\.git|\.DS_Store"

# ------------------------------

err()  { printf '\033[0;31merror:\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[0;33mwarn:\033[0m  %s\n' "$*" >&2; }
info() { printf '\033[0;36m·\033[0m %s\n' "$*"; }
ok()   { printf '\033[0;32m✓\033[0m %s\n' "$*"; }

# ------------------------------

_dotfiles() {

   [[ $# -eq 0 ]] && {
        info "usage: $(basename $0) [i|install|r|reinstall|u|uninstall|c|completions|check-crypt] "
        return 1
   }

   _command=$1
   shift 2>/dev/null

   pushd "${dotfiles_source_root}" > /dev/null

   _rc=0

   case ${_command} in
      
      i|install) _dotfiles_install "$@" ;;
      r|reinstall) _dotfiles_reinstall "$@" ;;
      u|uninstall) _dotfiles_uninstall "$@" ;;
      c|completions) _dotfiles_completions "$@" ;;
      check-crypt) "${dotfiles_source_root}/.githooks/check-crypt" "$@"; _rc=$? ;;
      
      *) printf "command '%s' unknown" "${_command}" && return ;;

   esac

   popd > /dev/null

   return ${_rc}

}


# ------------------------------

_dotfiles_install() {

   [[ ! -d "${dotfiles_target_root}" ]] && mkdir -p "${dotfiles_target_root}"

   _pkgs=${@:-"*"}

   for _pkg in ${_pkgs}; do
      
      [[ ! -d ${_pkg} ]] && {
         err "package '${_pkg}' does not exist"
         continue
      }
      
      
      [[ ${_pkg} =~ ^\. ]] && {
         warn "package '${_pkg}' prefixed with a period... ignoring"
         continue
      }

      [[ ${_pkg} == docs ]] && continue   # design records, not a stow package
      [[ ${_pkg} == tests ]] && continue  # repo tests, not a stow package

      _dotfiles_pre_install

      [[ -f "${_pkg}/.install" && -x "${_pkg}/.install" ]] && {
         info "package '${_pkg}' is being installed by script"
         source "${_pkg}/.install"
      }
      
      [[ ! -f "${_pkg}/.install" ]] && {

         _no_folding="--no-folding"
         
         [[ -f "${_pkg}/.fold" ]] && _no_folding=""

         info "package '${_pkg}' is being installed by stow"
         stow -t "${dotfiles_target_root}" -S ${_pkg} --ignore="${dotfiles_ignore}" ${_no_folding}

         [[ $? -ne 0 ]] && err "... failed to install"

      }

      _dotfiles_post_install

   done

}

# ------------------------------

_dotfiles_pre_install() {

   _script="${dotfiles_source_root}/${_pkg}/.preinstall"
      
   [[ -f "${_script}" && -x "${_script}" ]] && {
      info "package '${_pkg}' executing preinstall script"
      source "${_script}"
   }

}

_dotfiles_pre_uninstall() {

   _script="${dotfiles_source_root}/${_pkg}/.preuninstall"
      
   [[ -f "${_script}" && -x "${_script}" ]] && {
      info "package '${_pkg}' executing preuninstall script"
      source "${_script}"
   }
   
}

_dotfiles_post_install() {

   _script="${dotfiles_source_root}/${_pkg}/.postinstall"
      
   [[ -f "${_script}" && -x "${_script}" ]] && {
      info "package '${_pkg}' executing postinstall script"
      source "${_script}"
   }

}

_dotfiles_post_uninstall() {

   _script="${dotfiles_source_root}/${_pkg}/.postuninstall"
      
   [[ -f "${_script}" && -x "${_script}" ]] && {
      info "package '${_pkg}' executing postuninstall script"
      source "${_script}"
   }
   
}

# ------------------------------

_dotfiles_reinstall() {

   _dotfiles_uninstall $* 
   _dotfiles_install $* 

}

# ------------------------------

_dotfiles_uninstall() {

   [[ ! -d "${dotfiles_target_root}" ]] && return 1

   _pkgs=${@:-"*"}

   for _pkg in ${_pkgs}; do
      
      [[ ! -d ${_pkg} ]] && {
         err "package '${_pkg}' does not exist"
         continue
      }

      [[ ${_pkg} =~ ^\. ]] && {
         warn "package '${_pkg}' prefixed with a period... ignoring"
         continue
      }

      [[ ${_pkg} == docs ]] && continue   # design records, not a stow package
      [[ ${_pkg} == tests ]] && continue  # repo tests, not a stow package

      _dotfiles_pre_uninstall
         
      [[ -f "${_pkg}/.uninstall" && -x "${_pkg}/.uninstall" ]] && {
         info "package '${_pkg}' is being uninstalled by script"
         source "${_pkg}/.uninstall"
      }
      
      [[ ! -f "${_pkg}/.uninstall"  && ! -f "${_pkg}/.install" ]] && {

        _no_folding="--no-folding"
         
         [[ -f "${_pkg}/.fold" ]] && _no_folding=""
         
         info "package '${_pkg}' is being uninstalled by stow"
         stow -t "${dotfiles_target_root}" -D ${_pkg} --ignore="${dotfiles_ignore}" ${_no_folding}

         [[ $? -ne 0 ]] && err "... failed to uninstall"

      }

      _dotfiles_post_uninstall

   done

}

# ------------------------------

# Rewrites shell/.config/zsh/completions/_<tool>_cmd from `<tool> completion zsh`
# for each dotlib dispatcher in <pkg>/.local/bin (or just the tools named),
# run against this checkout's dotlib: zsh -f, because .zshenv would reset
# DOTLIB to the stowed copy. A file without the generator's "# Generated by"
# line is hand-written (coord, theme, barmenu) and is left alone. A new file
# still needs its own `ln -s` on a stowed host: stow folds completions/ per file.
_dotfiles_completions() {

   local _dir="shell/.config/zsh/completions" _bin _tool _out _tmp

   for _bin in */.local/bin/*; do

      _tool=$(basename "${_bin}")

      [[ $# -gt 0 && " $* " != *" ${_tool} "* ]] && continue
      grep -q '_dispatcher' "${_bin}" || continue

      _out="${_dir}/_${_tool}_cmd"

      [[ -f "${_out}" ]] && ! grep -q '^# Generated by' "${_out}" && {
         info "${_tool}: hand-written completion, skipped"
         continue
      }

      _tmp=$(mktemp "${_out}.XXXXXX")

      if DOTLIB="${dotfiles_source_root}/shell/.local/share/dotlib" zsh -f "${_bin}" completion zsh > "${_tmp}" \
         && zsh -n "${_tmp}"; then
         chmod 644 "${_tmp}"
         mv "${_tmp}" "${_out}"
         ok "${_out}"
      else
         rm -f "${_tmp}"
         err "${_tool}: completion zsh failed"
      fi

   done

}

# ------------------------------

_dotfiles "$@"

