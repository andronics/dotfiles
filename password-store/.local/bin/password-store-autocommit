#!/bin/bash
# password-store-autocommit - monitors for changes and auto-commits

SYNCING=false

inotifywait -m -r -e modify,create,delete,move ~/.password-store --exclude '\.git' | while read -r directory event filename; do

    [[ "$filename" == *.gpg ]] && {
        
        [[ "$SYNCING" == true ]] && {
            echo "Sync in progress, ignoring event"
            continue
        }
        
        cd ~/.password-store
        
        SYNCING=true
        
        # Pull any remote changes first with autostash
        git pull --rebase --autostash &>/dev/null
        
        # Check if there are actually uncommitted changes after the pull
        [[ -z $(git status --porcelain) ]] && {
            echo "No changes to commit for $filename (already committed or pulled from remote)"
            SYNCING=false
            continue
        }
        
        # Extract the pass name (relative path without .gpg)
        relative_path="${directory#$HOME/.password-store/}"
        
        [[ -n "$relative_path" && "$relative_path" != "$directory" ]] && {
            pass_name="${relative_path}${filename%.gpg}"
        } || {
            pass_name="${filename%.gpg}"
        }
        
        # Determine action based on event
        case "$event" in
            CREATE)
                action="Add given password for"
                ;;
            MODIFY)
                action="Edit password for"
                ;;
            DELETE|MOVED_FROM)
                action="Remove"
                ;;
            MOVED_TO)
                action="Rename"
                ;;
            *)
                action="Update"
                ;;
        esac
        
        git add -A &>/dev/null
        git commit -m "autocommit: $action $pass_name to store."
        echo "Committed: $action $pass_name"
        
        # Push to remote
        git push &>/dev/null
        [[ $? -eq 0 ]] && {
            echo "Synced with remote"
        } || {
            echo "Failed to push - GPG key may need unlocking"
	        notify-send "Password Store" "Git sync failed - unlock GPG key"
        }
        
        # Clear sync flag
        SYNCING=false
    
    }

done
